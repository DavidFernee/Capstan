{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:capstan:schemas:media-format-registry:1.0.0",
  "title":"Capstan media format registry",
  "description":"One record is one exact operation/profile tuple; no record implies adjacent profiles or directions.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","records"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "records":{"type":"array","items":{"$ref":"#/$defs/record"}}
  },
  "allOf":[
    {
      "if":{"properties":{"assurance_level":{"enum":["reviewed","release-assured"]}},"required":["assurance_level"]},
      "then":{
        "properties":{
          "licence_review":{"const":"reviewed-clear"},
          "patent_review":{"const":"reviewed-clear"},
          "test_status":{"const":"passed"},
          "fuzz_status":{"const":"passed"}
        },
        "required":["licence_review","patent_review","test_status","fuzz_status"]
      }
    },
    {
      "if":{"properties":{"assurance_level":{"const":"release-assured"}},"required":["assurance_level"]},
      "then":{"properties":{"corpus_revision":{"not":{"const":"none"}}},"required":["corpus_revision"]}
    }
  ],
  "$defs":{
    "review":{"enum":["not-reviewed","reviewed-clear","restricted","unknown"]},
    "record":{
      "type":"object","additionalProperties":false,
      "required":["id","version","container","codec","profile","level","operation","ancillary_formats","bit_depth","chroma","channel_layout","platforms","implementation","source_revision","licence_review","patent_review","corpus_revision","test_status","fuzz_status","assurance_level","known_limitations"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,95}$"},
        "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "container":{"type":"string","minLength":1},"codec":{"type":"string","minLength":1},
        "profile":{"type":"string","minLength":1},"level":{"type":["string","null"]},
        "operation":{"enum":["decode","encode","demux","mux"]},
        "ancillary_formats":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "bit_depth":{"type":["integer","null"],"minimum":1,"maximum":128},
        "chroma":{"type":["string","null"]},"channel_layout":{"type":["string","null"]},
        "platforms":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "implementation":{"type":"string","minLength":1},
        "source_revision":{"type":"string","pattern":"^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "licence_review":{"$ref":"#/$defs/review"},"patent_review":{"$ref":"#/$defs/review"},
        "corpus_revision":{"type":"string","minLength":1},
        "test_status":{"enum":["not-present","present-not-run","passed","failed","inconclusive"]},
        "fuzz_status":{"enum":["not-run","running","passed","failed","inconclusive"]},
        "assurance_level":{"enum":["unassessed","prototype","reviewed","release-assured"]},
        "known_limitations":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}