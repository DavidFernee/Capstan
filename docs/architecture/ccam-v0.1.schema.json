{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DavidFernee/Capstan/blob/main/docs/architecture/ccam-v0.1.schema.json",
  "title": "Capstan Core Abstract Machine v0.1 program",
  "type": "object",
  "required": ["entry", "functions"],
  "additionalProperties": false,
  "properties": {
    "entry": { "type": "string", "minLength": 1 },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "index": { "type": "integer", "minimum": 0 },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "function": {
      "type": "object",
      "required": ["name", "register_types", "parameter_count", "return_type", "instructions"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "register_types": {
          "type": "array",
          "items": { "enum": ["int", "bool"] }
        },
        "parameter_count": { "type": "integer", "minimum": 0 },
        "return_type": { "enum": ["int", "bool", "void"] },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/instruction" }
        }
      }
    },
    "instruction": {
      "oneOf": [
        {
          "type": "object", "required": ["op", "dst", "value"], "additionalProperties": false,
          "properties": { "op": { "const": "const_i" }, "dst": { "$ref": "#/$defs/index" }, "value": { "$ref": "#/$defs/int64" } }
        },
        {
          "type": "object", "required": ["op", "dst", "value"], "additionalProperties": false,
          "properties": { "op": { "const": "const_b" }, "dst": { "$ref": "#/$defs/index" }, "value": { "type": "boolean" } }
        },
        {
          "type": "object", "required": ["op", "dst", "src"], "additionalProperties": false,
          "properties": { "op": { "const": "move" }, "dst": { "$ref": "#/$defs/index" }, "src": { "$ref": "#/$defs/index" } }
        },
        {
          "type": "object", "required": ["op", "dst", "lhs", "rhs"], "additionalProperties": false,
          "properties": {
            "op": { "enum": ["add_i", "sub_i", "mul_i", "div_i", "rem_i", "eq_i", "lt_i"] },
            "dst": { "$ref": "#/$defs/index" }, "lhs": { "$ref": "#/$defs/index" }, "rhs": { "$ref": "#/$defs/index" }
          }
        },
        {
          "type": "object", "required": ["op", "dst", "src"], "additionalProperties": false,
          "properties": { "op": { "const": "not_b" }, "dst": { "$ref": "#/$defs/index" }, "src": { "$ref": "#/$defs/index" } }
        },
        {
          "type": "object", "required": ["op", "target"], "additionalProperties": false,
          "properties": { "op": { "const": "jump" }, "target": { "$ref": "#/$defs/index" } }
        },
        {
          "type": "object", "required": ["op", "cond", "if_true", "if_false"], "additionalProperties": false,
          "properties": {
            "op": { "const": "branch" }, "cond": { "$ref": "#/$defs/index" },
            "if_true": { "$ref": "#/$defs/index" }, "if_false": { "$ref": "#/$defs/index" }
          }
        },
        {
          "type": "object", "required": ["op", "dst", "function", "args"], "additionalProperties": false,
          "properties": {
            "op": { "const": "call" },
            "dst": { "oneOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
            "function": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "$ref": "#/$defs/index" } }
          }
        },
        {
          "type": "object", "required": ["op", "src"], "additionalProperties": false,
          "properties": { "op": { "const": "ret" }, "src": { "$ref": "#/$defs/index" } }
        },
        {
          "type": "object", "required": ["op"], "additionalProperties": false,
          "properties": { "op": { "const": "ret_void" } }
        },
        {
          "type": "object", "required": ["op", "reason"], "additionalProperties": false,
          "properties": {
            "op": { "const": "trap" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{0,63}$" }
          }
        }
      ]
    }
  }
}
