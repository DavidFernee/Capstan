{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DavidFernee/Capstan/blob/main/docs/assurance/execution-boundaries.schema.json",
  "title": "Capstan execution assurance boundary register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "baseline_commit",
    "production_path",
    "target_path",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository": {
      "const": "DavidFernee/Capstan"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "production_path": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_path": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "implementation",
        "formal",
        "implementation_refinement",
        "artifacts",
        "open"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "from": {
          "type": "string",
          "minLength": 2
        },
        "to": {
          "type": "string",
          "minLength": 2
        },
        "implementation": {
          "enum": [
            "absent",
            "specified",
            "prototype",
            "restricted",
            "production"
          ]
        },
        "formal": {
          "enum": [
            "unproved",
            "model-only",
            "partial",
            "proved"
          ]
        },
        "implementation_refinement": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
