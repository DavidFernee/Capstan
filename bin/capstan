#!/usr/bin/env bash
# capstan: front end for the Capstan compiler.
#   capstan run   file.cap... [-- program args]
#   capstan build file.cap... -o program [--release] [--strict]
#   capstan native file.cap... -o program [--release] [--strict] (Linux x86-64 prototype)
#   capstan test  file.cap...           [--strict]
#   capstan check file.cap...           [--release] [--strict]
#   capstan fmt   file.cap...           [--check]
#   capstan lsp                         (language server on stdin/stdout, started by an editor)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CAPSTANC="$ROOT/build/capstanc"
CC="${CC:-cc}"
CFLAGS="-O2 -std=gnu11 -w -I$ROOT/runtime"

if [[ ! -x "$CAPSTANC" ]]; then
  echo "capstan: bootstrapping the compiler (first run)..." >&2
  make -s -C "$ROOT" bootstrap >&2
fi

cmd="${1:-}"; shift || true
if [[ "$cmd" == fmt ]]; then
  [[ -x "$ROOT/build/capstanfmt" ]] || make -s -C "$ROOT" fmt >&2
  exec "$ROOT/build/capstanfmt" "$@"
fi
if [[ "$cmd" == lsp ]]; then
  [[ -x "$ROOT/build/capstan-lsp" ]] || make -s -C "$ROOT" lsp >&2
  exec "$ROOT/build/capstan-lsp" "$@"
fi
files=(); flags=(); out=""; progargs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    --release|--strict|--keep-checks) flags+=("$1"); shift ;;
    --) shift; progargs=("$@"); break ;;
    *) files+=("$1"); shift ;;
  esac
done

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
case "$cmd" in
  check) exec "$CAPSTANC" check "${flags[@]}" "${files[@]}" ;;
  build)
    [[ -n "$out" ]] || { echo "capstan build: needs -o program" >&2; exit 2; }
    "$CAPSTANC" build -o "$tmp/out.c" "${flags[@]}" "${files[@]}"
    "$CC" $CFLAGS "$tmp/out.c" -o "$out" ;;
  run)
    "$CAPSTANC" build -o "$tmp/out.c" "${flags[@]}" "${files[@]}"
    "$CC" $CFLAGS "$tmp/out.c" -o "$tmp/prog"
    "$tmp/prog" "${progargs[@]}" ;;
  test)
    "$CAPSTANC" test -o "$tmp/out.c" "${flags[@]}" "${files[@]}"
    "$CC" $CFLAGS "$tmp/out.c" -o "$tmp/tests"
    "$tmp/tests" ;;
  native)
    [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]] || {
      echo "capstan native: this prototype currently targets Linux x86-64 only" >&2
      exit 2
    }
    [[ -n "$out" ]] || { echo "capstan native: needs -o program" >&2; exit 2; }
    "$CAPSTANC" build -o "$tmp/native-driver.c" \
      "$ROOT/compiler/ast.cap" \
      "$ROOT/compiler/lexer.cap" \
      "$ROOT/compiler/parser.cap" \
      "$ROOT/compiler/checker.cap" \
      "$ROOT/verification/ccam_core.cap" \
      "$ROOT/verification/ccam_calls.cap" \
      "$ROOT/verification/ccam_lowering.cap" \
      "$ROOT/verification/ccam_native_x64.cap" \
      "$ROOT/tools/native_driver.cap"
    "$CC" $CFLAGS "$tmp/native-driver.c" -o "$tmp/native-driver"
    "$tmp/native-driver" -o "$tmp/out.s" "${flags[@]}" "${files[@]}"
    "${AS:-as}" --64 "$tmp/out.s" -o "$tmp/out.o"
    "${LD:-ld}" -o "$out" "$tmp/out.o"
    if readelf -l "$out" | grep -q "INTERP"; then
      echo "capstan native: linked ELF unexpectedly has a dynamic interpreter" >&2
      exit 1
    fi
    if [[ -n "$(nm -u "$out")" ]]; then
      echo "capstan native: linked ELF has undefined external symbols" >&2
      exit 1
    fi
    ;;
  *) echo "usage: capstan (run|build|test|check|fmt|lsp) file.cap... [-o program] [--release] [--strict] [--check]" >&2; exit 2 ;;
esac
