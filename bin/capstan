#!/usr/bin/env bash
# capstan: front end for the Capstan compiler.
#   capstan run   file.cap... [-- program args]
#   capstan build file.cap... -o program [--release] [--strict]
#   capstan native [--direct [--direct-steps N] [--direct-record]] [--root DIR] file.cap... -o program [--release] [--strict] (Linux x86-64 prototype)
#   capstan test  file.cap...           [--strict]
#   capstan check file.cap...           [--release] [--strict]
#   capstan fmt   file.cap...           [--check]
#   capstan lsp                         (language server on stdin/stdout, started by an editor)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CAPSTANC="$ROOT/build/capstanc"
CC="${CC:-cc}"
CFLAGS="-O2 -std=gnu11 -w -I$ROOT/runtime"
HARDEN_FLAGS="-fstack-protector-strong -fPIE"
if [[ "$(uname -s)" == "Linux" ]]; then HARDEN_FLAGS="$HARDEN_FLAGS -pie -D_FORTIFY_SOURCE=2"; fi

if [[ ! -x "$CAPSTANC" ]]; then
  echo "capstan: bootstrapping the compiler (first run)..." >&2
  make -s -C "$ROOT" bootstrap >&2
fi

cmd="${1:-}"; shift || true
if [[ "$cmd" == fmt ]]; then
  [[ -x "$ROOT/build/capstanfmt" ]] || make -s -C "$ROOT" fmt >&2
  exec "$ROOT/build/capstanfmt" "$@"
fi
if [[ "$cmd" == lsp ]]; then
  [[ -x "$ROOT/build/capstan-lsp" ]] || make -s -C "$ROOT" lsp >&2
  exec "$ROOT/build/capstan-lsp" "$@"
fi
files=(); flags=(); out=""; workspace_root=""; direct=0; direct_steps=(); direct_record=(); progargs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    --root) workspace_root="$2"; shift 2 ;;
    --direct) direct=1; shift ;;
    --direct-record) direct_record=("$1"); shift ;;
    --direct-steps)
      [[ $# -ge 2 ]] || { echo "capstan native: --direct-steps requires a budget" >&2; exit 2; }
      direct_steps=("$1" "$2"); shift 2 ;;
    --release|--strict|--keep-checks) flags+=("$1"); shift ;;
    --) shift; progargs=("$@"); break ;;
    *) files+=("$1"); shift ;;
  esac
done

if [[ -n "$workspace_root" && "$cmd" != "native" ]]; then
  echo "capstan: --root is supported only by the native command" >&2
  exit 2
fi

if [[ "$direct" -gt 0 && "$cmd" != "native" ]]; then
  echo "capstan: --direct is supported only by the native command" >&2
  exit 2
fi

if [[ -n "${direct_steps[0]-}" && ( "$cmd" != "native" || "$direct" -eq 0 ) ]]; then
  echo "capstan: --direct-steps requires native --direct" >&2
  exit 2
fi

if [[ -n "${direct_record[0]-}" && ( "$cmd" != "native" || "$direct" -eq 0 ) ]]; then
  echo "capstan: --direct-record requires native --direct" >&2
  exit 2
fi

tmp="$(mktemp -d)"
output_tmp=""
trap 'rm -rf -- "$tmp"; if [[ -n "$output_tmp" ]]; then rm -rf -- "$output_tmp"; fi' EXIT
case "$cmd" in
  check) exec "$CAPSTANC" check ${flags[@]+"${flags[@]}"} ${files[@]+"${files[@]}"} ;;
  build)
    [[ -n "$out" ]] || { echo "capstan build: needs -o program" >&2; exit 2; }
    "$CAPSTANC" build -o "$tmp/out.c" ${flags[@]+"${flags[@]}"} ${files[@]+"${files[@]}"}
    "$CC" $CFLAGS $HARDEN_FLAGS "$tmp/out.c" -o "$out" ;;
  run)
    "$CAPSTANC" build -o "$tmp/out.c" ${flags[@]+"${flags[@]}"} ${files[@]+"${files[@]}"}
    "$CC" $CFLAGS $HARDEN_FLAGS "$tmp/out.c" -o "$tmp/prog"
    "$tmp/prog" ${progargs[@]+"${progargs[@]}"} ;;
  test)
    "$CAPSTANC" test -o "$tmp/out.c" ${flags[@]+"${flags[@]}"} ${files[@]+"${files[@]}"}
    "$CC" $CFLAGS $HARDEN_FLAGS "$tmp/out.c" -o "$tmp/tests"
    "$tmp/tests" ;;
  native)
    [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]] || {
      echo "capstan native: this prototype currently targets Linux x86-64 only" >&2
      exit 2
    }
    [[ -n "$out" ]] || { echo "capstan native: needs -o program" >&2; exit 2; }
    "$CAPSTANC" build -o "$tmp/native-driver.c" \
      "$ROOT/compiler/ast.cap" \
      "$ROOT/compiler/lexer.cap" \
      "$ROOT/compiler/parser.cap" \
      "$ROOT/compiler/checker.cap" \
      "$ROOT/verification/ccam_core.cap" \
      "$ROOT/verification/ccam_calls.cap" \
      "$ROOT/verification/ccam_lowering.cap" \
      "$ROOT/verification/ccam_native_x64.cap" \
      "$ROOT/verification/ccam_direct_elf.cap" \
      "$ROOT/tools/native_driver.cap"
    "$CC" $CFLAGS $HARDEN_FLAGS "$tmp/native-driver.c" -o "$tmp/native-driver"
    workspace_root="${workspace_root:-$(pwd -P)}"
    workspace_root="$(cd "$workspace_root" 2>/dev/null && pwd -P)" || {
      echo "capstan native: workspace root must be an existing directory" >&2
      exit 2
    }
    native_files=()
    for file in ${files[@]+"${files[@]}"}; do
      if [[ "$file" == /* ]]; then
        if [[ "$workspace_root" == "/" ]]; then
          relative="${file#/}"
        elif [[ "$file" == "$workspace_root/"* ]]; then
          relative="${file#"$workspace_root"/}"
        else
          echo "capstan native: source file is outside the selected workspace" >&2
          exit 2
        fi
      else
        relative="$file"
      fi
      while [[ "$relative" == ./* ]]; do relative="${relative#./}"; done
      native_files+=("$relative")
    done
    if [[ "$direct" -gt 0 ]]; then
      output_tmp="$(mktemp -d -- "$out.XXXXXXXX")"
      "$tmp/native-driver" --root "$workspace_root" -o "$output_tmp/program" --direct \
        ${direct_steps[@]+"${direct_steps[@]}"} ${direct_record[@]+"${direct_record[@]}"} \
        ${flags[@]+"${flags[@]}"} ${native_files[@]+"${native_files[@]}"}
      chmod 700 -- "$output_tmp/program"
      mv -fT -- "$output_tmp/program" "$out"
      exit 0
    fi
    "$tmp/native-driver" --root "$workspace_root" -o "$tmp/out.s" ${flags[@]+"${flags[@]}"} ${native_files[@]+"${native_files[@]}"}
    "${AS:-as}" --64 "$tmp/out.s" -o "$tmp/out.o"
    "${LD:-ld}" -o "$out" "$tmp/out.o"
    if readelf -l "$out" | grep -q "INTERP"; then
      echo "capstan native: linked ELF unexpectedly has a dynamic interpreter" >&2
      exit 1
    fi
    if [[ -n "$(nm -u "$out")" ]]; then
      echo "capstan native: linked ELF has undefined external symbols" >&2
      exit 1
    fi
    ;;
  *) echo "usage: capstan (run|build|test|check|native|fmt|lsp) file.cap... [-o program] [--release] [--strict] [--check]" >&2; exit 2 ;;
esac
