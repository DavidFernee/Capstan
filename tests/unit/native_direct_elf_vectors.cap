// Compiled by native_direct_elf.py together with the direct backend. Both
// consumers receive the same typed CCAM object and step budget.
void direct_vector(string directory, string name, List<int> types,
                   List<CCAMInstruction> code, int steps) {
    List<CCAMFunction> functions = new List<CCAMFunction>();
    string function_name = "main";
    if (name == "max-record") {
        List<string> name_bytes = new List<string>();
        for (int i = 0; i < CCAM_MAX_FUNCTION_NAME_BYTES; i += 1) { name_bytes.push("m"); }
        function_name = join(name_bytes, "");
    }
    functions.push(new CCAMFunction{
        name: function_name, register_types: types, parameter_count: 0,
        return_type: CCAM_RETURN_INT, instructions: code, call_sites: new List<CCAMCallSite>()
    });
    CCAMCallMachineCreateResult reference = ccam_call_machine_create(functions, 0, steps, 1);
    CCAMDirectResult image = ccam_direct_elf(functions, 0, steps);
    if (!reference.ok || !image.ok) { exit(1); }
    CCAMCallMachine machine = reference.machine;
    while (!machine.halted) { ccam_call_machine_step(machine); }
    if (machine.output_bytes.len() != 0 ||
        (machine.trap_code == "" && !machine.halt_has_value)) { exit(1); }

    CCAMDirectResult record = ccam_direct_elf_with_record(functions, 0, steps, true);
    if (!record.ok) { exit(1); }
    direct_write_vector(directory + "/" + name, image.bytes);
    direct_write_vector(directory + "/" + name + ".record", record.bytes);

    // Report the reference fields independently of the emitted ELF.
    println(name + "\t" + machine.trap_code + "\t" + int_to_str(machine.halt_value) +
        "\t" + int_to_str(machine.steps) + "\t" + machine.trap_function +
        "\t" + int_to_str(machine.trap_pc) + "\t" + machine.trap_detail);
}

void direct_write_vector(string path, List<int> image) {
    List<string> bytes = new List<string>();
    for (int i = 0; i < image.len(); i += 1) {
        bytes.push(char_str(image[i]));
    }
    if (!write_file(path, join(bytes, ""))) { exit(1); }
}

CCAMInstruction direct_constant(int dst, int value) {
    CCAMInstruction ins = ccam_instruction(CCAM_OP_CONST_I);
    ins.dst = dst;
    ins.int_value = value;
    return ins;
}

void direct_arithmetic_vectors(string directory) {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction left = direct_constant(0, CCAM_I64_MIN);
    CCAMInstruction right = direct_constant(1, -1);
    code.push(left);
    code.push(right);
    CCAMInstruction operation = ccam_instruction(CCAM_OP_DIV_I);
    operation.dst = 0;
    operation.lhs = 0;
    operation.rhs = 1;
    code.push(operation);
    CCAMInstruction ret = ccam_instruction(CCAM_OP_RET);
    ret.lhs = 0;
    code.push(ret);

    direct_vector(directory, "fuel-before-overflow", types, code, 2);
    direct_vector(directory, "division-overflow", types, code, 3);
    operation.op = CCAM_OP_REM_I;
    direct_vector(directory, "fuel-before-return", types, code, 3);
    direct_vector(directory, "min-remainder", types, code, 4);
    right.int_value = 0;
    direct_vector(directory, "remainder-by-zero", types, code, 3);
    operation.op = CCAM_OP_DIV_I;
    direct_vector(directory, "division-by-zero", types, code, 3);
    operation.op = CCAM_OP_ADD_I;
    direct_vector(directory, "full-width-return", types, code, 4);
}

void direct_control_vectors(string directory) {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    code.push(direct_constant(0, 42));
    CCAMInstruction condition = ccam_instruction(CCAM_OP_CONST_B);
    condition.dst = 1;
    condition.bool_value = true;
    code.push(condition);
    CCAMInstruction branch = ccam_instruction(CCAM_OP_BRANCH);
    branch.lhs = 1;
    branch.if_true = 3;
    branch.if_false = 4;
    code.push(branch);
    CCAMInstruction jump = ccam_instruction(CCAM_OP_JUMP);
    jump.target = 2;
    code.push(jump);
    CCAMInstruction stop = ccam_instruction(CCAM_OP_TRAP);
    stop.reason = "chosen_stop";
    code.push(stop);
    direct_vector(directory, "loop-at-back-edge", types, code, 5);
    direct_vector(directory, "loop-at-branch", types, code, 6);
    condition.bool_value = false;
    direct_vector(directory, "fuel-before-explicit-trap", types, code, 3);
    direct_vector(directory, "explicit-trap", types, code, 4);
    List<string> detail = new List<string>();
    for (int i = 0; i < 64; i += 1) { detail.push("t"); }
    stop.reason = join(detail, "");
    direct_vector(directory, "max-record", types, code, 4);
}

// Observe both the returned offset and resulting cursor via the raw
// result file. A failed reservation writes the unchanged cursor alone.
void direct_arena_vector(string directory, string name, int used, int count) {
    int capacity = 16;
    AGRuntimeRegion model = new AGRuntimeRegion{capacity: capacity, used: used};
    int expected = ag_region_reserve(model, count);

    List<int> code = new List<int>();
    List<NativeFixup> fixups = new List<NativeFixup>();
    List<NativeSymbol> symbols = new List<NativeSymbol>();
    ccam_direct_movabs(code, 0, used);
    code.push(73); code.push(137); code.push(192); // mov r8,rax
    ccam_direct_movabs(code, 7, count);
    if (!native_arena_reserve(code, fixups, capacity, 0)) { exit(1); }
    code.push(65); code.push(80); // push r8 (updated cursor)
    code.push(80); // push rax (reserved offset)
    ccam_direct_write_result(code, 16, 77);
    symbols.push(new NativeSymbol{id: 0, offset: code.len()});
    code.push(65); code.push(80); // push r8 (original cursor)
    ccam_direct_write_result(code, 8, 77);

    NativeLinkResult linked = native_link_image(code, symbols, fixups);
    if (!linked.ok) { exit(1); }
    NativeElfImage image = native_elf64_image_with_stack(linked.bytes, 0, true);
    if (!image.ok) { exit(1); }
    direct_write_vector(directory + "/" + name, image.bytes);
    println(name + "\t" + int_to_str(expected) + "\t" + int_to_str(model.used));
}

void direct_record_vector(string directory, string name, int offset, int descriptor) {
    int value = -9223372036854775807 - 1;
    CCAMHeapCreateResult created = ccam_heap_create(1024, 2);
    List<int> types = new List<int>();
    types.push(CCAM_HEAP_VALUE_INT);
    List<bool> mutable = new List<bool>();
    mutable.push(false);
    CCAMHeapLayout layout = new CCAMHeapLayout{
        type_id: 7, field_types: types, field_ref_type_ids: new List<int>(),
        field_mutable: mutable
    };
    CCAMHeapRefResult first = ccam_heap_alloc_record(created.heap, layout);
    CCAMHeapRefResult second = ccam_heap_alloc_record(created.heap, layout);
    if (!first.ok || !second.ok ||
        ccam_heap_field_set(created.heap, first.reference, 7, 0, ccam_heap_int(value)) != "" ||
        ccam_heap_field_set(created.heap, second.reference, 7, 0, ccam_heap_int(42)) != "") {
        exit(1);
    }
    bool valid = offset == 0 || offset == 16;
    int expected = 0;
    if (valid) {
        CCAMHeapRef reference = first.reference;
        if (offset == 16) { reference = second.reference; }
        CCAMHeapValueResult result = ccam_heap_field_get(created.heap, reference, descriptor, 0);
        valid = result.ok;
        expected = result.value.int_value;
    }

    List<int> code = new List<int>();
    List<NativeFixup> fixups = new List<NativeFixup>();
    List<NativeSymbol> symbols = new List<NativeSymbol>();
    ccam_direct_stack_adjust(code, true, 32);
    code.push(73); code.push(137); code.push(227); // mov r11,rsp
    code.push(69); code.push(49); code.push(192); // xor r8d,r8d
    ccam_direct_movabs(code, 6, value);
    if (!native_arena_record_new(code, fixups, 32, 7, 0)) { exit(1); }
    ccam_direct_movabs(code, 6, 42);
    if (!native_arena_record_new(code, fixups, 32, 7, 0)) { exit(1); }
    ccam_direct_movabs(code, 0, offset);
    if (!native_arena_record_get(code, fixups, 32, descriptor, 0)) { exit(1); }
    code.push(80); // push rax
    ccam_direct_write_result(code, 8, 77);
    symbols.push(new NativeSymbol{id: 0, offset: code.len()});
    ccam_direct_exit(code, 79);
    NativeLinkResult linked = native_link_image(code, symbols, fixups);
    if (!linked.ok) { exit(1); }
    NativeElfImage image = native_elf64_image_with_stack(linked.bytes, 0, true);
    if (!image.ok) { exit(1); }
    direct_write_vector(directory + "/" + name, image.bytes);
    int status = 79;
    if (valid) { status = 0; }
    println(name + "\t" + int_to_str(status) + "\t" + int_to_str(expected));
}

int main() {
    List<string> arguments = args(1, 4096, 4096);
    if (arguments.len() != 1) { return 2; }
    direct_arithmetic_vectors(arguments[0]);
    direct_control_vectors(arguments[0]);
    direct_arena_vector(arguments[0], "arena-within", 3, 5);
    direct_arena_vector(arguments[0], "arena-exact", 3, 13);
    direct_arena_vector(arguments[0], "arena-empty-at-end", 16, 0);
    direct_arena_vector(arguments[0], "arena-over", 3, 14);
    direct_arena_vector(arguments[0], "arena-negative-size", 3, -1);
    direct_arena_vector(arguments[0], "arena-invalid-cursor", -1, 1);
    direct_arena_vector(arguments[0], "arena-cursor-over", 17, 0);
    direct_arena_vector(arguments[0], "arena-oversized-size", 3, 9223372036854775807);
    direct_record_vector(arguments[0], "record-first", 0, 7);
    direct_record_vector(arguments[0], "record-second", 16, 7);
    direct_record_vector(arguments[0], "record-wrong-descriptor", 16, 8);
    direct_record_vector(arguments[0], "record-negative-offset", -16, 7);
    direct_record_vector(arguments[0], "record-unaligned-offset", 8, 7);
    direct_record_vector(arguments[0], "record-unallocated-offset", 32, 7);
    return 0;
}
