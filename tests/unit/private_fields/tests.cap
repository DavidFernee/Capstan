import "record.cap";

test "factory preserves private representation and exports public fields" {
    Vault value = make_vault();
    assert(value.label == 7);
    assert(vault_is_valid(value));
}

test "defining module can update private fields" {
    Vault value = update_private(make_vault(), 43);
    assert(!vault_is_valid(value));
}

test "public fields remain writable by importers" {
    Vault value = make_vault();
    value.label = 8;
    assert(value.label == 8);
}

test "opaque structs hide every field while module factories preserve invariants" {
    SealedVault value = make_sealed_vault();
    assert(sealed_vault_is_valid(value));
    value = update_sealed_vault(value, 4);
    assert(sealed_vault_is_valid(value));
}

test "zero-field opaque capabilities cannot be forged by importers" {
    EmptyCapability value = make_empty_capability();
    assert(empty_capability_is_issued(value));
}
