  "epoch_vectors": [
    {
      "id": "RTB-E01",
      "operation": "compare",
      "left": {
        "stream": "v0",
        "epoch": "7",
        "tb": [
          "1",
          "90000"
        ],
        "ticks": "90000"
      },
      "right": {
        "stream": "v0",
        "epoch": "7",
        "tb": [
          "1",
          "48000"
        ],
        "ticks": "48000"
      },
      "expected": {
        "ok": true,
        "ordering": "equal"
      }
    },
    {
      "id": "RTB-E02",
      "operation": "compare",
      "left": {
        "stream": "v0",
        "epoch": "7",
        "tb": [
          "1",
          "90000"
        ],
        "ticks": "0"
      },
      "right": {
        "stream": "v0",
        "epoch": "8",
        "tb": [
          "1",
          "90000"
        ],
        "ticks": "0"
      },
      "expected": {
        "ok": false,
        "error": "epoch_mismatch"
      }
    },
    {
      "id": "RTB-E03",
      "operation": "discontinuity",
      "policy": "reject",
      "previous_epoch": "7",
      "candidate_ticks": "-900000",
      "expected": {
        "ok": false,
        "error": "discontinuity_rejected",
        "epoch_unchanged": true
      }
    },
    {
      "id": "RTB-E04",
      "operation": "discontinuity",
      "policy": "reset",
      "previous_epoch": "7",
      "new_epoch": "8",
      "anchor_ticks": "0",
      "expected": {
        "ok": true,
        "epoch": "8",
        "mapping": null
      }
    },
    {
      "id": "RTB-E05",
      "operation": "discontinuity",
      "policy": "rebase",
      "previous_epoch": "7",
      "new_epoch": "8",
      "old_anchor": "90000",
      "new_anchor": "0",
      "tb": [
        "1",
        "90000"
      ],
      "expected": {
        "ok": true,
        "epoch": "8",
        "mapping": "explicit_anchor_only"
      }
    }
