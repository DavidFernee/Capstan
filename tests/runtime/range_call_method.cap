// expect-runtime: CWE-190
// spec: runtime.checks
// Method calls are calls too: their arguments count toward the facts.
struct Acc {
    int total;
    int add(int n) { return self.total + n * 2; }
}

int main() {
    Acc a = new Acc{total: 0};
    println(int_to_str(a.add(5)));
    println(int_to_str(a.add(9223372036854775807 / 2 + 1)));
    return 0;
}
