// expect-runtime: CWE-190
// spec: runtime.checks types.int compiler.ranges
// A divisor known to be negative may still be -1.
int quotient(int a, int d) {
    if (d >= 0) { return 0; }
    return a / d;
}

int main() {
    println(int_to_str(quotient(0 - 9223372036854775807 - 1, 0 - 1)));
    return 0;
}
