// expect-runtime: CWE-125
// spec: runtime.checks compiler.ranges types.list
// A step that depends on the loop variable (here 0, 10, -10, ...) is not monotone,
// so i >= 0 must not be assumed and xs[i] keeps its bounds check.
int main() {
    List<int> xs = new List<int>();
    for (int k = 0; k < 20; k += 1) { xs.push(k); }
    for (int i = 0; i < xs.len(); i += 10 - 3 * i) { println(int_to_str(xs[i])); }
    return 0;
}
