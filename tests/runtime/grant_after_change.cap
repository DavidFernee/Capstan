// expect-runtime: CWE-367
// spec: auth.grant runtime.checks
// A grant is checked again at each protected call: once the document has a new owner, the
// grant issued to the old owner no longer reads it.
struct User { int id; }
sensitive struct Doc { int owner; string body; }
policy CanRead(User u, Doc d) { return u.id == d.owner; }
protected(CanRead) string read_doc(Grant<CanRead> g, Doc d) { return d.body; }
protected(CanRead) void transfer(Grant<CanRead> g, Doc d) { d.owner = 2; }
test "others are denied" { assert_denied CanRead(new User{id: 1}, new Doc{owner: 2, body: "x"}); }
int main() {
    User me = new User{id: 1};
    Doc d = new Doc{owner: 1, body: "private"};
    if (let g = authorize CanRead(me, d)) {
        transfer(g, d);
        println(read_doc(g, d));
    }
    return 0;
}
