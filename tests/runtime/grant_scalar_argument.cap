// expect-runtime: CWE-639
// spec: auth.policy auth.grant runtime.checks
// A grant for a small debit must not authorise a larger scalar amount.
sensitive struct Account { int balance; }
policy CanDebit(int amount, Account account) { return amount > 0 && amount <= account.balance; }
protected(CanDebit) void debit(Grant<CanDebit> g, int amount, Account account) { account.balance -= amount; }
int main() {
    Account account = new Account{balance: 100};
    if (let g = authorize CanDebit(10, account)) { debit(g, 500, account); }
    return 0;
}
