// expect-runtime: CWE-639
// spec: auth.policy auth.grant runtime.checks types.enum
// A grant for one enum payload cannot authorise a different payload of the same variant.
sensitive struct Account { int balance; }
enum Debit { Amount(int value), Other(int value) }
policy CanDebit(Debit request, Account account) {
    match (request) {
        case Amount(value) { return value > 0 && value <= account.balance; }
        else { return false; }
    }
}
protected(CanDebit) void debit(Grant<CanDebit> g, Debit request, Account account) {
    match (request) {
        case Amount(value) { account.balance -= value; }
        else { return; }
    }
}
int main() {
    Account account = new Account{balance: 100};
    if (let g = authorize CanDebit(Debit.Amount(10), account)) {
        debit(g, Debit.Amount(500), account);
    }
    return 0;
}
