// expect-runtime: CWE-787
// spec: types.list runtime.checks
// The RHS shrinks the list after the old element is read. The retained index
// must be checked again at the final write.
int shrink(List<int> xs) {
    xs.remove_at(0);
    return 1;
}

int main() {
    List<int> xs = new List<int>();
    xs.push(10);
    int i = 0;
    if (i < xs.len()) {
        xs[i] += shrink(xs);
    }
    return 0;
}
