// expect-runtime: CWE-639
// spec: auth.policy auth.grant runtime.checks
// A grant for the ordered pair (source, destination) cannot be used in reverse.
sensitive struct Account { int owner; int balance; }
policy CanTransfer(Account source, Account destination) { return source.owner == 1 && destination.owner == 2; }
protected(CanTransfer) void transfer(Grant<CanTransfer> g, Account source, Account destination) { source.balance -= 100; destination.balance += 100; }
int main() {
    Account source = new Account{owner: 1, balance: 500};
    Account destination = new Account{owner: 2, balance: 100};
    if (let g = authorize CanTransfer(source, destination)) { transfer(g, destination, source); }
    return 0;
}
test "transfer policy is directional" { assert_granted CanTransfer(new Account{owner: 1, balance: 500}, new Account{owner: 2, balance: 100}); assert_denied CanTransfer(new Account{owner: 2, balance: 100}, new Account{owner: 1, balance: 500}); }
