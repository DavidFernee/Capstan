// expect-runtime: CWE-639
// spec: auth.policy auth.grant runtime.checks
// A grant for (source, destination) must not authorise the reversed roles.
// Both protected parameters have the same struct type, so set-membership alone is insufficient.
sensitive struct Account {
    int owner;
    int balance;
}
policy CanTransfer(Account source, Account destination) {
    return source.owner == 1 && destination.owner == 2;
}
protected(CanTransfer)
void transfer(Grant<CanTransfer> g, Account source, Account destination) {
    source.balance = source.balance - 100;
    destination.balance = destination.balance + 100;
}
test "transfer policy is directional" {
    Account source = new Account{owner: 1, balance: 500};
    Account destination = new Account{owner: 2, balance: 100};
    assert_granted CanTransfer(source, destination);
    assert_denied CanTransfer(destination, source);
}
int main() {
    Account source = new Account{owner: 1, balance: 500};
    Account destination = new Account{owner: 2, balance: 100};
    if (let g = authorize CanTransfer(source, destination)) {
        // This must stop: the grant was issued for source->destination, not the reverse.
        transfer(g, destination, source);
    }
    return 0;
}
