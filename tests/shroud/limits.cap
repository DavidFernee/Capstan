// Regression tests for bounded raster and font allocations (CWE-789/CWE-400).
// The constructor-rejection case is built separately because it must exit 101.

// A shallow composite graph whose aggregate traversal exceeds the shared budget.
// Glyph 1 has 64 references to empty glyph 0; glyph 2 has 5 references to glyph 1.
// Every composite is within the local 64-part cap, but the root traverses 325 parts.
void limits_append_u16(List<int> bytes, int value) {
    bytes.push((value >> 8) & 255);
    bytes.push(value & 255);
}

void limits_append_u32(List<int> bytes, int value) {
    limits_append_u16(bytes, (value >> 16) & 65535);
    limits_append_u16(bytes, value & 65535);
}

Tainted limits_tainted(List<int> bytes) { return taint(bytes_text(bytes)); }

FontReader directory_fixture(int mode) {
    List<int> bytes = new List<int>();
    limits_append_u32(bytes, 0x00010000);
    limits_append_u16(bytes, 2);
    limits_append_u16(bytes, 0);
    limits_append_u16(bytes, 0);
    limits_append_u16(bytes, 0);
    limits_append_u32(bytes, tag_of("head"));
    limits_append_u32(bytes, 0);
    int first_offset = 44;
    if (mode == 3) { first_offset = 0; }
    if (mode == 4) { first_offset = 45; }
    limits_append_u32(bytes, first_offset);
    limits_append_u32(bytes, 4);
    int second_tag = tag_of("maxp");
    if (mode == 2) { second_tag = tag_of("head"); }
    limits_append_u32(bytes, second_tag);
    limits_append_u32(bytes, 0);
    int second_offset = 48;
    if (mode == 1) { second_offset = 44; }
    limits_append_u32(bytes, second_offset);
    limits_append_u32(bytes, 4);
    for (int i = 0; i < 8; i += 1) { bytes.push(0); }
    return new FontReader{b: bytes, ok: true};
}

Font composite_budget_fixture() {
    List<int> bytes = new List<int>();
    // Short loca entries for glyphs 0..3: 0, 0, 394, 434 bytes.
    limits_append_u16(bytes, 0);
    limits_append_u16(bytes, 0);
    limits_append_u16(bytes, 197);
    limits_append_u16(bytes, 217);
    // Glyph 1: composite header (10 bytes), then 64 six-byte components.
    limits_append_u16(bytes, 0xFFFF);
    for (int h = 0; h < 4; h += 1) { limits_append_u16(bytes, 0); }
    for (int i = 0; i < 64; i += 1) {
        int flags = 0x0002;
        if (i < 63) { flags = 0x0022; }
        limits_append_u16(bytes, flags);
        limits_append_u16(bytes, 0);
        bytes.push(0); bytes.push(0);
    }
    // Glyph 2: composite header, then five references to glyph 1.
    limits_append_u16(bytes, 0xFFFF);
    for (int h2 = 0; h2 < 4; h2 += 1) { limits_append_u16(bytes, 0); }
    for (int j = 0; j < 5; j += 1) {
        int flags = 0x0002;
        if (j < 4) { flags = 0x0022; }
        limits_append_u16(bytes, flags);
        limits_append_u16(bytes, 1);
        bytes.push(0); bytes.push(0);
    }
    FontReader reader = new FontReader{b: bytes, ok: true};
    return new Font{r: reader, units_per_em: 1000, ascent: 800, descent: -200,
        line_gap: 0, num_glyphs: 3, num_hmetrics: 1, loca_long: 0,
        t_head: 0, head_len: 0, t_hhea: 0, hhea_len: 0, t_maxp: 0, maxp_len: 0,
        t_cmap: 0, cmap_len: 0, cmap_at: 0, cmap_sub_len: 0, cmap_format: 0,
        t_loca: 0, loca_len: 8, t_glyf: 8, glyf_len: 434, t_hmtx: 0, hmtx_len: 0,
        cache: new Map<GlyphMask>(), cached: 0, cached_pixels: 0};
}

Font metrics_fixture(int table_len) {
    List<int> bytes = new List<int>();
    // Two long metrics: (1000, -2), (2000, 5); then bearings 6 and 7.
    bytes.push(0x03); bytes.push(0xE8);
    bytes.push(0xFF); bytes.push(0xFE);
    bytes.push(0x07); bytes.push(0xD0);
    bytes.push(0x00); bytes.push(0x05);
    bytes.push(0x00); bytes.push(0x06);
    bytes.push(0x00); bytes.push(0x07);
    FontReader reader = new FontReader{b: bytes, ok: true};
    return new Font{r: reader, units_per_em: 1000, ascent: 800, descent: -200,
        line_gap: 0, num_glyphs: 4, num_hmetrics: 2, loca_long: 0,
        t_head: 0, head_len: 0, t_hhea: 0, hhea_len: 0, t_maxp: 0, maxp_len: 0,
        t_cmap: 0, cmap_len: 0, cmap_at: 0, cmap_sub_len: 0, cmap_format: 0,
        t_loca: 0, loca_len: 0, t_glyf: 0, glyf_len: 0, t_hmtx: 0, hmtx_len: table_len,
        cache: new Map<GlyphMask>(), cached: 0, cached_pixels: 0};
}

Font truncated_composite_args_fixture() {
    List<int> bytes = new List<int>();
    for (int i = 0; i < 24; i += 1) { bytes.push(0); }
    // Short loca entries: glyph 0 = [0,0), glyph 1 = [0,14),
    // glyph 2 = [14,16). The composite's XY arguments are absent from
    // glyph 1 and exist only at the start of glyph 2.
    bytes[5] = 7;
    bytes[7] = 8;
    bytes[8] = 255;
    bytes[9] = 255;
    bytes[19] = 2;
    bytes[20] = 0;
    bytes[21] = 0;
    bytes[22] = 0;
    bytes[23] = 0;
    FontReader r = new FontReader{b: limits_tainted(bytes), ok: true};
    return new Font{r: r, num_glyphs: 3, loca_long: false, t_loca: 0, loca_len: 8, t_glyf: 8, glyf_len: 16};
}

Font truncated_simple_coords_fixture() {
    List<int> bytes = new List<int>();
    for (int i = 0; i < 28; i += 1) { bytes.push(0); }
    // Glyph 1 is a one-point simple glyph. Its flag says that both x and y
    // deltas follow, but the glyph ends before those coordinates; glyph 2
    // supplies the bytes that a file-only check could accidentally consume.
    bytes[5] = 8;
    bytes[7] = 10;
    bytes[9] = 1;
    bytes[22] = 0;
    bytes[23] = 0;
    FontReader r = new FontReader{b: limits_tainted(bytes), ok: true};
    return new Font{r:r, num_glyphs:3, loca_long:false, t_loca:0, loca_len:8, t_glyf:8, glyf_len:20};
}

Font truncated_composite_transform_fixture() {
    List<int> bytes = new List<int>();
    for (int i = 0; i < 26; i += 1) { bytes.push(0); }
    // The component's 2-byte scale transform exists only in glyph 2.
    bytes[5] = 8;
    bytes[7] = 9;
    bytes[8] = 255;
    bytes[9] = 255;
    bytes[19] = 10;
    bytes[20] = 0;
    bytes[21] = 0;
    bytes[22] = 0;
    bytes[23] = 0;
    FontReader r = new FontReader{b: limits_tainted(bytes), ok: true};
    return new Font{r: r, num_glyphs: 3, loca_long: false, t_loca: 0, loca_len: 8, t_glyf: 8, glyf_len: 18};
}

int main() {
    List<int> scaled_offset = component_offset(10, 20, 8192, 0, 0, 16384, true);
    if (scaled_offset[0] != 5 || scaled_offset[1] != 20) { return 49; }
    List<int> unscaled_offset = component_offset(10, 20, 8192, 0, 0, 16384, false);
    if (unscaled_offset[0] != 10 || unscaled_offset[1] != 20) { return 50; }
    if (pixmap_size_valid(1, 1) != true) { return 1; }
    if (pixmap_size_valid(4096, 4096) != true) { return 2; }
    if (pixmap_size_valid(16384, 1024) != true) { return 3; }
    if (pixmap_size_valid(4096, 4097) != false) { return 4; }
    if (pixmap_size_valid(16384, 1025) != false) { return 5; }
    if (pixmap_size_valid(16384, 16384) != false) { return 6; }
    if (pixmap_size_valid(0, 1) != false) { return 7; }
    if (pixmap_size_valid(1, 0) != false) { return 8; }
    if (pixmap_size_valid(-1, 1) != false) { return 9; }
    if (pixmap_size_valid(16385, 1) != false) { return 10; }
    Pixmap small = new_pixmap(2, 3);
    if (small.px.len() != 6) { return 11; }
    if (glyph_points_fit(16384, 4096) != true) { return 12; }
    if (glyph_points_fit(4095, 4096) != false) { return 13; }
    if (glyph_points_fit(-1, 1) != false) { return 14; }
    if (glyph_component_available(1) != true) { return 15; }
    if (glyph_component_available(0) != false) { return 16; }
    if (glyph_mask_size_valid(512, 512) != true) { return 17; }
    if (glyph_mask_size_valid(513, 512) != false) { return 18; }
    if (glyph_mask_size_valid(0, 1) != false) { return 19; }
    if (glyph_cache_fits(786432, 262144) != true) { return 20; }
    if (glyph_cache_fits(786433, 262144) != false) { return 21; }
    if (glyph_cache_fits(-1, 1) != false) { return 22; }
    if (glyph_cache_fits(MAX_CACHED_GLYPH_PIXELS, 1) != false) { return 23; }
    if (font_span_fits(10, 10, 10, 0) != true) { return 30; }
    if (font_span_fits(10, 10, 19, 1) != true) { return 31; }
    if (font_span_fits(10, 10, 20, 0) != true) { return 32; }
    if (font_span_fits(10, 10, 20, 1) != false) { return 33; }
    if (font_span_fits(10, 10, 9, 1) != false) { return 34; }
    if (font_span_fits(10, 10, 10, -1) != false) { return 35; }
    Font metrics = metrics_fixture(12);
    if (advance_units(metrics, 2) != 2000) { return 36; }
    if (bearing_units(metrics, 0) != -2) { return 37; }
    if (bearing_units(metrics, 1) != 5) { return 38; }
    if (bearing_units(metrics, 2) != 6) { return 39; }
    if (bearing_units(metrics, 3) != 7) { return 40; }
    Font short_metrics = metrics_fixture(11);
    if (bearing_units(short_metrics, 3) != 0) { return 41; }
    if (advance_units(short_metrics, 2) != 2000) { return 42; }
    if (!font_directory_valid(directory_fixture(0))) { return 43; }
    if (font_directory_valid(directory_fixture(1))) { return 44; }
    if (font_directory_valid(directory_fixture(2))) { return 45; }
    if (font_directory_valid(directory_fixture(3))) { return 46; }
    if (font_directory_valid(directory_fixture(4))) { return 47; }
    Font composite_font = composite_budget_fixture();
    Path leaf_path = new_path();
    if (glyph_outline(composite_font, 1, leaf_path, 1, 1, 0, 0, identity_transform(), 0) != true) { return 28; }
    Path aggregate_path = new_path();
    if (glyph_outline(composite_font, 2, aggregate_path, 1, 1, 0, 0, identity_transform(), 0) != false) { return 29; }
    if (let data = read_file("lib/shroud/fonts/DejaVuSans-Latin.ttf")) {
        if (let font = font_load(data)) {
            for (int cp = 33; cp < 127; cp += 1) {
                GlyphMask _cached = glyph_mask(font, glyph_index(font, cp), fx(256), 0);
            }
            if (font.cached_pixels > MAX_CACHED_GLYPH_PIXELS) { return 24; }
            GlyphMask huge = glyph_mask(font, glyph_index(font, 65), fx(1000), 0);
            if (huge.w != 0 || huge.h != 0) { return 25; }
        } else { return 26; }
    } else { return 27; }
    Font truncated = truncated_composite_args_fixture();
    List<int> truncated_budget = new List<int>();
    Path truncated_path = new_path();
    if (glyph_outline(truncated, 1, truncated_path, 16384, 1, 0, 0, identity_transform(), 0, truncated_budget)) { return 48; }
    Font truncated_simple = truncated_simple_coords_fixture();
    List<int> simple_budget = new List<int>();
    Path simple_path = new_path();
    if (glyph_outline(truncated_simple, 1, simple_path, 16384, 1, 0, 0, identity_transform(), 0, simple_budget)) { return 49; }
    Font truncated_transform = truncated_composite_transform_fixture();
    List<int> transform_budget = new List<int>();
    Path transform_path = new_path();
    if (glyph_outline(truncated_transform, 1, transform_path, 16384, 1, 0, 0, identity_transform(), 0, transform_budget)) { return 50; }
    List<int> shear = compose_matrix(identity_transform(), 16384, 8192, 0, 16384);
    if (shear[0] != 16384 || shear[1] != 8192 || shear[2] != 0 || shear[3] != 16384) { return 51; }
    List<int> translated = identity_transform();
    translated[4] = 7;
    translated[5] = 9;
    List<int> preserved = compose_matrix(translated, 16384, 0, 0, 16384);
    if (preserved[4] != 7 || preserved[5] != 9) { return 52; }
    println("resource limits: 52 assertions and glyph cache exercised");
    return 0;
}
