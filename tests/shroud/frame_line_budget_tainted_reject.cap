// Fail-closed integration regression for a full-size attacker-controlled text value.
// The harness writes this 1 MiB printable-ASCII payload and keeps it alive while
// both trusted and Tainted rejection executables run.

int main() {
    if (let font_data = read_file("lib/shroud/fonts/DejaVuSans-Latin.ttf", 16777216)) {
        if (let font = font_load(font_data)) {
            if (let payload = read_file("tests/shroud/.frame_line_payload.tmp", 16777216)) {
                Ui ui = new_ui(font, font, light_theme(), 64, 64, 256);
                layout_root(ui, user_text(payload), fx(1), fx(64));
                println("unexpectedly accepted over-budget Tainted text");
                return 1;
            }
        }
    }
    return 2;
}
