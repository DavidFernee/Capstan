Tainted wayland_registry_test_bytes(List<int> bytes) {
    List<Tainted> parts = new List<Tainted>();
    for (int i = 0; i < bytes.len(); i += 1) { parts.push(taint_char(bytes[i])); }
    return join(parts, "");
}
void wayland_registry_push_u32(List<int> out, int value) {
    out.push(value & 0xFF); out.push((value >>> 8) & 0xFF);
    out.push((value >>> 16) & 0xFF); out.push((value >>> 24) & 0xFF);
}
void wayland_registry_push_string(List<int> out, string value) {
    int n = value.len() + 1;
    wayland_registry_push_u32(out, n);
    for (int i = 0; i < value.len(); i += 1) { out.push(value.at(i)); }
    out.push(0);
    while (n % 4 != 0) { out.push(0); n += 1; }
}
Tainted wayland_registry_frame(int object_id, int opcode, List<int> payload) {
    List<int> bytes = new List<int>();
    int size = 8 + payload.len();
    wayland_registry_push_u32(bytes, object_id);
    wayland_registry_push_u32(bytes, (size << 16) | opcode);
    for (int i = 0; i < payload.len(); i += 1) { bytes.push(payload[i]); }
    return wayland_registry_test_bytes(bytes);
}
int main() {
    WaylandObjectTable objects = wayland_object_table();
    if (!wayland_object_add(objects, 1, 100, 1)) { return 1; }
    List<WaylandInterfaceSpec> interfaces = new List<WaylandInterfaceSpec>();
    interfaces.push(new WaylandInterfaceSpec{interface_id: 200, name: "wl_compositor", max_version: 6});
    interfaces.push(new WaylandInterfaceSpec{interface_id: 201, name: "wl_shm", max_version: 1});
    WaylandGlobalTable globals = wayland_global_table();
    if (globals.slots.len() != WAYLAND_GLOBAL_SLOTS_MAX) { return 2; }

    // Accept and resolve the compositor's advertised global.
    List<int> global_payload = new List<int>();
    wayland_registry_push_u32(global_payload, 55);
    wayland_registry_push_string(global_payload, "wl_compositor");
    wayland_registry_push_u32(global_payload, 5);
    Tainted global_frame_bytes = wayland_registry_frame(1, WAYLAND_REGISTRY_GLOBAL_OPCODE, global_payload);
    WaylandFrameHeader global_frame = wayland_frame_header(global_frame_bytes, 0);
    WaylandRegistryResult result = wayland_registry_global(global_frame_bytes, global_frame,
        objects, 1, 100, globals, interfaces);
    if (result.status != 1 || result.global_name != 55 || result.interface_id != 200
        || result.version != 5 || wayland_global_index(globals, 55) < 0) { return 3; }

    // Dynamic bind validates exact advertised name and negotiated version.
    List<int> bind_payload = new List<int>();
    wayland_registry_push_u32(bind_payload, 55);
    wayland_registry_push_string(bind_payload, "wl_compositor");
    wayland_registry_push_u32(bind_payload, 3);
    wayland_registry_push_u32(bind_payload, 2);
    Tainted bind_bytes = wayland_registry_frame(1, WAYLAND_REGISTRY_GLOBAL_OPCODE, bind_payload);
    result = wayland_registry_bind(bind_bytes, wayland_frame_header(bind_bytes, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != 1 || result.object_id != 2 || result.interface_id != 200
        || result.version != 3 || wayland_object_get(objects, 2).version != 3) { return 4; }

    // A second bind cannot reuse an existing object identifier.
    result = wayland_registry_bind(bind_bytes, wayland_frame_header(bind_bytes, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1 || wayland_object_get(objects, 9).interface_id != 200) { return 5; }

    // Version cannot exceed either compositor advertisement or local implementation.
    List<int> too_new_payload = new List<int>();
    wayland_registry_push_u32(too_new_payload, 55);
    wayland_registry_push_string(too_new_payload, "wl_compositor");
    wayland_registry_push_u32(too_new_payload, 6);
    wayland_registry_push_u32(too_new_payload, 10);
    Tainted too_new = wayland_registry_frame(1, 0, too_new_payload);
    result = wayland_registry_bind(too_new, wayland_frame_header(too_new, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1 || wayland_object_get(objects, 10).state != 0) { return 6; }

    // Interface mismatch, unknown global, unknown interface and zero values fail closed.
    List<int> mismatch_payload = new List<int>();
    wayland_registry_push_u32(mismatch_payload, 55);
    wayland_registry_push_string(mismatch_payload, "wl_shm");
    wayland_registry_push_u32(mismatch_payload, 1);
    wayland_registry_push_u32(mismatch_payload, 11);
    Tainted mismatch = wayland_registry_frame(1, 0, mismatch_payload);
    result = wayland_registry_bind(mismatch, wayland_frame_header(mismatch, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 7; }
    List<int> unknown_payload = new List<int>();
    wayland_registry_push_u32(unknown_payload, 999);
    wayland_registry_push_string(unknown_payload, "wl_compositor");
    wayland_registry_push_u32(unknown_payload, 1);
    wayland_registry_push_u32(unknown_payload, 12);
    Tainted unknown = wayland_registry_frame(1, 0, unknown_payload);
    result = wayland_registry_bind(unknown, wayland_frame_header(unknown, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 8; }
    List<int> zero_id_payload = new List<int>();
    wayland_registry_push_u32(zero_id_payload, 55);
    wayland_registry_push_string(zero_id_payload, "wl_compositor");
    wayland_registry_push_u32(zero_id_payload, 1);
    wayland_registry_push_u32(zero_id_payload, 0);
    Tainted zero_id = wayland_registry_frame(1, 0, zero_id_payload);
    result = wayland_registry_bind(zero_id, wayland_frame_header(zero_id, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 9; }

    // Duplicate global announcements are rejected.
    result = wayland_registry_global(global_frame_bytes, global_frame,
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 10; }

    // Unsupported interface names are retained as reserved globals, not bindable.
    List<int> unsupported_payload = new List<int>();
    wayland_registry_push_u32(unsupported_payload, 56);
    wayland_registry_push_string(unsupported_payload, "vendor_unknown");
    wayland_registry_push_u32(unsupported_payload, 1);
    Tainted unsupported = wayland_registry_frame(1, 0, unsupported_payload);
    result = wayland_registry_global(unsupported, wayland_frame_header(unsupported, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != 1 || result.interface_id != 0) { return 11; }
    List<int> unsupported_bind_payload = new List<int>();
    wayland_registry_push_u32(unsupported_bind_payload, 56);
    wayland_registry_push_string(unsupported_bind_payload, "vendor_unknown");
    wayland_registry_push_u32(unsupported_bind_payload, 1);
    wayland_registry_push_u32(unsupported_bind_payload, 13);
    Tainted unsupported_bind = wayland_registry_frame(1, 0, unsupported_bind_payload);
    result = wayland_registry_bind(unsupported_bind, wayland_frame_header(unsupported_bind, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 12; }

    // Global removal releases its global name; a subsequent bind fails.
    List<int> remove_payload = new List<int>(); wayland_registry_push_u32(remove_payload, 55);
    Tainted remove_bytes = wayland_registry_frame(1, WAYLAND_REGISTRY_REMOVE_OPCODE, remove_payload);
    result = wayland_registry_global_remove(remove_bytes, wayland_frame_header(remove_bytes, 0),
        objects, 1, 100, globals);
    if (result.status != 1 || wayland_global_index(globals, 55) != -1) { return 13; }
    result = wayland_registry_bind(bind_bytes, wayland_frame_header(bind_bytes, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 14; }
    result = wayland_registry_global_remove(remove_bytes, wayland_frame_header(remove_bytes, 0),
        objects, 1, 100, globals);
    if (result.status != -1) { return 15; }

    // Wrong registry object, interface, opcode, malformed/trailing fields fail closed.
    Tainted wrong_object = wayland_registry_frame(9, 0, global_payload);
    result = wayland_registry_global(wrong_object, wayland_frame_header(wrong_object, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 16; }
    result = wayland_registry_global(global_frame_bytes, global_frame,
        objects, 1, 999, globals, interfaces);
    if (result.status != -1) { return 17; }
    Tainted wrong_opcode = wayland_registry_frame(1, 2, global_payload);
    result = wayland_registry_global(wrong_opcode, wayland_frame_header(wrong_opcode, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 18; }
    List<int> trailing = new List<int>();
    for (int i = 0; i < global_payload.len(); i += 1) { trailing.push(global_payload[i]); }
    trailing.push(0); trailing.push(0); trailing.push(0); trailing.push(0);
    Tainted trailing_bytes = wayland_registry_frame(1, 0, trailing);
    result = wayland_registry_global(trailing_bytes, wayland_frame_header(trailing_bytes, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 19; }

    // Duplicate or malformed local catalogue entries are rejected.
    List<WaylandInterfaceSpec> duplicate_catalog = new List<WaylandInterfaceSpec>();
    duplicate_catalog.push(interfaces[0]);
    duplicate_catalog.push(interfaces[0]);
    result = wayland_registry_global(global_frame_bytes, global_frame,
        objects, 1, 100, globals, duplicate_catalog);
    if (result.status != -1) { return 20; }

    // Fixed global-table capacity is enforced without overwriting existing entries.
    WaylandGlobalTable full = wayland_global_table();
    int added = 0;
    for (int i = 1; i <= WAYLAND_GLOBAL_SLOTS_MAX; i += 1) {
        if (wayland_global_add(full, i, 0, 1)) { added += 1; }
    }
    if (added != WAYLAND_GLOBAL_SLOTS_MAX || wayland_global_add(full, 9999, 0, 1)
        || wayland_global_free_slots(full) != 0) { return 21; }


    // Local implementation version is an independent upper bound.
    List<int> shm_global_payload = new List<int>();
    wayland_registry_push_u32(shm_global_payload, 57);
    wayland_registry_push_string(shm_global_payload, "wl_shm");
    wayland_registry_push_u32(shm_global_payload, 5);
    Tainted shm_global = wayland_registry_frame(1, 0, shm_global_payload);
    result = wayland_registry_global(shm_global, wayland_frame_header(shm_global, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != 1 || result.interface_id != 201) { return 22; }
    List<int> shm_bind_payload = new List<int>();
    wayland_registry_push_u32(shm_bind_payload, 57);
    wayland_registry_push_string(shm_bind_payload, "wl_shm");
    wayland_registry_push_u32(shm_bind_payload, 2);
    wayland_registry_push_u32(shm_bind_payload, 14);
    Tainted shm_bind = wayland_registry_frame(1, 0, shm_bind_payload);
    result = wayland_registry_bind(shm_bind, wayland_frame_header(shm_bind, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1 || wayland_object_get(objects, 14).state != 0) { return 23; }

    // A zero requested version is invalid even for a known global.
    List<int> zero_version_payload = new List<int>();
    wayland_registry_push_u32(zero_version_payload, 57);
    wayland_registry_push_string(zero_version_payload, "wl_shm");
    wayland_registry_push_u32(zero_version_payload, 0);
    wayland_registry_push_u32(zero_version_payload, 15);
    Tainted zero_version = wayland_registry_frame(1, 0, zero_version_payload);
    result = wayland_registry_bind(zero_version, wayland_frame_header(zero_version, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1) { return 24; }

    // Duplicate interface names are ambiguous even when IDs differ.
    List<WaylandInterfaceSpec> duplicate_name_catalog = new List<WaylandInterfaceSpec>();
    duplicate_name_catalog.push(interfaces[0]);
    duplicate_name_catalog.push(new WaylandInterfaceSpec{interface_id: 202, name: "wl_compositor", max_version: 1});
    if (wayland_interface_catalog_valid(duplicate_name_catalog)) { return 25; }

    // Truncated frames remain incomplete and never mutate global state.
    Tainted truncated = wayland_registry_test_bytes(new List<int>());
    result = wayland_registry_global(truncated, wayland_frame_header(truncated, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != 0 || wayland_global_index(globals, 58) != -1) { return 26; }


    // A client bind cannot allocate a server-owned object ID.
    List<int> server_id_payload = new List<int>();
    wayland_registry_push_u32(server_id_payload, 55);
    wayland_registry_push_string(server_id_payload, "wl_compositor");
    wayland_registry_push_u32(server_id_payload, 1);
    wayland_registry_push_u32(server_id_payload, 4278190080);
    Tainted server_id_frame = wayland_registry_frame(1, 0, server_id_payload);
    result = wayland_registry_bind(server_id_frame, wayland_frame_header(server_id_frame, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1 || wayland_object_get(objects, 4278190080).state != 0) { return 27; }


    // Client IDs are allocated densely; an ID gap is rejected without mutation.
    List<int> gap_bind_payload = new List<int>();
    wayland_registry_push_u32(gap_bind_payload, 55);
    wayland_registry_push_string(gap_bind_payload, "wl_compositor");
    wayland_registry_push_u32(gap_bind_payload, 1);
    wayland_registry_push_u32(gap_bind_payload, 4);
    Tainted gap_bind = wayland_registry_frame(1, 0, gap_bind_payload);
    result = wayland_registry_bind(gap_bind, wayland_frame_header(gap_bind, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != -1 || wayland_object_get(objects, 4).state != 0) { return 28; }

    // The next sequential client ID is accepted.
    List<int> sequential_bind_payload = new List<int>();
    wayland_registry_push_u32(sequential_bind_payload, 55);
    wayland_registry_push_string(sequential_bind_payload, "wl_compositor");
    wayland_registry_push_u32(sequential_bind_payload, 1);
    wayland_registry_push_u32(sequential_bind_payload, 3);
    Tainted sequential_bind = wayland_registry_frame(1, 0, sequential_bind_payload);
    result = wayland_registry_bind(sequential_bind, wayland_frame_header(sequential_bind, 0),
        objects, 1, 100, globals, interfaces);
    if (result.status != 1 || result.object_id != 3 || wayland_object_get(objects, 3).state != 1) { return 29; }

    println("Wayland registry dynamic binding: 29 assertions passed");
    return 0;
}
