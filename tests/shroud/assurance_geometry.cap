// Compile with lib/shroud/geom.cap. Independent exact rational rounding
// references generated using arbitrary-precision integer arithmetic.
bool assurance_round_case(int a, int b, bool valid, int expected) {
    int? value = checked_round_div(a, b);
    if (let actual = value) { return valid && actual == expected; }
    return !valid;
}

test "Shroud checked rounding boundary row 0" {
    assert(assurance_round_case(SHROUD_INT_MIN, SHROUD_INT_MIN, true, 1));
    assert(assurance_round_case(SHROUD_INT_MIN, -9223372036854775807, true, 1));
    assert(assurance_round_case(SHROUD_INT_MIN, -4611686018427387904, true, 2));
    assert(assurance_round_case(SHROUD_INT_MIN, -257, true, 35888607147294848));
    assert(assurance_round_case(SHROUD_INT_MIN, -256, true, 36028797018963968));
    assert(assurance_round_case(SHROUD_INT_MIN, -255, true, 36170086419038337));
    assert(assurance_round_case(SHROUD_INT_MIN, -3, true, 3074457345618258603));
    assert(assurance_round_case(SHROUD_INT_MIN, -2, true, 4611686018427387904));
    assert(assurance_round_case(SHROUD_INT_MIN, -1, false, 0));
    assert(assurance_round_case(SHROUD_INT_MIN, 0, false, 0));
    assert(assurance_round_case(SHROUD_INT_MIN, 1, true, SHROUD_INT_MIN));
    assert(assurance_round_case(SHROUD_INT_MIN, 2, true, -4611686018427387904));
    assert(assurance_round_case(SHROUD_INT_MIN, 3, true, -3074457345618258603));
    assert(assurance_round_case(SHROUD_INT_MIN, 127, true, -72624976668147841));
    assert(assurance_round_case(SHROUD_INT_MIN, 128, true, -72057594037927936));
    assert(assurance_round_case(SHROUD_INT_MIN, 255, true, -36170086419038337));
    assert(assurance_round_case(SHROUD_INT_MIN, 256, true, -36028797018963968));
    assert(assurance_round_case(SHROUD_INT_MIN, 257, true, -35888607147294848));
    assert(assurance_round_case(SHROUD_INT_MIN, 4611686018427387904, true, -2));
    assert(assurance_round_case(SHROUD_INT_MIN, 9223372036854775806, true, -1));
    assert(assurance_round_case(SHROUD_INT_MIN, 9223372036854775807, true, -1));
}

