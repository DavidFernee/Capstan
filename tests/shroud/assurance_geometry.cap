test "Shroud checked clipping agrees with independent discrete point membership" {
    for (int ax = -2; ax <= 2; ax += 1) {
        for (int ay = -2; ay <= 2; ay += 1) {
            for (int bx = -2; bx <= 2; bx += 1) {
                for (int by = -2; by <= 2; by += 1) {
                    for (int aw = 0; aw <= 3; aw += 1) {
                        for (int bw = 0; bw <= 3; bw += 1) {
                            Rect a = rect(ax, ay, aw, 3);
                            Rect b = rect(bx, by, bw, 2);
                            if (let clipped = checked_rect_intersect(a, b)) {
                                assert(checked_rect_valid(clipped));
                                int count = 0;
                                for (int x = -2; x <= 5; x += 1) {
                                    for (int y = -2; y <= 5; y += 1) {
                                        bool expected = x >= ax && x < ax + aw && y >= ay && y < ay + 3 &&
                                            x >= bx && x < bx + bw && y >= by && y < by + 2;
                                        assert(clipped.contains(x, y) == expected);
                                        if (expected) { count += 1; }
                                    }
                                }
                                assert(clipped.w * clipped.h == count);
                            } else { assert(false); }
                        }
                    }
                }
            }
        }
    }
}

test "Shroud rejects overflowed and negative rectangle dimensions before clipping" {
    List<int> origins = new List<int>();
    origins.push(SHROUD_INT_MIN); origins.push(-1); origins.push(0);
    origins.push(SHROUD_INT_MAX - 1); origins.push(SHROUD_INT_MAX);
    for (int i = 0; i < origins.len(); i += 1) {
        for (int w = -1; w <= 3; w += 1) {
            for (int h = -1; h <= 3; h += 1) {
                int origin = origins[i];
                bool valid = w >= 0 && h >= 0;
                if (origin == SHROUD_INT_MAX && (w > 0 || h > 0)) { valid = false; }
                if (origin == SHROUD_INT_MAX - 1 && (w > 1 || h > 1)) { valid = false; }
                Rect a = rect(origin, origin, w, h);
                assert(checked_rect_valid(a) == valid);
                bool admitted = false;
                if (let intersection = checked_rect_intersect(a, rect(0, 0, 1, 1))) { admitted = true; }
                assert(admitted == valid);
            }
        }
    }
}
