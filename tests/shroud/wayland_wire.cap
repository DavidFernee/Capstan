// Adversarial tests for the pure-Capstan Wayland frame-header parser.
int main() {
    List<int> b = new List<int>();
    // object ID 1, size 8, opcode 3.
    b.push(1); b.push(0); b.push(0); b.push(0);
    b.push(3); b.push(0); b.push(8); b.push(0);
    List<int> r = wayland_frame_header(b, 0);
    if (r.status != 1 || r.object_id != 1 || r.size != 8 || r.opcode != 3 || r.end_offset != 8) { return 1; }
    // Two concatenated frames: parser returns the first frame's end.
    b.push(9); b.push(0); b.push(0); b.push(0);
    b.push(0); b.push(0); b.push(8); b.push(0);
    r = wayland_frame_header(b, 0);
    if (r.status != 1 || r.end_offset != 8) { return 2; }
    r = wayland_frame_header(b, 8);
    if (r.status != 1 || r.object_id != 9 || r.end_offset != 16) { return 3; }
    List<int> short_header = new List<int>();
    for (int i = 0; i < 7; i += 1) { short_header.push(0); }
    r = wayland_frame_header(short_header, 0);
    if (r.status != 0) { return 4; }
    // Complete header, incomplete body.
    List<int> body = new List<int>();
    body.push(7); body.push(0); body.push(0); body.push(0);
    body.push(1); body.push(0); body.push(12); body.push(0);
    r = wayland_frame_header(body, 0);
    if (r.status != 0 || r.object_id != 7 || r.size != 12 || r.opcode != 1) { return 5; }
    // Invalid object ID, undersized frame, and unaligned frame size.
    List<int> bad = new List<int>();
    for (int j = 0; j < 8; j += 1) { bad.push(0); }
    r = wayland_frame_header(bad, 0);
    if (r.status != -1) { return 6; }
    bad[0] = 1; bad[6] = 4; bad[7] = 0;
    r = wayland_frame_header(bad, 0);
    if (r.status != -1) { return 7; }
    bad[6] = 10; bad[7] = 0;
    r = wayland_frame_header(bad, 0);
    if (r.status != -1) { return 8; }
    // Maximum aligned size: incomplete until all bytes are present.
    List<int> max_header = new List<int>();
    max_header.push(2); max_header.push(0); max_header.push(0); max_header.push(0);
    max_header.push(0); max_header.push(0); max_header.push(252); max_header.push(255);
    r = wayland_frame_header(max_header, 0);
    if (r.status != 0 || r.size != 65532) { return 9; }
    List<int> max_frame = new List<int>();
    for (int k = 0; k < 65532; k += 1) { max_frame.push(0); }
    max_frame[0] = 2; max_frame[6] = 252; max_frame[7] = 255;
    r = wayland_frame_header(max_frame, 0);
    if (r.status != 1 || r.size != 65532 || r.end_offset != 65532) { return 10; }
    // 65,535 is representable in the field but is not a valid aligned frame.
    max_header[6] = 255; max_header[7] = 255;
    r = wayland_frame_header(max_header, 0);
    if (r.status != -1) { return 15; }
    r = wayland_frame_header(b, -1);
    if (r.status != -1) { return 11; }
    r = wayland_frame_header(b, b.len() + 1);
    if (r.status != -1) { return 12; }
    r = wayland_frame_header(b, b.len());
    if (r.status != 0) { return 13; }
    // Header octets outside 0..255 are rejected, not silently truncated.
    List<int> non_octet = new List<int>();
    for (int m = 0; m < 8; m += 1) { non_octet.push(0); }
    non_octet[0] = 256;
    r = wayland_frame_header(non_octet, 0);
    if (r.status != -1) { return 14; }
    // Exhaust the entire 16-bit declared-size domain against the size predicate.
    for (int size = 0; size <= 65535; size += 1) {
        bool want = size >= 8 && size <= 65532 && size % 4 == 0;
        if (wayland_frame_size_valid(size) != want) { return 16; }
    }
    println("Wayland framing: 16 adversarial assertions passed");
    return 0;
}
