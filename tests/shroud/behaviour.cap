// Shroud behaviour tests: layout, input, focus, text editing, safety and accessibility.
// Built with lib/shroud/*.cap and run by tests/shroud/check.py from the repository
// root. Prints "ok <name>" or "FAIL <name>: <detail>" per check and exits 1 on failure.

struct Tally {
    int failed;
    int passed;
}

void expect(Tally t, bool cond, string name, string detail) {
    if (cond) {
        t.passed += 1;
    } else {
        t.failed += 1;
        println("FAIL " + name + ": " + detail);
    }
}

void expect_int(Tally t, int got, int want, string name) {
    expect(t, got == want, name, $"got {got}, want {want}");
}

Laid laid_of(Ui ui, string id) {
    if (let l = ui.root) {
        if (let n = find_laid(l, id)) { return n; }
    }
    println("FAIL lookup: no view " + id);
    return new_laid(text(""), "");
}

List<Msg> click_at(Ui ui, string id, int t) {
    Laid n = laid_of(ui, id);
    int x = n.frame.x + n.frame.w / 2;
    int y = n.frame.y + n.frame.h / 2;
    List<Msg> a = ui.handle(pointer_event(EV_POINTER_DOWN, x, y, t));
    List<Msg> b = ui.handle(pointer_event(EV_POINTER_UP, x, y, t + 50));
    for (int i = 0; i < b.len(); i += 1) { a.push(b[i]); }
    return a;
}

void test_layout(Tally t, Ui ui) {
    // A row of fixed boxes and two flexible ones sharing the rest 1:3.
    View r = row().spacing(10).width(400).height(50)
        .add(box().frame(40, 20).key("a"))
        .add(box().grow(1).key("b"))
        .add(box().grow(3).key("c"))
        .add(box().frame(60, 50).key("d"));
    ui.render(column().add(r), 0);
    expect_int(t, laid_of(ui, "a").frame.w, fx(40), "row: fixed child keeps its width");
    // 400 - 40 - 60 - 3 * 10 = 270 to share: 67.5 and 202.5, snapped to pixels.
    expect_int(t, laid_of(ui, "b").frame.w + laid_of(ui, "c").frame.w, fx(270), "row: flexible children share the rest");
    expect(t, int_abs(laid_of(ui, "b").frame.w - fx(68)) <= FX, "row: shares are proportional", $"{laid_of(ui, "b").frame.w}");
    expect_int(t, laid_of(ui, "d").frame.x, fx(340), "row: last child ends at the row's end");
    expect_int(t, laid_of(ui, "a").frame.y, fx(15), "row: children centred across by default");
    // Column alignment and padding.
    View c = column().padding(10).width(200).align(ALIGN_START, ALIGN_END)
        .add(box().frame(50, 10).key("p"))
        .add(box().frame(80, 10).key("q").align_self(ALIGN_CENTER));
    ui.render(column().add(c), 0);
    expect_int(t, laid_of(ui, "p").frame.x, fx(140), "column: end alignment inside padding");
    expect_int(t, laid_of(ui, "q").frame.x, fx(60), "column: align_self overrides");
    expect_int(t, laid_of(ui, "p").frame.y, fx(10), "column: padding offsets the first child");
    // Space between.
    View s = row().width(300).align(ALIGN_BETWEEN, ALIGN_START).add(box().frame(20, 10).key("s1")).add(box().frame(20, 10).key("s2")).add(box().frame(20, 10).key("s3"));
    ui.render(column().add(s), 0);
    expect_int(t, laid_of(ui, "s2").frame.x, fx(140), "row: space between");
    expect_int(t, laid_of(ui, "s3").frame.x, fx(280), "row: space between reaches the end");
    // Text wraps to the space it is given.
    ui.render(column().add(column().width(120).add(text("one two three four five six seven").key("w"))), 0);
    expect(t, laid_of(ui, "w").lines.len() / 2 >= 3, "text: wraps in a narrow column", $"{laid_of(ui, "w").lines.len() / 2} lines");
    expect(t, laid_of(ui, "w").frame.w <= fx(120), "text: stays within its width", "too wide");
    ui.render(column().add(column().width(120).add(text("one two three four five six seven").max_lines(2).key("w2"))), 0);
    expect_int(t, laid_of(ui, "w2").lines.len() / 2, 2, "text: max_lines");
    // A word too long for the line is broken inside.
    ui.render(column().add(column().width(60).add(text("Supercalifragilistic").key("long"))), 0);
    expect(t, laid_of(ui, "long").lines.len() / 2 >= 2, "text: long word broken", "not broken");
}

void test_buttons_and_guard(Tally t, Ui ui) {
    View v = column().spacing(8).add(button("Save", "save").key("save")).add(button("Erase", "erase").danger().key("erase")).add(button("Off", "off").disabled(true).key("off"));
    ui.render(v, 1000);
    List<Msg> m = click_at(ui, "save", 1100);
    expect(t, m.len() == 1 && m[0].action == "save", "button: click sends its action", $"{m.len()} messages");
    // A danger button is guarded: a click right after it appeared is ignored.
    List<Msg> m2 = click_at(ui, "erase", 1100);
    expect_int(t, m2.len(), 0, "guard: click within 500 ms of appearing is ignored (CWE-1021)");
    // A forged future event timestamp must not advance the guard clock.
    List<Msg> future = click_at(ui, "erase", 1000000);
    expect_int(t, future.len(), 0, "guard: a future event timestamp cannot bypass the delay");
    // The render clock, not an event timestamp, records that the user had time to see it.
    ui.render(v, 1600);
    List<Msg> m3 = click_at(ui, "erase", 1600);
    expect(t, m3.len() == 1 && m3[0].action == "erase", "guard: click after 500 ms is accepted", $"{m3.len()} messages");
    // When the button moves, the guard starts again.
    View moved = column().spacing(8).add(text("A new line pushes the button down")).add(button("Save", "save").key("save")).add(button("Erase", "erase").danger().key("erase"));
    ui.render(moved, 2000);
    List<Msg> m4 = click_at(ui, "erase", 2100);
    expect_int(t, m4.len(), 0, "guard: restarts when the control moves");
    ui.render(v, 2500);
    List<Msg> m5 = click_at(ui, "off", 3000);
    expect_int(t, m5.len(), 0, "button: disabled buttons do nothing");
    // Changing the action without changing the geometry must restart the guard.
    View changed = column().spacing(8).add(button("Save", "save").key("save")).add(button("Erase", "erase-all").danger().key("erase")).add(button("Off", "off").disabled(true).key("off"));
    ui.render(changed, 3500);
    List<Msg> changed_early = click_at(ui, "erase", 3600);
    expect_int(t, changed_early.len(), 0, "guard: changing a destructive action restarts the delay");
    ui.render(changed, 4100);
    List<Msg> changed_late = click_at(ui, "erase", 4100);
    expect(t, changed_late.len() == 1 && changed_late[0].action == "erase-all", "guard: changed action activates after delay", $"{changed_late.len()} messages");
    // Removing a guarded control for one frame and reintroducing it must restart the delay.
    View hidden = column().spacing(8).add(button("Save", "save").key("save")).add(button("Off", "off").disabled(true).key("off"));
    ui.render(hidden, 5000);
    ui.render(v, 5100);
    List<Msg> reappeared = click_at(ui, "erase", 5200);
    expect_int(t, reappeared.len(), 0, "guard: reappearing control restarts the delay");
    // Press on one button and release on another: nothing.
    // Keep the trusted event clock monotonic throughout this test.
    ui.render(v, 5300);
    Laid a = laid_of(ui, "save");
    Laid b = laid_of(ui, "erase");
    List<Msg> m6 = ui.handle(pointer_event(EV_POINTER_DOWN, a.frame.x + FX, a.frame.y + FX, 5400));
    List<Msg> m7 = ui.handle(pointer_event(EV_POINTER_UP, b.frame.x + FX, b.frame.y + FX, 5450));
    expect_int(t, m6.len() + m7.len(), 0, "button: release elsewhere cancels");
}

void test_duplicate_keys(Tally t, Ui ui) {
    // Both controls overlap. The later sibling is painted and hit-tested on top.
    // Reusing a key must not route its click to the earlier, visually covered sibling.
    View v = stack().width(200).height(60)
        .add(button("Delete", "delete").key("collision"))
        .add(button("Keep", "keep").key("collision"));
    ui.render(v, 1000);
    if (let root = ui.root) {
        Laid covered = root.kids[0];
        Laid visible = root.kids[1];
        expect(t, covered.id != visible.id, "identity: duplicate keys receive distinct laid-out ids", $"{covered.id} / {visible.id}");
        int x = visible.frame.x + visible.frame.w / 2;
        int y = visible.frame.y + visible.frame.h / 2;
        List<Msg> down = ui.handle(pointer_event(EV_POINTER_DOWN, x, y, 1100));
        expect(t, ui.focus == visible.id,
            "identity: focus resolves to the visible duplicate", ui.focus);
        List<Msg> up = ui.handle(pointer_event(EV_POINTER_UP, x, y, 1150));
        expect(t, down.len() == 0 && up.len() == 1 && up[0].action == "keep",
            "identity: hit testing activates the visible duplicate", $"{down.len()} down, {up.len()} up");
        List<Msg> keyboard = ui.handle(key_event(KEY_ENTER, 0, 1200));
        expect(t, keyboard.len() == 1 && keyboard[0].action == "keep",
            "identity: keyboard activation resolves the same visible duplicate", $"{keyboard.len()} messages");
    } else {
        expect(t, false, "identity: laid-out root exists", "none");
    }
    expect(t, contains(join(a11y_problems(ui), "; "), "duplicate view identity"),
        "identity: duplicate keys are reported to accessibility diagnostics", join(a11y_problems(ui), "; "));
}

void test_duplicate_key_collisions(Tally t, Ui ui) {
    // Reserve a run of generated-looking keys. Repeated duplicates of the same
    // original key should continue from the previous suffix, not rescan the run.
    View v = column()
        .add(text("first").key("collision"))
        .add(text("reserved one").key("collision#shroud-duplicate-1"))
        .add(text("duplicate one").key("collision"))
        .add(text("reserved two").key("collision#shroud-duplicate-2"))
        .add(text("duplicate two").key("collision"))
        .add(text("reserved three").key("collision#shroud-duplicate-3"))
        .add(text("duplicate three").key("collision"))
        .add(text("reserved four").key("collision#shroud-duplicate-4"))
        .add(text("reserved five").key("collision#shroud-duplicate-5"))
        .add(text("reserved six").key("collision#shroud-duplicate-6"))
        .add(text("reserved seven").key("collision#shroud-duplicate-7"));
    ui.render(v, 0);
    if (let root = ui.root) {
        expect(t, root.kids[2].id == "collision#shroud-duplicate-8",
            "identity: first duplicate skips reserved generated-looking keys", root.kids[2].id);
        expect(t, root.kids[4].id == "collision#shroud-duplicate-9",
            "identity: later duplicate continues after prior suffix", root.kids[4].id);
        expect(t, root.kids[6].id == "collision#shroud-duplicate-10",
            "identity: suffix allocation does not rescan prior collisions", root.kids[6].id);
    } else {
        expect(t, false, "identity: collision test root exists", "none");
    }
}

void test_disabled_hit_blocking(Tally t, Ui ui) {
    // The disabled checkbox is visually on top of an enabled button.
    // It must block the click rather than pass it through to the button below.
    View v = stack().width(200).height(60)
        .add(button("Underlying action", "under").width(200).key("under"))
        .add(checkbox("Disabled", false, "disabled").disabled(true).key("disabled"));
    ui.render(v, 0);
    Laid top = laid_of(ui, "disabled");
    int x = top.frame.x + top.frame.w / 2;
    int y = top.frame.y + top.frame.h / 2;
    List<Msg> down = ui.handle(pointer_event(EV_POINTER_DOWN, x, y, 10));
    List<Msg> up = ui.handle(pointer_event(EV_POINTER_UP, x, y, 20));
    expect(t, down.len() == 0 && up.len() == 0,
        "input: disabled interactive overlay blocks click-through", $"{down.len()} down, {up.len()} up");
    expect(t, ui.focus == "", "input: disabled overlay does not receive focus", ui.focus);
}

void test_host_cancellation(Tally t, Ui ui) {
    View v = column()
        .add(button("Cancel me", "cancelled").key("cancel-button"))
        .add(slider(5, 0, 10, "slide").key("cancel-slider"));
    ui.render(v, 0);
    Laid button_view = laid_of(ui, "cancel-button");
    int bx = button_view.frame.x + button_view.frame.w / 2;
    int by = button_view.frame.y + button_view.frame.h / 2;
    ui.handle(pointer_event(EV_POINTER_DOWN, bx, by, 10));
    expect(t, ui.pressed == button_view.id, "input cancel: pointer down records pressed control", ui.pressed);
    ui.handle(pointer_event(EV_POINTER_CANCEL, bx, by, 20));
    expect(t, ui.pressed == "" && ui.hover == "", "input cancel: capture loss clears transient state", ui.pressed + "/" + ui.hover);
    List<Msg> released = ui.handle(pointer_event(EV_POINTER_UP, bx, by, 30));
    expect_int(t, released.len(), 0, "input cancel: later release cannot activate the cancelled control");

    // Pointer leave is not capture loss: it clears hover but keeps the press until
    // an actual release or explicit cancellation arrives.
    ui.handle(pointer_event(EV_POINTER_DOWN, bx, by, 40));
    ui.handle(new_event(EV_POINTER_LEAVE, 45));
    expect(t, ui.pressed == button_view.id && ui.hover == "",
        "input cancel: pointer leave does not cancel the press", ui.pressed + "/" + ui.hover);
    ui.handle(new_event(EV_POINTER_CANCEL, 50));

    // A cancelled slider drag must not continue producing messages on later motion.
    Laid slider_view = laid_of(ui, "cancel-slider");
    int sx = slider_view.frame.x + slider_view.frame.w / 2;
    int sy = slider_view.frame.y + slider_view.frame.h / 2;
    ui.handle(pointer_event(EV_POINTER_DOWN, sx, sy, 60));
    ui.handle(new_event(EV_POINTER_CANCEL, 65));
    List<Msg> drag = ui.handle(pointer_event(EV_POINTER_MOVE, slider_view.frame.right(), sy, 70));
    expect_int(t, drag.len(), 0, "input cancel: slider stops tracking after capture loss");

    // Native deactivation clears transient pointer state and suppresses all input,
    // while retaining logical widget focus so it can be restored on activation.
    ui.handle(pointer_event(EV_POINTER_DOWN, bx, by, 80));
    string focused = ui.focus;
    ui.handle(new_event(EV_FOCUS_LOST, 90));
    expect(t, !ui.host_focused && ui.pressed == "" && ui.hover == "",
        "window focus: loss clears transient pointer state", ui.pressed + "/" + ui.hover);
    expect(t, focused != "" && ui.focus == focused,
        "window focus: logical widget focus is preserved", ui.focus);
    expect_int(t, ui.handle(key_event(KEY_ENTER, 0, 100)).len(), 0,
        "window focus: keyboard input is ignored while inactive");
    expect_int(t, ui.handle(text_event(taint("x"), 110)).len(), 0,
        "window focus: committed text is ignored while inactive");
    ui.handle(new_event(EV_FOCUS_GAINED, 120));
    expect(t, ui.host_focused, "window focus: activation restores input delivery", "not focused");
    List<Msg> stale_release = ui.handle(pointer_event(EV_POINTER_UP, bx, by, 125));
    expect_int(t, stale_release.len(), 0,
        "window focus: stale pre-deactivation pointer release cannot activate");
    List<Msg> activated = ui.handle(key_event(KEY_ENTER, 0, 130));
    expect(t, activated.len() == 1 && activated[0].action == "cancelled",
        "window focus: preserved widget focus works after reactivation", $"{activated.len()} messages");
}

void test_keyboard(Tally t, Ui ui) {
    View v = column().add(button("One", "one").key("k1")).add(text("label")).add(checkbox("Two", false, "two").key("k2")).add(button("Three", "three").disabled(true).key("k3")).add(slider(5, 0, 10, "s").key("k4").label("Level"));
    ui.render(v, 0);
    ui.handle(key_event(KEY_TAB, 0, 10));
    expect(t, ui.focus == "k1", "focus: Tab goes to the first control", ui.focus);
    expect(t, ui.focus_visible, "focus: keyboard use shows the focus ring", "hidden");
    ui.handle(key_event(KEY_TAB, 0, 20));
    expect(t, ui.focus == "k2", "focus: Tab skips text", ui.focus);
    ui.handle(key_event(KEY_TAB, 0, 30));
    expect(t, ui.focus == "k4", "focus: Tab skips disabled controls", ui.focus);
    ui.handle(key_event(KEY_TAB, 0, 40));
    expect(t, ui.focus == "k1", "focus: Tab wraps around", ui.focus);
    ui.handle(key_event(KEY_TAB, MOD_SHIFT, 50));
    expect(t, ui.focus == "k4", "focus: Shift+Tab goes back", ui.focus);
    List<Msg> m = ui.handle(key_event(KEY_RIGHT, 0, 60));
    expect(t, m.len() == 1 && m[0].value == 6, "slider: right arrow steps up", $"{m.len()}");
    List<Msg> m2 = ui.handle(key_event(KEY_END, 0, 70));
    expect(t, m2.len() == 1 && m2[0].value == 10, "slider: End goes to the maximum", $"{m2.len()}");
    ui.handle(key_event(KEY_TAB, MOD_SHIFT, 80));
    List<Msg> m3 = ui.handle(key_event(KEY_SPACE, 0, 90));
    expect(t, m3.len() == 1 && m3[0].action == "two" && m3[0].value == 1, "checkbox: Space toggles", $"{m3.len()}");
    ui.handle(key_event(KEY_TAB, MOD_SHIFT, 100));
    List<Msg> m4 = ui.handle(key_event(KEY_ENTER, 0, 110));
    expect(t, m4.len() == 1 && m4[0].action == "one", "button: Enter activates", $"{m4.len()}");
    // A pointer press hides the focus ring again.
    click_at(ui, "k1", 200);
    expect(t, !ui.focus_visible, "focus: pointer use hides the focus ring", "shown");
    // Focus is dropped when its control disappears.
    ui.render(column().add(text("gone")), 300);
    expect(t, ui.focus == "", "focus: cleared when the control goes away", ui.focus);
}

// Applies text-field messages to `value`, as an application would.
Tainted apply_text(List<Msg> ms, Tainted value) {
    Tainted v = value;
    for (int i = 0; i < ms.len(); i += 1) {
        if (ms[i].action == "f" && ms[i].value == 0) { v = ms[i].text; }
    }
    return v;
}

void test_utf8_byte_ends(Tally t) {
    Tainted valid = taint("A" + char_str(0xE2) + char_str(0x80) + char_str(0xAE) + "B");
    List<int> ends = utf8_decode_with_ends(tainted_bytes(valid)).byte_ends;
    expect(t, ends.len() == 3, "utf8 offsets: one end per decoded code point", $"{ends.len()}");
    if (ends.len() == 3) {
        expect_int(t, ends[0], 1, "utf8 offsets: ASCII end");
        expect_int(t, ends[1], 4, "utf8 offsets: three-byte code point end");
        expect_int(t, ends[2], 5, "utf8 offsets: final ASCII end");
    }
    Tainted malformed = taint("A" + char_str(0xE2) + char_str(0x82) + "B");
    List<int> bad_ends = utf8_decode_with_ends(tainted_bytes(malformed)).byte_ends;
    expect(t, bad_ends.len() == 3, "utf8 offsets: maximal subparts retain one boundary each", $"{bad_ends.len()}");
    if (bad_ends.len() == 3) {
        expect_int(t, bad_ends[1], 3, "utf8 offsets: malformed maximal subpart end");
        expect_int(t, bad_ends[2], 4, "utf8 offsets: trailing ASCII end");
    }
}

void test_caret_byte_positions(Tally t, Ui ui) {
    string rlo = char_str(0xE2) + char_str(0x80) + char_str(0xAE);
    Tainted valid = taint("A" + rlo + "B");
    ui.render(text_field("f", valid, "Name").key("caret-valid"), 0);
    if (let n = ui.root) {
        int left = n.frame.x + dp(ui, n.v.pad.left);
        int size = text_size_of(ui, n.v);
        int a = glyph_advance(ui.font, glyph_for(ui.font, 0x41), size);
        int replacement = glyph_advance(ui.font, glyph_for(ui.font, REPLACEMENT_CHAR), size);
        ui.place_caret(n, left + a);
        if (let c = ui.caret.get(n.id)) {
            expect_int(t, c, 1, "caret: ASCII boundary retains byte offset");
        } else {
            expect(t, false, "caret: ASCII boundary is recorded", "missing");
        }
        ui.place_caret(n, left + a + replacement);
        if (let c2 = ui.caret.get(n.id)) {
            expect_int(t, c2, 4, "caret: sanitised three-byte code point retains source byte offset");
        } else {
            expect(t, false, "caret: multibyte boundary is recorded", "missing");
        }
    } else {
        expect(t, false, "caret: valid text field is laid out", "none");
    }

    Tainted malformed = taint("A" + char_str(0xE2) + char_str(0x82) + "B");
    ui.render(text_field("f", malformed, "Name").key("caret-malformed"), 1);
    if (let n2 = ui.root) {
        int left2 = n2.frame.x + dp(ui, n2.v.pad.left);
        int size2 = text_size_of(ui, n2.v);
        int a2 = glyph_advance(ui.font, glyph_for(ui.font, 0x41), size2);
        int replacement2 = glyph_advance(ui.font, glyph_for(ui.font, REPLACEMENT_CHAR), size2);
        ui.place_caret(n2, left2 + a2 + replacement2);
        if (let c3 = ui.caret.get(n2.id)) {
            expect_int(t, c3, 3, "caret: malformed maximal subpart maps to its byte end");
        } else {
            expect(t, false, "caret: malformed boundary is recorded", "missing");
        }
    } else {
        expect(t, false, "caret: malformed text field is laid out", "none");
    }

    Tainted secret = taint("A" + rlo + "B");
    ui.render(password_field("p", secret, "Secret").key("caret-secret"), 2);
    if (let n3 = ui.root) {
        int left3 = n3.frame.x + dp(ui, n3.v.pad.left);
        int size3 = text_size_of(ui, n3.v);
        int bullet = glyph_advance(ui.font, glyph_for(ui.font, 0x2022), size3);
        ui.place_caret(n3, left3 + bullet * 2);
        if (let c4 = ui.caret.get(n3.id)) {
            expect_int(t, c4, 4, "caret: secure bullet positions map to original UTF-8 byte offsets");
        } else {
            expect(t, false, "caret: secure boundary is recorded", "missing");
        }
    } else {
        expect(t, false, "caret: secure text field is laid out", "none");
    }
}

void test_text_field(Tally t, Ui ui) {
    Tainted value = taint("");
    ui.render(column().add(text_field("f", value, "Name").key("f")), 0);
    click_at(ui, "f", 10);
    expect(t, ui.focus == "f", "field: click focuses", ui.focus);
    value = apply_text(ui.handle(text_event(taint("héllo"), 20)), value);
    expect(t, value.len() == 6, "field: typed text arrives (UTF-8)", $"{value.len()} bytes");
    ui.render(column().add(text_field("f", value, "Name").key("f")), 30);
    // Move left over "o" and "l", then backspace twice: removes "l" and "l".
    ui.handle(key_event(KEY_LEFT, 0, 40));
    value = apply_text(ui.handle(key_event(KEY_BACKSPACE, 0, 50)), value);
    ui.render(column().add(text_field("f", value, "Name").key("f")), 55);
    value = apply_text(ui.handle(key_event(KEY_BACKSPACE, 0, 60)), value);
    ui.render(column().add(text_field("f", value, "Name").key("f")), 65);
    expect_int(t, value.len(), 4, "field: backspace removes whole characters");
    // The caret is now after the two-byte "é"; backspace removes both bytes.
    value = apply_text(ui.handle(key_event(KEY_BACKSPACE, 0, 70)), value);
    ui.render(column().add(text_field("f", value, "Name").key("f")), 75);
    expect_int(t, value.len(), 2, "field: backspace removes a two-byte character whole");
    value = apply_text(ui.handle(key_event(KEY_BACKSPACE, 0, 80)), value);
    expect_int(t, value.len(), 1, "field: backspace at the second character");
    ui.render(column().add(text_field("f", value, "Name").key("f")), 85);
    // Pasted line breaks and control characters are dropped from a one-line field.
    value = apply_text(ui.handle(text_event(taint("a\nb\tc" + char_str(0x1B) + "d"), 90)), value);
    expect_int(t, value.len(), 5, "field: control characters are not inserted");
    ui.render(column().add(text_field("f", value, "Name").key("f")), 95);
    List<Msg> enter = ui.handle(key_event(KEY_ENTER, 0, 100));
    expect(t, enter.len() == 1 && enter[0].value == 1, "field: Enter submits", $"{enter.len()}");
}

void test_single_line_unicode_controls(Tally t, Ui ui) {
    string nel = char_str(0xC2) + char_str(0x85);
    string ls = char_str(0xE2) + char_str(0x80) + char_str(0xA8);
    string ps = char_str(0xE2) + char_str(0x80) + char_str(0xA9);
    Tainted pasted = taint("A" + nel + "B" + ls + "C" + ps + "D");
    Tainted filtered = single_line(pasted);
    expect_int(t, filtered.len(), 4, "single-line: C1 NEL and Unicode LS/PS are removed");
    if (filtered.len() == 4) {
        expect_int(t, filtered.at(0), 0x41, "single-line: retained byte A");
        expect_int(t, filtered.at(1), 0x42, "single-line: retained byte B");
        expect_int(t, filtered.at(2), 0x43, "single-line: retained byte C");
        expect_int(t, filtered.at(3), 0x44, "single-line: retained byte D");
    }

    ui.render(column().add(text_field("f", taint(""), "Name").key("f")), 0);
    click_at(ui, "f", 10);
    List<Msg> messages = ui.handle(text_event(pasted, 20));
    expect(t, messages.len() == 1 && messages[0].text.len() == 4,
        "single-line: Msg.text contains no Unicode line separators", $"{messages.len()} messages");
    if (messages.len() == 1 && messages[0].text.len() == 4) {
        expect_int(t, messages[0].text.at(0), 0x41, "single-line message starts with retained byte A");
        expect_int(t, messages[0].text.at(3), 0x44, "single-line message ends with retained byte D");
    }
}

string repeated_ascii(int n) {
    List<string> parts = new List<string>();
    for (int i = 0; i < n; i += 1) { parts.push("x"); }
    return join(parts, "");
}

void test_single_line_oversized_paste(Tally t, Ui ui) {
    Tainted initial = taint("A");
    ui.render(column().add(text_field("f", initial, "Name").key("f")), 0);
    click_at(ui, "f", 10);
    ui.handle(key_event(KEY_END, 0, 15));

    // The oversized event is rejected before decoding or changing the field/caret.
    Tainted oversized = taint(repeated_ascii(MAX_FIELD_BYTES + 1));
    expect_int(t, single_line(oversized).len(), MAX_FIELD_BYTES + 1,
        "single-line: oversized paste is returned untouched for rejection");
    List<Msg> dropped = ui.handle(text_event(oversized, 20));
    expect(t, dropped.len() == 0, "single-line: oversized paste emits no Msg", $"{dropped.len()} messages");

    // A subsequent ordinary character proves both the old value and caret survived.
    Tainted after = apply_text(ui.handle(text_event(taint("B"), 30)), initial);
    expect(t, after.len() == 2 && after.at(0) == 0x41 && after.at(1) == 0x42,
        "single-line: oversized paste leaves value and caret unchanged", $"{after.len()} bytes");
}

void test_untrusted_display(Tally t) {
    // "invoice", RIGHT-TO-LEFT OVERRIDE, "fdp.exe": shown as "invoice?fdp.exe" with a mark.
    Tainted name = taint("invoice" + char_str(0xE2) + char_str(0x80) + char_str(0xAE) + "fdp.exe");
    List<int> cps = untrusted_codepoints(name);
    expect_int(t, cps.len(), 15, "untrusted text: one mark for the override");
    expect_int(t, cps[7], REPLACEMENT_CHAR, "untrusted text: bidi override is made visible (CWE-451)");
    List<int> zw = untrusted_codepoints(taint("pay" + char_str(0xE2) + char_str(0x80) + char_str(0x8B) + "pal"));
    expect_int(t, zw[3], REPLACEMENT_CHAR, "untrusted text: zero-width space is made visible");
    // The program's own text is left alone.
    List<int> own = text_codepoints("a" + char_str(0xE2) + char_str(0x80) + char_str(0x8F) + "b");
    expect_int(t, own[1], 0x200F, "trusted text: marks are kept");
    // Strict UTF-8: overlong, surrogate and truncated forms become U+FFFD.
    List<int> bad = utf8_decode(text_bytes_of("A" + char_str(0xC0) + char_str(0xAF) + char_str(0xED) + char_str(0xA0) + char_str(0x80) + char_str(0xE2) + char_str(0x82)));
    expect_int(t, bad[0], 0x41, "utf-8: ASCII");
    expect_int(t, bad[1], REPLACEMENT_CHAR, "utf-8: overlong form rejected");
    expect_int(t, bad.len(), 7, "utf-8: one replacement per maximal subpart");
}

List<int> text_bytes_of(string s) { return string_bytes(s); }

void test_a11y(Tally t, Ui ui) {
    View v = column().add(text_field("p", taint("hunter2"), "Password").key("pw").label("Password")).add(password_field("q", taint("hunter2"), "Secret").key("pw2").label("Secret")).add(text_field("search", taint(""), "Search").key("placeholder-only")).add(button("", "x").key("nameless")).add(button("", "y").label("Close").key("named"));
    ui.render(v, 0);
    List<string> problems = a11y_problems(ui);
    bool nameless = false;
    bool named = false;
    bool placeholder_is_not_name = false;
    for (int i = 0; i < problems.len(); i += 1) {
        if (problems[i].len() > 14 && problems[i].slice(0, 15) == "button nameless") { nameless = true; }
        if (problems[i].len() > 11 && problems[i].slice(0, 12) == "button named") { named = true; }
        if (contains(problems[i], "textbox placeholder-only")) { placeholder_is_not_name = true; }
    }
    expect(t, nameless, "a11y: a button without a name is reported", join(problems, "; "));
    expect(t, !named, "a11y: label() names a button", join(problems, "; "));
    expect(t, placeholder_is_not_name, "a11y: placeholder text does not substitute for a textbox label", join(problems, "; "));
    if (let tree = a11y_tree(ui)) {
        string j = a11y_json(tree);
        expect(t, contains(j, "\"role\":\"password\""), "a11y: password fields have their own role", j);
        expect(t, contains(j, "\"id\":\"placeholder-only\",\"role\":\"textbox\",\"name\":\"\""), "a11y: placeholder-only field has an empty accessible name", j);
        expect(t, contains(j, "7 characters"), "a11y: password length is announced", j);
        // The plain field exposes its value; the password field must not.
        expect_int(t, count_of(j, "hunter2"), 1, "a11y: a password is never exposed");
    } else {
        expect(t, false, "a11y: tree exists", "none");
    }
    // Text below 4.5:1 contrast is reported while painting.
    ui.render(column().add(text("faint").foreground(hex_rgb(0xBBBBBB))), 0);
    expect_int(t, a11y_problems(ui).len(), 1, "a11y: low-contrast text is reported (WCAG 1.4.3)");
}

bool contains(string hay, string needle) { return count_of(hay, needle) > 0; }

int count_of(string hay, string needle) {
    int n = 0;
    for (int i = 0; i + needle.len() <= hay.len(); i += 1) {
        if (hay.slice(i, i + needle.len()) == needle) { n += 1; }
    }
    return n;
}

void test_a11y_untrusted(Tally t, Ui ui) {
    string rlo = char_str(0xE2) + char_str(0x80) + char_str(0xAE);
    string zwsp = char_str(0xE2) + char_str(0x80) + char_str(0x8B);
    string replacement = char_str(0xEF) + char_str(0xBF) + char_str(0xBD);
    Tainted deceptive = taint("pay" + rlo + "pal" + zwsp + "x");
    Tainted visible = taint("pay" + replacement + "pal" + replacement + "x");
    ui.render(column()
        .add(user_text(deceptive).key("untrusted-label"))
        .add(text_field("field", deceptive, "Name").key("untrusted-field")), 0);
    if (let tree = a11y_tree(ui)) {
        expect(t, tree.kids.len() == 2, "a11y: untrusted text nodes exist", $"{tree.kids.len()}");
        if (tree.kids.len() == 2) {
            expect(t, tree.kids[0].name == visible,
                "a11y: user_text name retains sanitised Tainted text", escape_json(tree.kids[0].name));
            expect(t, tree.kids[1].value == visible,
                "a11y: textbox value retains sanitised Tainted text", escape_json(tree.kids[1].value));
        }
    } else {
        expect(t, false, "a11y: untrusted text tree exists", "none");
    }
}

void test_themes(Tally t) {
    List<string> light = theme_problems(light_theme());
    List<string> dark = theme_problems(dark_theme());
    expect(t, light.len() == 0, "theme: light passes WCAG 2.2 contrast", join(light, "; "));
    expect(t, dark.len() == 0, "theme: dark passes WCAG 2.2 contrast", join(dark, "; "));
    Theme bad = light_theme();
    bad.text_secondary = hex_rgb(0xAAAAAA);
    expect(t, theme_problems(bad).len() == 2, "theme: poor contrast is reported", join(theme_problems(bad), "; "));
    expect_int(t, contrast_x100(hex_rgb(0x000000), hex_rgb(0xFFFFFF)), 2100, "contrast: black on white is 21:1");
    expect_int(t, contrast_x100(hex_rgb(0x777777), hex_rgb(0xFFFFFF)), 447, "contrast: #777 on white is 4.47:1");
}

void test_scroll(Tally t, Ui ui) {
    View list = column();
    for (int i = 0; i < 40; i += 1) {
        if (i == 0) { list.add(button("", "item").key("item0")); }
        else { list.add(button($"Item {i}", "item").key($"item{i}")); }
    }
    View v = column().add(scroll(list).height(200).key("sc"));
    ui.render(v, 0);
    Laid sc = laid_of(ui, "sc");
    expect_int(t, sc.frame.h, fx(200), "scroll: viewport keeps its height");
    expect(t, sc.content_h > fx(1000), "scroll: content is measured in full", $"{sc.content_h}");
    ui.handle(wheel_event(sc.frame.x + FX, sc.frame.y + FX, fx(100), 10));
    ui.render(v, 20);
    expect_int(t, laid_of(ui, "item0").frame.y, laid_of(ui, "sc").frame.y - fx(100), "scroll: the wheel moves the content");
    ui.handle(wheel_event(sc.frame.x + FX, sc.frame.y + FX, fx(100000), 30));
    ui.render(v, 40);
    Laid last = laid_of(ui, "item39");
    expect_int(t, last.frame.bottom(), laid_of(ui, "sc").frame.bottom(), "scroll: clamped at the end");
    // The accessibility snapshot must mirror the same scroll clipping as the painter.
    if (let tree = a11y_tree(ui)) {
        string snapshot = a11y_json(tree);
        expect(t, !contains(snapshot, "\"id\":\"item0\""),
            "scroll: fully clipped controls are absent from accessibility tree", snapshot);
        expect(t, contains(snapshot, "\"id\":\"item39\""),
            "scroll: visible controls remain in accessibility tree", snapshot);
        expect(t, !contains(join(a11y_problems(ui), "; "), "button item0"),
            "scroll: fully clipped controls are excluded from accessibility diagnostics", join(a11y_problems(ui), "; "));
    } else {
        expect(t, false, "scroll: accessibility tree exists after scrolling", "none");
    }
    // A control scrolled out of view cannot be clicked through the viewport's edge.
    Laid first = laid_of(ui, "item0");
    List<Msg> m = ui.handle(pointer_event(EV_POINTER_DOWN, first.frame.x + FX, first.frame.y + FX, 50));
    List<Msg> m2 = ui.handle(pointer_event(EV_POINTER_UP, first.frame.x + FX, first.frame.y + FX, 60));
    expect_int(t, m.len() + m2.len(), 0, "scroll: hidden content is not clickable");
}

void test_raster(Tally t) {
    Pixmap pm = new_pixmap(10, 10);
    Canvas cv = new_canvas(pm);
    cv.fill_rect(rect(fx(2) + FX_HALF, fx(2), fx(3), fx(1)), solid(0xFF000000));
    expect_int(t, ch_a(pm.get(2, 2)), 128, "raster: half-covered pixel is half opaque");
    expect_int(t, ch_a(pm.get(3, 2)), 255, "raster: covered pixel is opaque");
    expect_int(t, ch_a(pm.get(5, 2)), 128, "raster: right edge");
    expect_int(t, ch_a(pm.get(6, 2)), 0, "raster: outside untouched");
    // Even-odd leaves the hole in a ring; nonzero with opposite winding does too.
    Pixmap pm2 = new_pixmap(20, 20);
    Canvas cv2 = new_canvas(pm2);
    cv2.fill_path(path_round_rect_ring(rect_px(0, 0, 20, 20), 0, fx(5)), solid(0xFF000000), FILL_NONZERO);
    expect_int(t, ch_a(pm2.get(10, 10)), 0, "raster: ring has a hole");
    expect_int(t, ch_a(pm2.get(2, 10)), 255, "raster: ring is filled");
    // Clipping.
    cv2.push_clip(rect_px(0, 0, 5, 5));
    cv2.fill_rect(rect_px(0, 0, 20, 20), solid(0xFFFF0000));
    cv2.pop_clip();
    expect_int(t, ch_r(pm2.get(4, 4)), 255, "raster: inside the clip");
    expect_int(t, ch_r(pm2.get(5, 5)), 0, "raster: outside the clip");
    // Compositing is exact at the ends.
    expect_int(t, over(premultiply(0x80FFFFFF), premultiply(0xFF000000)), 0xFF808080, "colour: 50% white over black");
    expect_int(t, unpremultiply(premultiply(0xFF336699)), 0xFF336699, "colour: opaque colours survive premultiplying");
    int back = unpremultiply(premultiply(0x80336699));
    expect(t, ch_a(back) == 0x80 && int_abs(ch_r(back) - 0x33) <= 1 && int_abs(ch_g(back) - 0x66) <= 1 && int_abs(ch_b(back) - 0x99) <= 1, "colour: translucent colours survive within one step", $"{back}");
}

void test_resize(Tally t, Font f, Font b) {
    Ui ui = new_ui(f, b, light_theme(), 640, 480, 256);
    View v = column()
        .add(button("Danger", "danger").danger().key("danger"))
        .add(text_field("field", taint("abc"), "Name").key("field"))
        .add(scroll(column().add(button("Item", "item"))).height(40).key("scroll"));
    ui.render(v, 1000);
    string guard_id = laid_of(ui, "danger").id;
    string field_id = laid_of(ui, "field").id;
    int old_guard_time = 0;
    if (let t0 = ui.shown_at.get(guard_id)) { old_guard_time = t0; }
    ui.focus = field_id;
    ui.caret.set(field_id, 2);
    ui.scroll.set("scroll", fx(12));
    ui.hover = guard_id;
    ui.pressed = guard_id;

    int old_w = ui.pixmap.w;
    int old_h = ui.pixmap.h;
    int old_scale = ui.scale;
    expect(t, !ui.resize(0, 600, 384), "resize: zero width is rejected", "resize unexpectedly accepted zero width");
    expect(t, !ui.resize(800, 600, 63), "resize: scale below minimum is rejected", "resize unexpectedly accepted invalid scale");
    expect(t, ui.pixmap.w == old_w && ui.pixmap.h == old_h && ui.scale == old_scale &&
        ui.focus == field_id && ui.hover == guard_id && ui.pressed == guard_id,
        "resize: invalid requests leave Ui state unchanged", "state changed after rejected resize");

    expect(t, ui.resize(800, 600, 384), "resize: valid dimensions and scale are accepted", "resize rejected valid dimensions and scale");
    expect(t, ui.pixmap.w == 800 && ui.pixmap.h == 600 && ui.scale == 384,
        "resize: pixel surface and scale update together", $"{ui.pixmap.w}x{ui.pixmap.h}@{ui.scale}");
    bool old_tree_cleared = true;
    if (let _old_root = ui.root) { old_tree_cleared = false; }
    expect(t, old_tree_cleared && ui.hover == "" && ui.pressed == "",
        "resize: old hit-test tree and transient pointer state are invalidated", "stale state retained");
    expect(t, ui.focus == field_id, "resize: logical focus is preserved", ui.focus);
    bool caret_preserved = false;
    bool scroll_preserved = false;
    if (let caret_value = ui.caret.get(field_id)) { caret_preserved = caret_value == 2; }
    if (let scroll_value = ui.scroll.get("scroll")) { scroll_preserved = scroll_value == fx(12); }
    expect(t, caret_preserved && scroll_preserved,
        "resize: caret and scroll state are preserved", "retained state differs");
    bool guard_preserved = false;
    if (let guard_time = ui.shown_at.get(guard_id)) { guard_preserved = guard_time == old_guard_time; }
    expect(t, guard_preserved,
        "resize: guard history is retained until the next rendered frame", "guard history changed early");
    expect_int(t, ui.handle(pointer_event(EV_POINTER_UP, 10, 10, 1100)).len(), 0,
        "resize: pointer input is ignored until a fresh frame is rendered");

    ui.render(v, 1200);
    int new_guard_time = 0;
    if (let t1 = ui.shown_at.get(guard_id)) { new_guard_time = t1; }
    expect(t, new_guard_time == 1200,
        "resize: scale transition restarts guarded activation after fresh layout", $"{new_guard_time}");
}

void test_scale(Tally t, Font f, Font b) {
    // At 150% every length in dp is 1.5 device pixels.
    Ui ui = new_ui(f, b, light_theme(), 300, 200, 384);
    ui.render(column().add(box().frame(100, 40).key("x")), 0);
    expect_int(t, laid_of(ui, "x").frame.w, fx(150), "scale: 100 dp is 150 px at 150%");
    expect_int(t, laid_of(ui, "x").frame.h, fx(60), "scale: heights scale too");
}

void test_unicode_logical_preservation(Tally t) {
    string zwnj = char_str(0xE2) + char_str(0x80) + char_str(0x8C);
    string zwj = char_str(0xE2) + char_str(0x80) + char_str(0x8D);
    string zwsp = char_str(0xE2) + char_str(0x80) + char_str(0x8B);
    string wj = char_str(0xE2) + char_str(0x81) + char_str(0xA0);
    string shy = char_str(0xC2) + char_str(0xAD);
    string vs16 = char_str(0xEF) + char_str(0xB8) + char_str(0x8F);
    string tag_g = char_str(0xF3) + char_str(0xA0) + char_str(0x81) + char_str(0xA7);
    string tag_end = char_str(0xF3) + char_str(0xA0) + char_str(0x81) + char_str(0xBF);
    string nonchar = char_str(0xEF) + char_str(0xB7) + char_str(0x90);
    string source = "A" + zwnj + zwj + zwsp + wj + shy + vs16 + tag_g + tag_end + nonchar + "Z";
    Utf8Decoded decoded = utf8_decode_with_ends(string_bytes(source));
    List<int> cps = decoded.codepoints;
    expect_int(t, cps.len(), 11, "unicode U0: all valid scalar values survive decoding");
    if (cps.len() == 11) {
        expect_int(t, cps[0], 0x41, "unicode U0: leading ASCII");
        expect_int(t, cps[1], 0x200C, "unicode U0: ZWNJ retained logically");
        expect_int(t, cps[2], 0x200D, "unicode U0: ZWJ retained logically");
        expect_int(t, cps[3], 0x200B, "unicode U0: zero-width space retained logically");
        expect_int(t, cps[4], 0x2060, "unicode U0: word joiner retained logically");
        expect_int(t, cps[5], 0x00AD, "unicode U0: soft hyphen retained logically");
        expect_int(t, cps[6], 0xFE0F, "unicode U0: variation selector retained logically");
        expect_int(t, cps[7], 0xE0067, "unicode U0: emoji tag letter retained logically");
        expect_int(t, cps[8], 0xE007F, "unicode U0: emoji cancel tag retained logically");
        expect_int(t, cps[9], 0xFDD0, "unicode U0: noncharacter remains a decoded scalar");
        expect_int(t, cps[10], 0x5A, "unicode U0: trailing ASCII");
    }
    expect_int(t, decoded.byte_ends.len(), cps.len(),
        "unicode U0: source-byte map has one end per logical scalar");
    if (decoded.byte_ends.len() == 11) {
        expect_int(t, decoded.byte_ends[0], 1, "unicode U0: ASCII byte end");
        expect_int(t, decoded.byte_ends[1], 4, "unicode U0: ZWNJ byte end");
        expect_int(t, decoded.byte_ends[2], 7, "unicode U0: ZWJ byte end");
        expect_int(t, decoded.byte_ends[3], 10, "unicode U0: ZWSP byte end");
        expect_int(t, decoded.byte_ends[4], 13, "unicode U0: word joiner byte end");
        expect_int(t, decoded.byte_ends[5], 15, "unicode U0: soft hyphen byte end");
        expect_int(t, decoded.byte_ends[6], 18, "unicode U0: variation selector byte end");
        expect_int(t, decoded.byte_ends[7], 22, "unicode U0: tag character byte end");
        expect_int(t, decoded.byte_ends[8], 26, "unicode U0: cancel tag byte end");
        expect_int(t, decoded.byte_ends[9], 29, "unicode U0: noncharacter byte end");
        expect_int(t, decoded.byte_ends[10], 30, "unicode U0: final ASCII byte end");
    }
}

void test_unicode_semantic_sequences(Tally t) {
    // Persian code points U+0645 U+06CC U+200C U+0631 U+0648 U+0645; the joiner is significant.
    string persian = char_str(0xD9) + char_str(0x85) +
        char_str(0xDB) + char_str(0x8C) +
        char_str(0xE2) + char_str(0x80) + char_str(0x8C) +
        char_str(0xD8) + char_str(0xB1) +
        char_str(0xD9) + char_str(0x88) +
        char_str(0xD9) + char_str(0x85);
    Utf8Decoded p = utf8_decode_with_ends(string_bytes(persian));
    expect_int(t, p.codepoints.len(), 6, "unicode U0: Persian ZWNJ word retains six logical scalars");
    if (p.codepoints.len() == 6) {
        expect_int(t, p.codepoints[0], 0x0645, "unicode U0: Persian meem preserved");
        expect_int(t, p.codepoints[1], 0x06CC, "unicode U0: Persian yeh preserved");
        expect_int(t, p.codepoints[2], 0x200C, "unicode U0: Persian ZWNJ preserved in context");
        expect_int(t, p.codepoints[3], 0x0631, "unicode U0: Persian reh preserved");
        expect_int(t, p.codepoints[4], 0x0648, "unicode U0: Persian vav preserved");
        expect_int(t, p.codepoints[5], 0x0645, "unicode U0: final Persian meem preserved");
    }
    expect_int(t, p.byte_ends.len(), 6, "unicode U0: Persian source map covers every scalar");
    if (p.byte_ends.len() == 6) {
        expect_int(t, p.byte_ends[0], 2, "unicode U0: Persian first span end");
        expect_int(t, p.byte_ends[1], 4, "unicode U0: Persian second span end");
        expect_int(t, p.byte_ends[2], 7, "unicode U0: Persian ZWNJ span end");
        expect_int(t, p.byte_ends[3], 9, "unicode U0: Persian fourth span end");
        expect_int(t, p.byte_ends[4], 11, "unicode U0: Persian fifth span end");
        expect_int(t, p.byte_ends[5], 13, "unicode U0: Persian final span end");
    }

    // Devanagari KA + VIRAMA + ZWJ + SSA: preserve the joiner-sensitive input.
    string indic = char_str(0xE0) + char_str(0xA4) + char_str(0x95) +
        char_str(0xE0) + char_str(0xA5) + char_str(0x8D) +
        char_str(0xE2) + char_str(0x80) + char_str(0x8D) +
        char_str(0xE0) + char_str(0xA4) + char_str(0xB7);
    Utf8Decoded d = utf8_decode_with_ends(string_bytes(indic));
    expect_int(t, d.codepoints.len(), 4, "unicode U0: Indic joiner-sensitive sequence retains four scalars");
    if (d.codepoints.len() == 4) {
        expect_int(t, d.codepoints[0], 0x0915, "unicode U0: Devanagari KA preserved");
        expect_int(t, d.codepoints[1], 0x094D, "unicode U0: Devanagari VIRAMA preserved");
        expect_int(t, d.codepoints[2], 0x200D, "unicode U0: Indic ZWJ preserved");
        expect_int(t, d.codepoints[3], 0x0937, "unicode U0: Devanagari SSA preserved");
    }
    expect_int(t, d.byte_ends.len(), 4, "unicode U0: Indic source map covers every scalar");
    if (d.byte_ends.len() == 4) {
        expect_int(t, d.byte_ends[0], 3, "unicode U0: Indic KA span end");
        expect_int(t, d.byte_ends[1], 6, "unicode U0: Indic VIRAMA span end");
        expect_int(t, d.byte_ends[2], 9, "unicode U0: Indic ZWJ span end");
        expect_int(t, d.byte_ends[3], 12, "unicode U0: Indic SSA span end");
    }

    // Emoji family sequence: MAN + ZWJ + WOMAN + ZWJ + GIRL.
    string family = char_str(0xF0) + char_str(0x9F) + char_str(0x91) + char_str(0xA8) +
        char_str(0xE2) + char_str(0x80) + char_str(0x8D) +
        char_str(0xF0) + char_str(0x9F) + char_str(0x91) + char_str(0xA9) +
        char_str(0xE2) + char_str(0x80) + char_str(0x8D) +
        char_str(0xF0) + char_str(0x9F) + char_str(0x91) + char_str(0xA7);
    Utf8Decoded e = utf8_decode_with_ends(string_bytes(family));
    expect_int(t, e.codepoints.len(), 5, "unicode U0: emoji family source retains five scalars");
    if (e.codepoints.len() == 5) {
        expect_int(t, e.codepoints[0], 0x1F468, "unicode U0: family MAN preserved");
        expect_int(t, e.codepoints[1], 0x200D, "unicode U0: first family ZWJ preserved");
        expect_int(t, e.codepoints[2], 0x1F469, "unicode U0: family WOMAN preserved");
        expect_int(t, e.codepoints[3], 0x200D, "unicode U0: second family ZWJ preserved");
        expect_int(t, e.codepoints[4], 0x1F467, "unicode U0: family GIRL preserved");
    }
    expect_int(t, e.byte_ends.len(), 5, "unicode U0: emoji source map covers every scalar");
    if (e.byte_ends.len() == 5) {
        expect_int(t, e.byte_ends[0], 4, "unicode U0: emoji MAN span end");
        expect_int(t, e.byte_ends[1], 7, "unicode U0: emoji first ZWJ span end");
        expect_int(t, e.byte_ends[2], 11, "unicode U0: emoji WOMAN span end");
        expect_int(t, e.byte_ends[3], 14, "unicode U0: emoji second ZWJ span end");
        expect_int(t, e.byte_ends[4], 18, "unicode U0: emoji GIRL span end");
    }
}

void test_a11y_utf8_encoder(Tally t) {
    // A large mixed-width payload exercises the former quadratic append path.
    List<int> expected = new List<int>();
    for (int i = 0; i < 16384; i += 1) {
        expected.push(0x41);
        expected.push(0x00E9);
        expected.push(0x20AC);
        expected.push(0x1F600);
    }
    Tainted encoded = utf8_from_codepoints(expected);
    expect_int(t, encoded.len(), 163840,
        "a11y UTF-8 encoder: large mixed-width output has exact byte length");
    List<int> actual = utf8_decode(tainted_bytes(encoded));
    expect_int(t, actual.len(), expected.len(),
        "a11y UTF-8 encoder: large output decodes to the original scalar count");
    if (actual.len() == expected.len()) {
        bool equal = true;
        for (int j = 0; j < expected.len(); j += 1) {
            if (actual[j] != expected[j]) { equal = false; }
        }
        expect(t, equal, "a11y UTF-8 encoder: large mixed-width round trip is exact",
            "decoded scalar sequence differs from source");
    }
    Tainted visible = visible_untrusted_text(taint("A" + char_str(0xC3) + char_str(0xA9) +
        char_str(0xE2) + char_str(0x82) + char_str(0xAC)));
    Tainted expected_visible = taint("A" + char_str(0xC3) + char_str(0xA9) +
        char_str(0xE2) + char_str(0x82) + char_str(0xAC));
    expect(t, escape_json(visible) == escape_json(expected_visible),
        "a11y UTF-8 encoder: visible untrusted text preserves UTF-8 bytes", escape_json(visible));
}

void test_a11y_json_escaping(Tally t) {
    List<string> states = new List<string>();
    states.push("focused\",\"injected\":true");
    A11yNode hostile = new A11yNode{
        id: "node\",\"injected\":true",
        role: "button\",\"injected\":true",
        name: taint("name\",\"injected\":true"),
        value: taint(""),
        states: states,
        bounds: rect(0, 0, 1, 1),
        kids: new List<A11yNode>()
    };
    string json = a11y_json(hostile);
    string expected = "{\"id\":\"" + escape_json(taint(hostile.id)) +
        "\",\"role\":\"" + escape_json(taint(hostile.role)) +
        "\",\"name\":\"" + escape_json(hostile.name) +
        "\",\"states\":[\"" + escape_json(taint(states[0])) +
        "\"],\"bounds\":[0,0,1,1]}";
    expect(t, json == expected,
        "a11y JSON: every public string field is escaped exactly once", json);
}

void test_ui_state_pruning(Tally t, Ui ui) {
    View scroll_items = column();
    for (int i = 0; i < 8; i += 1) { scroll_items.add(button($"item {i}", "item")); }
    View live = column()
        .add(scroll(scroll_items).height(40).key("live-scroll"))
        .add(text_field("field", taint("abc"), "Name").key("live-field"));
    ui.render(live, 0);
    string scroll_id = laid_of(ui, "live-scroll").id;
    string field_id = laid_of(ui, "live-field").id;
    ui.scroll.set(scroll_id, 17);
    ui.caret.set(field_id, 2);
    ui.render(live, 1);
    expect_int(t, ui.scroll.keys().len(), 1, "UI state: live scroll offset is retained");
    expect_int(t, ui.caret.keys().len(), 1, "UI state: live text caret is retained");
    int scroll_value = 0;
    int caret_value = 0;
    if (let value = ui.scroll.get(scroll_id)) { scroll_value = value; }
    if (let value = ui.caret.get(field_id)) { caret_value = value; }
    expect_int(t, scroll_value, 17, "UI state: retained scroll offset is unchanged");
    expect_int(t, caret_value, 2, "UI state: retained caret is unchanged");

    // Reusing the same key for a different widget kind must not preserve
    // state whose semantics belong only to the former control kind.
    ui.render(column()
        .add(text("scroll replaced").key("live-scroll"))
        .add(text("field replaced").key("live-field")), 2);
    expect_int(t, ui.scroll.keys().len(), 0, "UI state: scroll state is pruned when node kind changes");
    expect_int(t, ui.caret.keys().len(), 0, "UI state: caret state is pruned when node kind changes");

    ui.scroll.set(scroll_id, 17);
    ui.caret.set(field_id, 2);
    ui.render(text("replacement").key("replacement"), 3);
    expect_int(t, ui.scroll.keys().len(), 0, "UI state: removed scroll node is pruned");
    expect_int(t, ui.caret.keys().len(), 0, "UI state: removed text field is pruned");

    // Repeated generations with fresh stale IDs must not grow retained state.
    for (int i = 0; i < 1000; i += 1) {
        ui.scroll.set($"stale-scroll-{i}", i);
        ui.caret.set($"stale-caret-{i}", i);
        ui.render(text("stable").key("stable"), i + 3);
    }
    expect_int(t, ui.scroll.keys().len(), 0, "UI state: scroll map stays bounded across 1000 generations");
    expect_int(t, ui.caret.keys().len(), 0, "UI state: caret map stays bounded across 1000 generations");
}

void test_display_list(Tally t, Font font) {
    List<int> canonical_alpha = new List<int>();
    canonical_alpha.push(0);
    canonical_alpha.push(128);
    canonical_alpha.push(255);
    expect(t, display_mask_alpha_valid(canonical_alpha),
        "display list: canonical glyph alpha is accepted", "valid alpha rejected");
    List<int> invalid_alpha_values = new List<int>();
    invalid_alpha_values.push(-1);
    expect(t, !display_mask_alpha_valid(invalid_alpha_values),
        "display list: negative glyph alpha is rejected", "negative alpha accepted");
    invalid_alpha_values[0] = 256;
    expect(t, !display_mask_alpha_valid(invalid_alpha_values),
        "display list: over-range glyph alpha is rejected", "over-range alpha accepted");
    Canvas admission = new_recording_canvas(new_pixmap(1, 1));
    expect(t, display_mask_admissible(admission, 1, 1, 1),
        "display list: one-pixel mask passes pre-allocation admission", "valid one-pixel mask rejected");
    expect(t, !display_mask_admissible(admission, 1, 1, MAX_DISPLAY_MASK_PIXELS + 1),
        "display list: oversized mask is rejected before copying", "oversized mask accepted");
    expect(t, !display_mask_admissible(admission, 2, 2, 3),
        "display list: inconsistent mask dimensions are rejected before copying", "inconsistent mask dimensions accepted");
    expect(t, !display_mask_admissible(admission, 0, 1, 0),
        "display list: partially zero mask dimensions are rejected", "partially zero mask dimensions accepted");
    Pixmap direct = new_pixmap(48, 36);
    Pixmap replayed = new_pixmap(48, 36);
    direct.clear(0xFF182838);
    replayed.clear(0xFF182838);
    Canvas a = new_canvas(direct);
    Canvas recorder = new_recording_canvas(replayed);

    // Cover each current command family and capture nested clip state.
    a.fill_rect(rect(fx(2) + FX_HALF, fx(3), fx(17), fx(9)),
        linear_gradient(fx(2), 0, 0xC0FF4000, fx(20), 0, 0x804080FF));
    recorder.fill_rect(rect(fx(2) + FX_HALF, fx(3), fx(17), fx(9)),
        linear_gradient(fx(2), 0, 0xC0FF4000, fx(20), 0, 0x804080FF));
    a.push_clip(rect_px(5, 4, 30, 24));
    recorder.push_clip(rect_px(5, 4, 30, 24));
    Path shape = path_round_rect_ring(rect_px(3, 2, 34, 27), fx(5), fx(3));
    a.fill_path(shape, solid(0xA040C080), FILL_NONZERO);
    recorder.fill_path(shape, solid(0xA040C080), FILL_NONZERO);
    a.blend(8, 8, solid(0x80FFFFFF), 117);
    recorder.blend(8, 8, solid(0x80FFFFFF), 117);
    a.pop_clip();
    recorder.pop_clip();
    List<int> glyphs = text_codepoints("G P U");
    int _direct_pen = draw_glyphs(a, font, fx(11), glyphs, 0, glyphs.len(), fx(2), fx(33), 0xFFE0F0FF);
    int _recorded_pen = draw_glyphs(recorder, font, fx(11), glyphs, 0, glyphs.len(), fx(2), fx(33), 0xFFE0F0FF);
    expect_int(t, _recorded_pen, _direct_pen, "display list: glyph advances are unchanged");
    a.fill_rect(rect_px(0, 0, 2, 2), solid(0xFFFF00FF));
    recorder.fill_rect(rect_px(0, 0, 2, 2), solid(0xFFFF00FF));

    // A recorded mask owns its pixels; mutating the font-side source afterwards
    // must not change the already-recorded frame.
    List<int> mask = new List<int>();
    mask.push(255);
    a.draw_mask(mask, 1, 1, 40, 30, solid(0xFFFFFF00));
    recorder.draw_mask(mask, 1, 1, 40, 30, solid(0xFFFFFF00));
    mask[0] = 0;

    DisplayList frame = finish_display_list(recorder);
    int published_commands = frame.commands.len();
    int published_path_x = 0;
    int published_mask_alpha = 0;
    if (let frame_segments = frame.commands[1].segments) {
        published_path_x = frame_segments.x0[0];
    }
    if (let frame_alpha = frame.commands[frame.commands.len() - 1].mask_alpha) {
        published_mask_alpha = frame_alpha[0];
    }
    // Mutating nested recorder payloads after publication must not mutate the
    // published frame. A shallow command-struct copy would fail both checks.
    if (let recorder_segments = recorder.commands[1].segments) {
        recorder_segments.x0[0] = fx(47);
    }
    if (let recorder_alpha = recorder.commands[recorder.commands.len() - 1].mask_alpha) {
        recorder_alpha[0] = 0;
    }
    bool nested_snapshot = false;
    if (let frame_segments_after = frame.commands[1].segments) {
        if (let frame_alpha_after = frame.commands[frame.commands.len() - 1].mask_alpha) {
            nested_snapshot = frame_segments_after.x0[0] == published_path_x &&
                frame_alpha_after[0] == published_mask_alpha && published_mask_alpha == 255;
        }
    }
    expect(t, nested_snapshot,
        "display list: path and mask payloads are deep-snapshotted",
        "recorder mutation changed a published nested payload");

    // Snapshot admission recomputes bounds instead of trusting the recorder's
    // mutable cached budget, and rejects malformed parallel path arrays.
    Canvas malformed_recorder = new_recording_canvas(new_pixmap(1, 1));
    DisplayCommand malformed_snapshot = frame.commands[1];
    Segments mismatched_segments = new_segments();
    mismatched_segments.x0.push(0);
    malformed_snapshot.segments = mismatched_segments;
    malformed_recorder.commands.push(malformed_snapshot);
    expect(t, !display_snapshot_fits(malformed_recorder),
        "display list: malformed recorder geometry is rejected before snapshot",
        "mismatched segment arrays admitted");

    // Appending to the recorder after publication must not mutate the frame.
    recorder.fill_rect(rect_px(45, 33, 1, 1), solid(0xFFFF0000));
    execute_display_list(frame, replayed);
    bool same = direct.px.len() == replayed.px.len();
    for (int i = 0; i < direct.px.len() && same; i += 1) {
        if (direct.px[i] != replayed.px[i]) { same = false; }
    }
    expect(t, same, "display list: replay is byte-identical to immediate software rasterisation",
        $"commands={frame.commands.len()}");
    expect(t, frame.width == 48 && frame.height == 36 && frame.commands.len() >= 5,
        "display list: frame dimensions and commands are retained",
        $"{frame.width}x{frame.height}, {frame.commands.len()} commands");
    expect_int(t, frame.commands.len(), published_commands,
        "display list: published command sequence is isolated from later recording");
    expect_int(t, ch_r(replayed.get(40, 30)), 255,
        "display list: glyph mask pixels are snapshotted at record time");

    // The executor accepts public DisplayList values, not just recorder output.
    // Invalid metadata must be rejected before any destination pixel is touched.
    Pixmap guarded = new_pixmap(48, 36);
    guarded.clear(0xFF123456);
    int before = guarded.get(0, 0);
    DisplayCommand bad_clip = frame.commands[0];
    bad_clip.clip = rect(-1, 0, 2, 2);
    List<DisplayCommand> bad_clip_commands = new List<DisplayCommand>();
    bad_clip_commands.push(bad_clip);
    DisplayList bad_clip_frame = new DisplayList{width: 48, height: 36, commands: bad_clip_commands};
    expect(t, !display_list_valid(bad_clip_frame, guarded),
        "display list: out-of-surface clip is rejected", "invalid clip accepted");
    expect_int(t, guarded.get(0, 0), before,
        "display list: validation does not mutate the target");

    DisplayCommand bad_opacity = frame.commands[0];
    bad_opacity.opacity = 256;
    List<DisplayCommand> bad_opacity_commands = new List<DisplayCommand>();
    bad_opacity_commands.push(bad_opacity);
    DisplayList bad_opacity_frame = new DisplayList{width: 48, height: 36, commands: bad_opacity_commands};
    expect(t, !display_list_valid(bad_opacity_frame, guarded),
        "display list: out-of-range opacity is rejected", "invalid opacity accepted");

    // Variable-sized payloads on the wrong command kind must not evade the
    // aggregate geometry/mask accounting merely because the executor ignores them.
    List<int> hidden_payload = new List<int>();
    hidden_payload.push(255);
    DisplayCommand bad_rect_payload = frame.commands[0];
    bad_rect_payload.mask_alpha = hidden_payload;
    List<DisplayCommand> bad_rect_payload_commands = new List<DisplayCommand>();
    bad_rect_payload_commands.push(bad_rect_payload);
    DisplayList bad_rect_payload_frame = new DisplayList{
        width: 48, height: 36, commands: bad_rect_payload_commands
    };
    expect(t, !display_list_valid(bad_rect_payload_frame, guarded),
        "display list: rectangle cannot smuggle an unaccounted mask payload",
        "hidden rectangle payload accepted");

    DisplayCommand bad_path_payload = frame.commands[1];
    bad_path_payload.mask_alpha = hidden_payload;
    List<DisplayCommand> bad_path_payload_commands = new List<DisplayCommand>();
    bad_path_payload_commands.push(bad_path_payload);
    DisplayList bad_path_payload_frame = new DisplayList{
        width: 48, height: 36, commands: bad_path_payload_commands
    };
    expect(t, !display_list_valid(bad_path_payload_frame, guarded),
        "display list: path cannot smuggle an unaccounted mask payload",
        "hidden path payload accepted");

    List<int> invalid_alpha = new List<int>();
    invalid_alpha.push(256);
    DisplayCommand bad_mask = frame.commands[0];
    bad_mask.kind = DISPLAY_MASK;
    bad_mask.segments = none;
    bad_mask.mask_alpha = invalid_alpha;
    bad_mask.mask_w = 1;
    bad_mask.mask_h = 1;
    bad_mask.x = 0;
    bad_mask.y = 0;
    List<DisplayCommand> bad_mask_commands = new List<DisplayCommand>();
    bad_mask_commands.push(bad_mask);
    DisplayList bad_mask_frame = new DisplayList{width: 48, height: 36, commands: bad_mask_commands};
    expect(t, !display_list_valid(bad_mask_frame, guarded),
        "display list: noncanonical mask alpha is rejected", "invalid alpha accepted");
    expect_int(t, guarded.get(0, 0), before,
        "display list: malformed mask validation is non-mutating");

    // Bound work, not just storage: many long paths on a tall viewport would
    // otherwise multiply segment scans and per-scanline sorting without limit.
    Segments expensive = new_segments();
    for (int i = 0; i < 12000; i += 1) {
        expensive.add(0, 0, fx(48), fx(36));
    }
    DisplayCommand expensive_path = frame.commands[1];
    expensive_path.segments = expensive;
    List<DisplayCommand> expensive_commands = new List<DisplayCommand>();
    expensive_commands.push(expensive_path);
    DisplayList expensive_frame = new DisplayList{width: 48, height: 36, commands: expensive_commands};
    expect(t, !display_list_valid(expensive_frame, guarded),
        "display list: aggregate path raster work is bounded", "expensive path accepted");
    expect_int(t, guarded.get(0, 0), before,
        "display list: over-budget frame is rejected before execution");
}

void test_path_flatten_preflight(Tally t) {
    Path small = new_path().move_to(0, 0).line_to(fx(1), 0).close();
    expect_int(t, path_flatten_segment_bound(small), 2,
        "path preflight: line and close have a bounded cost");

    Path curves = new_path().move_to(0, 0);
    for (int i = 0; i < 1000; i += 1) {
        curves.cubic_to(fx(i + 1), fx(1), fx(i + 2), fx(1), fx(i + 3), 0);
    }
    curves.close();
    expect(t, path_flatten_segment_bound(curves) >= 0,
        "path preflight: accepts a path whose worst-case subdivision fits");

    Path excessive = new_path().move_to(0, 0);
    for (int j = 0; j < 1024; j += 1) {
        excessive.cubic_to(fx(j + 1), fx(1), fx(j + 2), fx(1), fx(j + 3), 0);
    }
    excessive.close();
    expect_int(t, path_flatten_segment_bound(excessive), -1,
        "path preflight: rejects excessive worst-case curve expansion");

    Path malformed = new_path();
    malformed.verbs.push(VERB_LINE);
    malformed.pts.push(0);
    malformed.pts.push(0);
    expect_int(t, path_flatten_segment_bound(malformed), -1,
        "path preflight: rejects a line without a move");

    Path trailing = new_path().move_to(0, 0);
    trailing.pts.push(7);
    expect_int(t, path_flatten_segment_bound(trailing), -1,
        "path preflight: rejects unconsumed point data");

    Path extreme = new_path().move_to(2147483647, 0).line_to(0, 0);
    expect_int(t, path_flatten_segment_bound(extreme), -1,
        "path preflight: rejects coordinates outside the safe curve-arithmetic domain");
}

void test_display_payload_byte_budget(Tally t) {
    Pixmap target = new_pixmap(1, 1);
    Canvas recorder = new_recording_canvas(target);
    expect(t, display_list_payload_fits(recorder, 1, 32),
        "display bytes: one segment reserves four integer arrays", "small segment rejected");
    expect(t, display_mask_admissible(recorder, 1, 1, 1),
        "display bytes: one mask pixel reserves one integer", "small mask rejected");
    expect(t, display_list_payload_fits(recorder, 1, MAX_DISPLAY_PAYLOAD_BYTES - DISPLAY_COMMAND_BUDGET_BYTES),
        "display bytes: exact aggregate byte boundary is admitted", "exact boundary rejected");
    expect(t, !display_list_payload_fits(recorder, 1, MAX_DISPLAY_PAYLOAD_BYTES),
        "display bytes: command metadata cannot overflow aggregate byte budget",
        "over-budget command admitted");

    DisplayCommand command = new DisplayCommand{
        kind: DISPLAY_BLEND, bounds: rect(0, 0, 0, 0), clip: rect_px(0, 0, 1, 1),
        paint: solid(0xFFFFFFFF), rule: FILL_NONZERO, segments: none, mask_alpha: none,
        mask_w: 0, mask_h: 0, x: 0, y: 0, coverage: 255, opacity: 255
    };
    display_list_append(recorder, command, 0, 0);
    expect(t, display_snapshot_fits(recorder),
        "display bytes: snapshot verifies cached byte counters", "valid counters rejected");
    recorder.budget[1] -= 1;
    expect(t, !display_snapshot_fits(recorder),
        "display bytes: forged byte counter is rejected", "forged counter accepted");
}

void test_display_work_budget(Tally t) {
    Pixmap target = new_pixmap(1, MAX_PIXMAP_SIDE);
    Segments small = new_segments();
    for (int i = 0; i < 8; i += 1) {
        small.add(0, 0, FX, fx(MAX_PIXMAP_SIDE));
    }
    DisplayCommand small_cmd = new DisplayCommand{
        kind: DISPLAY_PATH, bounds: rect(0, 0, 0, 0),
        clip: rect_px(0, 0, 1, MAX_PIXMAP_SIDE),
        paint: solid(0xFFFFFFFF), rule: FILL_NONZERO,
        segments: small, mask_alpha: none, mask_w: 0, mask_h: 0,
        x: 0, y: 0, coverage: 0, opacity: 255
    };
    List<DisplayCommand> small_commands = new List<DisplayCommand>();
    small_commands.push(small_cmd);
    DisplayList small_frame = new DisplayList{
        width: 1, height: MAX_PIXMAP_SIDE, commands: small_commands
    };
    expect(t, display_list_valid(small_frame, target),
        "display work: a bounded tall path remains admissible", "small path rejected");

    List<DisplayCommand> aggregate_commands = new List<DisplayCommand>();
    for (int repeat = 0; repeat < 3; repeat += 1) { aggregate_commands.push(small_cmd); }
    DisplayList aggregate_frame = new DisplayList{
        width: 1, height: MAX_PIXMAP_SIDE, commands: aggregate_commands
    };
    expect(t, !display_list_valid(aggregate_frame, target),
        "display work: individually valid paths cannot exceed the aggregate frame budget",
        "aggregate work limit was not enforced");

    Segments adversarial = new_segments();
    for (int j = 0; j < 512; j += 1) {
        adversarial.add(0, 0, FX, fx(MAX_PIXMAP_SIDE));
    }
    DisplayCommand adversarial_cmd = new DisplayCommand{
        kind: DISPLAY_PATH, bounds: rect(0, 0, 0, 0),
        clip: rect_px(0, 0, 1, MAX_PIXMAP_SIDE),
        paint: solid(0xFFFFFFFF), rule: FILL_NONZERO,
        segments: adversarial, mask_alpha: none, mask_w: 0, mask_h: 0,
        x: 0, y: 0, coverage: 0, opacity: 255
    };
    List<DisplayCommand> adversarial_commands = new List<DisplayCommand>();
    adversarial_commands.push(adversarial_cmd);
    DisplayList adversarial_frame = new DisplayList{
        width: 1, height: MAX_PIXMAP_SIDE, commands: adversarial_commands
    };
    expect(t, !display_list_valid(adversarial_frame, target),
        "display work: segment-by-row amplification is rejected before replay",
        "high-work path accepted");
}

void test_blend_bounds(Tally t) {
    Pixmap pm = new_pixmap(2, 2);
    Canvas cv = new_canvas(pm);
    // Out-of-surface and out-of-clip writes must be harmless.
    cv.blend(-1, 0, solid(0xFFFF0000), 255);
    cv.blend(2, 0, solid(0xFFFF0000), 255);
    cv.blend(0, -1, solid(0xFFFF0000), 255);
    cv.blend(0, 2, solid(0xFFFF0000), 255);
    cv.push_clip(rect_px(0, 0, 1, 1));
    cv.blend(1, 0, solid(0xFFFF0000), 255);
    cv.blend(0, 1, solid(0xFFFF0000), 255);
    cv.blend(0, 0, solid(0xFFFF0000), -1);
    expect_int(t, pm.px[0], 0, "raster: invalid coverage is clamped to no-op");
    expect_int(t, pm.px[1], 0, "raster: direct blend respects right clip edge");
    expect_int(t, pm.px[2], 0, "raster: direct blend respects bottom clip edge");
    expect_int(t, pm.px[3], 0, "raster: out-of-surface blend is ignored");

    cv.blend(0, 0, solid(0xFFFF0000), 300);
    expect_int(t, pm.px[0], premultiply(0xFFFF0000),
        "raster: coverage above 255 is safely clamped");

    List<int> one_pixel = new List<int>();
    one_pixel.push(255);
    cv.draw_mask(one_pixel, 1, 1, 2147483647, 0, solid(0xFFFFFFFF));
    cv.draw_mask(one_pixel, 1, 1, -2147483647, 0, solid(0xFFFFFFFF));
    expect_int(t, pm.px[0], premultiply(0xFFFF0000),
        "raster: extreme glyph-mask coordinates are rejected safely");

    Pixmap recorded = new_pixmap(2, 2);
    Canvas recorder = new_recording_canvas(recorded);
    recorder.push_clip(rect_px(0, 0, 1, 1));
    recorder.blend(1, 0, solid(0xFF00FF00), 255);
    recorder.blend(0, 0, solid(0xFF00FF00), 255);
    DisplayList frame = finish_display_list(recorder);
    execute_display_list(frame, recorded);
    expect_int(t, recorded.px[0], premultiply(0xFF00FF00),
        "display list: valid direct blend replays");
    expect_int(t, recorded.px[1], 0,
        "display list: blend outside recorded clip is discarded");
}


int main() {
    Font? regular = none;
    Font? bold = none;
    if (let r = read_file("lib/shroud/fonts/DejaVuSans-Latin.ttf")) { regular = font_load(r); }
    if (let b = read_file("lib/shroud/fonts/DejaVuSans-Bold-Latin.ttf")) { bold = font_load(b); }
    Tally t = new Tally{failed: 0, passed: 0};
    if (let f = regular) {
        if (let fb = bold) {
            test_layout(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_buttons_and_guard(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_duplicate_keys(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_duplicate_key_collisions(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_disabled_hit_blocking(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_host_cancellation(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_keyboard(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_text_field(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_single_line_unicode_controls(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_single_line_oversized_paste(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_utf8_byte_ends(t);
            test_unicode_logical_preservation(t);
            test_unicode_semantic_sequences(t);
            test_caret_byte_positions(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_a11y_utf8_encoder(t);
            test_a11y(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_a11y_untrusted(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_a11y_json_escaping(t);
            test_scroll(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_display_list(t, f);
            test_path_flatten_preflight(t);
            test_display_payload_byte_budget(t);
            test_display_work_budget(t);
            test_blend_bounds(t);
            test_ui_state_pruning(t, new_ui(f, fb, light_theme(), 640, 480, 256));
            test_resize(t, f, fb);
            test_scale(t, f, fb);
        }
    } else {
        println("FAIL fonts: could not load lib/shroud/fonts");
        return 1;
    }
    test_untrusted_display(t);
    test_themes(t);
    test_raster(t);
    println($"{t.passed} passed, {t.failed} failed");
    if (t.failed > 0) { return 1; }
    return 0;
}
