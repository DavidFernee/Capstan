// expect: CWE-20
// spec: types.tainted
// A byte decoded from untrusted text with taint_char() is still untrusted.
string greet(string name) { return "Hello " + name; }
int main() {
    if (let line = read_line(1048576)) {
        if (line.len() > 0) { println(greet(taint_char(line.at(0)))); }
    }
    return 0;
}
