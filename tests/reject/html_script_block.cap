// expect: CWE-79
// spec: types.html
// Inside <script>, HTML escaping is not JavaScript escaping.
int main() {
    if (let t = read_line(1048576)) {
        bool ok = write_file("p.html", "<script>var name = '" + escape_html(t) + "';</script>");
        if (!ok) { println("write failed"); }
    }
    return 0;
}
