// expect: CWE-20
// spec: types.tainted types.list
// Bytes of untrusted input pushed into a list and popped back out are still untrusted.
int main() {
    if (let t = read_line()) {
        List<int> bytes = new List<int>();
        for (int i = 0; i < t.len(); i += 1) { bytes.push(t.at(i)); }
        string rebuilt = "";
        while (true) {
            if (let b = bytes.pop()) { rebuilt = char_str(b) + rebuilt; } else { break; }
        }
        println(rebuilt);
    }
    return 0;
}
