// expect: CWE-20
// spec: types.tainted types.list
// A table of integers indexed by untrusted bytes yields untrusted integers.
int main() {
    if (let t = read_line(1048576)) {
        List<int> ids = new List<int>();
        for (int c = 0; c < 256; c += 1) { ids.push(c); }
        string out = "";
        for (int i = 0; i < t.len(); i += 1) { out = out + char_str(ids[t.at(i)]); }
        sql_query("SELECT ?", out);
    }
    return 0;
}
