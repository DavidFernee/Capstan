struct Vault {
    private int secret;
    int label;
}

Vault make_vault() {
    return new Vault{secret: 41, label: 7};
}

opaque struct SealedVault {
    int secret;
    int counter;
}

SealedVault make_sealed_vault() {
    return new SealedVault{secret: 73, counter: 0};
}

opaque struct EmptyCapability {}

EmptyCapability make_empty_capability() {
    return new EmptyCapability{};
}
