// expect: CWE-862
struct Doc { int owner; string body; }
struct User { int id; }
policy ReadDoc(User u, Doc d) { return u.id == d.owner; }
protected(ReadDoc) string read(Grant<ReadDoc> g, Doc d) { return d.body; }
int main() {
    Doc d = new Doc{owner: 1, body: "private"};
    println(read(d));
    return 0;
}
test "deny" { assert_denied ReadDoc(new User{id: 2}, new Doc{owner: 1, body: ""}); }
