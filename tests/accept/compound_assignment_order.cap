// spec: stmt.assign
// Compound assignment must read the old indexed value before evaluating an RHS
// that mutates the same list. MIN % -1 preserves the existing result of zero.
int mutate_first(List<int> xs) {
    xs[0] = 100;
    return 1;
}

int main() {
    List<int> xs = new List<int>();
    xs.push(10);
    xs[0] += mutate_first(xs);
    println(int_to_str(xs[0]));

    int min = -9223372036854775807 - 1;
    println(int_to_str(min % -1));
    return 0;
}
