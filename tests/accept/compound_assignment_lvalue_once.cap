// spec: stmt.assign expr.order types.struct types.list
// Compound assignment evaluates the lvalue receiver and index exactly once.
struct Counter {
    int value;
}

Counter get_counter(List<int> calls, Counter c) {
    calls[0] = calls[0] + 1;
    return c;
}

List<int> get_list(List<int> calls, List<int> xs) {
    calls[0] = calls[0] + 1;
    return xs;
}

int get_index(List<int> calls) {
    calls[0] = calls[0] + 1;
    return 0;
}

int mutate_counter(Counter c) {
    c.value = 100;
    return 1;
}

int mutate_first(List<int> xs) {
    xs[0] = 100;
    return 1;
}

int main() {
    List<int> calls = new List<int>();
    calls.push(0);

    Counter c = new Counter{value: 10};
    get_counter(calls, c).value += mutate_counter(c);
    println(int_to_str(c.value));
    println(int_to_str(calls[0]));

    List<int> xs = new List<int>();
    xs.push(10);
    get_list(calls, xs)[get_index(calls)] += mutate_first(xs);
    println(int_to_str(xs[0]));
    println(int_to_str(calls[0]));

    return 0;
}
