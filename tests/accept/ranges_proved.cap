// spec: runtime.checks types.int types.list types.string compiler.ranges
// expect-proved: 51
// What the range analysis proves. Each line notes whether its check is left out
// ("proved") or kept; tests/run.sh counts the proved operations in the C.
const int LIMIT = 1000;
const int FLOOR = -5;                            // -5: proved

int sum(List<int> xs) {
    int total = 0;
    for (int i = 0; i < xs.len(); i += 1) {      // i += 1: proved (i < len)
        total += xs[i];                          // xs[i]: proved; total += ...: kept
    }
    return total;
}

int digits(string s) {
    int n = 0;
    for (int i = 0; i < s.len(); i += 1) {       // i += 1: proved
        int c = s.at(i);                         // s.at(i): proved (strings never shrink)
        if (c >= '0' && c <= '9') { n += 1; }    // n += 1: kept (n is reassigned)
    }
    return n;
}

int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);              // n - 1, n - 2: proved (n >= 2); + kept
}

int average(int total, int count) {
    if (count <= 0) { return 0; }
    return total / count;                        // proved (count > 0)
}

int scaled(int pct) {
    if (pct < 0 || pct > 100) { return -1; }     // -1 (negating a literal): proved
    return pct * LIMIT - pct + -pct;             // *, -, unary -, +: all proved
}

int countdown(int n) {
    if (n < 0 || n > 1000) { return 0; }
    int total = 0;
    for (int i = n; i > 0; i -= 1) {             // i -= 1: proved (i > 0, decreasing)
        total += i - 1 + i * 1000000;            // i - 1, i * 1000000, +: proved (i <= n <= 1000); total += ...: kept
    }
    return total;
}

int strided(int step) {
    if (step < 1 || step > 100) { return 0; }
    int hits = 0;
    for (int i = 0; i < 1000; i += step) {       // i += step: proved (i < 1000, step <= 100)
        hits += 1;                               // kept
    }
    return hits;
}

int every_nth(List<int> xs, int step) {
    if (step < 1) { return 0; }
    int sum = 0;
    for (int i = 0; i < xs.len(); i += step) {   // i += step: kept (step has no upper bound)
        sum += xs[i];                            // xs[i]: proved (i >= 0, i < len); sum += ...: kept
    }
    return sum;
}

int skip_and_stop(List<int> xs) {
    int sum = 0;
    for (int i = 0; i < xs.len(); i += 1) {      // i += 1, xs[i]: proved
        int v = xs[i];
        if (v <= 0) { continue; }
        if (v > 1000) { break; }
        sum += 1000000 / v + v * 1000;           // /, * and +: proved (0 < v <= 1000); sum += ...: kept
    }
    return sum;
}

int pack_rgb(int r, int g, int b) {
    if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) { return 0; }
    return (r << 16) | (g << 8) | b;             // << 16, << 8: proved (0..255 shifted stays small)
}

int low_bits(int x) {
    return (x >> 3) + (x >>> 60);                // >> 3, >>> 60: proved (literal counts); + kept
}

int popcount(int x) {
    int bits = 0;
    for (int k = 0; k < 64; k += 1) {            // k += 1: proved
        bits += (x >>> k) & 1;                   // >>> k: proved (0 <= k <= 63); bits += ...: kept
    }
    return bits;
}

int combine(int a, int b) {
    if (a < 0 || a > 15 || b < 0 || b > 15) { return 0; }
    return (a | b) * 1000 + (a ^ b) * 1000;      // both *, and +: proved (| and ^ of 0..15 stay in 0..15)
}

int halves(int x, int y) {
    if (x < -1000 || x > 1000 || y < 0 || y > 1000) { return 0; }   // -1000: proved
    return (x >> 4) * 1000 + (y >>> 2) * 1000;                      // >> 4, >>> 2, both *, and +: proved
}

int spread(int a, int b) {
    if (a < 0 || a > 100 || b < 0 || b > 100) { return 0; }
    return (a + b) * 1000 + (a - b) * 1000;      // +, -, both *, and the outer +: proved
}

int percent(int x) {
    if (x >= 0 && x <= 100) { return x * 1000; }   // *: proved (both halves of the && count)
    return 0;
}

int main() {
    List<int> xs = new List<int>();
    for (int i = 1; i <= LIMIT; i += 1) { xs.push(i % 7); }     // i += 1, i % 7: proved
    println(int_to_str(sum(xs)));
    println(int_to_str(digits("a1b22c333")));
    println(int_to_str(fib(20)));
    println(int_to_str(average(sum(xs), xs.len())));
    println(int_to_str(scaled(42)));
    println(int_to_str(scaled(400)));
    println(int_to_str(countdown(10)));
    println(int_to_str(strided(7)));
    List<int> mixed = new List<int>();
    mixed.push(5); mixed.push(-3); mixed.push(250); mixed.push(0); mixed.push(5000); mixed.push(9);   // -3: proved
    println(int_to_str(skip_and_stop(mixed)));
    println(int_to_str(every_nth(mixed, 2)));
    println(int_to_str(percent(42)));
    println(int_to_str(combine(12, 10)));
    println(int_to_str(halves(-999, 1000)));                           // -999: proved
    println(int_to_str(spread(30, 70)));
    println(int_to_str(pack_rgb(18, 52, 86)));
    println(int_to_str(low_bits(-1000)));                              // -1000: proved
    println(int_to_str(popcount(0xFF00FF)));
    println(int_to_str(FLOOR * LIMIT));                                // *: proved (a negative constant)
    return 0;
}
