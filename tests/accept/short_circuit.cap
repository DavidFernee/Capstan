// spec: types.bool expr.order expr.short_circuit
// A suppressed boolean RHS must not execute, even when it would trap at runtime.
int divide_by_argument(int x) {
    return 1 / x;
}
int main() {
    bool a = false && (divide_by_argument(0) == 0);
    bool b = true || (divide_by_argument(0) == 0);
    if (a) {
        println("bad");
    } else {
        println("false");
    }
    if (b) {
        println("true");
    } else {
        println("bad");
    }
    return 0;
}
