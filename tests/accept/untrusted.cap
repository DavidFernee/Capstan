// The legitimate ways to handle untrusted input.
int main() {
    Tainted name = taint("<b>Bob</b>\nadmin");
    println("html: " + escape_html(name));
    println("log: " + escape_log(name));
    if (let id = validate_ident(taint("user_42"))) { println("ident: " + id); }
    if (let _bad = validate_ident(taint("42; drop"))) { println("unexpected"); } else { println("rejected bad ident"); }
    if (let n = validate_int(taint("-120"))) { println("int: " + int_to_str(n + 1)); }
    if (let _huge = validate_int(taint("99999999999999999999"))) { println("unexpected"); } else { println("rejected overflowing int"); }
    sql_query("UPDATE users SET name = ? WHERE id = ?", name, "42");
    run("convert", "--", taint("a.jpg; rm -rf ~"), "out.png");
    string reviewed = trust(taint("ok"), "value comes from our own config file");
    println("trusted: " + reviewed);
    println(hash("abc"));
    println("verify: " + bool_text(hash_verify("abc", hash("abc"))) + " " + bool_text(hash_verify("abd", hash("abc"))));
    println("legacy tag accepted: " + bool_text(hash_verify("abc", "md5$900150983cd24fb0d6963f7d28e17f72")));
    return 0;
}
string bool_text(bool b) { if (b) { return "true"; } return "false"; }
