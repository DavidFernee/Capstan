// Allocation-heavy: build and discard binary trees (exercises the collector).
struct T { T? l; T? r; }
T make(int d) {
    if (d == 0) { return new T{l: none, r: none}; }
    return new T{l: make(d - 1), r: make(d - 1)};
}
int count(T? t) {
    if (let n = t) { return 1 + count(n.l) + count(n.r); }
    return 0;
}
int main() {
    int total = 0;
    for (int i = 0; i < 40; i += 1) { total += count(make(16)); }
    println(int_to_str(total));
    return 0;
}
