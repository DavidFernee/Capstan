// Capstan compiler: lexer.
//
// Source text arrives as Tainted. Identifiers leave through validate_ident(),
// numbers through validate_int(), and string literals through escape_c(), so
// nothing from a source file can reach the generated C unescaped (CWE-94).

const int T_ID = 1;
const int T_INT = 2;
const int T_STR = 3;
const int T_OP = 4;
const int T_KW = 5;
const int T_EOF = 6;

struct Token {
    int k;
    string s;       // identifier, keyword, operator, or escaped string body
    int n;          // integer value, or decoded byte length of a string
    int line;
    int col;
    int file;
}

struct Lexer {
    Tainted src;
    int pos;
    int end;
    int line;
    int line_start;
    int tok_start;
    int file;
    Ctx ctx;
    List<Token> toks;
}

bool is_keyword(string w) {
    List<string> kws = new List<string>();
    kws.push("struct"); kws.push("const"); kws.push("if"); kws.push("else");
    kws.push("while"); kws.push("for"); kws.push("return"); kws.push("break");
    kws.push("continue"); kws.push("true"); kws.push("false"); kws.push("none");
    kws.push("new"); kws.push("let"); kws.push("protected"); kws.push("policy");
    kws.push("public"); kws.push("private"); kws.push("test"); kws.push("authorize");
    kws.push("assert_denied"); kws.push("assert_granted");
    kws.push("enum"); kws.push("match"); kws.push("case"); kws.push("import"); kws.push("sensitive");
    for (int i = 0; i < kws.len(); i += 1) {
        if (kws[i] == w) { return true; }
    }
    return false;
}

// Case-insensitive search in a slice of the (untrusted) source text.
bool src_has(Lexer lx, int from, int to, string needle) {
    for (int i = from; i + needle.len() <= to; i += 1) {
        bool same = true;
        for (int j = 0; j < needle.len() && same; j += 1) {
            int c = lx.src.at(i + j);
            if (c >= 'A' && c <= 'Z') { c = c + 32; }
            if (c != needle.at(j)) { same = false; }
        }
        if (same) { return true; }
    }
    return false;
}

// Notes left in comments about unfinished security work deserve a reviewer (CWE-546).
void check_comment(Lexer lx, int from, int to, int line) {
    bool marker = src_has(lx, from, to, "todo") || src_has(lx, from, to, "fixme") || src_has(lx, from, to, "xxx") || src_has(lx, from, to, "hack");
    bool topic = src_has(lx, from, to, "password") || src_has(lx, from, to, "auth") || src_has(lx, from, to, "secur")
        || src_has(lx, from, to, "secret") || src_has(lx, from, to, "bypass") || src_has(lx, from, to, "remove before");
    if (src_has(lx, from, to, "backdoor") || (marker && topic)) {
        report_at(lx.ctx, lx.file, line, 0, lx.ctx.strict, "CWE-546", "comment suggests unfinished or hidden security-relevant code; resolve it before release");
    }
}

bool is_alpha(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

bool is_digit(int c) {
    return c >= '0' && c <= '9';
}

int peek_ch(Lexer lx, int ahead) {
    int at = lx.pos + ahead;
    if (at >= lx.end) { return -1; }
    return lx.src.at(at);
}

void add_tok(Lexer lx, int k, string s, int n) {
    lx.toks.push(new Token{k: k, s: s, n: n, line: lx.line, col: lx.tok_start - lx.line_start + 1, file: lx.file});
}

void lex_error(Lexer lx, string msg) {
    report_at(lx.ctx, lx.file, lx.line, lx.pos - lx.line_start + 1, true, "", msg);
}

// Decode one escape sequence after a backslash; returns the byte value or -1.
int escape_value(int e) {
    if (e == 'n') { return 10; }
    if (e == 't') { return 9; }
    if (e == 'r') { return 13; }
    if (e == '0') { return 0; }
    if (e == '\\') { return '\\'; }
    if (e == '"') { return '"'; }
    if (e == '\'') { return '\''; }
    return -1;
}

void lex_string(Lexer lx) {
    lx.pos += 1;
    Tainted decoded = lx.src.slice(0, 0);
    int bytes = 0;
    while (true) {
        int c = peek_ch(lx, 0);
        if (c == -1 || c == '\n') {
            lex_error(lx, "unterminated string literal");
            return;
        }
        if (c == '"') { break; }
        if (c == '\\') {
            int v = escape_value(peek_ch(lx, 1));
            if (v == -1) {
                lex_error(lx, "unknown escape sequence in string literal");
                v = '?';
            }
            decoded = decoded + char_str(v);
            lx.pos += 2;
        } else {
            decoded = decoded + lx.src.slice(lx.pos, lx.pos + 1);
            lx.pos += 1;
        }
        bytes += 1;
    }
    lx.pos += 1;
    add_tok(lx, T_STR, escape_c(decoded), bytes);
}

void lex_char(Lexer lx) {
    int c = peek_ch(lx, 1);
    int v = c;
    int width = 1;
    if (c == '\\') {
        v = escape_value(peek_ch(lx, 2));
        width = 2;
    }
    if (v == -1 || c == -1 || peek_ch(lx, 1 + width) != '\'') {
        lex_error(lx, "malformed character literal");
        lx.pos += 1;
        return;
    }
    add_tok(lx, T_INT, "", v);
    lx.pos += 2 + width;
}

// Decode escapes in src[a, b) into a string token.
void add_text(Lexer lx, int a, int b) {
    Tainted decoded = lx.src.slice(0, 0);
    int i = a;
    while (i < b) {
        int c = lx.src.at(i);
        if (c == '\\' && i + 1 < b) {
            int v = escape_value(lx.src.at(i + 1));
            if (v == -1) {
                lex_error(lx, "unknown escape sequence in string literal");
                v = '?';
            }
            decoded = decoded + char_str(v);
            i += 2;
        } else {
            decoded = decoded + lx.src.slice(i, i + 1);
            i += 1;
        }
    }
    add_tok(lx, T_STR, escape_c(decoded), decoded.len());
}

// $"text {expr} text" becomes ("" + to_text(expr) + "text"), so every typing
// and safety rule for + applies unchanged. {{ and }} are literal braces.
void lex_interp(Lexer lx) {
    lx.pos += 2;
    add_tok(lx, T_OP, "(", 0);
    add_tok(lx, T_STR, "", 0);
    int part = lx.pos;
    while (true) {
        int c = peek_ch(lx, 0);
        if (c == -1 || c == '\n') {
            lex_error(lx, "unterminated interpolated string");
            return;
        }
        if (c == '"') { break; }
        if (c == '\\') {
            lx.pos += 2;
        } else if ((c == '{' && peek_ch(lx, 1) == '{') || (c == '}' && peek_ch(lx, 1) == '}')) {
            lx.pos += 1;
            if (lx.pos > part) {
                add_tok(lx, T_OP, "+", 0);
                add_text(lx, part, lx.pos);
            }
            lx.pos += 1;
            part = lx.pos;
        } else if (c == '{') {
            if (lx.pos > part) {
                add_tok(lx, T_OP, "+", 0);
                add_text(lx, part, lx.pos);
            }
            int depth = 1;
            int j = lx.pos + 1;
            while (j < lx.end && depth > 0) {
                int d = lx.src.at(j);
                if (d == '\n') { break; }
                if (d == '"') {
                    j += 1;
                    while (j < lx.end && lx.src.at(j) != '"' && lx.src.at(j) != '\n') {
                        if (lx.src.at(j) == '\\') { j += 1; }
                        j += 1;
                    }
                } else if (d == '{') {
                    depth += 1;
                } else if (d == '}') {
                    depth -= 1;
                }
                if (depth > 0) { j += 1; }
            }
            if (depth != 0) {
                lex_error(lx, "unclosed { in interpolated string");
                return;
            }
            add_tok(lx, T_OP, "+", 0);
            add_tok(lx, T_ID, "to_text", 0);
            add_tok(lx, T_OP, "(", 0);
            Lexer sub = new Lexer{src: lx.src, pos: lx.pos + 1, end: j, line: lx.line, line_start: lx.line_start, tok_start: lx.pos + 1, file: lx.file, ctx: lx.ctx, toks: lx.toks};
            lex_run(sub);
            lx.tok_start = j;
            add_tok(lx, T_OP, ")", 0);
            lx.pos = j + 1;
            part = lx.pos;
        } else if (c == '}') {
            lex_error(lx, "unmatched } in interpolated string; write }} for a literal brace");
            lx.pos += 1;
        } else {
            lx.pos += 1;
        }
    }
    if (lx.pos > part) {
        add_tok(lx, T_OP, "+", 0);
        add_text(lx, part, lx.pos);
    }
    lx.pos += 1;
    add_tok(lx, T_OP, ")", 0);
}

int hex_digit(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

// 0x... uses all 64 bits, as in Java: 0xFFFFFFFFFFFFFFFF is -1. Masks and the
// constants of hash functions are written this way.
void lex_hex(Lexer lx) {
    lx.pos += 2;
    int v = 0;
    int digits = 0;
    int significant = 0;
    while (hex_digit(peek_ch(lx, 0)) >= 0) {
        int d = hex_digit(peek_ch(lx, 0));
        if (significant > 0 || d != 0) { significant += 1; }
        v = wrapping_add(wrapping_shl(v, 4), d);
        digits += 1;
        lx.pos += 1;
    }
    if (digits == 0 || is_alpha(peek_ch(lx, 0)) || is_digit(peek_ch(lx, 0))) {
        lex_error(lx, "malformed hexadecimal literal");
        while (is_alpha(peek_ch(lx, 0)) || is_digit(peek_ch(lx, 0))) { lx.pos += 1; }
        return;
    }
    if (significant > 16) {
        lex_error(lx, "hexadecimal literal does not fit in 64 bits [CWE-190]");
        return;
    }
    add_tok(lx, T_INT, "", v);
}

// Two-character operators first, then single characters.
bool lex_op(Lexer lx) {
    int c = peek_ch(lx, 0);
    int d = peek_ch(lx, 1);
    List<string> two = new List<string>();
    two.push("&&"); two.push("||"); two.push("=="); two.push("!=");
    two.push("<="); two.push(">="); two.push("+="); two.push("-=");
    two.push("++"); two.push("--"); two.push("<<");
    for (int i = 0; i < two.len(); i += 1) {
        string op = two[i];
        if (c == op.at(0) && d == op.at(1)) {
            add_tok(lx, T_OP, op, 0);
            lx.pos += 2;
            return true;
        }
    }
    // '>' stays a single token: the parser joins adjacent ones into >> and >>>,
    // so that Map<List<int>> still closes two type arguments.
    string one = "{}()[];,.:?<>=+-*/%!&|^~";
    for (int j = 0; j < one.len(); j += 1) {
        if (c == one.at(j)) {
            add_tok(lx, T_OP, one.slice(j, j + 1), 0);
            lx.pos += 1;
            return true;
        }
    }
    return false;
}

// Trojan Source (CVE-2021-42574, CWE-1007): bidirectional controls make code display in a
// different order from the one it compiles in, and zero-width characters hide text. Neither has
// any use in Capstan source, so both are rejected everywhere, in comments and strings included.
// A byte-order mark is allowed only as the first character of a file.
string invisible_name(Tainted src, int i) {
    int n = src.len();
    if (i + 1 < n && src.at(i) == 0xD8 && src.at(i + 1) == 0x9C) { return "U+061C ARABIC LETTER MARK"; }
    if (i + 2 >= n) { return ""; }
    int b0 = src.at(i);
    int b1 = src.at(i + 1);
    int b2 = src.at(i + 2);
    if (b0 == 0xE2 && b1 == 0x80 && b2 >= 0xAA && b2 <= 0xAE) { return "a bidirectional embedding or override control (U+202A to U+202E)"; }
    if (b0 == 0xE2 && b1 == 0x81 && b2 >= 0xA6 && b2 <= 0xA9) { return "a bidirectional isolate control (U+2066 to U+2069)"; }
    if (b0 == 0xE2 && b1 == 0x80 && (b2 == 0x8E || b2 == 0x8F)) { return "a left-to-right or right-to-left mark (U+200E, U+200F)"; }
    if (b0 == 0xE2 && b1 == 0x80 && b2 >= 0x8B && b2 <= 0x8D) { return "a zero-width character (U+200B to U+200D)"; }
    if (b0 == 0xE2 && b1 == 0x81 && b2 == 0xA0) { return "a word joiner (U+2060)"; }
    if (b0 == 0xEF && b1 == 0xBB && b2 == 0xBF && i > 0) { return "a byte-order mark after the start of the file (U+FEFF)"; }
    return "";
}

void check_invisible(Lexer lx) {
    int line = 1;
    int line_start = 0;
    for (int i = 0; i < lx.end; i += 1) {
        int b = lx.src.at(i);
        if (b == '\n') {
            line += 1;
            line_start = i + 1;
        } else if (b >= 0xD8) {
            string what = invisible_name(lx.src, i);
            if (what != "") {
                report_at(lx.ctx, lx.file, line, i - line_start + 1, true, "CWE-1007", "source contains " + what + ", which can make code display differently from how it compiles (Trojan Source); remove it");
            }
        }
    }
}

List<Token> lex(Ctx ctx, Tainted src, int file) {
    Lexer lx = new Lexer{src: src, pos: 0, end: src.len(), line: 1, line_start: 0, tok_start: 0, file: file, ctx: ctx, toks: new List<Token>()};
    check_invisible(lx);
    lex_run(lx);
    lx.tok_start = lx.pos;
    add_tok(lx, T_EOF, "", 0);
    return lx.toks;
}

// Tokenise src[pos, end), appending to lx.toks.
void lex_run(Lexer lx) {
    Tainted src = lx.src;
    while (lx.pos < lx.end) {
        int c = peek_ch(lx, 0);
        lx.tok_start = lx.pos;
        if (c == '\n') {
            lx.line += 1;
            lx.pos += 1;
            lx.line_start = lx.pos;
        } else if (c == ' ' || c == '\t' || c == '\r') {
            lx.pos += 1;
        } else if (c == '/' && peek_ch(lx, 1) == '/') {
            int cstart = lx.pos;
            while (lx.pos < lx.end && peek_ch(lx, 0) != '\n') { lx.pos += 1; }
            check_comment(lx, cstart, lx.pos, lx.line);
        } else if (c == '/' && peek_ch(lx, 1) == '*') {
            int bstart = lx.pos;
            int bline = lx.line;
            lx.pos += 2;
            while (lx.pos < lx.end && !(peek_ch(lx, 0) == '*' && peek_ch(lx, 1) == '/')) {
                if (peek_ch(lx, 0) == '\n') {
                    lx.line += 1;
                    lx.line_start = lx.pos + 1;
                }
                lx.pos += 1;
            }
            if (lx.pos >= lx.end) {
                lex_error(lx, "unterminated comment");
            } else {
                lx.pos += 2;
                check_comment(lx, bstart, lx.pos, bline);
            }
        } else if (is_alpha(c)) {
            int start = lx.pos;
            while (is_alpha(peek_ch(lx, 0)) || is_digit(peek_ch(lx, 0))) { lx.pos += 1; }
            if (let w = validate_ident(src.slice(start, lx.pos))) {
                if (is_keyword(w)) { add_tok(lx, T_KW, w, 0); } else { add_tok(lx, T_ID, w, 0); }
            } else {
                lex_error(lx, "invalid identifier");
            }
        } else if (c == '0' && (peek_ch(lx, 1) == 'x' || peek_ch(lx, 1) == 'X')) {
            lex_hex(lx);
        } else if (is_digit(c)) {
            int start2 = lx.pos;
            while (is_digit(peek_ch(lx, 0))) { lx.pos += 1; }
            if (let v = validate_int(src.slice(start2, lx.pos))) {
                add_tok(lx, T_INT, "", v);
            } else {
                lex_error(lx, "integer literal does not fit in 64 bits [CWE-190]");
            }
        } else if (c == '$' && peek_ch(lx, 1) == '"') {
            lex_interp(lx);
        } else if (c == '"') {
            lex_string(lx);
        } else if (c == '\'') {
            lex_char(lx);
        } else if (!lex_op(lx)) {
            lex_error(lx, "unexpected character (byte " + int_to_str(c) + ")");
            lx.pos += 1;
        }
    }
}
