// Capstan compiler: shared data structures.
//
// The compiler is written in Capstan and obeys every rule it enforces:
// source text is read as Tainted, and only reaches the generated C code
// through validate_ident(), validate_int() and escape_c().

// ---- types ----------------------------------------------------------------

// The largest source file the compiler and its tools read: a bigger one, or an
// endless one such as /dev/zero, is refused rather than read into memory (CWE-400).
const int MAX_SOURCE_BYTES = 16777216;

const int TY_INT = 1;
const int TY_BOOL = 2;
const int TY_STR = 3;
const int TY_VOID = 4;
const int TY_TAINT = 5;
const int TY_SECRET = 6;
const int TY_STRUCT = 7;
const int TY_LIST = 8;
const int TY_MAP = 9;
const int TY_GRANT = 10;
const int TY_OPT = 11;
const int TY_NONE = 12;
const int TY_ERR = 13;
const int TY_ENUM = 14;
const int TY_HTML = 15;      // text escaped for HTML; usable only where HTML is expected
const int TY_LOG = 16;       // text escaped for logs and terminals

struct Type {
    int k;
    string name;        // struct or policy name
    List<Type> args;    // element type for List, Map, optional
}

// ---- syntax tree ----------------------------------------------------------

const int N_STRUCT = 1;
const int N_FIELD = 2;
const int N_CONST = 3;
const int N_FN = 4;
const int N_PARAM = 5;
const int N_POLICY = 6;
const int N_TEST = 7;
const int N_BLOCK = 10;
const int N_DECL = 11;
const int N_ASSIGN = 12;
const int N_EXPR = 13;
const int N_IF = 14;
const int N_WHILE = 15;
const int N_FOR = 16;
const int N_RETURN = 17;
const int N_BREAK = 18;
const int N_CONTINUE = 19;
const int N_ASSERT_DENIED = 20;
const int N_ASSERT_GRANTED = 21;
const int N_INT = 30;
const int N_STR = 31;
const int N_BOOL = 32;
const int N_NONE = 33;
const int N_VAR = 34;
const int N_BIN = 35;
const int N_NOT = 36;
const int N_NEG = 37;
const int N_GETF = 38;
const int N_INDEX = 39;
const int N_METHOD = 40;
const int N_CALL = 41;
const int N_NEW = 42;
const int N_INIT = 43;
const int N_NEWLIST = 44;
const int N_NEWMAP = 45;
const int N_AUTHORIZE = 46;
const int N_ENUM = 47;
const int N_VARIANT = 48;
const int N_ENUMVAL = 49;
const int N_MATCH = 50;
const int N_CASE = 51;
const int N_IMPORT = 52;
const int N_BNOT = 53;     // ~x

struct Node {
    int k;
    string s;           // name, operator, or escaped string literal
    string s2;          // if-let variable; protected policy name; field visibility
    string s3;          // additional declaration marker (e.g. opaque struct)
    int n;              // integer value, byte length of a string literal, flags
    int line;
    int col;
    int file;
    List<Node> kids;
    Type? ty;           // declared type (declarations) or computed type (expressions)
}

// ---- diagnostics ----------------------------------------------------------

struct Diag {
    int file;
    int line;
    int col;
    bool error;
    string code;
    string msg;
}

struct Ctx {
    List<string> files;
    List<Tainted> sources;
    List<Diag> diags;
    bool release;
    bool strict;
    bool keep_checks;   // --keep-checks: emit every run-time check, even ones proved unnecessary
}

void report(Ctx c, int file, int line, bool error, string code, string msg) {
    report_at(c, file, line, 0, error, code, msg);
}

void report_at(Ctx c, int file, int line, int col, bool error, string code, string msg) {
    c.diags.push(new Diag{file: file, line: line, col: col, error: error, code: code, msg: msg});
}

void error_at(Ctx c, Node at, string code, string msg) {
    report_at(c, at.file, at.line, at.col, true, code, msg);
}

void warn_at(Ctx c, Node at, string code, string msg) {
    report_at(c, at.file, at.line, at.col, c.strict, code, msg);
}

// The source line a diagnostic points at, made safe for a terminal: source files
// are untrusted, and a crafted file must not be able to inject escape sequences.
LogText? source_excerpt(Ctx c, Diag d) {
    if (d.file >= c.sources.len() || d.line <= 0) { return none; }
    Tainted src = c.sources[d.file];
    int line = 1;
    int start = 0;
    int i = 0;
    while (i < src.len() && line < d.line) {
        if (src.at(i) == '\n') {
            line += 1;
            start = i + 1;
        }
        i += 1;
    }
    if (line != d.line) { return none; }
    int end = start;
    while (end < src.len() && src.at(end) != '\n') { end += 1; }
    if (end - start > 200) { end = start + 200; }
    LogText out = "    " + escape_log(src.slice(start, end));
    if (d.col > 0 && d.col <= end - start + 1) {
        List<string> pad = new List<string>();
        for (int k = 1; k < d.col; k += 1) { pad.push(" "); }
        out = out + "\n    " + join(pad, "") + "^";
    }
    return out;
}

int error_count(Ctx c) {
    int n = 0;
    for (int i = 0; i < c.diags.len(); i += 1) {
        if (c.diags[i].error) { n += 1; }
    }
    return n;
}

void print_diags(Ctx c) {
    for (int i = 0; i < c.diags.len(); i += 1) {
        Diag d = c.diags[i];
        string sev = "warning";
        if (d.error) { sev = "error"; }
        string code = "";
        if (d.code != "") { code = "[" + d.code + "]"; }
        string where = c.files[d.file] + ":" + int_to_str(d.line);
        if (d.col > 0) { where = where + ":" + int_to_str(d.col); }
        println(where + ": " + sev + code + ": " + d.msg);
        if (let ex = source_excerpt(c, d)) { println(ex); }
    }
}

// ---- constructors ---------------------------------------------------------

Type mk_type(int k) {
    return new Type{k: k, name: "", args: new List<Type>()};
}

Type mk_named(int k, string name) {
    return new Type{k: k, name: name, args: new List<Type>()};
}

Type mk_wrap(int k, Type inner) {
    List<Type> a = new List<Type>();
    a.push(inner);
    return new Type{k: k, name: "", args: a};
}

Node mk_node(int k, int file, int line) {
    return new Node{k: k, s: "", s2: "", s3: "", n: 0, line: line, col: 0, file: file, kids: new List<Node>(), ty: none};
}

// Edit distance, for "did you mean" suggestions.
int edit_distance(string a, string b) {
    List<int> prev = new List<int>();
    for (int j = 0; j <= b.len(); j += 1) { prev.push(j); }
    for (int i = 1; i <= a.len(); i += 1) {
        List<int> row = new List<int>();
        row.push(i);
        for (int j2 = 1; j2 <= b.len(); j2 += 1) {
            int cost = 1;
            if (a.at(i - 1) == b.at(j2 - 1)) { cost = 0; }
            int best = prev[j2] + 1;
            if (row[j2 - 1] + 1 < best) { best = row[j2 - 1] + 1; }
            if (prev[j2 - 1] + cost < best) { best = prev[j2 - 1] + cost; }
            row.push(best);
        }
        prev = row;
    }
    return prev[b.len()];
}

string suggest(string name, List<string> candidates) {
    string best = "";
    int best_d = 3;
    if (name.len() <= 3) { best_d = 2; }
    for (int i = 0; i < candidates.len(); i += 1) {
        int d = edit_distance(lower(name), lower(candidates[i]));
        if (d < best_d && candidates[i] != name) {
            best_d = d;
            best = candidates[i];
        }
    }
    if (best == "") { return ""; }
    return " (did you mean '" + best + "'?)";
}

Node mk_node_s(int k, string s, int file, int line) {
    Node nd = mk_node(k, file, line);
    nd.s = s;
    return nd;
}

// ---- type helpers -----------------------------------------------------------

bool type_eq(Type a, Type b) {
    if (a.k != b.k) { return false; }
    if (a.name != b.name) { return false; }
    if (a.args.len() != b.args.len()) { return false; }
    for (int i = 0; i < a.args.len(); i += 1) {
        if (!type_eq(a.args[i], b.args[i])) { return false; }
    }
    return true;
}

string type_str(Type t) {
    if (t.k == TY_INT) { return "int"; }
    if (t.k == TY_BOOL) { return "bool"; }
    if (t.k == TY_STR) { return "string"; }
    if (t.k == TY_VOID) { return "void"; }
    if (t.k == TY_TAINT) { return "Tainted"; }
    if (t.k == TY_SECRET) { return "Secret"; }
    if (t.k == TY_HTML) { return "Html"; }
    if (t.k == TY_LOG) { return "LogText"; }
    if (t.k == TY_STRUCT || t.k == TY_ENUM) { return t.name; }
    if (t.k == TY_LIST) { return "List<" + type_str(t.args[0]) + ">"; }
    if (t.k == TY_MAP) { return "Map<" + type_str(t.args[0]) + ">"; }
    if (t.k == TY_GRANT) { return "Grant<" + t.name + ">"; }
    if (t.k == TY_OPT) { return type_str(t.args[0]) + "?"; }
    if (t.k == TY_NONE) { return "none"; }
    return "<error>";
}

// Can a value of type `from` be used where `to` is expected?
bool assignable(Type from, Type to) {
    if (from.k == TY_ERR || to.k == TY_ERR) { return true; }
    if (type_eq(from, to)) { return true; }
    if (to.k == TY_OPT) {
        if (from.k == TY_NONE) { return true; }
        if (type_eq(from, to.args[0])) { return true; }
    }
    return false;
}

bool is_stringish(Type t) {
    return t.k == TY_STR || t.k == TY_TAINT;
}

// Any text value, whatever its trust level or escaping context.
bool is_texty(Type t) {
    return t.k == TY_STR || t.k == TY_TAINT || t.k == TY_HTML || t.k == TY_LOG;
}

string lower(string s) {
    List<string> out = new List<string>();
    for (int i = 0; i < s.len(); i += 1) {
        int c = s.at(i);
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        out.push(char_str(c));
    }
    return join(out, "");
}

bool contains(string hay, string needle) {
    if (needle.len() > hay.len()) { return false; }
    for (int i = 0; i + needle.len() <= hay.len(); i += 1) {
        if (hay.slice(i, i + needle.len()) == needle) { return true; }
    }
    return false;
}
