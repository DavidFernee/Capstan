// Capstan compiler: type and safety checker.
//
// Every rule that makes a weakness class impossible to write lives here.
// Diagnostics carry the CWE number of the weakness they prevent.

const int MAX_GRANT_OBJECT_ROLES = 8;

struct Checker {
    Ctx ctx;
    Map<Node> structs;
    Map<Node> fns;
    Map<Node> policies;
    Map<int> policy_ids;
    Map<Node> consts;
    Map<Type> const_types;
    List<Map<Type>> scopes;
    int depth;
    Type ret;
    int loops;
    bool in_test;
    bool in_policy;
    Map<int> denials;
    int asserts;
    List<Map<int>> used;        // per scope: name -> read count (CWE-563)
    List<Map<Node>> decl_at;    // per scope: name -> declaring node
    Map<Node> enums;
    bool privileged;            // inside a protected function, policy or test
}

Type ty_of(Node n) {
    if (let t = n.ty) { return t; }
    return mk_type(TY_ERR);
}

Type typed(Node n, Type t) {
    n.ty = t;
    return t;
}

// ---- scopes -------------------------------------------------------------------

void push_scope(Checker c) {
    if (c.depth < c.scopes.len()) {
        c.scopes[c.depth] = new Map<Type>();
        c.used[c.depth] = new Map<int>();
        c.decl_at[c.depth] = new Map<Node>();
    } else {
        c.scopes.push(new Map<Type>());
        c.used.push(new Map<int>());
        c.decl_at.push(new Map<Node>());
    }
    c.depth += 1;
}

// Leaving a scope reports locals that were declared but never read (CWE-563).
void pop_scope(Checker c) {
    int top = c.depth - 1;
    List<string> names = c.decl_at[top].keys();
    for (int i = 0; i < names.len(); i += 1) {
        if (!c.used[top].has(names[i]) && names[i].at(0) != '_') {
            if (let at = c.decl_at[top].get(names[i])) {
                warn_at(c.ctx, at, "CWE-563", "'" + names[i] + "' is never used; remove it, or name it _" + names[i] + " if that is intended");
            }
        }
    }
    c.depth -= 1;
}

Type? find_local(Checker c, string name) {
    for (int i = c.depth - 1; i >= 0; i -= 1) {
        if (let t = c.scopes[i].get(name)) { return t; }
    }
    return none;
}

Type? lookup_local(Checker c, string name) {
    for (int i = c.depth - 1; i >= 0; i -= 1) {
        if (let t = c.scopes[i].get(name)) {
            c.used[i].set(name, 1);
            return t;
        }
    }
    return none;
}

// Parameters are declared without unused-variable tracking.
void declare_param(Checker c, Node at, string name, Type t) {
    declare(c, at, name, t);
    c.used[c.depth - 1].set(name, 1);
}

void declare(Checker c, Node at, string name, Type t) {
    if (let _prev = find_local(c, name)) {
        error_at(c.ctx, at, "CAP-SHADOW", "'" + name + "' is already declared in an enclosing scope; shadowing is not allowed");
        return;
    }
    if (c.const_types.has(name)) {
        error_at(c.ctx, at, "CAP-SHADOW", "'" + name + "' would shadow the constant of the same name");
        return;
    }
    c.scopes[c.depth - 1].set(name, t);
    c.decl_at[c.depth - 1].set(name, at);
}

// ---- type validation ----------------------------------------------------------

// The parser cannot tell struct names from enum names; resolve them here.
void normalise(Checker c, Type t) {
    if (t.k == TY_STRUCT && c.enums.has(t.name)) { t.k = TY_ENUM; }
    for (int i = 0; i < t.args.len(); i += 1) { normalise(c, t.args[i]); }
}

void normalise_node(Checker c, Node n) {
    if (let t = n.ty) { normalise(c, t); }
    for (int i = 0; i < n.kids.len(); i += 1) {
        int k = n.kids[i].k;
        if (k == N_PARAM || k == N_FIELD || k == N_VARIANT) { normalise_node(c, n.kids[i]); }
    }
}

List<string> type_names(Checker c) {
    List<string> out = c.structs.keys();
    List<string> en = c.enums.keys();
    for (int i = 0; i < en.len(); i += 1) { out.push(en[i]); }
    out.push("int"); out.push("bool"); out.push("string"); out.push("Tainted"); out.push("Secret");
    return out;
}

void check_type(Checker c, Node at, Type t, bool allow_void) {
    normalise(c, t);
    if (t.k == TY_VOID && !allow_void) {
        error_at(c.ctx, at, "", "void is only allowed as a function return type");
    }
    if (t.k == TY_STRUCT && !c.structs.has(t.name)) {
        error_at(c.ctx, at, "", "unknown type '" + t.name + "'" + suggest(t.name, type_names(c)));
    }
    if (t.k == TY_GRANT && !c.policies.has(t.name)) {
        error_at(c.ctx, at, "", "Grant refers to unknown policy '" + t.name + "'");
    }
    if (t.k == TY_OPT) {
        Type inner = t.args[0];
        if (inner.k == TY_OPT || inner.k == TY_VOID) {
            error_at(c.ctx, at, "", "invalid optional type " + type_str(t));
        }
        check_type(c, at, inner, false);
    }
    if (t.k == TY_LIST || t.k == TY_MAP) {
        Type el = t.args[0];
        if (el.k == TY_OPT) {
            error_at(c.ctx, at, "", "collection elements cannot be optional (" + type_str(t) + ")");
        }
        if (el.k == TY_GRANT) {
            error_at(c.ctx, at, "CWE-613", "grants cannot be stored in collections; a grant must not outlive the request that obtained it");
        }
        check_type(c, at, el, false);
    }
}

bool contains_grant(Type t) {
    if (t.k == TY_GRANT) { return true; }
    for (int i = 0; i < t.args.len(); i += 1) {
        if (contains_grant(t.args[i])) { return true; }
    }
    return false;
}

void mismatch(Checker c, Node at, Type from, Type to, string where) {
    if (from.k == TY_TAINT && to.k == TY_STR) {
        error_at(c.ctx, at, "CWE-20", "untrusted input (Tainted) used as a trusted string in " + where + "; pass it through a validator or escaper first");
    } else if ((from.k == TY_HTML || from.k == TY_LOG) && to.k == TY_STR) {
        error_at(c.ctx, at, "CWE-116", "text escaped as " + type_str(from) + " is only safe where " + type_str(from) + " is expected, not as a plain string in " + where);
    } else if (from.k == TY_SECRET) {
        error_at(c.ctx, at, "CWE-200", "a Secret cannot be used as " + type_str(to) + " in " + where);
    } else if (from.k == TY_OPT && type_eq(from.args[0], to)) {
        error_at(c.ctx, at, "CWE-476", "value may be none in " + where + "; unwrap it with if (let x = ...)");
    } else {
        error_at(c.ctx, at, "", "type mismatch in " + where + ": expected " + type_str(to) + ", found " + type_str(from));
    }
}

void expect_type(Checker c, Node at, Type from, Type to, string where) {
    if (!assignable(from, to)) { mismatch(c, at, from, to, where); }
}

bool looks_secret(string name) {
    string l = lower(name);
    return contains(l, "password") || contains(l, "passwd") || contains(l, "secret") || contains(l, "apikey")
        || contains(l, "api_key") || contains(l, "token") || contains(l, "private_key") || contains(l, "credential");
}

bool looks_password(string name) {
    string l = lower(name);
    return contains(l, "password") || contains(l, "passwd") || contains(l, "passphrase") || contains(l, "pwd") || l == "pw" || l == "pass";
}

// Does the expression mention a variable or field whose name passes `kind`?
// kind 1: credential-like (looks_secret); kind 2: password-like.
bool mentions_name(Node e, int kind) {
    if (e.k == N_VAR || e.k == N_GETF) {
        if (kind == 1 && looks_secret(e.s)) { return true; }
        if (kind == 2 && (looks_password(e.s))) { return true; }
    }
    if (e.k == N_CALL || e.k == N_METHOD) { return false; }
    for (int i = 0; i < e.kids.len(); i += 1) {
        if (mentions_name(e.kids[i], kind)) { return true; }
    }
    return false;
}

// A credential prefix followed by at least 8 more characters (a bare prefix is not a key).
bool starts(string s, string p) {
    return s.len() >= p.len() + 8 && s.slice(0, p.len()) == p;
}

bool all_in(string s, int from, int to, string allowed) {
    for (int i = from; i < to; i += 1) {
        bool found = false;
        for (int j = 0; j < allowed.len(); j += 1) {
            if (s.at(i) == allowed.at(j)) { found = true; }
        }
        if (!found) { return false; }
    }
    return true;
}

// Known credential formats, as secret scanners recognise them.
string credential_format(string s) {
    string upper_digits = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    if (starts(s, "sk_live_") || starts(s, "rk_live_")) { return "payment API key"; }
    if (s.len() == 20 && (starts(s, "AKIA") || starts(s, "ASIA")) && all_in(s, 4, 20, upper_digits)) { return "cloud access key"; }
    if (starts(s, "ghp_") || starts(s, "gho_") || starts(s, "ghs_") || starts(s, "github_pat_")) { return "source-hosting token"; }
    if (starts(s, "xoxb-") || starts(s, "xoxp-") || starts(s, "xoxa-")) { return "chat-platform token"; }
    if (s.len() == 39 && starts(s, "AIza")) { return "web API key"; }
    if (s.len() > 10 && s.slice(0, 10) == "-----BEGIN" && contains(s, "PRIVATE KEY")) { return "private key"; }
    return "";
}

void check_literal(Checker c, Node e) {
    string kind = credential_format(e.s);
    if (kind != "") {
        error_at(c.ctx, e, "CWE-798", "string literal looks like a hard-coded credential (" + kind + "); load it with secret_env(\"NAME\")");
    }
}

// Like mentions_name, but also looks inside call arguments (escape_html(password)).
bool mentions_deep(Node e, int kind) {
    if (e.k == N_VAR || e.k == N_GETF) {
        if (kind == 1 && looks_secret(e.s)) { return true; }
        if (kind == 2 && looks_password(e.s)) { return true; }
    }
    for (int i = 0; i < e.kids.len(); i += 1) {
        if (mentions_deep(e.kids[i], kind)) { return true; }
    }
    return false;
}

void check_hardcoded(Checker c, Node at, string name, Node value) {
    if (value.k == N_STR && value.n > 0 && looks_secret(name)) {
        error_at(c.ctx, at, "CWE-798", "hard-coded credential in '" + name + "'; load it with secret_env(\"NAME\") instead");
    }
}

// ---- expressions ----------------------------------------------------------------

List<string> field_names(Checker c, string sname, int requester_file) {
    List<string> out = new List<string>();
    if (let st = c.structs.get(sname)) {
        for (int i = 0; i < st.kids.len(); i += 1) {
            Node fd = st.kids[i];
            if (fd.s2 != "private" || requester_file == st.file) { out.push(fd.s); }
        }
    }
    return out;
}

Node? field_decl(Checker c, string sname, string fname) {
    if (let st = c.structs.get(sname)) {
        for (int i = 0; i < st.kids.len(); i += 1) {
            if (st.kids[i].s == fname) { return st.kids[i]; }
        }
    }
    return none;
}

Type? field_type(Checker c, string sname, string fname) {
    if (let fd = field_decl(c, sname, fname)) { return ty_of(fd); }
    return none;
}

List<string> visible_names(Checker c) {
    List<string> out = new List<string>();
    for (int i = 0; i < c.depth; i += 1) {
        List<string> ks = c.scopes[i].keys();
        for (int j = 0; j < ks.len(); j += 1) { out.push(ks[j]); }
    }
    List<string> cs = c.const_types.keys();
    for (int k = 0; k < cs.len(); k += 1) { out.push(cs[k]); }
    return out;
}

// Name.Variant or Name.Variant(values): is the receiver an enum name?
bool is_enum_ref(Checker c, Node recv) {
    if (recv.k != N_VAR || !c.enums.has(recv.s)) { return false; }
    if (let _l = find_local(c, recv.s)) { return false; }
    return true;
}

Type check_enum_value(Checker c, Node e, int first) {
    string ename = e.kids[0].s;
    if (let en = c.enums.get(ename)) {
        List<string> names = new List<string>();
        for (int i = 0; i < en.kids.len(); i += 1) {
            Node v = en.kids[i];
            names.push(v.s);
            if (v.s == e.s) {
                List<Node> args = new List<Node>();
                for (int j = first; j < e.kids.len(); j += 1) { args.push(e.kids[j]); }
                e.k = N_ENUMVAL;
                e.s2 = ename;
                e.n = i;
                e.kids = args;
                if (args.len() != v.kids.len()) {
                    error_at(c.ctx, e, "", ename + "." + v.s + " takes " + int_to_str(v.kids.len()) + " value(s), found " + int_to_str(args.len()));
                    return mk_type(TY_ERR);
                }
                for (int a = 0; a < args.len(); a += 1) {
                    expect_type(c, args[a], check_expr(c, args[a]), ty_of(v.kids[a]), ename + "." + v.s + " value " + int_to_str(a + 1));
                }
                return mk_named(TY_ENUM, ename);
            }
        }
        error_at(c.ctx, e, "", "enum " + ename + " has no variant '" + e.s + "'" + suggest(e.s, names));
    }
    return mk_type(TY_ERR);
}

bool simple_enum(Checker c, string name) {
    if (let en = c.enums.get(name)) {
        for (int i = 0; i < en.kids.len(); i += 1) {
            if (en.kids[i].kids.len() > 0) { return false; }
        }
        return true;
    }
    return false;
}

Type check_expr(Checker c, Node e) {
    int k = e.k;
    if (k == N_INT) { return typed(e, mk_type(TY_INT)); }
    if (k == N_STR) {
        check_literal(c, e);
        return typed(e, mk_type(TY_STR));
    }
    if (k == N_BOOL) { return typed(e, mk_type(TY_BOOL)); }
    if (k == N_NONE) { return typed(e, mk_type(TY_NONE)); }
    if (k == N_VAR) {
        if (let lt = lookup_local(c, e.s)) { return typed(e, lt); }
        if (let ct = c.const_types.get(e.s)) {
            e.n = 1;
            return typed(e, ct);
        }
        if (c.enums.has(e.s)) {
            error_at(c.ctx, e, "", "'" + e.s + "' is an enum; write " + e.s + ".Variant");
            return typed(e, mk_type(TY_ERR));
        }
        error_at(c.ctx, e, "", "unknown variable '" + e.s + "'" + suggest(e.s, visible_names(c)));
        return typed(e, mk_type(TY_ERR));
    }
    if (k == N_NOT) {
        expect_type(c, e, check_expr(c, e.kids[0]), mk_type(TY_BOOL), "'!'");
        return typed(e, mk_type(TY_BOOL));
    }
    if (k == N_NEG) {
        expect_type(c, e, check_expr(c, e.kids[0]), mk_type(TY_INT), "unary '-'");
        return typed(e, mk_type(TY_INT));
    }
    if (k == N_BNOT) {
        Type bt = check_expr(c, e.kids[0]);
        if (bt.k == TY_BOOL) {
            error_at(c.ctx, e, "CWE-480", "'~' is the bitwise complement of an int; for a bool use '!'");
        } else {
            expect_type(c, e, bt, mk_type(TY_INT), "'~'");
        }
        return typed(e, mk_type(TY_INT));
    }
    if (k == N_BIN) { return typed(e, check_binary(c, e)); }
    if (k == N_GETF && is_enum_ref(c, e.kids[0])) { return typed(e, check_enum_value(c, e, 1)); }
    if (k == N_METHOD && is_enum_ref(c, e.kids[0])) { return typed(e, check_enum_value(c, e, 1)); }
    if (k == N_GETF) {
        Type ot = check_expr(c, e.kids[0]);
        if (ot.k == TY_OPT) {
            error_at(c.ctx, e, "CWE-476", "field '" + e.s + "' read through a value that may be none; unwrap it with if (let x = ...)");
            return typed(e, mk_type(TY_ERR));
        }
        if (ot.k != TY_STRUCT) {
            if (ot.k != TY_ERR) { error_at(c.ctx, e, "", "'" + type_str(ot) + "' has no field '" + e.s + "'"); }
            return typed(e, mk_type(TY_ERR));
        }
        if (let sst = c.structs.get(ot.name)) {
            if (sst.s2 == "sensitive" && !c.privileged) {
                error_at(c.ctx, e, "CWE-862", ot.name + " is sensitive: its fields can only be read or changed in protected functions, policies and tests (field '" + e.s + "')");
                return typed(e, mk_type(TY_ERR));
            }
        }
        if (let fd = field_decl(c, ot.name, e.s)) {
            if (fd.s2 == "private") {
                if (let owner = c.structs.get(ot.name)) {
                    if (e.file != owner.file) {
                        error_at(c.ctx, e, "CAP-PRIVATE", "private field '" + e.s + "' of " + ot.name + " is accessible only within its defining module");
                        return typed(e, mk_type(TY_ERR));
                    }
                }
            }
            return typed(e, ty_of(fd));
        }
        error_at(c.ctx, e, "", "struct " + ot.name + " has no field '" + e.s + "'" + suggest(e.s, field_names(c, ot.name, e.file)));
        return typed(e, mk_type(TY_ERR));
    }
    if (k == N_INDEX) {
        Type lt2 = check_expr(c, e.kids[0]);
        expect_type(c, e, check_expr(c, e.kids[1]), mk_type(TY_INT), "index");
        if (lt2.k == TY_LIST) { return typed(e, lt2.args[0]); }
        if (lt2.k == TY_OPT) {
            error_at(c.ctx, e, "CWE-476", "indexing a value that may be none; unwrap it with if (let x = ...)");
        } else if (lt2.k == TY_STR || lt2.k == TY_TAINT) {
            error_at(c.ctx, e, "", "strings are indexed with .at(i)");
        } else if (lt2.k != TY_ERR) {
            error_at(c.ctx, e, "", "cannot index a value of type " + type_str(lt2));
        }
        return typed(e, mk_type(TY_ERR));
    }
    if (k == N_METHOD) { return typed(e, check_method(c, e)); }
    if (k == N_CALL) { return typed(e, check_call(c, e)); }
    if (k == N_NEW) { return typed(e, check_new(c, e)); }
    if (k == N_NEWLIST || k == N_NEWMAP) {
        Type nt = ty_of(e);
        check_type(c, e, nt, false);
        return nt;
    }
    if (k == N_ENUMVAL) {
        for (int ev = 0; ev < e.kids.len(); ev += 1) { check_expr(c, e.kids[ev]); }
        return typed(e, mk_named(TY_ENUM, e.s2));
    }
    if (k == N_AUTHORIZE) {
        if (let pol = c.policies.get(e.s)) {
            check_args(c, e, pol, 0, "authorize " + e.s);
            return typed(e, mk_wrap(TY_OPT, mk_named(TY_GRANT, e.s)));
        }
        error_at(c.ctx, e, "", "unknown policy '" + e.s + "'");
        return typed(e, mk_type(TY_ERR));
    }
    error_at(c.ctx, e, "", "unsupported expression");
    return typed(e, mk_type(TY_ERR));
}

bool security_name(Node e) {
    if (e.k != N_VAR && e.k != N_GETF) { return false; }
    string l = lower(e.s);
    return contains(l, "role") || contains(l, "level") || contains(l, "permission") || contains(l, "privilege")
        || contains(l, "clearance") || contains(l, "access") || contains(l, "rank");
}

// A shift count written as a literal (possibly negated) that is outside 0..63.
bool bad_literal_count(Node n) {
    if (n.k == N_INT) { return n.n < 0 || n.n > 63; }
    return n.k == N_NEG && n.kids[0].k == N_INT && n.kids[0].n != 0;
}

string literal_text(Node n) {
    if (n.k == N_NEG) { return "-" + int_to_str(n.kids[0].n); }
    return int_to_str(n.n);
}

bool is_bitwise(string op) {
    return op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>";
}

// C's precedence for bitwise operators is a classic source of bugs (in C,
// x & 1 == 0 means x & (1 == 0)). Capstan sidesteps it: a bitwise or shift
// operator may not be combined with any other operator without parentheses.
// Chains of one associative operator (a | b | c) are fine.
void check_bitwise_grouping(Checker c, Node e) {
    for (int k = 0; k < 2; k += 1) {
        Node side = e.kids[k];
        if (side.k != N_BIN || side.s2 == "()") { continue; }
        bool mixed = false;
        if (is_bitwise(e.s) || is_bitwise(side.s)) {
            mixed = side.s != e.s || e.s == "<<" || e.s == ">>" || e.s == ">>>";
        }
        if (mixed) {
            error_at(c.ctx, side, "CWE-783", "'" + side.s + "' combined with '" + e.s + "' needs parentheses; Capstan does not rely on the precedence of bitwise operators");
        }
    }
}

// ---- HTML contexts (CWE-79) ----------------------------------------------------
//
// escape_html() makes text safe in element content and inside a quoted attribute value. It does
// not make it safe in an unquoted attribute, a URL or event-handler attribute, or a script,
// style or comment block. When escaped text is joined to literal HTML in one expression, the
// literal text before it is parsed to find its context. Html built in separate statements is
// not followed (a documented limit in the CWE atlas).

bool is_escape_html(Node e) {
    return e.k == N_CALL && e.s == "escape_html";
}

// String literals are stored escaped for C; undo the escapes that matter here.
string c_unescape(string s) {
    string out = "";
    int i = 0;
    while (i < s.len()) {
        int ch = s.at(i);
        if (ch == '\\' && i + 1 < s.len()) {
            int nx = s.at(i + 1);
            if (nx >= '0' && nx <= '7') {
                out = out + "?";
                i += 4;
            } else {
                out = out + s.slice(i + 1, i + 2);
                i += 2;
            }
        } else {
            out = out + s.slice(i, i + 1);
            i += 1;
        }
    }
    return out;
}

// The text an HTML expression produces before its last part: literals as written, anything
// else as neutral text.
string html_prefix(Node e) {
    if (e.k == N_STR) { return c_unescape(e.s); }
    if (e.k == N_BIN && e.s == "+") { return html_prefix(e.kids[0]) + html_prefix(e.kids[1]); }
    return "x";
}

string lower_ascii(string s) {
    string out = "";
    for (int i = 0; i < s.len(); i += 1) {
        int ch = s.at(i);
        if (ch >= 'A' && ch <= 'Z') { out = out + char_str(ch + 32); } else { out = out + s.slice(i, i + 1); }
    }
    return out;
}

int last_index(string s, string needle) {
    int found = -1;
    for (int i = 0; i + needle.len() <= s.len(); i += 1) {
        if (s.slice(i, i + needle.len()) == needle) { found = i; }
    }
    return found;
}

bool is_name_ch(int ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '_' || ch == ':';
}

// Why text appended after `prefix` is not in a context escape_html() protects, or "" if it is.
string html_context(string prefix) {
    string p = lower_ascii(prefix);
    if (last_index(p, "<script") > last_index(p, "</script")) { return "inside a <script> element"; }
    if (last_index(p, "<style") > last_index(p, "</style")) { return "inside a <style> element"; }
    if (last_index(p, "<!--") > last_index(p, "-->")) { return "inside an HTML comment"; }
    int lt = last_index(p, "<");
    if (lt <= last_index(p, ">")) { return ""; }
    // Inside a tag: find whether the end is within a quoted attribute value, and which.
    int quote = 0;
    int qstart = -1;
    for (int i = lt + 1; i < p.len(); i += 1) {
        int ch = p.at(i);
        if (quote == 0 && (ch == '"' || ch == '\'')) {
            quote = ch;
            qstart = i;
        } else if (quote != 0 && ch == quote) {
            quote = 0;
        }
    }
    if (quote == 0) { return "inside a tag but not inside a quoted attribute value"; }
    int k = qstart - 1;
    while (k > lt && p.at(k) == ' ') { k -= 1; }
    if (k <= lt || p.at(k) != '=') { return "inside a tag but not inside a quoted attribute value"; }
    k -= 1;
    while (k > lt && p.at(k) == ' ') { k -= 1; }
    int nend = k + 1;
    while (k > lt && is_name_ch(p.at(k))) { k -= 1; }
    string attr = p.slice(k + 1, nend);
    if (attr.len() > 2 && attr.slice(0, 2) == "on") { return "in the event-handler attribute '" + attr + "'"; }
    List<string> urls = new List<string>();
    urls.push("href"); urls.push("src"); urls.push("action"); urls.push("formaction"); urls.push("srcdoc"); urls.push("style");
    urls.push("xlink:href"); urls.push("data"); urls.push("poster"); urls.push("background"); urls.push("cite"); urls.push("codebase");
    urls.push("ping"); urls.push("manifest"); urls.push("lowsrc"); urls.push("srcset"); urls.push("dynsrc"); urls.push("longdesc");
    urls.push("usemap"); urls.push("xmlns"); urls.push("archive"); urls.push("classid"); urls.push("profile"); urls.push("http-equiv");
    for (int u = 0; u < urls.len(); u += 1) {
        if (attr == urls[u]) { return "in the URL or style attribute '" + attr + "'"; }
    }
    return "";
}

Type check_binary(Checker c, Node e) {
    string op = e.s;
    Type a = check_expr(c, e.kids[0]);
    Type b = check_expr(c, e.kids[1]);
    if (a.k == TY_ERR || b.k == TY_ERR) { return mk_type(TY_ERR); }
    check_bitwise_grouping(c, e);
    if (is_bitwise(op)) {
        if ((op == "&" || op == "|" || op == "^") && (a.k == TY_BOOL || b.k == TY_BOOL)) {
            string logical = "&&";
            if (op == "|") { logical = "||"; }
            if (op == "^") { logical = "!="; }
            error_at(c.ctx, e, "CWE-480", "'" + op + "' is a bitwise operator on ints; for booleans use '" + logical + "'");
            return mk_type(TY_ERR);
        }
        if (a.k != TY_INT || b.k != TY_INT) {
            error_at(c.ctx, e, "", "'" + op + "' needs int operands, found " + type_str(a) + " and " + type_str(b));
            return mk_type(TY_ERR);
        }
        if (op != "&" && op != "|" && op != "^" && bad_literal_count(e.kids[1])) {
            error_at(c.ctx, e, "CWE-1335", "shift count " + literal_text(e.kids[1]) + " is outside 0..63");
        }
        return mk_type(TY_INT);
    }
    if (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=") {
        for (int mk = 0; mk < 2; mk += 1) {
            Node lit = e.kids[mk];
            Node other = e.kids[1 - mk];
            if (lit.k == N_INT && lit.n > 1 && security_name(other)) {
                warn_at(c.ctx, e, "CWE-547", "security decision on the magic number " + int_to_str(lit.n) + "; give it a name with an enum");
            }
        }
    }
    if (op == "||") {
        for (int pk = 0; pk < 2; pk += 1) {
            Node side = e.kids[pk];
            if (side.k == N_BIN && side.s == "&&" && side.s2 != "()") {
                warn_at(c.ctx, side, "CWE-783", "'&&' inside '||' without parentheses; add them to make the intended grouping explicit");
            }
        }
    }
    if (op == "&&" || op == "||") {
        expect_type(c, e, a, mk_type(TY_BOOL), "'" + op + "'");
        expect_type(c, e, b, mk_type(TY_BOOL), "'" + op + "'");
        return mk_type(TY_BOOL);
    }
    if (a.k == TY_SECRET || b.k == TY_SECRET) {
        if (op == "==" || op == "!=") {
            error_at(c.ctx, e, "CWE-208", "comparing a Secret with '" + op + "' leaks timing information; use secret_eq()");
        } else {
            error_at(c.ctx, e, "CWE-200", "a Secret cannot be used with '" + op + "'");
        }
        return mk_type(TY_ERR);
    }
    if (a.k == TY_OPT || b.k == TY_OPT) {
        error_at(c.ctx, e, "CWE-476", "operand of '" + op + "' may be none; unwrap it with if (let x = ...)");
        return mk_type(TY_ERR);
    }
    if ((op == "==" || op == "!=") && a.k == TY_ENUM) {
        if (!type_eq(a, b)) {
            error_at(c.ctx, e, "", "cannot compare " + type_str(a) + " with " + type_str(b));
        } else if (!simple_enum(c, a.name)) {
            error_at(c.ctx, e, "", "enum " + a.name + " carries values, so it cannot be compared with '" + op + "'; use match");
        }
        return mk_type(TY_BOOL);
    }
    if (op == "==" || op == "!=") {
        bool ok = (a.k == TY_INT && b.k == TY_INT) || (a.k == TY_BOOL && b.k == TY_BOOL) || (is_stringish(a) && is_stringish(b));
        if (!ok) { error_at(c.ctx, e, "", "cannot compare " + type_str(a) + " with " + type_str(b)); }
        if (ok && is_stringish(a) && (mentions_name(e.kids[0], 1) || mentions_name(e.kids[1], 1) || mentions_name(e.kids[0], 2) || mentions_name(e.kids[1], 2))) {
            error_at(c.ctx, e, "CWE-208", "comparing credentials with '" + op + "' leaks timing information; load them as Secret and use secret_eq(), or store hashes and use verify_password()");
        }
        return mk_type(TY_BOOL);
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        if (a.k != TY_INT || b.k != TY_INT) { error_at(c.ctx, e, "", "'" + op + "' needs int operands"); }
        return mk_type(TY_BOOL);
    }
    if (op == "+" && is_texty(a) && is_texty(b) && (a.k == TY_HTML || b.k == TY_HTML || a.k == TY_LOG || b.k == TY_LOG)) {
        int ctx_k = TY_HTML;
        string ctx_name = "Html";
        string esc = "escape_html()";
        if (a.k == TY_LOG || b.k == TY_LOG) { ctx_k = TY_LOG; ctx_name = "LogText"; esc = "escape_log()"; }
        if ((a.k == TY_HTML && b.k == TY_LOG) || (a.k == TY_LOG && b.k == TY_HTML)) {
            error_at(c.ctx, e, "CWE-116", "text escaped for HTML and text escaped for logs cannot be combined");
            return mk_type(TY_ERR);
        }
        if (a.k == TY_TAINT || b.k == TY_TAINT) {
            error_at(c.ctx, e, "CWE-116", "untrusted input cannot be joined to " + ctx_name + " unescaped; wrap it in " + esc);
            return mk_type(TY_ERR);
        }
        if (ctx_k == TY_HTML && is_escape_html(e.kids[1])) {
            string why = html_context(html_prefix(e.kids[0]));
            if (why != "") {
                error_at(c.ctx, e.kids[1], "CWE-79", "escape_html() output lands " + why + ", where HTML escaping does not stop script injection; use it only in element text or a quoted, non-URL, non-event attribute");
            }
        }
        return mk_type(ctx_k);
    }
    if (op == "+" && is_stringish(a) && is_stringish(b)) {
        if (a.k == TY_TAINT || b.k == TY_TAINT) { return mk_type(TY_TAINT); }
        return mk_type(TY_STR);
    }
    if (a.k != TY_INT || b.k != TY_INT) {
        error_at(c.ctx, e, "", "'" + op + "' needs int operands, found " + type_str(a) + " and " + type_str(b));
        return mk_type(TY_ERR);
    }
    if ((op == "/" || op == "%") && e.kids[1].k == N_INT && e.kids[1].n == 0) {
        error_at(c.ctx, e, "CWE-369", "division by zero");
    }
    return mk_type(TY_INT);
}

// Programs that execute their arguments: shells, interpreters, and launchers that run another
// program named in their arguments. The name is matched without its directory or ".exe".
bool is_launcher(string prog) {
    int start = 0;
    for (int i = 0; i < prog.len(); i += 1) {
        if (prog.at(i) == '/' || prog.at(i) == '\\') { start = i + 1; }
    }
    string p = prog.slice(start, prog.len());
    if (p.len() > 4 && p.slice(p.len() - 4, p.len()) == ".exe") { p = p.slice(0, p.len() - 4); }
    List<string> exact = new List<string>();
    exact.push("sh"); exact.push("bash"); exact.push("dash"); exact.push("zsh"); exact.push("ksh"); exact.push("mksh");
    exact.push("csh"); exact.push("tcsh"); exact.push("fish"); exact.push("ash"); exact.push("busybox"); exact.push("cmd");
    exact.push("powershell"); exact.push("pwsh"); exact.push("env"); exact.push("xargs"); exact.push("nohup"); exact.push("nice");
    exact.push("timeout"); exact.push("stdbuf"); exact.push("setsid"); exact.push("sudo"); exact.push("doas"); exact.push("su");
    exact.push("runuser"); exact.push("chroot"); exact.push("ssh"); exact.push("rsh"); exact.push("watch"); exact.push("time");
    exact.push("strace"); exact.push("ltrace"); exact.push("gdb"); exact.push("flock"); exact.push("unshare"); exact.push("nsenter");
    exact.push("node"); exact.push("nodejs"); exact.push("deno"); exact.push("bun"); exact.push("tclsh"); exact.push("wish");
    exact.push("awk"); exact.push("gawk"); exact.push("mawk"); exact.push("nawk"); exact.push("sed"); exact.push("find");
    exact.push("make"); exact.push("osascript"); exact.push("wscript"); exact.push("cscript"); exact.push("mshta");
    exact.push("rundll32"); exact.push("regsvr32"); exact.push("at"); exact.push("batch"); exact.push("crontab"); exact.push("expect");
    exact.push("script"); exact.push("docker"); exact.push("podman"); exact.push("kubectl"); exact.push("systemd-run");
    exact.push("pkexec"); exact.push("eval"); exact.push("exec"); exact.push("command"); exact.push("start");
    for (int k = 0; k < exact.len(); k += 1) {
        if (p == exact[k]) { return true; }
    }
    List<string> prefix = new List<string>();
    prefix.push("python"); prefix.push("perl"); prefix.push("ruby"); prefix.push("php"); prefix.push("lua"); prefix.push("pypy");
    for (int q = 0; q < prefix.len(); q += 1) {
        string pre = prefix[q];
        if (p.len() >= pre.len() && p.slice(0, pre.len()) == pre) { return true; }
    }
    return false;
}

int arg_count(Node e) {
    return e.kids.len();
}

void want_args(Checker c, Node e, int first, int count, string name) {
    if (e.kids.len() - first != count) {
        error_at(c.ctx, e, "", name + " expects " + int_to_str(count) + " argument(s), found " + int_to_str(e.kids.len() - first));
    }
}

List<string> method_names(Checker c, string sname) {
    List<string> out = new List<string>();
    List<string> fs = c.fns.keys();
    string prefix = sname + "__";
    for (int i = 0; i < fs.len(); i += 1) {
        if (fs[i].len() > prefix.len() && fs[i].slice(0, prefix.len()) == prefix) { out.push(fs[i].slice(prefix.len(), fs[i].len())); }
    }
    return out;
}

Type check_method(Checker c, Node e) {
    Type rt = check_expr(c, e.kids[0]);
    if (rt.k == TY_STRUCT) {
        string mangled = rt.name + "__" + e.s;
        if (c.fns.has(mangled)) {
            e.k = N_CALL;
            e.s = mangled;
            return check_call(c, e);
        }
        error_at(c.ctx, e, "", "struct " + rt.name + " has no method '" + e.s + "'" + suggest(e.s, method_names(c, rt.name)));
        return mk_type(TY_ERR);
    }
    for (int i = 1; i < e.kids.len(); i += 1) { check_expr(c, e.kids[i]); }
    string m = e.s;
    if (rt.k == TY_ERR) { return rt; }
    if (rt.k == TY_OPT) {
        error_at(c.ctx, e, "CWE-476", "method '" + m + "' called on a value that may be none; unwrap it with if (let x = ...)");
        return mk_type(TY_ERR);
    }
    if (rt.k == TY_SECRET) {
        error_at(c.ctx, e, "CWE-200", "a Secret exposes no methods; its contents cannot be read");
        return mk_type(TY_ERR);
    }
    if (is_stringish(rt)) {
        if (m == "len") { want_args(c, e, 1, 0, "len"); return mk_type(TY_INT); }
        if (m == "at") {
            want_args(c, e, 1, 1, "at");
            if (e.kids.len() == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), "at()"); }
            return mk_type(TY_INT);
        }
        if (m == "slice") {
            want_args(c, e, 1, 2, "slice");
            for (int j = 1; j < e.kids.len(); j += 1) { expect_type(c, e, ty_of(e.kids[j]), mk_type(TY_INT), "slice()"); }
            return rt;
        }
    }
    if (rt.k == TY_LIST) {
        Type el = rt.args[0];
        if (m == "len") { want_args(c, e, 1, 0, "len"); return mk_type(TY_INT); }
        if (m == "pop") { want_args(c, e, 1, 0, "pop"); return mk_wrap(TY_OPT, el); }
        if (m == "clear") { want_args(c, e, 1, 0, "clear"); return mk_type(TY_VOID); }
        if (m == "remove_at") {
            want_args(c, e, 1, 1, "remove_at");
            if (e.kids.len() == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), "remove_at()"); }
            return el;
        }
        if (m == "insert") {
            want_args(c, e, 1, 2, "insert");
            if (e.kids.len() == 3) {
                expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), "insert() position");
                expect_type(c, e, ty_of(e.kids[2]), el, "insert()");
            }
            return mk_type(TY_VOID);
        }
        if (m == "sort") {
            want_args(c, e, 1, 0, "sort");
            if (el.k != TY_INT && el.k != TY_STR) { error_at(c.ctx, e, "", "sort() needs List<int> or List<string>"); }
            return mk_type(TY_VOID);
        }
        if (m == "push") {
            want_args(c, e, 1, 1, "push");
            if (e.kids.len() == 2) { expect_type(c, e, ty_of(e.kids[1]), el, "push()"); }
            return mk_type(TY_VOID);
        }
    }
    if (rt.k == TY_MAP) {
        Type mv = rt.args[0];
        if (m == "get" || m == "has") {
            want_args(c, e, 1, 1, m);
            if (e.kids.len() == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_STR), m + "()"); }
            if (m == "has") { return mk_type(TY_BOOL); }
            return mk_wrap(TY_OPT, mv);
        }
        if (m == "set") {
            want_args(c, e, 1, 2, "set");
            if (e.kids.len() == 3) {
                expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_STR), "set()");
                expect_type(c, e, ty_of(e.kids[2]), mv, "set()");
            }
            return mk_type(TY_VOID);
        }
        if (m == "keys") { want_args(c, e, 1, 0, "keys"); return mk_wrap(TY_LIST, mk_type(TY_STR)); }
        if (m == "remove") {
            want_args(c, e, 1, 1, "remove");
            if (e.kids.len() == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_STR), "remove()"); }
            return mk_type(TY_BOOL);
        }
    }
    error_at(c.ctx, e, "", type_str(rt) + " has no method '" + m + "'");
    return mk_type(TY_ERR);
}

// Check user-function or policy arguments starting at kid `first`.
void check_args(Checker c, Node e, Node callee, int first, string what) {
    for (int i = first; i < e.kids.len(); i += 1) { check_expr(c, e.kids[i]); }
    int np = callee.n;
    if (e.kids.len() - first != np) {
        error_at(c.ctx, e, "", what + " expects " + int_to_str(np) + " argument(s), found " + int_to_str(e.kids.len() - first));
        return;
    }
    for (int j = 0; j < np; j += 1) {
        Node arg = e.kids[first + j];
        expect_type(c, arg, ty_of(arg), ty_of(callee.kids[j]), "argument " + int_to_str(j + 1) + " of " + what);
    }
}

List<string> builtin_names() {
    List<string> b = new List<string>();
    b.push("print"); b.push("println"); b.push("int_to_str"); b.push("char_str"); b.push("read_file");
    b.push("read_line"); b.push("write_file"); b.push("args"); b.push("exit"); b.push("join"); b.push("assert");
    b.push("validate_ident"); b.push("validate_int"); b.push("escape_c"); b.push("escape_html"); b.push("escape_log");
    b.push("trust"); b.push("taint"); b.push("sql_query"); b.push("run"); b.push("secret_env"); b.push("secret_eq");
    b.push("hash"); b.push("hash_verify"); b.push("hash_password"); b.push("verify_password"); b.push("needs_rehash");
    b.push("escape_csv"); b.push("validate_path"); b.push("validate_range"); b.push("to_text");
    b.push("wrapping_add"); b.push("wrapping_sub"); b.push("wrapping_mul"); b.push("wrapping_shl");
    b.push("read_bytes"); b.push("flush"); b.push("escape_json"); b.push("taint_char");
    return b;
}

string banned_hint(string name) {
    if (name == "md5" || name == "sha1" || name == "des" || name == "rc4" || name == "crc32") {
        return "CWE-327|weak cryptographic primitive '" + name + "' does not exist in Capstan; use hash(), or hash_password() for passwords";
    }
    if (name == "system" || name == "popen" || name == "exec" || name == "shell" || name == "execl") {
        return "CWE-78|there is no shell execution in Capstan; use run(\"program\", args...) which never invokes a shell";
    }
    if (name == "eval") { return "CWE-95|Capstan has no eval"; }
    if (name == "printf" || name == "sprintf" || name == "fprintf") {
        return "CWE-134|Capstan has no format strings; build text with + and print()";
    }
    if (name == "gets" || name == "strcpy" || name == "strcat" || name == "memcpy") {
        return "CWE-120|unchecked buffer copies do not exist in Capstan; strings and lists are bounds-checked";
    }
    if (name == "malloc" || name == "free" || name == "realloc") {
        return "CWE-415|manual memory management does not exist in Capstan; memory is managed for you";
    }
    if (name == "rand" || name == "random") {
        return "CWE-338|predictable random numbers are not available; a secure random API is on the roadmap";
    }
    return "";
}

bool is_literal_str(Node e) {
    return e.k == N_STR;
}
// Node.s stores the C-escaped literal body, not its decoded bytes. The lexer
// encodes a NUL byte as the three-digit octal escape \000. Skip escaped
// backslashes/quotes/question marks so a literal backslash followed by "000"
// is not mistaken for an embedded NUL.
bool literal_has_nul(Node e) {
    int i = 0;
    while (i < e.s.len()) {
        if (e.s.at(i) != '\\') {
            i += 1;
            continue;
        }
        i += 1;
        if (i + 2 < e.s.len() && e.s.at(i) == '0' &&
            e.s.at(i + 1) == '0' && e.s.at(i + 2) == '0') {
            return true;
        }
        i += 1;
    }
    return false;
}

// Arguments for print-like and storage sinks: anything stringish, but never secrets.
void sink_string(Checker c, Node arg, string what, bool allow_tainted) {
    Type t = ty_of(arg);
    if (t.k == TY_TAINT && !allow_tainted) {
        error_at(c.ctx, arg, "CWE-117", "untrusted input passed to " + what + " can forge output or log lines; wrap it in escape_log()");
        return;
    }
    if (t.k == TY_SECRET) {
        error_at(c.ctx, arg, "CWE-532", "a Secret cannot be written by " + what);
        return;
    }
    if (!is_texty(t)) { expect_type(c, arg, t, mk_type(TY_STR), what); }
}

Type check_call(Checker c, Node e) {
    string f = e.s;
    if (let fnode = c.fns.get(f)) {
        if (fnode.s2 != "") {
            bool granted = false;
            if (e.kids.len() > 0) {
                Type gt = check_expr(c, e.kids[0]);
                granted = gt.k == TY_GRANT && gt.name == fnode.s2;
            }
            if (!granted) {
                error_at(c.ctx, e, "CWE-862", f + "() is protected; obtain a grant with authorize " + fnode.s2 + "(...) and pass it as the first argument");
                return ty_of(fnode);
            }
        }
        check_args(c, e, fnode, 0, f + "()");
        return ty_of(fnode);
    }
    if (c.policies.has(f)) {
        error_at(c.ctx, e, "CWE-862", "policies are not called directly; use authorize " + f + "(...) to obtain a grant");
        return mk_type(TY_ERR);
    }
    for (int i = 0; i < e.kids.len(); i += 1) { check_expr(c, e.kids[i]); }
    int n = e.kids.len();
    if (f == "print" || f == "println") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { sink_string(c, e.kids[0], f + "()", false); }
        return mk_type(TY_VOID);
    }
    if (f == "to_text") {
        want_args(c, e, 0, 1, f);
        if (n == 1) {
            Type xt = ty_of(e.kids[0]);
            if (xt.k == TY_INT || xt.k == TY_BOOL) { return mk_type(TY_STR); }
            if (is_texty(xt)) { return xt; }
            if (xt.k == TY_SECRET) {
                error_at(c.ctx, e, "CWE-200", "a Secret cannot be interpolated into text");
            } else if (xt.k == TY_OPT) {
                error_at(c.ctx, e, "CWE-476", "an optional value cannot be interpolated; unwrap it with if (let x = ...)");
            } else if (xt.k != TY_ERR) {
                error_at(c.ctx, e, "", type_str(xt) + " cannot be interpolated into text");
            }
        }
        return mk_type(TY_ERR);
    }
    if (f == "wrapping_add" || f == "wrapping_sub" || f == "wrapping_mul" || f == "wrapping_shl") {
        want_args(c, e, 0, 2, f);
        if (n == 2) {
            expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_INT), f + "()");
            expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), f + "()");
            if (f == "wrapping_shl" && bad_literal_count(e.kids[1])) {
                error_at(c.ctx, e, "CWE-1335", "shift count " + literal_text(e.kids[1]) + " is outside 0..63");
            }
        }
        return mk_type(TY_INT);
    }
    if (f == "int_to_str" || f == "char_str") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_INT), f + "()"); }
        return mk_type(TY_STR);
    }
    if (f == "read_file") {
        if (n != 2) { want_args(c, e, 0, 1, f); }
        if (n >= 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_STR), "read_file() path"); }
        if (n == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), "read_file() limit"); }
        return mk_wrap(TY_OPT, mk_type(TY_TAINT));
    }
    if (f == "read_line") {
        want_args(c, e, 0, 0, f);
        return mk_wrap(TY_OPT, mk_type(TY_TAINT));
    }
    if (f == "read_bytes") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_INT), "read_bytes() count"); }
        return mk_wrap(TY_OPT, mk_type(TY_TAINT));
    }
    if (f == "flush") {
        want_args(c, e, 0, 0, f);
        return mk_type(TY_VOID);
    }
    if (f == "write_file") {
        want_args(c, e, 0, 2, f);
        if (n == 2) {
            expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_STR), "write_file() path");
            Type wt = ty_of(e.kids[1]);
            if (wt.k == TY_TAINT) {
                error_at(c.ctx, e.kids[1], "CWE-20", "untrusted input written to a file unchanged; escape it for the file's format first (escape_csv() for spreadsheets, escape_html() for web pages) or validate it");
            } else if (mentions_deep(e.kids[1], 2)) {
                error_at(c.ctx, e.kids[1], "CWE-256", "passwords must never be written out; store hash_password() of it instead");
            } else {
                sink_string(c, e.kids[1], "write_file()", true);
            }
        }
        return mk_type(TY_BOOL);
    }
    if (f == "args") { want_args(c, e, 0, 0, f); return mk_wrap(TY_LIST, mk_type(TY_STR)); }
    if (f == "exit") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_INT), "exit()"); }
        return mk_type(TY_VOID);
    }
    if (f == "join") {
        want_args(c, e, 0, 2, f);
        if (n == 2) {
            Type parts = ty_of(e.kids[0]);
            expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_STR), "join() separator");
            if (parts.k == TY_LIST && parts.args.len() == 1 && parts.args[0].k == TY_TAINT) {
                // cap_join() allocates the joined bytes once; retain the
                // untrusted type when any input part is Tainted.
                expect_type(c, e, parts, mk_wrap(TY_LIST, mk_type(TY_TAINT)), "join()");
                return mk_type(TY_TAINT);
            }
            expect_type(c, e, parts, mk_wrap(TY_LIST, mk_type(TY_STR)), "join()");
        }
        return mk_type(TY_STR);
    }
    if (f == "assert") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_BOOL), "assert()"); }
        if (!c.in_test) {
            warn_at(c.ctx, e, "CWE-617", "assert() outside a test stops the program when it fails; if input can reach it, handle the case instead");
        }
        c.asserts += 1;
        return mk_type(TY_VOID);
    }
    if (f == "validate_ident" || f == "validate_int") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_TAINT), f + "()"); }
        if (f == "validate_int") { return mk_wrap(TY_OPT, mk_type(TY_INT)); }
        return mk_wrap(TY_OPT, mk_type(TY_STR));
    }
    if (f == "taint_char") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_INT), f + "()"); }
        return mk_type(TY_TAINT);
    }
    if (f == "escape_c" || f == "escape_html" || f == "escape_log" || f == "escape_csv" || f == "escape_json") {
        want_args(c, e, 0, 1, f);
        if (n == 1 && !is_stringish(ty_of(e.kids[0]))) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_TAINT), f + "()"); }
        if (f == "escape_html") { return mk_type(TY_HTML); }
        if (f == "escape_log") { return mk_type(TY_LOG); }
        return mk_type(TY_STR);
    }
    if (f == "validate_path") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_TAINT), f + "()"); }
        return mk_wrap(TY_OPT, mk_type(TY_STR));
    }
    if (f == "validate_range") {
        want_args(c, e, 0, 3, f);
        if (n == 3) {
            expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_TAINT), f + "()");
            expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_INT), f + "() minimum");
            expect_type(c, e, ty_of(e.kids[2]), mk_type(TY_INT), f + "() maximum");
        }
        return mk_wrap(TY_OPT, mk_type(TY_INT));
    }
    if (f == "trust") {
        want_args(c, e, 0, 2, f);
        if (n == 2) {
            expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_TAINT), "trust()");
            if (!is_literal_str(e.kids[1]) || e.kids[1].n == 0) {
                error_at(c.ctx, e, "CWE-20", "trust() needs a written justification as a string literal");
            } else {
                warn_at(c.ctx, e, "AUDIT", "untrusted input explicitly trusted: \"" + e.kids[1].s + "\"");
            }
        }
        return mk_type(TY_STR);
    }
    if (f == "taint") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_STR), "taint()"); }
        return mk_type(TY_TAINT);
    }
    if (f == "sql_query" || f == "run") {
        // A shell, interpreter or launcher runs its arguments as code or as another program, so
        // passing it anything but literals is command injection by another route (CWE-78).
        bool launcher = f == "run" && n > 0 && is_literal_str(e.kids[0]) && is_launcher(e.kids[0].s);
        string cwe = "CWE-89";
        string what = "SQL query text";
        if (f == "run") { cwe = "CWE-78"; what = "program name"; }
        if (n == 0 || !is_literal_str(e.kids[0])) {
            error_at(c.ctx, e, cwe, "the " + what + " passed to " + f + "() must be a string literal; pass untrusted values as separate arguments");
        }
        bool options_ended = false;
        for (int j = 1; j < n; j += 1) {
            Type argt = ty_of(e.kids[j]);
            if (e.kids[j].k == N_STR && e.kids[j].s == "--") { options_ended = true; }
            bool literal = is_literal_str(e.kids[j]);
            if (launcher && !literal) {
                error_at(c.ctx, e.kids[j], "CWE-78", "'" + e.kids[0].s + "' runs its arguments as code or as another program; every argument to it must be a string literal. Call the program you need directly");
            } else if (f == "run" && argt.k == TY_TAINT && !options_ended) {
                error_at(c.ctx, e.kids[j], "CWE-88", "untrusted argument to run() could be read as an option (for example --upload-pack=...); put \"--\" before untrusted arguments");
            } else if (f == "run" && !literal && !options_ended) {
                error_at(c.ctx, e.kids[j], "CWE-88", "a computed argument to run() could begin with '-' and be read as an option (validated numbers can be negative); put \"--\" before computed arguments");
            }
            if (argt.k == TY_SECRET) {
                error_at(c.ctx, e.kids[j], "CWE-532", "a Secret cannot be passed to " + f + "()");
            } else if (!is_stringish(argt)) {
                expect_type(c, e.kids[j], argt, mk_type(TY_STR), f + "() argument");
            }
        }
        return mk_type(TY_VOID);
    }
    if (f == "secret_env") {
        want_args(c, e, 0, 1, f);
        if (n == 1) {
            if (!is_literal_str(e.kids[0])) {
                error_at(c.ctx, e, "", "secret_env() takes the variable name as a string literal");
            } else if (literal_has_nul(e.kids[0])) {
                error_at(c.ctx, e.kids[0], "CWE-158", "secret_env() variable name must not contain NUL");
            }
        }
        return mk_wrap(TY_OPT, mk_type(TY_SECRET));
    }
    if (f == "secret_eq") {
        want_args(c, e, 0, 2, f);
        if (n == 2) {
            expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_SECRET), "secret_eq()");
            Type bt = ty_of(e.kids[1]);
            if (bt.k != TY_SECRET && !is_stringish(bt)) { expect_type(c, e, bt, mk_type(TY_TAINT), "secret_eq()"); }
        }
        return mk_type(TY_BOOL);
    }
    if (f == "hash" || f == "hash_password" || f == "hash_verify" || f == "verify_password") {
        int want = 1;
        if (f == "hash_verify" || f == "verify_password") { want = 2; }
        want_args(c, e, 0, want, f);
        if (n >= 1) {
            Type dt = ty_of(e.kids[0]);
            if (dt.k != TY_SECRET && !is_stringish(dt)) { expect_type(c, e, dt, mk_type(TY_STR), f + "()"); }
            if (f == "hash" && dt.k == TY_SECRET) {
                error_at(c.ctx, e, "CWE-532", "hash() of a Secret gives printable text from which a short or guessable secret can be recovered by trying values offline; compare secrets with secret_eq() or hash_verify(), and store passwords with hash_password()");
            }
            if ((f == "hash" || f == "hash_verify") && mentions_name(e.kids[0], 2)) {
                error_at(c.ctx, e, "CWE-916", f + "() is a fast, unsalted hash and must not be used for passwords; use hash_password() and verify_password()");
            }
        }
        if (n == 2) { expect_type(c, e, ty_of(e.kids[1]), mk_type(TY_STR), f + "() stored hash"); }
        if (want == 2) { return mk_type(TY_BOOL); }
        return mk_type(TY_STR);
    }
    if (f == "needs_rehash") {
        want_args(c, e, 0, 1, f);
        if (n == 1) { expect_type(c, e, ty_of(e.kids[0]), mk_type(TY_STR), f + "()"); }
        return mk_type(TY_BOOL);
    }
    string hint = banned_hint(f);
    if (hint != "") {
        int bar = 0;
        while (hint.at(bar) != '|') { bar += 1; }
        error_at(c.ctx, e, hint.slice(0, bar), hint.slice(bar + 1, hint.len()));
    } else {
        List<string> fnames = c.fns.keys();
        List<string> bi = builtin_names();
        for (int b = 0; b < bi.len(); b += 1) { fnames.push(bi[b]); }
        error_at(c.ctx, e, "", "unknown function '" + f + "'" + suggest(f, fnames));
    }
    return mk_type(TY_ERR);
}

Type check_new(Checker c, Node e) {
    if (let st = c.structs.get(e.s)) {
        Map<int> seen = new Map<int>();
        for (int i = 0; i < e.kids.len(); i += 1) {
            Node init = e.kids[i];
            Type vt = check_expr(c, init.kids[0]);
            if (seen.has(init.s)) {
                error_at(c.ctx, init, "", "field '" + init.s + "' initialised twice");
            }
            seen.set(init.s, 1);
            if (let fd = field_decl(c, e.s, init.s)) {
                if (fd.s2 == "private" && init.file != st.file) {
                    error_at(c.ctx, init, "CAP-PRIVATE", "private field '" + init.s + "' of " + e.s + " may be initialised only within its defining module");
                } else {
                    expect_type(c, init, vt, ty_of(fd), "field '" + init.s + "'");
                }
                check_hardcoded(c, init, init.s, init.kids[0]);
            } else {
                error_at(c.ctx, init, "", "struct " + e.s + " has no field '" + init.s + "'");
            }
        }
        bool missing_private = false;
        for (int j = 0; j < st.kids.len(); j += 1) {
            if (!seen.has(st.kids[j].s)) {
                if (st.kids[j].s2 == "private" && e.file != st.file) {
                    missing_private = true;
                } else {
                    error_at(c.ctx, e, "CWE-908", "field '" + st.kids[j].s + "' of " + e.s + " is not initialised");
                }
            }
        }
        if (missing_private) {
            error_at(c.ctx, e, "CAP-PRIVATE", "private state of " + e.s + " must be initialised by its defining module");
        }
        return mk_named(TY_STRUCT, e.s);
    }
    error_at(c.ctx, e, "", "unknown struct '" + e.s + "'");
    return mk_type(TY_ERR);
}

// ---- statements ---------------------------------------------------------------

bool lvalue_ok(Node e) {
    if (e.k == N_VAR) { return e.n == 0; }
    if (e.k == N_GETF) { return true; }
    if (e.k == N_INDEX) { return true; }
    return false;
}

// A target that can be evaluated twice without side effects: x, x.f, xs[i], xs[i].f
bool pure_path(Node e) {
    if (e.k == N_VAR) { return true; }
    if (e.k == N_GETF) { return pure_path(e.kids[0]); }
    if (e.k == N_INDEX) { return pure_path(e.kids[0]) && is_simple_operand(e.kids[1]); }
    return false;
}

bool is_simple_operand(Node e) {
    return e.k == N_INT || e.k == N_VAR;
}

bool same_path(Node a, Node b) {
    if (a.k != b.k || a.s != b.s || a.kids.len() != b.kids.len()) { return false; }
    if (a.k == N_INT) { return a.n == b.n; }
    if (a.k != N_VAR && a.k != N_GETF && a.k != N_INDEX) { return false; }
    for (int i = 0; i < a.kids.len(); i += 1) {
        if (!same_path(a.kids[i], b.kids[i])) { return false; }
    }
    return true;
}

string lvalue_name(Node e) {
    if (e.k == N_VAR || e.k == N_GETF) { return e.s; }
    return "";
}

void check_block(Checker c, Node b) {
    push_scope(c);
    bool ended = false;
    for (int i = 0; i < b.kids.len(); i += 1) {
        if (ended) {
            warn_at(c.ctx, b.kids[i], "CWE-561", "unreachable code: this statement can never run");
            ended = false;
        }
        check_stmt(c, b.kids[i]);
        if (terminates(b.kids[i]) && i + 1 < b.kids.len()) { ended = true; }
    }
    pop_scope(c);
}

void check_stmt(Checker c, Node s) {
    int k = s.k;
    if (k == N_BLOCK) { check_block(c, s); return; }
    if (k == N_DECL) {
        Type dt = ty_of(s);
        check_type(c, s, dt, false);
        Type vt = check_expr(c, s.kids[0]);
        expect_type(c, s, vt, dt, "initialiser of '" + s.s + "'");
        check_hardcoded(c, s, s.s, s.kids[0]);
        declare(c, s, s.s, dt);
        return;
    }
    if (k == N_ASSIGN) {
        Node target = s.kids[0];
        Type tt = check_expr(c, target);
        Type rv = check_expr(c, s.kids[1]);
        if (!lvalue_ok(target)) {
            error_at(c.ctx, s, "", "cannot assign to this expression");
            return;
        }
        if (s.s != "=") {
            // Compound field assignment lowers its receiver to one temporary
            // before reading the old value and evaluating the RHS. It is safe
            // for that receiver to be effectful because the backend evaluates it
            // exactly once; indexed targets retain the stricter pure-path rule.
            if (!pure_path(target) && target.k != N_GETF) {
                error_at(c.ctx, s, "", "'" + s.s + "' needs a variable, field or simply-indexed element on the left; write x = x + v");
            }
            bool ctx_ok = s.s == "+=" && (tt.k == TY_HTML || tt.k == TY_LOG) && (rv.k == tt.k || rv.k == TY_STR);
            if (!ctx_ok && !(tt.k == TY_INT && rv.k == TY_INT) && !(s.s == "+=" && is_stringish(tt) && is_stringish(rv) && (tt.k == TY_TAINT || rv.k == TY_STR))) {
                error_at(c.ctx, s, "", "'" + s.s + "' is not defined for " + type_str(tt) + " and " + type_str(rv));
            }
            return;
        }
        expect_type(c, s, rv, tt, "assignment");
        check_hardcoded(c, s, lvalue_name(target), s.kids[1]);
        if (pure_path(target) && same_path(target, s.kids[1])) {
            warn_at(c.ctx, s, "CWE-1164", "assignment of a value to itself has no effect");
        }
        return;
    }
    if (k == N_EXPR) {
        Node ex = s.kids[0];
        Type et = check_expr(c, ex);
        if (ex.k != N_CALL && ex.k != N_METHOD && et.k != TY_ERR) {
            error_at(c.ctx, s, "", "expression result is unused");
        }
        if (ex.k == N_CALL && ex.s == "write_file") {
            warn_at(c.ctx, s, "CWE-252", "result of write_file() is ignored; check whether the write succeeded");
        }
        return;
    }
    if (k == N_IF) {
        Type ct = check_expr(c, s.kids[0]);
        if (s.n == 1) {
            if (ct.k != TY_OPT) {
                if (ct.k != TY_ERR) { error_at(c.ctx, s, "", "if (let ...) needs an optional value, found " + type_str(ct)); }
                push_scope(c);
                check_block(c, s.kids[1]);
                pop_scope(c);
            } else {
                push_scope(c);
                declare(c, s, s.s2, ct.args[0]);
                check_block(c, s.kids[1]);
                pop_scope(c);
            }
        } else {
            expect_type(c, s, ct, mk_type(TY_BOOL), "if condition");
            if (s.kids[0].k == N_BOOL) {
                if (s.kids[0].n == 1) {
                    warn_at(c.ctx, s, "CWE-571", "condition is always true");
                } else {
                    warn_at(c.ctx, s, "CWE-570", "condition is always false; the branch is dead code");
                }
            }
            check_block(c, s.kids[1]);
        }
        if (s.kids.len() > 2) {
            if (s.kids[2].kids.len() == 0) {
                warn_at(c.ctx, s, "CWE-390", "the else branch is empty, so this failure case is silently ignored; handle it or remove the else");
            }
            check_block(c, s.kids[2]);
        }
        return;
    }
    if (k == N_WHILE) {
        expect_type(c, s, check_expr(c, s.kids[0]), mk_type(TY_BOOL), "while condition");
        c.loops += 1;
        check_block(c, s.kids[1]);
        c.loops -= 1;
        return;
    }
    if (k == N_FOR) {
        push_scope(c);
        check_stmt(c, s.kids[0]);
        expect_type(c, s, check_expr(c, s.kids[1]), mk_type(TY_BOOL), "for condition");
        check_stmt(c, s.kids[2]);
        c.loops += 1;
        check_block(c, s.kids[3]);
        c.loops -= 1;
        pop_scope(c);
        return;
    }
    if (k == N_RETURN) {
        if (s.kids.len() == 0) {
            if (c.ret.k != TY_VOID) { error_at(c.ctx, s, "", "missing return value"); }
        } else {
            Type rt = check_expr(c, s.kids[0]);
            if (c.ret.k == TY_VOID) {
                error_at(c.ctx, s, "", "void function cannot return a value");
            } else {
                expect_type(c, s, rt, c.ret, "return");
            }
        }
        return;
    }
    if (k == N_MATCH) { check_match(c, s); return; }
    if (k == N_BREAK || k == N_CONTINUE) {
        if (c.loops == 0) { error_at(c.ctx, s, "", "break/continue outside a loop"); }
        return;
    }
    if (k == N_ASSERT_DENIED || k == N_ASSERT_GRANTED) {
        if (!c.in_test) { error_at(c.ctx, s, "", "assert_denied/assert_granted are only allowed in tests"); }
        if (let pol = c.policies.get(s.s)) {
            check_args(c, s, pol, 0, s.s);
            if (k == N_ASSERT_DENIED) {
                int prev = 0;
                if (let pv = c.denials.get(s.s)) { prev = pv; }
                c.denials.set(s.s, prev + 1);
            }
            c.asserts += 1;
        } else {
            error_at(c.ctx, s, "", "unknown policy '" + s.s + "'");
        }
        return;
    }
    error_at(c.ctx, s, "", "unsupported statement");
}

void check_match(Checker c, Node s) {
    Type mt = check_expr(c, s.kids[0]);
    if (mt.k != TY_ENUM) {
        if (mt.k == TY_OPT) {
            error_at(c.ctx, s, "CWE-476", "match on a value that may be none; unwrap it with if (let x = ...)");
        } else if (mt.k != TY_ERR) {
            error_at(c.ctx, s, "", "match needs an enum value, found " + type_str(mt));
        }
        return;
    }
    if (let en = c.enums.get(mt.name)) {
        Map<int> seen = new Map<int>();
        bool has_else = false;
        List<string> names = new List<string>();
        for (int v = 0; v < en.kids.len(); v += 1) { names.push(en.kids[v].s); }
        for (int i = 1; i < s.kids.len(); i += 1) {
            Node cs = s.kids[i];
            Node body = cs.kids[cs.kids.len() - 1];
            if (cs.n == 1) {
                if (has_else) { error_at(c.ctx, cs, "", "match has more than one else branch"); }
                if (i != s.kids.len() - 1) { error_at(c.ctx, cs, "", "else must be the last branch of a match"); }
                if (seen.keys().len() == en.kids.len()) { warn_at(c.ctx, cs, "CWE-561", "every variant is already handled, so this else can never run"); }
                has_else = true;
                check_block(c, body);
            } else {
                Node? variant = none;
                for (int j = 0; j < en.kids.len(); j += 1) {
                    if (en.kids[j].s == cs.s) { variant = en.kids[j]; }
                }
                if (let vn = variant) {
                    if (seen.has(cs.s)) { error_at(c.ctx, cs, "", "variant " + cs.s + " is handled twice"); }
                    seen.set(cs.s, 1);
                    int nb = cs.kids.len() - 1;
                    if (nb != vn.kids.len()) {
                        error_at(c.ctx, cs, "", "case " + cs.s + " binds " + int_to_str(nb) + " value(s) but " + mt.name + "." + cs.s + " carries " + int_to_str(vn.kids.len()));
                    }
                    push_scope(c);
                    for (int b = 0; b < nb && b < vn.kids.len(); b += 1) {
                        declare(c, cs.kids[b], cs.kids[b].s, ty_of(vn.kids[b]));
                    }
                    check_block(c, body);
                    pop_scope(c);
                } else {
                    error_at(c.ctx, cs, "", "enum " + mt.name + " has no variant '" + cs.s + "'" + suggest(cs.s, names));
                }
            }
        }
        List<string> missing = new List<string>();
        for (int m = 0; m < en.kids.len(); m += 1) {
            if (!seen.has(en.kids[m].s)) { missing.push(en.kids[m].s); }
        }
        if (missing.len() > 0 && !has_else) {
            error_at(c.ctx, s, "CWE-478", "match on " + mt.name + " does not handle " + join(missing, ", ") + "; add those cases or an else branch");
        } else {
            s.n = 1;
        }
    }
}

// Does this statement always end in a return?
bool always_returns(Node s) {
    if (s.k == N_RETURN) { return true; }
    if (s.k == N_BLOCK) {
        for (int i = 0; i < s.kids.len(); i += 1) {
            if (always_returns(s.kids[i])) { return true; }
        }
        return false;
    }
    if (s.k == N_IF && s.kids.len() == 3) {
        return always_returns(s.kids[1]) && always_returns(s.kids[2]);
    }
    if (s.k == N_WHILE && s.kids[0].k == N_BOOL && s.kids[0].n == 1) { return !breaks_out(s.kids[1]); }
    if (s.k == N_EXPR && s.kids[0].k == N_CALL && s.kids[0].s == "exit") { return true; }
    if (s.k == N_MATCH && s.n == 1 && s.kids.len() > 1) {
        for (int i = 1; i < s.kids.len(); i += 1) {
            Node cs = s.kids[i];
            if (!always_returns(cs.kids[cs.kids.len() - 1])) { return false; }
        }
        return true;
    }
    return false;
}

// Does a loop body contain a break that leaves this loop (not a nested one)?
bool breaks_out(Node s) {
    if (s.k == N_BREAK) { return true; }
    if (s.k == N_WHILE || s.k == N_FOR) { return false; }
    for (int i = 0; i < s.kids.len(); i += 1) {
        if (breaks_out(s.kids[i])) { return true; }
    }
    return false;
}

// Does control never continue past this statement?
bool terminates(Node s) {
    return always_returns(s) || s.k == N_BREAK || s.k == N_CONTINUE;
}

// ---- policy analysis ------------------------------------------------------------

bool uses_var(Node n, string name) {
    if (n.k == N_VAR && n.s == name) { return true; }
    for (int i = 0; i < n.kids.len(); i += 1) {
        if (uses_var(n.kids[i], name)) { return true; }
    }
    return false;
}

bool compares_string_literal(Node n) {
    if (n.k == N_BIN && (n.s == "==" || n.s == "!=")) {
        if (n.kids[0].k == N_STR || n.kids[1].k == N_STR) { return true; }
    }
    for (int i = 0; i < n.kids.len(); i += 1) {
        if (compares_string_literal(n.kids[i])) { return true; }
    }
    return false;
}

bool trivially_permits(Node body) {
    if (body.kids.len() == 0) { return false; }
    Node first = body.kids[0];
    if (first.k != N_RETURN || first.kids.len() != 1) { return false; }
    Node v = first.kids[0];
    return v.k == N_BOOL && v.n == 1;
}

void check_policy(Checker c, Node p) {
    Node body = p.kids[p.n];
    bool is_public = p.s2 == "public";
    // Keep this bound in sync with CAP_GRANT_MAX in runtime/capstan_rt.h.
    // The runtime stores struct-identity roles in a fixed-size grant array.
    int object_roles = 0;
    for (int i = 0; i < p.n; i += 1) {
        if (ty_of(p.kids[i]).k == TY_STRUCT) { object_roles += 1; }
    }
    if (object_roles > MAX_GRANT_OBJECT_ROLES) {
        error_at(c.ctx, p, "", "policy '" + p.s + "' has more than 8 struct parameters; grants support at most 8 object roles");
    }
    for (int i = 0; i < p.n; i += 1) {
        Node prm = p.kids[i];
        Type pt = ty_of(prm);
        if (pt.k == TY_TAINT) {
            error_at(c.ctx, prm, "CWE-807", "policy '" + p.s + "' decides on untrusted input '" + prm.s + "'; authorisation must use authenticated data");
        }
        if (!uses_var(body, prm.s) && !is_public) {
            warn_at(c.ctx, prm, "CWE-639", "policy '" + p.s + "' never looks at '" + prm.s + "'; per-object decisions that ignore the object allow access to other users' data");
        }
    }
    if (trivially_permits(body) && !is_public) {
        error_at(c.ctx, p, "CWE-862", "policy '" + p.s + "' permits every request; declare it 'public policy' if that is intended");
    }
    if (compares_string_literal(body)) {
        warn_at(c.ctx, p, "CAP-ROLE", "policy '" + p.s + "' compares against a string literal; use an enum for roles so a typo cannot fail open");
    }
    if (!always_returns(body)) {
        error_at(c.ctx, p, "", "policy '" + p.s + "' must return a decision on every path (default deny)");
    }
}

// ---- declarations -------------------------------------------------------------

Checker new_checker(Ctx ctx) {
    return new Checker{
        ctx: ctx, structs: new Map<Node>(), fns: new Map<Node>(), policies: new Map<Node>(),
        policy_ids: new Map<int>(), consts: new Map<Node>(), const_types: new Map<Type>(),
        scopes: new List<Map<Type>>(), depth: 0, ret: mk_type(TY_VOID), loops: 0,
        in_test: false, in_policy: false, denials: new Map<int>(), asserts: 0,
        used: new List<Map<int>>(), decl_at: new List<Map<Node>>(), enums: new Map<Node>(), privileged: false
    };
}

bool taken(Checker c, string name) {
    return c.structs.has(name) || c.fns.has(name) || c.policies.has(name) || c.consts.has(name) || c.enums.has(name);
}

void register(Checker c, Node d) {
    if (d.k == N_STRUCT || d.k == N_FN || d.k == N_POLICY || d.k == N_CONST || d.k == N_ENUM) {
        if (taken(c, d.s)) {
            error_at(c.ctx, d, "", "'" + d.s + "' is declared more than once");
            return;
        }
    }
    if (d.k == N_STRUCT) { c.structs.set(d.s, d); }
    if (d.k == N_ENUM) { c.enums.set(d.s, d); }
    if (d.k == N_FN) { c.fns.set(d.s, d); }
    if (d.k == N_POLICY) {
        c.policy_ids.set(d.s, c.policies.keys().len());
        c.policies.set(d.s, d);
    }
    if (d.k == N_CONST) { c.consts.set(d.s, d); }
}

void check_params(Checker c, Node f) {
    Map<int> seen = new Map<int>();
    for (int i = 0; i < f.n; i += 1) {
        Node prm = f.kids[i];
        check_type(c, prm, ty_of(prm), false);
        if (seen.has(prm.s)) { error_at(c.ctx, prm, "", "duplicate parameter '" + prm.s + "'"); }
        seen.set(prm.s, 1);
    }
}

void bind_params(Checker c, Node f) {
    for (int i = 0; i < f.n; i += 1) {
        declare_param(c, f.kids[i], f.kids[i].s, ty_of(f.kids[i]));
    }
}

int count_params_of_type(Node f, Type t, int start) {
    int count = 0;
    for (int i = start; i < f.n; i += 1) {
        if (type_eq(ty_of(f.kids[i]), t)) { count += 1; }
    }
    return count;
}

void check_fn(Checker c, Node f) {
    Type rt = ty_of(f);
    check_type(c, f, rt, true);
    if (contains_grant(rt)) {
        error_at(c.ctx, f, "CWE-613", "functions cannot return grants; authorise where the protected action happens");
    }
    check_params(c, f);
    if (f.s2 != "") {
        if (let pol = c.policies.get(f.s2)) {
            bool ok = f.n >= 1 && ty_of(f.kids[0]).k == TY_GRANT && ty_of(f.kids[0]).name == f.s2;
            if (!ok) {
                error_at(c.ctx, f, "CWE-862", "protected(" + f.s2 + ") function '" + f.s + "' must take Grant<" + f.s2 + "> as its first parameter");
            }
            // Every protected-function argument must be represented in the policy.
            // Otherwise a caller could vary an unexamined value (for example, a debit amount)
            // while presenting a grant for a different, authorised request.
            for (int i = 1; i < f.n; i += 1) {
                Type ft = ty_of(f.kids[i]);
                bool found = false;
                for (int j = 0; j < pol.n; j += 1) {
                    if (type_eq(ty_of(pol.kids[j]), ft)) { found = true; }
                }
                if (!found) {
                    error_at(c.ctx, f.kids[i], "CWE-639", "protected(" + f.s2 + ") parameter '" + f.kids[i].s + "' is not bound by policy '" + f.s2 + "'; include this argument in the policy or remove it from the protected function");
                }
            }
            // Parameters of a repeated type are matched by occurrence, so a protected
            // function must accept all policy arguments of that type or none.
            for (int i = 0; i < pol.n; i += 1) {
                Type pt = ty_of(pol.kids[i]);
                if (pt.k != TY_VOID && pt.k != TY_ERR && pt.k != TY_NONE) {
                    bool seen = false;
                    for (int j = 0; j < i; j += 1) {
                        if (type_eq(ty_of(pol.kids[j]), pt)) { seen = true; }
                    }
                    if (!seen) {
                        int policy_count = count_params_of_type(pol, pt, 0);
                        int function_count = count_params_of_type(f, pt, 1);
                        if (function_count != 0 && function_count != policy_count) {
                            error_at(c.ctx, f, "CWE-639", "protected(" + f.s2 + ") function '" + f.s + "' must take all " + int_to_str(policy_count) + " policy parameters of type " + type_str(pt) + " or none, so argument roles remain unambiguous");
                        }
                    }
                }
            }
        } else {
            error_at(c.ctx, f, "", "protected() names unknown policy '" + f.s2 + "'");
        }
    } else {
        for (int i = 0; i < f.n; i += 1) {
            if (ty_of(f.kids[i]).k == TY_GRANT) {
                error_at(c.ctx, f.kids[i], "CWE-862", "only protected functions may take a Grant; declare '" + f.s + "' as protected(" + ty_of(f.kids[i]).name + ")");
            }
        }
    }
    c.ret = rt;
    c.depth = 0;
    c.privileged = f.s2 != "";
    push_scope(c);
    bind_params(c, f);
    Node body = f.kids[f.n];
    check_block(c, body);
    pop_scope(c);
    if (rt.k != TY_VOID && !always_returns(body)) {
        error_at(c.ctx, f, "", "function '" + f.s + "' can reach its end without returning a value");
    }
}

void check_program(Checker c, List<Node> decls, bool need_main) {
    for (int i = 0; i < decls.len(); i += 1) { register(c, decls[i]); }
    for (int n0 = 0; n0 < decls.len(); n0 += 1) { normalise_node(c, decls[n0]); }
    for (int e0 = 0; e0 < decls.len(); e0 += 1) {
        Node en = decls[e0];
        if (en.k == N_ENUM) {
            Map<int> vseen = new Map<int>();
            if (en.kids.len() == 0) { error_at(c.ctx, en, "", "enum " + en.s + " has no variants"); }
            for (int v = 0; v < en.kids.len(); v += 1) {
                Node vn = en.kids[v];
                if (vseen.has(vn.s)) { error_at(c.ctx, vn, "", "duplicate variant '" + vn.s + "'"); }
                vseen.set(vn.s, 1);
                for (int f = 0; f < vn.kids.len(); f += 1) {
                    Type ft = ty_of(vn.kids[f]);
                    check_type(c, vn.kids[f], ft, false);
                    if (contains_grant(ft)) { error_at(c.ctx, vn.kids[f], "CWE-613", "grants cannot be stored in enum values"); }
                }
            }
        }
    }
    for (int i2 = 0; i2 < decls.len(); i2 += 1) {
        Node d = decls[i2];
        if (d.k == N_STRUCT) {
            Map<int> seen = new Map<int>();
            for (int j = 0; j < d.kids.len(); j += 1) {
                Node fd = d.kids[j];
                Type ft = ty_of(fd);
                check_type(c, fd, ft, false);
                if (contains_grant(ft)) {
                    error_at(c.ctx, fd, "CWE-613", "grants cannot be stored in struct fields; a grant must not outlive the request that obtained it");
                }
                if (seen.has(fd.s)) { error_at(c.ctx, fd, "", "duplicate field '" + fd.s + "'"); }
                seen.set(fd.s, 1);
            }
        }
    }
    for (int i3 = 0; i3 < decls.len(); i3 += 1) {
        Node d3 = decls[i3];
        if (d3.k == N_CONST) {
            Type ct = ty_of(d3);
            check_type(c, d3, ct, false);
            if (contains_grant(ct)) { error_at(c.ctx, d3, "CWE-613", "grants cannot be constants"); }
            c.depth = 0;
            push_scope(c);
            Type vt = check_expr(c, d3.kids[0]);
            pop_scope(c);
            expect_type(c, d3, vt, ct, "constant '" + d3.s + "'");
            string dl = lower(d3.s);
            if (c.ctx.release && ct.k == TY_BOOL && d3.kids[0].k == N_BOOL && d3.kids[0].n == 1
                && (contains(dl, "debug") || contains(dl, "dev_mode") || contains(dl, "test_mode") || contains(dl, "insecure"))) {
                error_at(c.ctx, d3, "CWE-489", "debug switch '" + d3.s + "' is on in a release build");
            }
            check_hardcoded(c, d3, d3.s, d3.kids[0]);
            c.const_types.set(d3.s, ct);
        }
    }
    for (int i4 = 0; i4 < decls.len(); i4 += 1) {
        Node d4 = decls[i4];
        if (d4.k == N_FN) { check_fn(c, d4); }
        if (d4.k == N_POLICY) {
            check_params(c, d4);
            c.ret = mk_type(TY_BOOL);
            c.depth = 0;
            c.in_policy = true;
            c.privileged = true;
            push_scope(c);
            bind_params(c, d4);
            check_block(c, d4.kids[d4.n]);
            pop_scope(c);
            c.in_policy = false;
            check_policy(c, d4);
        }
        if (d4.k == N_TEST) {
            c.ret = mk_type(TY_VOID);
            c.depth = 0;
            c.in_test = true;
            c.privileged = true;
            int before = c.asserts;
            check_block(c, d4.kids[0]);
            c.in_test = false;
            if (c.asserts == before) {
                warn_at(c.ctx, d4, "CAP-TEST", "test \"" + d4.s + "\" asserts nothing");
            }
        }
    }
    if (error_count(c.ctx) == 0) { check_laundering(c, decls); }
    List<string> pols = c.policies.keys();
    for (int i5 = 0; i5 < pols.len(); i5 += 1) {
        if (let pn = c.policies.get(pols[i5])) {
            if (pn.s2 != "public" && !c.denials.has(pols[i5])) {
                report(c.ctx, pn.file, pn.line, c.ctx.release || c.ctx.strict, "CAP-TEST",
                    "policy '" + pols[i5] + "' has no test showing a request being denied; add assert_denied " + pols[i5] + "(...) in a test");
            }
        }
    }
    if (need_main) {
        if (let m = c.fns.get("main")) {
            Type mt = ty_of(m);
            if (m.n != 0 || (mt.k != TY_INT && mt.k != TY_VOID)) {
                error_at(c.ctx, m, "", "main must be declared as int main() or void main()");
            }
        } else {
            report(c.ctx, 0, 1, true, "", "program has no main() function");
        }
    }
}

// ---- laundering analysis (CWE-20) ---------------------------------------------
//
// Bytes read from a Tainted value with .at() are "derived" integers. Rebuilding
// text from them would strip the Tainted marking, so every way of doing it is
// rejected: char_str() of a derived integer, and looking up trusted text with one
// (an index into a list of strings, a slice of a trusted string, a map key made
// from it). A collection indexed by a derived integer yields derived values, and
// int_to_str() of a derived integer is a derived string. Derivation is tracked
// through arithmetic, local variables, collections and struct fields written with
// derived values, function return values and integer parameters (inter-procedurally,
// to a fixpoint). Not tracked: information carried only by control flow.

struct FlowSummary {
    bool returns_derived;
    List<bool> param_to_return;
    List<bool> param_to_sink;
}

struct Flow {
    Map<int> vars;
    Map<FlowSummary> sums;
    bool changed;
    bool returns;
    bool sinks;
    bool report;
    Ctx ctx;
}

bool is_arith(string op) {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || is_bitwise(op);
}

bool derived(Flow f, Node e) {
    if (e.k == N_METHOD && e.s == "at" && ty_of(e.kids[0]).k == TY_TAINT) { return true; }
    if (e.k == N_VAR) { return f.vars.has(e.s); }
    if (e.k == N_NEG || e.k == N_BNOT) { return derived(f, e.kids[0]); }
    // A collection or struct that ever held a derived integer yields derived integers.
    if (e.k == N_GETF) { return base_marked(f, e.kids[0]); }
    // Indexing with a derived integer selects by untrusted data: the result is derived too.
    if (e.k == N_INDEX) { return base_marked(f, e.kids[0]) || derived(f, e.kids[1]); }
    if (e.k == N_METHOD && e.s == "get" && e.kids.len() > 1 && derived(f, e.kids[1])) { return true; }
    // Decimal digits of an untrusted byte, and text joined to them, are derived strings.
    if (e.k == N_CALL && e.s == "int_to_str" && e.kids.len() == 1 && derived(f, e.kids[0])) { return true; }
    if (e.k == N_BIN && e.s == "+" && ty_of(e).k == TY_STR) { return derived(f, e.kids[0]) || derived(f, e.kids[1]); }
    if (e.k == N_METHOD && (e.s == "pop" || e.s == "get" || e.s == "remove_at")) { return base_marked(f, e.kids[0]); }
    if (e.k == N_BIN && is_arith(e.s) && ty_of(e).k == TY_INT) {
        return derived(f, e.kids[0]) || derived(f, e.kids[1]);
    }
    // The wrapping builtins compute with their arguments, so untrusted bytes stay untrusted.
    if (e.k == N_CALL && (e.s == "wrapping_add" || e.s == "wrapping_sub" || e.s == "wrapping_mul" || e.s == "wrapping_shl")) {
        for (int w = 0; w < e.kids.len(); w += 1) {
            if (derived(f, e.kids[w])) { return true; }
        }
    }
    if (e.k == N_CALL) {
        if (let sm = f.sums.get(e.s)) {
            if (sm.returns_derived) { return true; }
            for (int i = 0; i < e.kids.len() && i < sm.param_to_return.len(); i += 1) {
                if (sm.param_to_return[i] && derived(f, e.kids[i])) { return true; }
            }
        }
    }
    return false;
}

bool base_marked(Flow f, Node e) {
    if (e.k == N_VAR) { return f.vars.has(e.s); }
    if (e.k == N_GETF || e.k == N_INDEX) { return base_marked(f, e.kids[0]); }
    return false;
}

string base_name(Node e) {
    if (e.k == N_VAR) { return e.s; }
    if (e.k == N_GETF || e.k == N_INDEX) { return base_name(e.kids[0]); }
    return "";
}

void mark(Flow f, string name) {
    if (!f.vars.has(name)) {
        f.vars.set(name, 1);
        f.changed = true;
    }
}

void sink(Flow f, Node at) {
    f.sinks = true;
    if (f.report) {
        error_at(f.ctx, at, "CWE-20", "char_str() rebuilds text from bytes of untrusted input, which removes its Tainted marking; slice the Tainted value instead and validate or escape it");
    }
}

void lookup_sink(Flow f, Node at) {
    f.sinks = true;
    if (f.report) {
        error_at(f.ctx, at, "CWE-20", "trusted text selected by bytes of untrusted input rebuilds that input without its Tainted marking; slice the Tainted value instead and validate or escape it");
    }
}

bool texty_type(Type t) {
    return t.k == TY_STR || t.k == TY_HTML || t.k == TY_LOG;
}

void flow_walk(Flow f, Node n) {
    if (n.k == N_DECL && (ty_of(n).k == TY_INT || ty_of(n).k == TY_STR) && derived(f, n.kids[0])) { mark(f, n.s); }
    if (n.k == N_ASSIGN && n.kids[0].k == N_VAR && (ty_of(n.kids[0]).k == TY_INT || ty_of(n.kids[0]).k == TY_STR) && derived(f, n.kids[1])) { mark(f, n.kids[0].s); }
    // Lookups of trusted text keyed by untrusted bytes.
    if (n.k == N_INDEX && texty_type(ty_of(n)) && derived(f, n.kids[1])) { lookup_sink(f, n); }
    if (n.k == N_METHOD && n.s == "get" && n.kids.len() > 1 && derived(f, n.kids[1])) {
        Type gt = ty_of(n);
        if (gt.k == TY_OPT && gt.args.len() > 0 && texty_type(gt.args[0])) { lookup_sink(f, n); }
    }
    if (n.k == N_METHOD && n.s == "slice" && ty_of(n.kids[0]).k != TY_TAINT) {
        bool sliced_by_input = false;
        for (int si = 1; si < n.kids.len(); si += 1) {
            if (derived(f, n.kids[si])) { sliced_by_input = true; }
        }
        if (sliced_by_input) { lookup_sink(f, n); }
    }
    if (n.k == N_ASSIGN && (n.kids[0].k == N_INDEX || n.kids[0].k == N_GETF) && derived(f, n.kids[1])) {
        string bn = base_name(n.kids[0]);
        if (bn != "") { mark(f, bn); }
    }
    if (n.k == N_METHOD && (n.s == "push" || n.s == "insert" || n.s == "set") && n.kids.len() > 1 && derived(f, n.kids[n.kids.len() - 1])) {
        string bn2 = base_name(n.kids[0]);
        if (bn2 != "") { mark(f, bn2); }
    }
    if (n.k == N_IF && n.n == 1 && derived(f, n.kids[0])) { mark(f, n.s2); }
    if (n.k == N_RETURN && n.kids.len() == 1 && derived(f, n.kids[0])) { f.returns = true; }
    if (n.k == N_CALL && n.s == "char_str" && n.kids.len() == 1 && derived(f, n.kids[0])) { sink(f, n); }
    if (n.k == N_CALL) {
        if (let sm = f.sums.get(n.s)) {
            for (int i = 0; i < n.kids.len() && i < sm.param_to_sink.len(); i += 1) {
                if (sm.param_to_sink[i] && derived(f, n.kids[i])) { sink(f, n); }
            }
        }
    }
    for (int k = 0; k < n.kids.len(); k += 1) { flow_walk(f, n.kids[k]); }
}

// Analyse one body until the set of derived locals stops growing.
Flow flow_body(Map<FlowSummary> sums, Ctx ctx, Node body, string seed, bool report) {
    Flow f = new Flow{vars: new Map<int>(), sums: sums, changed: true, returns: false, sinks: false, report: false, ctx: ctx};
    if (seed != "") { f.vars.set(seed, 1); }
    int rounds = 0;
    while (f.changed && rounds < 100) {
        f.changed = false;
        f.returns = false;
        f.sinks = false;
        flow_walk(f, body);
        rounds += 1;
    }
    // Never run sink diagnostics with a partial intraprocedural taint set.
    // A long reverse dependency chain can require more than 100 passes.
    if (f.changed) {
        if (error_count(ctx) == 0) {
            error_at(ctx, body, "CWE-20",
                "intraprocedural taint analysis did not reach a fixpoint within 100 rounds; refusing to compile");
        }
        return f;
    }
    if (report) {
        f.report = true;
        flow_walk(f, body);
    }
    return f;
}

FlowSummary summarise(Map<FlowSummary> sums, Ctx ctx, Node fn) {
    Node body = fn.kids[fn.n];
    Flow base = flow_body(sums, ctx, body, "", false);
    FlowSummary out = new FlowSummary{returns_derived: base.returns, param_to_return: new List<bool>(), param_to_sink: new List<bool>()};
    for (int i = 0; i < fn.n; i += 1) {
        if (ty_of(fn.kids[i]).k == TY_INT) {
            Flow pf = flow_body(sums, ctx, body, fn.kids[i].s, false);
            out.param_to_return.push(pf.returns);
            out.param_to_sink.push(pf.sinks);
        } else {
            out.param_to_return.push(false);
            out.param_to_sink.push(false);
        }
    }
    return out;
}

bool same_summary(FlowSummary a, FlowSummary b) {
    if (a.returns_derived != b.returns_derived) { return false; }
    for (int i = 0; i < a.param_to_return.len(); i += 1) {
        if (a.param_to_return[i] != b.param_to_return[i] || a.param_to_sink[i] != b.param_to_sink[i]) { return false; }
    }
    return true;
}

void check_laundering(Checker c, List<Node> decls) {
    Map<FlowSummary> sums = new Map<FlowSummary>();
    bool changed = true;
    int rounds = 0;
    while (changed && rounds < 50) {
        changed = false;
        for (int i = 0; i < decls.len(); i += 1) {
            Node d = decls[i];
            if (d.k == N_FN) {
                FlowSummary s = summarise(sums, c.ctx, d);
                if (error_count(c.ctx) > 0) { return; }
                if (let prev = sums.get(d.s)) {
                    if (!same_summary(prev, s)) { changed = true; }
                } else {
                    changed = true;
                }
                sums.set(d.s, s);
            }
        }
        rounds += 1;
    }
    // Never run sink diagnostics against an incomplete summary set. An adversarial
    // helper chain can require more than 50 rounds; accepting it would turn an
    // analysis resource limit into a taint-laundering bypass.
    if (changed) {
        report(c.ctx, 0, 1, true, "CWE-20",
            "taint analysis did not reach a fixpoint within 50 rounds; refusing to compile");
        return;
    }
    if (error_count(c.ctx) > 0) { return; }
    for (int j = 0; j < decls.len(); j += 1) {
        Node d2 = decls[j];
        if (d2.k == N_FN || d2.k == N_POLICY) { flow_body(sums, c.ctx, d2.kids[d2.n], "", true); }
        if (d2.k == N_TEST) { flow_body(sums, c.ctx, d2.kids[0], "", true); }
        if (error_count(c.ctx) > 0) { return; }
    }
}
