// Emit a signed 32-bit immediate as its two's-complement little-endian bits.
bool ag_x86_imm32(List<int> b,int value) {
    if (value < -2147483648 || value > 2147483647 || b.len() > AG_BYTE_LIMIT - 4) {
        return false;
    }
    int encoded = value;
    if (encoded < 0) { encoded += 4294967296; }
    return ag_u32(b, encoded);
}

test "x86 imm32 emits signed endpoints without partial writes" {
    List<int> bytes = new List<int>();
    assert(ag_x86_imm32(bytes, -2147483648));
    assert(bytes.len() == 4);
    assert(bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0 && bytes[3] == 128);
    assert(ag_x86_imm32(bytes, 2147483647));
    assert(bytes[4] == 255 && bytes[5] == 255 && bytes[6] == 255 && bytes[7] == 127);
    int before = bytes.len();
    assert(!ag_x86_imm32(bytes, 2147483648));
    assert(!ag_x86_imm32(bytes, -2147483649));
    assert(bytes.len() == before);
}
