// Higher values bind more tightly. Order follows the C-family expression
// grammar for the operators supported by this research parser.
int ag_operator_class(int op) {
    if (op == 124) { return 1; } // |
    if (op == 94) { return 2; }  // ^
    if (op == 38) { return 3; }  // &
    if (op == 60 || op == 62 || op == 61 || op == 33) { return 4; }
    if (op == 43 || op == 45) { return 5; }
    if (op == 42 || op == 47 || op == 37) { return 6; }
    return 0;
}
