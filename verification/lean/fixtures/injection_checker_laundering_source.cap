// ---- laundering analysis (CWE-20) ---------------------------------------------
//
// Bytes read from a Tainted value with .at() are "derived" integers. Rebuilding
// text from them would strip the Tainted marking, so every way of doing it is
// rejected: char_str() of a derived integer, and looking up trusted text with one
// (an index into a list of strings, a slice of a trusted string, a map key made
// from it). A collection indexed by a derived integer yields derived values, and
// int_to_str() of a derived integer is a derived string. Derivation is tracked
// through arithmetic, local variables, collections and struct fields written with
// derived values, function return values and integer parameters (inter-procedurally,
// to a fixpoint). Not tracked: information carried only by control flow.

struct FlowSummary {
    bool returns_derived;
    List<bool> param_to_return;
    List<bool> param_to_sink;
}

const int MAX_FLOW_PATHS = 4096;

struct Flow {
    Map<int> paths;                 // typed access-path key -> may-derived fact
    int path_count;
    bool exhausted;
    Map<FlowSummary> sums;
    bool changed;
    bool returns;
    bool sinks;
    bool report;
    Ctx ctx;
}

bool aggregate_type(Type t) {
    if (t.k == TY_STRUCT || t.k == TY_LIST || t.k == TY_MAP) { return true; }
    if (t.k == TY_OPT && t.args.len() > 0) { return aggregate_type(t.args[0]); }
    return false;
}

bool is_arith(string op) {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || is_bitwise(op);
}

bool derived(Flow f, Node e) {
    if (e.k == N_METHOD && e.s == "at" && ty_of(e.kids[0]).k == TY_TAINT) { return true; }
    if (e.k == N_VAR) {
        Type vt = ty_of(e);
        if (vt.k == TY_TAINT) { return true; }
        if (aggregate_type(vt)) { return aggregate_marked(f, e); }
        return path_marked(f, e);
    }
    if (e.k == N_NEG || e.k == N_BNOT || e.k == N_NOT) { return derived(f, e.kids[0]); }
    // Comparisons and Boolean connectives produce values that depend on their operands.
    if (e.k == N_BIN && ty_of(e).k == TY_BOOL) {
        return derived(f, e.kids[0]) || derived(f, e.kids[1]);
    }
    // Length reveals input-dependent metadata even though the result is an integer.
    if (e.k == N_METHOD && e.s == "len") {
        return ty_of(e.kids[0]).k == TY_TAINT || aggregate_marked(f, e.kids[0]);
    }
    // A collection or struct that ever held a derived integer yields derived integers.
    if (e.k == N_GETF) {
        if (aggregate_type(ty_of(e))) { return aggregate_marked(f, e); }
        return path_marked(f, e);
    }
    // Indexing with a derived integer selects by untrusted data: the result is derived too.
    if (e.k == N_INDEX) {
        bool selected = derived(f, e.kids[1]);
        if (aggregate_type(ty_of(e))) { return aggregate_marked(f, e) || selected; }
        return path_marked(f, e) || selected;
    }
    if (e.k == N_METHOD && e.s == "get" && e.kids.len() > 1 && (derived(f, e.kids[1]) || aggregate_marked(f, e.kids[0]))) { return true; }
    // Decimal digits of an untrusted byte, and text joined to them, are derived strings.
    if (e.k == N_CALL && (e.s == "int_to_str" || e.s == "to_text") && e.kids.len() == 1 && derived(f, e.kids[0])) { return true; }
    // join(List<Tainted>, separator) retains the list's input provenance.
    if (e.k == N_CALL && e.s == "join" && e.kids.len() == 2 && derived(f, e.kids[0])) { return true; }
    if (e.k == N_BIN && e.s == "+" && ty_of(e).k == TY_STR) { return derived(f, e.kids[0]) || derived(f, e.kids[1]); }
    if (e.k == N_METHOD && (e.s == "pop" || e.s == "get" || e.s == "remove_at")) { return aggregate_marked(f, e.kids[0]); }
    if (e.k == N_BIN && is_arith(e.s) && ty_of(e).k == TY_INT) {
        return derived(f, e.kids[0]) || derived(f, e.kids[1]);
    }
    // The wrapping builtins compute with their arguments, so untrusted bytes stay untrusted.
    if (e.k == N_CALL && (e.s == "wrapping_add" || e.s == "wrapping_sub" || e.s == "wrapping_mul" || e.s == "wrapping_shl")) {
        for (int w = 0; w < e.kids.len(); w += 1) {
            if (derived(f, e.kids[w])) { return true; }
        }
    }
    if (e.k == N_CALL) {
        if (let sm = f.sums.get(e.s)) {
            if (sm.returns_derived) { return true; }
            for (int i = 0; i < e.kids.len() && i < sm.param_to_return.len(); i += 1) {
                if (sm.param_to_return[i] && derived(f, e.kids[i])) { return true; }
            }
        }
    }
    return false;
}

string binding_path(int binding_id) {
    if (binding_id <= 0) { return ""; }
    return int_to_str(binding_id);
}

// Access paths use resolved binding identity plus typed selectors. Dynamic list
// indices widen to [*]; map keys and values are distinct abstract locations.
string path_key(Node e) {
    if (e.k == N_VAR) { return binding_path(e.binding_id); }
    if (e.k == N_GETF) {
        string parent = path_key(e.kids[0]);
        if (parent == "") { return ""; }
        return parent + "." + e.s;
    }
    if (e.k == N_INDEX) {
        string parent = path_key(e.kids[0]);
        if (parent == "") { return ""; }
        if (ty_of(e.kids[0]).k == TY_MAP) { return parent + "{value}"; }
        if (e.kids[1].k == N_INT) { return parent + "[" + int_to_str(e.kids[1].n) + "]"; }
        return parent + "[*]";
    }
    return "";
}

// Replace every list index selector with the conservative wildcard. This also
// matches nested writes such as items[i].field against a later items[0].field read.
string wildcard_path_key(Node e) {
    if (e.k == N_VAR) { return binding_path(e.binding_id); }
    if (e.k == N_GETF) {
        string parent = wildcard_path_key(e.kids[0]);
        if (parent == "") { return ""; }
        return parent + "." + e.s;
    }
    if (e.k == N_INDEX) {
        string parent = wildcard_path_key(e.kids[0]);
        if (parent == "") { return ""; }
        if (ty_of(e.kids[0]).k == TY_MAP) { return parent + "{value}"; }
        return parent + "[*]";
    }
    return "";
}

bool has_path_prefix(Flow f, string prefix) {
    List<string> keys = f.paths.keys();
    for (int i = 0; i < keys.len(); i += 1) {
        if (keys[i].len() > prefix.len() && keys[i].slice(0, prefix.len()) == prefix) { return true; }
    }
    return false;
}

bool path_marked(Flow f, Node e) {
    string key = path_key(e);
    if (key == "") { return false; }
    if (f.paths.has(key)) { return true; }
    string wildcard = wildcard_path_key(e);
    if (wildcard != "" && f.paths.has(wildcard)) { return true; }
    if (e.k == N_INDEX) {
        string parent = path_key(e.kids[0]);
        if (parent != "" && ty_of(e.kids[0]).k != TY_MAP) {
            if (e.kids[1].k == N_INT) {
                if (f.paths.has(parent + "[*]")) { return true; }
            } else if (has_path_prefix(f, parent + "[")) {
                return true;
            }
        }
        return path_marked(f, e.kids[0]);
    }
    if (e.k == N_GETF) { return path_marked(f, e.kids[0]); }
    return false;
}

// Aggregate operations observe a child summary. This deliberately over-approximates
// element/field presence until a fully flow-sensitive heap and alias domain exists.
bool aggregate_marked(Flow f, Node e) {
    string key = path_key(e);
    if (key == "") { return false; }
    if (path_marked(f, e)
        || f.paths.has(key + "[*]")
        || f.paths.has(key + "{key}")
        || f.paths.has(key + "{value}")) { return true; }
    // A nested child may be the only derived part of this aggregate.
    return has_path_prefix(f, key + ".")
        || has_path_prefix(f, key + "[")
        || has_path_prefix(f, key + "{");
}

void mark_key(Flow f, string key) {
    if (key != "" && !f.paths.has(key)) {
        if (f.path_count >= MAX_FLOW_PATHS) {
            f.exhausted = true;
            return;
        }
        f.paths.set(key, 1);
        f.path_count += 1;
        f.changed = true;
    }
}

void mark_binding(Flow f, int binding_id) {
    mark_key(f, binding_path(binding_id));
}

void mark_path(Flow f, Node target) {
    mark_key(f, path_key(target));
}

void mark_child(Flow f, Node base, string selector) {
    string parent = path_key(base);
    if (parent != "") { mark_key(f, parent + selector); }
}

void sink(Flow f, Node at) {
    f.sinks = true;
    if (f.report) {
        error_at(f.ctx, at, "CWE-20", "char_str() rebuilds text from bytes of untrusted input, which removes its Tainted marking; slice the Tainted value instead and validate or escape it");
    }
}

void lookup_sink(Flow f, Node at) {
    f.sinks = true;
    if (f.report) {
        error_at(f.ctx, at, "CWE-20", "trusted text selected by bytes of untrusted input rebuilds that input without its Tainted marking; slice the Tainted value instead and validate or escape it");
    }
}

bool texty_type(Type t) {
    return t.k == TY_STR || t.k == TY_HTML || t.k == TY_LOG || t.k == TY_CSV;
}

void flow_walk(Flow f, Node n) {
    if (n.k == N_DECL && (ty_of(n).k == TY_INT || ty_of(n).k == TY_STR || ty_of(n).k == TY_BOOL) && derived(f, n.kids[0])) { mark_binding(f, n.binding_id); }
    if (n.k == N_ASSIGN && n.kids[0].k == N_VAR && (ty_of(n.kids[0]).k == TY_INT || ty_of(n.kids[0]).k == TY_STR || ty_of(n.kids[0]).k == TY_BOOL) && derived(f, n.kids[1])) { mark_path(f, n.kids[0]); }
    // Lookups of trusted text keyed by untrusted bytes.
    if (n.k == N_INDEX && texty_type(ty_of(n)) && derived(f, n.kids[1])) { lookup_sink(f, n); }
    if (n.k == N_METHOD && n.s == "get" && n.kids.len() > 1 && derived(f, n.kids[1])) {
        Type gt = ty_of(n);
        if (gt.k == TY_OPT && gt.args.len() > 0 && texty_type(gt.args[0])) { lookup_sink(f, n); }
    }
    if (n.k == N_METHOD && n.s == "slice" && ty_of(n.kids[0]).k != TY_TAINT) {
        bool sliced_by_input = false;
        for (int si = 1; si < n.kids.len(); si += 1) {
            if (derived(f, n.kids[si])) { sliced_by_input = true; }
        }
        if (sliced_by_input) { lookup_sink(f, n); }
    }
    if (n.k == N_ASSIGN && (n.kids[0].k == N_INDEX || n.kids[0].k == N_GETF) && derived(f, n.kids[1])) {
        mark_path(f, n.kids[0]);
    }
    if (n.k == N_METHOD && (n.s == "push" || n.s == "insert" || n.s == "set") && n.kids.len() > 1) {
        if (n.s == "set" && n.kids.len() > 2) {
            if (derived(f, n.kids[1])) { mark_child(f, n.kids[0], "{key}"); }
            if (derived(f, n.kids[n.kids.len() - 1])) { mark_child(f, n.kids[0], "{value}"); }
        } else if (derived(f, n.kids[n.kids.len() - 1]) || (n.s == "insert" && derived(f, n.kids[1]))) {
            mark_child(f, n.kids[0], "[*]");
        }
    }
    if (n.k == N_IF && n.n == 1 && derived(f, n.kids[0])) { mark_binding(f, n.binding_id); }
    if (n.k == N_RETURN && n.kids.len() == 1 && derived(f, n.kids[0])) { f.returns = true; }
    if (n.k == N_CALL && n.s == "char_str" && n.kids.len() == 1 && derived(f, n.kids[0])) { sink(f, n); }
    if (n.k == N_CALL) {
        if (let sm = f.sums.get(n.s)) {
            for (int i = 0; i < n.kids.len() && i < sm.param_to_sink.len(); i += 1) {
                if (sm.param_to_sink[i] && derived(f, n.kids[i])) { sink(f, n); }
            }
        }
    }
    for (int k = 0; k < n.kids.len(); k += 1) { flow_walk(f, n.kids[k]); }
}

// Analyse one body until the set of derived locals stops growing.
Flow flow_body(Map<FlowSummary> sums, Ctx ctx, Node body, int seed, bool report) {
    Flow f = new Flow{paths: new Map<int>(), path_count: 0, exhausted: false, sums: sums, changed: true, returns: false, sinks: false, report: false, ctx: ctx};
    if (seed > 0) { mark_binding(f, seed); }
    int rounds = 0;
    while (f.changed && rounds < 100) {
        f.changed = false;
        f.returns = false;
        f.sinks = false;
        flow_walk(f, body);
        if (f.exhausted) {
            if (error_count(ctx) == 0) {
                error_at(ctx, body, "CWE-20",
                    "provenance access-path budget exceeded (4096 facts); refusing to compile");
            }
            return f;
        }
        rounds += 1;
    }
    // Never run sink diagnostics with a partial intraprocedural taint set.
    // A long reverse dependency chain can require more than 100 passes.
    if (f.changed) {
        if (error_count(ctx) == 0) {
            error_at(ctx, body, "CWE-20",
                "intraprocedural taint analysis did not reach a fixpoint within 100 rounds; refusing to compile");
        }
        return f;
    }
    if (report) {
        f.report = true;
        flow_walk(f, body);
    }
    return f;
}

bool mentions_binding(Node n, int binding_id) {
    if (n.k == N_VAR && n.binding_id == binding_id) { return true; }
    for (int i = 0; i < n.kids.len(); i += 1) {
        if (mentions_binding(n.kids[i], binding_id)) { return true; }
    }
    return false;
}

// Aggregate summaries only affect return and call/sink dependencies. Avoid a
// full abstract-state run for aggregate parameters that cannot participate in
// either relation; this is a conservative worklist prefilter, not an analysis
// shortcut for any parameter that can affect a return or call.
bool needs_aggregate_summary(Node n, int binding_id) {
    if (n.k == N_RETURN && n.kids.len() > 0 && mentions_binding(n.kids[0], binding_id)) { return true; }
    if (n.k == N_CALL && mentions_binding(n, binding_id)) { return true; }
    for (int i = 0; i < n.kids.len(); i += 1) {
        if (needs_aggregate_summary(n.kids[i], binding_id)) { return true; }
    }
    return false;
}

FlowSummary summarise(Map<FlowSummary> sums, Ctx ctx, Node fn) {
    Node body = fn.kids[fn.n];
    Flow base = flow_body(sums, ctx, body, 0, false);
    FlowSummary out = new FlowSummary{returns_derived: base.returns, param_to_return: new List<bool>(), param_to_sink: new List<bool>()};
    for (int i = 0; i < fn.n; i += 1) {
        Type pt = ty_of(fn.kids[i]);
        bool scalar_parameter = pt.k == TY_INT || pt.k == TY_BOOL || pt.k == TY_STR || pt.k == TY_TAINT;
        bool aggregate_parameter = aggregate_type(pt) && needs_aggregate_summary(body, fn.kids[i].binding_id);
        if (scalar_parameter || aggregate_parameter) {
            Flow pf = flow_body(sums, ctx, body, fn.kids[i].binding_id, false);
            out.param_to_return.push(pf.returns);
            out.param_to_sink.push(pf.sinks);
        } else {
            out.param_to_return.push(false);
            out.param_to_sink.push(false);
        }
    }
    return out;
}

bool same_summary(FlowSummary a, FlowSummary b) {
    if (a.returns_derived != b.returns_derived) { return false; }
    for (int i = 0; i < a.param_to_return.len(); i += 1) {
        if (a.param_to_return[i] != b.param_to_return[i] || a.param_to_sink[i] != b.param_to_sink[i]) { return false; }
    }
    return true;
}

void check_laundering(Checker c, List<Node> decls) {
    Map<FlowSummary> sums = new Map<FlowSummary>();
    bool changed = true;
    int rounds = 0;
    while (changed && rounds < 50) {
        changed = false;
        for (int i = 0; i < decls.len(); i += 1) {
            Node d = decls[i];
            if (d.k == N_FN) {
                FlowSummary s = summarise(sums, c.ctx, d);
                if (error_count(c.ctx) > 0) { return; }
                if (let prev = sums.get(d.s)) {
                    if (!same_summary(prev, s)) { changed = true; }
                } else {
                    changed = true;
                }
                sums.set(d.s, s);
            }
        }
        rounds += 1;
    }
    // Never run sink diagnostics against an incomplete summary set. An adversarial
    // helper chain can require more than 50 rounds; accepting it would turn an
    // analysis resource limit into a taint-laundering bypass.
    if (changed) {
        report(c.ctx, 0, 1, true, "CWE-20",
            "taint analysis did not reach a fixpoint within 50 rounds; refusing to compile");
        return;
    }
    if (error_count(c.ctx) > 0) { return; }
    for (int j = 0; j < decls.len(); j += 1) {
        Node d2 = decls[j];
        if (d2.k == N_FN || d2.k == N_POLICY) { flow_body(sums, c.ctx, d2.kids[d2.n], 0, true); }
        if (d2.k == N_TEST) { flow_body(sums, c.ctx, d2.kids[0], 0, true); }
        if (error_count(c.ctx) > 0) { return; }
    }
}
