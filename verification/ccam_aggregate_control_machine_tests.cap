import "ccam_aggregate_control_machine.cap";
test "bounded control machine executes a summation loop" {
    List<AGControlInstruction> code=new List<AGControlInstruction>();
    code.push(new AGControlInstruction{opcode:1,destination:0,left:0,right:0,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:1,destination:1,left:0,right:0,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:1,destination:2,left:0,right:0,immediate:5,target:0});
    code.push(new AGControlInstruction{opcode:1,destination:4,left:0,right:0,immediate:1,target:0});
    code.push(new AGControlInstruction{opcode:6,destination:3,left:0,right:2,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:8,destination:0,left:3,right:0,immediate:0,target:10});
    code.push(new AGControlInstruction{opcode:2,destination:1,left:1,right:0,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:2,destination:0,left:0,right:4,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:9,destination:0,left:0,right:0,immediate:0,target:4});
    code.push(new AGControlInstruction{opcode:10,destination:1,left:0,right:0,immediate:0,target:0});
    AGControlResult result=ag_control_execute(code,100,5);
    assert(result.ok && result.value==10);
}
test "bounded control machine stops an infinite loop at fuel limit" {
    List<AGControlInstruction> code=new List<AGControlInstruction>();
    code.push(new AGControlInstruction{opcode:9,destination:0,left:0,right:0,immediate:0,target:0});
    AGControlResult result=ag_control_execute(code,7,1);
    assert(!result.ok && result.steps==7);
}
test "bounded control machine rejects invalid branch targets" {
    List<AGControlInstruction> code=new List<AGControlInstruction>();
    code.push(new AGControlInstruction{opcode:8,destination:0,left:0,right:0,immediate:0,target:8});
    assert(!ag_control_execute(code,10,1).ok);
}
test "bounded control machine rejects arithmetic failure" {
    List<AGControlInstruction> code=new List<AGControlInstruction>();
    code.push(new AGControlInstruction{opcode:1,destination:0,left:0,right:0,immediate:1,target:0});
    code.push(new AGControlInstruction{opcode:1,destination:1,left:0,right:0,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:5,destination:2,left:0,right:1,immediate:0,target:0});
    code.push(new AGControlInstruction{opcode:10,destination:2,left:0,right:0,immediate:0,target:0});
    assert(!ag_control_execute(code,10,3).ok);
}
