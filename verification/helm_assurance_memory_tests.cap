import "helm_boot_memory_model.cap";

bool assurance_helm_pair(int ah, int al, int bh, int bl, bool add_ok, int add_hi, int add_lo,
    bool sub_ok, int sub_hi, int sub_lo, int compare) {
    HBMU64 a = hbm_u64(ah, al); HBMU64 b = hbm_u64(bh, bl);
    HBMU64Result sum = hbm_u64_add(a, b);
    HBMU64Result diff = hbm_u64_sub(a, b);
    if (hbm_u64_compare(a, b) != compare || sum.ok != add_ok || diff.ok != sub_ok) { return false; }
    if (sum.value.hi != add_hi || sum.value.lo != add_lo || diff.value.hi != sub_hi || diff.value.lo != sub_lo) { return false; }
    if (!add_ok && sum.error != "u64_overflow") { return false; }
    if (!sub_ok && diff.error != "u64_underflow") { return false; }
    return a.hi == ah && a.lo == al && b.hi == bh && b.lo == bl;
}

test "Helm unsigned address arithmetic row 0" {
    assert(assurance_helm_pair(0, 0, 0, 0, true, 0, 0, true, 0, 0, 0));
    assert(assurance_helm_pair(0, 0, 0, 1, true, 0, 1, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 0, 4294967295, true, 0, 4294967295, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 1, 0, true, 1, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 32767, 4294967295, true, 32767, 4294967295, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 32768, 0, true, 32768, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 2147483647, 4294967295, true, 2147483647, 4294967295, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 2147483648, 0, true, 2147483648, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 4294934527, 4294967295, true, 4294934527, 4294967295, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 4294934528, 0, true, 4294934528, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 4294967295, 4294967294, true, 4294967295, 4294967294, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 0, 4294967295, 4294967295, true, 4294967295, 4294967295, false, 0, 0, -1));
}

