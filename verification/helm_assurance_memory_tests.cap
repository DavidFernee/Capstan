test "Helm all bounded snapshot windows and read widths" {
    for (int start = -1; start <= 9; start += 1) {
        for (int length = -1; length <= 9; length += 1) {
            List<int> source = new List<int>();
            for (int i = 0; i < 8; i += 1) { source.push(i + 1); }
            HBMViewResult view = hbm_view_create(source, start, length);
            bool valid = start >= 0 && length >= 0 && start + length <= 8;
            assert(view.ok == valid);
            if (!valid) {
                assert(view.view.length == 0 && view.view.bytes.len() == 0);
            } else {
                for (int i = 0; i < 8; i += 1) { source[i] = 255; }
                for (int offset = -1; offset <= length; offset += 1) {
                    HBMReadResult b = hbm_read_u8(view.view, offset);
                    HBMReadResult w = hbm_read_u16le(view.view, offset);
                    HBMReadResult d = hbm_read_u32le(view.view, offset);
                    HBMU64ReadResult q = hbm_read_u64le(view.view, offset);
                    assert(b.ok == (offset >= 0 && offset + 1 <= length));
                    assert(w.ok == (offset >= 0 && offset + 2 <= length));
                    assert(d.ok == (offset >= 0 && offset + 4 <= length));
                    assert(q.ok == (offset >= 0 && offset + 8 <= length));
                    int first = start + offset + 1;
                    if (b.ok) { assert(b.value == first); }
                    if (w.ok) { assert(w.value == first + (first + 1) * 256); }
                    if (d.ok) { assert(d.value == first + (first + 1) * 256 + (first + 2) * 65536 + (first + 3) * 16777216); }
                    if (q.ok) {
                        assert(q.value.lo == 67305985 && q.value.hi == 134678021);
                    }
                }
            }
        }
    }
}

test "Helm canonical48 high limb boundary windows" {
    List<int> bases = new List<int>();
    bases.push(0); bases.push(32768); bases.push(4294934528); bases.push(4294967296);
    for (int i = 0; i < bases.len(); i += 1) {
        for (int delta = -32; delta <= 32; delta += 1) {
            int high = bases[i] + delta;
            bool expected = (high >= 0 && high < 32768) || (high >= 4294934528 && high < 4294967296);
            assert(hbm_x64_canonical48(hbm_u64(high, 0)) == expected);
            assert(hbm_x64_canonical48(hbm_u64(high, HBM_U32_MAX)) == expected);
        }
    }
}
