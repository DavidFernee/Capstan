    assert(assurance_helm_pair(0, 1, 0, 4294967295, true, 1, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 1, 0, true, 1, 1, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 32767, 4294967295, true, 32768, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 32768, 0, true, 32768, 1, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 2147483647, 4294967295, true, 2147483648, 0, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 2147483648, 0, true, 2147483648, 1, false, 0, 0, -1));
    assert(assurance_helm_pair(0, 1, 4294934527, 4294967295, true, 4294934528, 0, false, 0, 0, -1));
