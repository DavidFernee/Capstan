struct AGCheckedInt { bool ok; int value; }
AGCheckedInt ag_checked_add(int a,int b){
    if(a>1000000000||a< -1000000000||b>1000000000||b< -1000000000){return new AGCheckedInt{ok:false,value:0};}
    int value=a+b;
    if(value>1000000000||value< -1000000000){return new AGCheckedInt{ok:false,value:0};}
    return new AGCheckedInt{ok:true,value:value};
}

test "checked addition enforces result range as well as operand range" {
    assert(ag_checked_add(1000000000,0).ok);
    assert(!ag_checked_add(1000000000,1).ok);
    assert(!ag_checked_add(-1000000000,-1).ok);
    assert(!ag_checked_add(1000000001,0).ok);
}
