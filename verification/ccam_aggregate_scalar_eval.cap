import "ccam_aggregate_scalar_ir.cap";
struct AGScalarResult { bool ok; int value; }
AGScalarResult ag_scalar_eval_literals(List<AGScalarInstruction> instructions) {
 int value=0;
 if (instructions.len()==0 || instructions.len()>65536) { return new AGScalarResult{ok:false,value:0}; }
 for (int i=0;i<instructions.len();i+=1) {
  AGScalarInstruction ins=instructions[i];
  if (!ag_scalar_shape(ins,instructions.len()) || ins.opcode!=1 || ins.dest!=i) { return new AGScalarResult{ok:false,value:0}; }
  value=ins.immediate;
 }
 return new AGScalarResult{ok:true,value:value};
}
