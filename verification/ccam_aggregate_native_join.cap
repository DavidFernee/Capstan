test "native join emits exact bounded leaf" {
    List<int> b = new List<int>();
    assert(ag_native_emit_join(b));
    assert(b.len() == AG_NATIVE_JOIN_SIZE);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-join.bin", data));
}
