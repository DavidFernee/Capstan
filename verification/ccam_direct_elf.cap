// Direct Linux x86-64 backend for one scalar CCAM entry function.
// The kernel supplies the initial stack. This backend
// uses at most 3184 bytes of it and charges one step before every CCAM instruction.
import "ccam_calls.cap";
import "native_elf64.cap";
import "native_link_model.cap";
import "native_alu_encoding.cap";

// One label per instruction plus four shared exit labels fits the linker.
const int CCAM_DIRECT_INSTRUCTION_LIMIT = 252;
const int CCAM_DIRECT_REGISTER_LIMIT = 256;
const int CCAM_DIRECT_CALL_DEPTH = 16;
const int CCAM_DIRECT_CALL_REGISTERS = 15;

struct CCAMDirectResult {
    bool ok;
    List<int> bytes;
    string error;
}

CCAMDirectResult ccam_direct_error(string error) {
    return new CCAMDirectResult{ok: false, bytes: new List<int>(), error: error};
}

void ccam_direct_movabs(List<int> code, int reg, int value) {
    code.push(72);
    code.push(184 + reg);
    // Convert each low byte to its unsigned value before dividing, so
    // negative operands (including INT64_MIN) are shifted arithmetically.
    for (int i = 0; i < 8; i += 1) {
        int byte = value & 255;
        code.push(byte);
        value = (value - byte) / 256;
    }
}

// MOV between a register and a frame slot at [rsp + disp32].
void ccam_direct_slot(List<int> code, bool load, int reg, int slot) {
    code.push(72);
    if (load) { code.push(139); } else { code.push(137); }
    code.push(132 + reg * 8);
    code.push(36);
    native_elf_field(code, slot * 8, 4);
}

void ccam_direct_fixup(List<int> code, List<NativeFixup> fixups, int condition, int symbol) {
    code.push(15);
    code.push(condition);
    fixups.push(new NativeFixup{field: code.len(), symbol: symbol});
    native_elf_field(code, 0, 4);
}

void ccam_direct_jump(List<int> code, List<NativeFixup> fixups, int symbol) {
    code.push(233); // jmp rel32
    fixups.push(new NativeFixup{field: code.len(), symbol: symbol});
    native_elf_field(code, 0, 4);
}

void ccam_direct_exit_syscall(List<int> code) {
    code.push(184); native_elf_field(code, 60, 4);     // mov eax,SYS_exit
    code.push(15); code.push(5);                       // syscall
    code.push(15); code.push(11);                      // ud2 if exit returns
}

void ccam_direct_exit(List<int> code, int status) {
    code.push(191); native_elf_field(code, status, 4); // mov edi,status
    ccam_direct_exit_syscall(code);
}

void ccam_direct_write_result(List<int> code, int length, int failure_status) {
    // The caller supplies fd 3 (a fresh regular file). A single bounded
    // write transfers the result payload. Any short write or
    // error is a transport failure, and the caller discards the result.
    code.push(72); code.push(137); code.push(230);       // mov rsi,rsp
    code.push(186); native_elf_field(code, length, 4);   // mov edx,length
    code.push(191); native_elf_field(code, 3, 4);        // mov edi,3
    code.push(184); native_elf_field(code, 1, 4);        // mov eax,SYS_write
    code.push(15); code.push(5);                        // syscall
    // CMP rax,length uses a signed immediate. Preserve the compact scalar
    // encoding while allowing a record up to 1,136 bytes.
    code.push(72);
    if (length <= 127) {
        code.push(131); code.push(248); code.push(length);
    } else {
        code.push(61); native_elf_field(code, length, 4);
    }
    code.push(191); native_elf_field(code, failure_status, 4); // mov edi,status (preserves flags)
    code.push(186); native_elf_field(code, 0, 4);  // mov edx,0
    code.push(15); code.push(68); code.push(250); // cmove edi,edx
    ccam_direct_exit_syscall(code);
}

// Experimental scalar subset of the proposed CCAMRES v1 record. RAX holds
// the return value, R9D remaining fuel and R10D the current instruction PC.
void ccam_direct_record(List<int> code, int budget, int kind, int trap, int function_index, string name, string detail) {
    List<int> record = new List<int>();
    string magic = "CCAMRES";
    for (int i = 0; i < magic.len(); i += 1) { record.push(magic.at(i)); }
    record.push(0);
    native_elf_field(record, 1, 2);
    int function = 4294967295;
    int pc = 4294967295;
    if (kind == 2) {
        function = function_index;
        pc = 0;
    }
    native_elf_field(record, kind, 2);
    native_elf_field(record, trap, 4);
    native_elf_field(record, 0, 8); // signed value filled at runtime on return
    native_elf_field(record, 0, 8); // charged steps filled at runtime
    native_elf_field(record, function, 4);
    native_elf_field(record, pc, 4);
    native_elf_field(record, name.len(), 4);
    native_elf_field(record, detail.len(), 4);
    for (int i = 0; i < name.len(); i += 1) { record.push(name.at(i)); }
    for (int i = 0; i < detail.len(); i += 1) { record.push(detail.at(i)); }

    // Load the address just after the five-byte jump that skips the template.
    code.push(72); code.push(141); code.push(53);
    native_elf_field(code, 5, 4); // lea rsi,[rip+5]
    code.push(233); native_elf_field(code, record.len(), 4);
    for (int i = 0; i < record.len(); i += 1) { code.push(record[i]); }
    code.push(72); code.push(129); code.push(236); // sub rsp,length
    native_elf_field(code, record.len(), 4);
    code.push(72); code.push(137); code.push(231); // mov rdi,rsp
    code.push(185); native_elf_field(code, record.len(), 4); // mov ecx,length
    code.push(252); code.push(243); code.push(164); // cld; rep movsb
    if (kind == 0) {
        code.push(72); code.push(137); code.push(68); code.push(36); code.push(16);
    } else if (kind == 2) {
        code.push(68); code.push(137); code.push(84); code.push(36); code.push(36);
    }
    code.push(186); native_elf_field(code, budget, 4); // mov edx,budget
    code.push(68); code.push(41); code.push(202); // sub edx,r9d (zero-extends RDX)
    code.push(72); code.push(137); code.push(84); code.push(36); code.push(24);
    ccam_direct_write_result(code, record.len(), 76);
}

void ccam_direct_terminal_trap(List<int> code, bool record, int budget,
                               int trap, int function_index, string name, int legacy_status) {
    if (record) {
        ccam_direct_record(code, budget, 2, trap, function_index, name, "");
    } else {
        ccam_direct_exit(code, legacy_status);
    }
}

void ccam_direct_division(List<int> code, List<NativeFixup> fixups, bool remainder, int overflow, int divzero) {
    code.push(72); code.push(133); code.push(201); // test rcx,rcx
    ccam_direct_fixup(code, fixups, 132, divzero);
    code.push(72); code.push(131); code.push(249); code.push(255); // cmp rcx,-1
    if (remainder) {
        // x % -1 is always zero in CCAM, even when IDIV would overflow.
        code.push(117); code.push(4); // jne normal (xor + jmp)
        code.push(49); code.push(192); // xor eax,eax
        code.push(235); code.push(8); // jmp done (cqo + idiv + mov)
    } else {
        code.push(117); code.push(19); // jne normal (movabs + cmp + je)
        ccam_direct_movabs(code, 2, CCAM_I64_MIN);
        code.push(72); code.push(57); code.push(208); // cmp rax,rdx
        ccam_direct_fixup(code, fixups, 132, overflow);
    }
    code.push(72); code.push(153);                // cqo
    code.push(72); code.push(247); code.push(249); // idiv rcx
    if (remainder) {
        code.push(72); code.push(137); code.push(208); // mov rax,rdx
    }
}

void ccam_direct_binary(List<int> code, List<NativeFixup> fixups, int op, int overflow, int divzero) {
    if (op == CCAM_OP_DIV_I || op == CCAM_OP_REM_I) {
        ccam_direct_division(code, fixups, op == CCAM_OP_REM_I, overflow, divzero);
    } else if (op == CCAM_OP_MUL_I) {
        code.push(72); code.push(15); code.push(175); code.push(193); // imul rax,rcx
        ccam_direct_fixup(code, fixups, 128, overflow); // jo
    } else if (op == CCAM_OP_EQ_I || op == CCAM_OP_LT_I) {
        code.push(72); code.push(57); code.push(200); // cmp rax,rcx
        code.push(15);
        if (op == CCAM_OP_EQ_I) { code.push(148); } else { code.push(156); }
        code.push(192); // sete/setl al
        code.push(15); code.push(182); code.push(192); // movzx eax,al
    } else {
        int alu = NATIVE_ALU_ADD;
        if (op == CCAM_OP_SUB_I) { alu = NATIVE_ALU_SUB; }
        NativeRel32Result encoded = native_alu64(alu, 0, 1);
        for (int i = 0; i < encoded.bytes.len(); i += 1) {
            code.push(encoded.bytes[i]);
        }
        ccam_direct_fixup(code, fixups, 128, overflow);
    }
}

void ccam_direct_stack_adjust(List<int> code, bool reserve, int bytes) {
    code.push(72); code.push(129);
    if (reserve) { code.push(236); } else { code.push(196); }
    native_elf_field(code, bytes, 4);
}

void ccam_direct_call(List<int> code, List<NativeFixup> fixups, int symbol) {
    code.push(232);
    fixups.push(new NativeFixup{field: code.len(), symbol: symbol});
    native_elf_field(code, 0, 4);
}

CCAMCallSite ccam_direct_call_site(CCAMFunction fn, int pc) {
    for (int i = 0; i < fn.call_sites.len(); i += 1) {
        if (fn.call_sites[i].instruction_index == pc) { return fn.call_sites[i]; }
    }
    return new CCAMCallSite{
        instruction_index: -1, callee_index: -1, argument_registers: new List<int>(),
        destination_register: 0, has_destination: false
    };
}

struct CCAMDirectFlow {
    int read_first;
    int read_second;
    int write_register;
    int next_first;
    int next_second;
}

void ccam_direct_visit(List<int> work, List<bool> seen, int pc) {
    if (pc >= 0 && !seen[pc]) {
        seen[pc] = true;
        work.push(pc);
    }
}

// The canonical validator establishes operand types and index ranges.
// For each register, visit the paths on which it is still uninitialized.
// A write closes that path. Reads precede writes, including aliased operands.
// Each PC is visited at most once per register even on cyclic control flow.
string ccam_direct_profile(CCAMFunction fn) {
    List<CCAMDirectFlow> flow = new List<CCAMDirectFlow>();
    for (int pc = 0; pc < fn.instructions.len(); pc += 1) {
        CCAMInstruction ins = fn.instructions[pc];
        int op = ins.op;
        CCAMDirectFlow instruction = new CCAMDirectFlow{
            read_first: -1, read_second: -1, write_register: -1,
            next_first: -1, next_second: -1
        };
        if (op == CCAM_OP_JUMP) {
            instruction.next_first = ins.target;
        } else if (op == CCAM_OP_BRANCH) {
            instruction.read_first = ins.lhs;
            instruction.next_first = ins.if_true;
            instruction.next_second = ins.if_false;
        } else if (op == CCAM_OP_RET) {
            instruction.read_first = ins.lhs;
        } else if (op != CCAM_OP_TRAP && op != CCAM_OP_RET_VOID) {
            if (op >= CCAM_OP_ADD_I && op <= CCAM_OP_LT_I) {
                instruction.read_first = ins.lhs;
                instruction.read_second = ins.rhs;
            } else if (op == CCAM_OP_NOT_B) {
                instruction.read_first = ins.lhs;
            } else if (op == CCAM_OP_MOVE) {
                instruction.read_first = ins.src;
            } else if (op == CCAM_OP_CALL) {
                CCAMCallSite site = ccam_direct_call_site(fn, pc);
                if (site.instruction_index < 0) { return "missing_call_site"; }
            } else if (op != CCAM_OP_CONST_I && op != CCAM_OP_CONST_B) {
                return "unsupported_direct_instruction";
            }
            instruction.write_register = ins.dst;
            if (op == CCAM_OP_CALL) {
                CCAMCallSite site = ccam_direct_call_site(fn, pc);
                instruction.write_register = -1;
                if (site.has_destination) { instruction.write_register = site.destination_register; }
            }
            // The canonical validator rejects reachable fallthrough.
            if (pc + 1 < fn.instructions.len()) { instruction.next_first = pc + 1; }
        }
        flow.push(instruction);
    }
    for (int reg = fn.parameter_count; reg < fn.register_types.len(); reg += 1) {
        List<bool> seen = new List<bool>();
        for (int pc = 0; pc < flow.len(); pc += 1) { seen.push(false); }
        List<int> work = new List<int>();
        ccam_direct_visit(work, seen, 0);
        for (int cursor = 0; cursor < work.len(); cursor += 1) {
            CCAMDirectFlow ins = flow[work[cursor]];
            if (ins.read_first == reg || ins.read_second == reg) {
                return "uninitialised_register";
            }
            if (fn.instructions[work[cursor]].op == CCAM_OP_CALL) {
                CCAMCallSite site = ccam_direct_call_site(fn, work[cursor]);
                for (int arg = 0; arg < site.argument_registers.len(); arg += 1) {
                    if (site.argument_registers[arg] == reg) { return "uninitialised_register"; }
                }
            }
            if (ins.write_register != reg) {
                ccam_direct_visit(work, seen, ins.next_first);
                ccam_direct_visit(work, seen, ins.next_second);
            }
        }
    }
    return "";
}

CCAMDirectResult ccam_direct_elf(List<CCAMFunction> functions, int entry, int max_steps) {
    return ccam_direct_elf_with_record(functions, entry, max_steps, false);
}

CCAMDirectResult ccam_direct_elf_with_record(List<CCAMFunction> functions, int entry,
                                            int max_steps, bool record) {
    if (max_steps < 0 || max_steps > CCAM_MAX_STEPS) {
        return ccam_direct_error("invalid_step_budget");
    }
    if (entry < 0 || entry >= functions.len()) {
        return ccam_direct_error("direct_backend_requires_one_entry");
    }
    CCAMFunction entry_function = functions[entry];
    bool integer_entry = entry_function.return_type == CCAM_RETURN_INT &&
        entry_function.register_types.len() > 0;
    bool void_record_entry = record && entry_function.return_type == CCAM_RETURN_VOID;
    if (entry_function.parameter_count != 0 || (!integer_entry && !void_record_entry)) {
        return ccam_direct_error("unsupported_direct_profile");
    }
    bool calls = functions.len() > 1 || entry_function.call_sites.len() > 0;
    List<int> bases = new List<int>();
    int labels = 0;
    int frame_slots = 0;
    for (int index = 0; index < functions.len(); index += 1) {
        CCAMFunction fn = functions[index];
        int registers = fn.register_types.len();
        if (registers > CCAM_DIRECT_REGISTER_LIMIT ||
            (calls && registers > CCAM_DIRECT_CALL_REGISTERS) ||
            fn.instructions.len() > CCAM_DIRECT_INSTRUCTION_LIMIT) {
            return ccam_direct_error("unsupported_direct_profile");
        }
        bases.push(labels);
        labels += fn.instructions.len() + 4;
        if (labels > 256) { return ccam_direct_error("unsupported_direct_profile"); }
        if (registers > frame_slots) { frame_slots = registers; }
    }
    CCAMValidationResult valid = ccam_validate_multi_function(functions, entry);
    if (!valid.ok) { return ccam_direct_error(valid.error); }
    for (int index = 0; index < functions.len(); index += 1) {
        CCAMFunction fn = functions[index];
        for (int site = 0; site < fn.call_sites.len(); site += 1) {
            if (fn.call_sites[site].callee_index == entry) {
                return ccam_direct_error("unsupported_call_to_direct_entry");
            }
        }
        string profile = ccam_direct_profile(functions[index]);
        if (profile != "") { return ccam_direct_error(profile); }
    }

    List<NativeFixup> fixups = new List<NativeFixup>();
    List<int> code = new List<int>();
    List<NativeSymbol> symbols = new List<NativeSymbol>();
    int slot_offset = 0;
    ccam_direct_stack_adjust(code, true, frame_slots * 8);
    code.push(65); code.push(185); // mov r9d,imm32; R9 is reserved for remaining steps
    native_elf_field(code, max_steps, 4);
    if (calls) {
        slot_offset = 1;
        code.push(65); code.push(184); // mov r8d,1; depth includes entry
        native_elf_field(code, 1, 4);
        ccam_direct_call(code, fixups, bases[entry]);
        code.push(15); code.push(11); // entry terminates the process
    }
    for (int function_index = 0; function_index < functions.len(); function_index += 1) {
        CCAMFunction fn = functions[function_index];
        int base = bases[function_index];
        int overflow = base + fn.instructions.len();
        int divzero = overflow + 1;
        int fuel = overflow + 2;
        int depth = overflow + 3;
        for (int pc = 0; pc < fn.instructions.len(); pc += 1) {
            CCAMInstruction ins = fn.instructions[pc];
            int op = ins.op;
            symbols.push(new NativeSymbol{id: base + pc, offset: code.len()});
            if (record) {
                code.push(65); code.push(186); // mov r10d,pc, before the fuel check
                native_elf_field(code, pc, 4);
            }
            code.push(69); code.push(133); code.push(201); // test r9d,r9d
            ccam_direct_fixup(code, fixups, 132, fuel);
            code.push(65); code.push(255); code.push(201); // dec r9d
            if (op == CCAM_OP_JUMP) {
                ccam_direct_jump(code, fixups, base + ins.target);
                continue;
            }
            if (op == CCAM_OP_TRAP) {
                if (record) {
                    ccam_direct_record(code, max_steps, 2, 8, function_index, fn.name, ins.reason);
                } else {
                    ccam_direct_exit(code, 72);
                }
                continue;
            }
            if (op == CCAM_OP_CALL) {
                CCAMCallSite site = ccam_direct_call_site(fn, pc);
                code.push(65); code.push(131); code.push(248); code.push(CCAM_DIRECT_CALL_DEPTH);
                ccam_direct_fixup(code, fixups, 131, depth); // jae
                ccam_direct_stack_adjust(code, true, frame_slots * 8);
                for (int arg = 0; arg < site.argument_registers.len(); arg += 1) {
                    ccam_direct_slot(code, true, 0, frame_slots + slot_offset + site.argument_registers[arg]);
                    ccam_direct_slot(code, false, 0, arg);
                }
                code.push(65); code.push(255); code.push(192); // inc r8d
                ccam_direct_call(code, fixups, bases[site.callee_index]);
                code.push(65); code.push(255); code.push(200); // dec r8d
                ccam_direct_stack_adjust(code, false, frame_slots * 8);
                if (site.has_destination) {
                    ccam_direct_slot(code, false, 0, slot_offset + site.destination_register);
                }
                continue;
            }
            if (op == CCAM_OP_RET_VOID) {
                if (function_index != entry) {
                    code.push(195);
                } else {
                    ccam_direct_record(code, max_steps, 1, 0, 0, "", "");
                }
                continue;
            }
            if (op == CCAM_OP_CONST_I) {
                ccam_direct_movabs(code, 0, ins.int_value);
            } else if (op == CCAM_OP_CONST_B) {
                int value = 0;
                if (ins.bool_value) { value = 1; }
                ccam_direct_movabs(code, 0, value);
            } else {
                int source = ins.lhs;
                if (op == CCAM_OP_MOVE) { source = ins.src; }
                ccam_direct_slot(code, true, 0, slot_offset + source);
                if (op == CCAM_OP_RET) {
                    if (function_index != entry) {
                        code.push(195);
                    } else if (record) {
                        ccam_direct_record(code, max_steps, 0, 0, 0, "", "");
                    } else {
                        code.push(80); // push rax
                        ccam_direct_write_result(code, 8, 77);
                    }
                    continue;
                }
                if (op == CCAM_OP_BRANCH) {
                    code.push(72); code.push(133); code.push(192); // test rax,rax
                    ccam_direct_fixup(code, fixups, 133, base + ins.if_true);
                    ccam_direct_jump(code, fixups, base + ins.if_false);
                    continue;
                }
                if (op == CCAM_OP_NOT_B) {
                    code.push(131); code.push(240); code.push(1); // xor eax,1
                } else if (op != CCAM_OP_MOVE) {
                    ccam_direct_slot(code, true, 1, slot_offset + ins.rhs);
                    ccam_direct_binary(code, fixups, op, overflow, divzero);
                }
            }
            ccam_direct_slot(code, false, 0, slot_offset + ins.dst);
        }
        symbols.push(new NativeSymbol{id: overflow, offset: code.len()});
        ccam_direct_terminal_trap(code, record, max_steps, 1, function_index, fn.name, 70);
        symbols.push(new NativeSymbol{id: divzero, offset: code.len()});
        ccam_direct_terminal_trap(code, record, max_steps, 2, function_index, fn.name, 71);
        symbols.push(new NativeSymbol{id: fuel, offset: code.len()});
        ccam_direct_terminal_trap(code, record, max_steps, 6, function_index, fn.name, 73);
        symbols.push(new NativeSymbol{id: depth, offset: code.len()});
        ccam_direct_terminal_trap(code, record, max_steps, 7, function_index, fn.name, 74);
    }
    NativeLinkResult linked = native_link_image(code, symbols, fixups);
    if (!linked.ok) { return ccam_direct_error("direct_relocation_failed"); }
    NativeElfImage image = native_elf64_image_with_stack(linked.bytes, 0, true);
    if (!image.ok) { return ccam_direct_error("direct_elf_failed"); }
    return new CCAMDirectResult{ok: true, bytes: image.bytes, error: ""};
}
