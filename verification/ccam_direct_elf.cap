// Direct Linux x86-64 backend for one integer-returning
// CCAM entry function. The kernel supplies the initial stack. This backend
// uses at most 2056 bytes of it and charges one step before every CCAM instruction.
import "ccam_calls.cap";
import "native_elf64.cap";
import "native_link_model.cap";
import "native_alu_encoding.cap";

// One label per instruction plus four shared exit labels fits the linker.
const int CCAM_DIRECT_INSTRUCTION_LIMIT = 252;
const int CCAM_DIRECT_REGISTER_LIMIT = 256;
const int CCAM_DIRECT_OVERFLOW = 252;
const int CCAM_DIRECT_DIVZERO = 253;
const int CCAM_DIRECT_STEP_LIMIT = 254;
const int CCAM_DIRECT_EXPLICIT_TRAP = 255;

struct CCAMDirectResult {
    bool ok;
    List<int> bytes;
    string error;
}

CCAMDirectResult ccam_direct_error(string error) {
    return new CCAMDirectResult{ok: false, bytes: new List<int>(), error: error};
}

void ccam_direct_movabs(List<int> code, int reg, int value) {
    code.push(72);
    code.push(184 + reg);
    // Convert each low byte to its unsigned value before dividing, so
    // negative operands (including INT64_MIN) are shifted arithmetically.
    for (int i = 0; i < 8; i += 1) {
        int byte = value & 255;
        code.push(byte);
        value = (value - byte) / 256;
    }
}

// MOV between a register and a frame slot at [rsp + disp32].
void ccam_direct_slot(List<int> code, bool load, int reg, int slot) {
    code.push(72);
    if (load) { code.push(139); } else { code.push(137); }
    code.push(132 + reg * 8);
    code.push(36);
    native_elf_field(code, slot * 8, 4);
}

void ccam_direct_fixup(List<int> code, List<NativeFixup> fixups, int condition, int symbol) {
    code.push(15);
    code.push(condition);
    fixups.push(new NativeFixup{field: code.len(), symbol: symbol});
    native_elf_field(code, 0, 4);
}

void ccam_direct_jump(List<int> code, List<NativeFixup> fixups, int symbol) {
    code.push(233); // jmp rel32
    fixups.push(new NativeFixup{field: code.len(), symbol: symbol});
    native_elf_field(code, 0, 4);
}

void ccam_direct_exit_syscall(List<int> code) {
    code.push(184); native_elf_field(code, 60, 4);     // mov eax,SYS_exit
    code.push(15); code.push(5);                       // syscall
    code.push(15); code.push(11);                      // ud2 if exit returns
}

void ccam_direct_exit(List<int> code, int status) {
    code.push(191); native_elf_field(code, status, 4); // mov edi,status
    ccam_direct_exit_syscall(code);
}

void ccam_direct_result(List<int> code) {
    // The caller supplies fd 3 (a fresh regular file). A single bounded
    // write transfers the signed little-endian result. Any short write or
    // error is a transport failure, and the caller discards the result.
    code.push(80);                                      // push rax
    code.push(72); code.push(137); code.push(230);       // mov rsi,rsp
    code.push(186); native_elf_field(code, 8, 4);        // mov edx,8
    code.push(191); native_elf_field(code, 3, 4);        // mov edi,3
    code.push(184); native_elf_field(code, 1, 4);        // mov eax,SYS_write
    code.push(15); code.push(5);                        // syscall
    code.push(72); code.push(131); code.push(248); code.push(8); // cmp rax,8
    code.push(191); native_elf_field(code, 77, 4); // mov edi,77 (preserves flags)
    code.push(186); native_elf_field(code, 0, 4);  // mov edx,0
    code.push(15); code.push(68); code.push(250); // cmove edi,edx
    ccam_direct_exit_syscall(code);
}

void ccam_direct_division(List<int> code, List<NativeFixup> fixups, bool remainder) {
    code.push(72); code.push(133); code.push(201); // test rcx,rcx
    ccam_direct_fixup(code, fixups, 132, CCAM_DIRECT_DIVZERO);
    code.push(72); code.push(131); code.push(249); code.push(255); // cmp rcx,-1
    if (remainder) {
        // x % -1 is always zero in CCAM, even when IDIV would overflow.
        code.push(117); code.push(4); // jne normal (xor + jmp)
        code.push(49); code.push(192); // xor eax,eax
        code.push(235); code.push(8); // jmp done (cqo + idiv + mov)
    } else {
        code.push(117); code.push(19); // jne normal (movabs + cmp + je)
        ccam_direct_movabs(code, 2, CCAM_I64_MIN);
        code.push(72); code.push(57); code.push(208); // cmp rax,rdx
        ccam_direct_fixup(code, fixups, 132, CCAM_DIRECT_OVERFLOW);
    }
    code.push(72); code.push(153);                // cqo
    code.push(72); code.push(247); code.push(249); // idiv rcx
    if (remainder) {
        code.push(72); code.push(137); code.push(208); // mov rax,rdx
    }
}

void ccam_direct_binary(List<int> code, List<NativeFixup> fixups, int op) {
    if (op == CCAM_OP_DIV_I || op == CCAM_OP_REM_I) {
        ccam_direct_division(code, fixups, op == CCAM_OP_REM_I);
    } else if (op == CCAM_OP_MUL_I) {
        code.push(72); code.push(15); code.push(175); code.push(193); // imul rax,rcx
        ccam_direct_fixup(code, fixups, 128, CCAM_DIRECT_OVERFLOW); // jo
    } else if (op == CCAM_OP_EQ_I || op == CCAM_OP_LT_I) {
        code.push(72); code.push(57); code.push(200); // cmp rax,rcx
        code.push(15);
        if (op == CCAM_OP_EQ_I) { code.push(148); } else { code.push(156); }
        code.push(192); // sete/setl al
        code.push(15); code.push(182); code.push(192); // movzx eax,al
    } else {
        int alu = NATIVE_ALU_ADD;
        if (op == CCAM_OP_SUB_I) { alu = NATIVE_ALU_SUB; }
        NativeRel32Result encoded = native_alu64(alu, 0, 1);
        for (int i = 0; i < encoded.bytes.len(); i += 1) {
            code.push(encoded.bytes[i]);
        }
        ccam_direct_fixup(code, fixups, 128, CCAM_DIRECT_OVERFLOW);
    }
}

struct CCAMDirectFlow {
    int read_first;
    int read_second;
    int write_register;
    int next_first;
    int next_second;
}

void ccam_direct_visit(List<int> work, List<bool> seen, int pc) {
    if (pc >= 0 && !seen[pc]) {
        seen[pc] = true;
        work.push(pc);
    }
}

// The canonical validator establishes operand types and index ranges.
// For each register, visit the paths on which it is still uninitialized.
// A write closes that path. Reads precede writes, including aliased operands.
// Each PC is visited at most once per register even on cyclic control flow.
string ccam_direct_profile(CCAMFunction fn) {
    List<CCAMDirectFlow> flow = new List<CCAMDirectFlow>();
    for (int pc = 0; pc < fn.instructions.len(); pc += 1) {
        CCAMInstruction ins = fn.instructions[pc];
        int op = ins.op;
        CCAMDirectFlow instruction = new CCAMDirectFlow{
            read_first: -1, read_second: -1, write_register: -1,
            next_first: -1, next_second: -1
        };
        if (op == CCAM_OP_JUMP) {
            instruction.next_first = ins.target;
        } else if (op == CCAM_OP_BRANCH) {
            instruction.read_first = ins.lhs;
            instruction.next_first = ins.if_true;
            instruction.next_second = ins.if_false;
        } else if (op == CCAM_OP_RET) {
            instruction.read_first = ins.lhs;
        } else if (op != CCAM_OP_TRAP) {
            if (op >= CCAM_OP_ADD_I && op <= CCAM_OP_LT_I) {
                instruction.read_first = ins.lhs;
                instruction.read_second = ins.rhs;
            } else if (op == CCAM_OP_NOT_B) {
                instruction.read_first = ins.lhs;
            } else if (op == CCAM_OP_MOVE) {
                instruction.read_first = ins.src;
            } else if (op != CCAM_OP_CONST_I && op != CCAM_OP_CONST_B) {
                return "unsupported_direct_instruction";
            }
            instruction.write_register = ins.dst;
            // The canonical validator rejects reachable fallthrough.
            if (pc + 1 < fn.instructions.len()) { instruction.next_first = pc + 1; }
        }
        flow.push(instruction);
    }
    for (int reg = 0; reg < fn.register_types.len(); reg += 1) {
        List<bool> seen = new List<bool>();
        for (int pc = 0; pc < flow.len(); pc += 1) { seen.push(false); }
        List<int> work = new List<int>();
        ccam_direct_visit(work, seen, 0);
        for (int cursor = 0; cursor < work.len(); cursor += 1) {
            CCAMDirectFlow ins = flow[work[cursor]];
            if (ins.read_first == reg || ins.read_second == reg) {
                return "uninitialised_register";
            }
            if (ins.write_register != reg) {
                ccam_direct_visit(work, seen, ins.next_first);
                ccam_direct_visit(work, seen, ins.next_second);
            }
        }
    }
    return "";
}

CCAMDirectResult ccam_direct_elf(List<CCAMFunction> functions, int entry, int max_steps) {
    if (max_steps < 0 || max_steps > CCAM_MAX_STEPS) {
        return ccam_direct_error("invalid_step_budget");
    }
    if (functions.len() != 1 || entry != 0) {
        return ccam_direct_error("direct_backend_requires_one_entry");
    }
    CCAMFunction fn = functions[0];
    if (fn.parameter_count != 0 || fn.return_type != CCAM_RETURN_INT ||
        fn.call_sites.len() != 0 || fn.register_types.len() == 0 || fn.register_types.len() > CCAM_DIRECT_REGISTER_LIMIT ||
        fn.instructions.len() > CCAM_DIRECT_INSTRUCTION_LIMIT) {
        return ccam_direct_error("unsupported_direct_profile");
    }
    CCAMValidationResult valid = ccam_validate_multi_function(functions, entry);
    if (!valid.ok) { return ccam_direct_error(valid.error); }
    string profile = ccam_direct_profile(fn);
    if (profile != "") { return ccam_direct_error(profile); }

    List<NativeFixup> fixups = new List<NativeFixup>();
    List<int> code = new List<int>();
    List<NativeSymbol> symbols = new List<NativeSymbol>();
    code.push(72); code.push(129); code.push(236); // sub rsp,imm32
    native_elf_field(code, fn.register_types.len() * 8, 4);
    code.push(65); code.push(185); // mov r9d,imm32; R9 is reserved for remaining steps
    native_elf_field(code, max_steps, 4);
    for (int pc = 0; pc < fn.instructions.len(); pc += 1) {
        CCAMInstruction ins = fn.instructions[pc];
        int op = ins.op;
        symbols.push(new NativeSymbol{id: pc, offset: code.len()});
        code.push(69); code.push(133); code.push(201); // test r9d,r9d
        ccam_direct_fixup(code, fixups, 132, CCAM_DIRECT_STEP_LIMIT);
        code.push(65); code.push(255); code.push(201); // dec r9d
        if (op == CCAM_OP_JUMP) {
            ccam_direct_jump(code, fixups, ins.target);
            continue;
        }
        if (op == CCAM_OP_TRAP) {
            ccam_direct_jump(code, fixups, CCAM_DIRECT_EXPLICIT_TRAP);
            continue;
        }
        if (op == CCAM_OP_CONST_I) {
            ccam_direct_movabs(code, 0, ins.int_value);
        } else if (op == CCAM_OP_CONST_B) {
            int value = 0;
            if (ins.bool_value) { value = 1; }
            ccam_direct_movabs(code, 0, value);
        } else {
            int source = ins.lhs;
            if (op == CCAM_OP_MOVE) { source = ins.src; }
            ccam_direct_slot(code, true, 0, source);
            if (op == CCAM_OP_RET) {
                ccam_direct_result(code);
                continue;
            }
            if (op == CCAM_OP_BRANCH) {
                code.push(72); code.push(133); code.push(192); // test rax,rax
                ccam_direct_fixup(code, fixups, 133, ins.if_true);
                ccam_direct_jump(code, fixups, ins.if_false);
                continue;
            }
            if (op == CCAM_OP_NOT_B) {
                code.push(131); code.push(240); code.push(1); // xor eax,1
            } else if (op != CCAM_OP_MOVE) {
                ccam_direct_slot(code, true, 1, ins.rhs);
                ccam_direct_binary(code, fixups, op);
            }
        }
        ccam_direct_slot(code, false, 0, ins.dst);
    }
    symbols.push(new NativeSymbol{id: CCAM_DIRECT_OVERFLOW, offset: code.len()});
    ccam_direct_exit(code, 70);
    symbols.push(new NativeSymbol{id: CCAM_DIRECT_DIVZERO, offset: code.len()});
    ccam_direct_exit(code, 71);
    symbols.push(new NativeSymbol{id: CCAM_DIRECT_STEP_LIMIT, offset: code.len()});
    ccam_direct_exit(code, 73);
    symbols.push(new NativeSymbol{id: CCAM_DIRECT_EXPLICIT_TRAP, offset: code.len()});
    ccam_direct_exit(code, 72);
    NativeLinkResult linked = native_link_image(code, symbols, fixups);
    if (!linked.ok) { return ccam_direct_error("direct_relocation_failed"); }
    NativeElfImage image = native_elf64_image_with_stack(linked.bytes, 0, true);
    if (!image.ok) { return ccam_direct_error("direct_elf_failed"); }
    return new CCAMDirectResult{ok: true, bytes: image.bytes, error: ""};
}
