test "x86 exact GNU assembler vectors register 1" {
    List<int> expected = new List<int>();
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(193);
    assert(assurance_x86_fixture(0, 1, 0, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(193);
    assert(assurance_x86_fixture(1, 1, 0, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(137); expected.push(193);
    assert(assurance_x86_fixture(2, 1, 0, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(15); expected.push(175); expected.push(200);
    assert(assurance_x86_fixture(3, 1, 0, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(201);
    assert(assurance_x86_fixture(0, 1, 1, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(201);
    assert(assurance_x86_fixture(1, 1, 1, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(137); expected.push(201);
    assert(assurance_x86_fixture(2, 1, 1, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(15); expected.push(175); expected.push(201);
    assert(assurance_x86_fixture(3, 1, 1, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(209);
    assert(assurance_x86_fixture(0, 1, 2, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(209);
    assert(assurance_x86_fixture(1, 1, 2, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(137); expected.push(209);
    assert(assurance_x86_fixture(2, 1, 2, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(15); expected.push(175); expected.push(202);
    assert(assurance_x86_fixture(3, 1, 2, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(217);
    assert(assurance_x86_fixture(0, 1, 3, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(217);
    assert(assurance_x86_fixture(1, 1, 3, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(137); expected.push(217);
    assert(assurance_x86_fixture(2, 1, 3, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(15); expected.push(175); expected.push(203);
    assert(assurance_x86_fixture(3, 1, 3, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(225);
    assert(assurance_x86_fixture(0, 1, 4, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(225);
    assert(assurance_x86_fixture(1, 1, 4, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(137); expected.push(225);
    assert(assurance_x86_fixture(2, 1, 4, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(15); expected.push(175); expected.push(204);
    assert(assurance_x86_fixture(3, 1, 4, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(1); expected.push(233);
    assert(assurance_x86_fixture(0, 1, 5, 0, expected));
    expected = new List<int>(); expected.push(72); expected.push(41); expected.push(233);
    assert(assurance_x86_fixture(1, 1, 5, 0, expected));
