test "x86 exact GNU assembler vectors register 15" {
    List<int> expected = new List<int>();
    expected = new List<int>(); expected.push(73); expected.push(1); expected.push(199);
    assert(assurance_x86_fixture(0, 15, 0, 0, expected));
    expected = new List<int>(); expected.push(73); expected.push(41); expected.push(199);
    assert(assurance_x86_fixture(1, 15, 0, 0, expected));
