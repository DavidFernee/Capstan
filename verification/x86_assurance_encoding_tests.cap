import "ccam_research_native_x86_scalar_ops.cap";
import "ccam_research_native_x86_spill_memory.cap";
import "ccam_research_native_x86_mov_rr.cap";

// Fixed bytes checked independently against GNU as --64 and objcopy.
bool assurance_x86_bytes(List<int> actual, List<int> expected) {
    if (actual.len() != expected.len() + 1 || actual[0] != 204) { return false; }
    for (int i = 0; i < expected.len(); i += 1) {
        if (actual[i + 1] != expected[i]) { return false; }
    }
    return true;
}

bool assurance_x86_fixture(int op, int dst, int src, int imm, List<int> expected) {
    List<int> bytes = new List<int>(); bytes.push(204);
    bool ok = false;
    if (op == 0) { ok = ag_x86_add_rr(bytes, dst, src); }
    else if (op == 1) { ok = ag_x86_sub_rr(bytes, dst, src); }
    else if (op == 2) { ok = ag_x86_mov_rr(bytes, dst, src); }
    else if (op == 3) { ok = ag_x86_imul_rr(bytes, dst, src); }
    else if (op == 4) { ok = ag_x86_mov_ri64(bytes, dst, imm); }
    else if (op == 5) { ok = ag_x86_store_rbp(bytes, dst, imm); }
    else if (op == 6) { ok = ag_x86_load_rbp(bytes, dst, imm); }
    return ok && assurance_x86_bytes(bytes, expected);
}

