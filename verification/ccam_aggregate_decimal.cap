import "ccam_aggregate_character.cap";
struct AGDecimal { bool ok; int value; }
AGDecimal ag_decimal_span(List<int> bytes, int start, int end) {
 int value = 0;
 AGDecimal invalid = new AGDecimal{ok:false,value:0};
 if (start < 0 || end <= start || end > bytes.len()) { return invalid; }
 for (int i=start; i<end; i+=1) {
  if (!ag_digit(bytes[i])) { return invalid; }
  int digit = bytes[i] - 48;
  if (value > (9223372036854775807 - digit) / 10) { return invalid; }
  value = value * 10 + digit;
 }
 return new AGDecimal{ok:true,value:value};
}
AGDecimal ag_decimal(List<int> bytes) {
 return ag_decimal_span(bytes,0,bytes.len());
}
test "decimal rejects malformed input" {
 List<int> digits = new List<int>(); digits.push(49); digits.push(50);
 assert(ag_decimal(digits).value == 12);
 digits.push(65); assert(!ag_decimal(digits).ok);
}
