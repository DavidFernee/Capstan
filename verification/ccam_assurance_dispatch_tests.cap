test "dispatch sub alias and fuel row 0" {
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, CCAM_I64_MIN, 0, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, -9223372036854775807, -1, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, -3037000500, -9223372033817775308, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, -3037000499, -9223372033817775309, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, -2, -9223372036854775806, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, -1, -9223372036854775807, ""));
    assert(assurance_dispatch_case(CCAM_OP_SUB_I, CCAM_I64_MIN, 0, CCAM_I64_MIN, ""));
