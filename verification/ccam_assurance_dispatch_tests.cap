import "ccam_core.cap";

// Independent exact results, all three destination aliases, all six fuel prefixes.
bool assurance_dispatch_case(int op, int a, int b, int want, string trap) {
    for (int dst = 0; dst < 3; dst += 1) {
        for (int fuel = 0; fuel <= 5; fuel += 1) {
            List<int> types = new List<int>();
            types.push(CCAM_TYPE_INT); types.push(CCAM_TYPE_INT); types.push(CCAM_TYPE_INT);
            List<CCAMInstruction> code = new List<CCAMInstruction>();
            CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
            i.dst = 0; i.int_value = a; code.push(i);
            i = ccam_instruction(CCAM_OP_CONST_I);
            i.dst = 1; i.int_value = b; code.push(i);
            i = ccam_instruction(CCAM_OP_CONST_I);
            i.dst = 2; i.int_value = 73; code.push(i);
            i = ccam_instruction(op);
            i.dst = dst; i.lhs = 0; i.rhs = 1; code.push(i);
            i = ccam_instruction(CCAM_OP_RET);
            i.lhs = dst; code.push(i);
            CCAMMachineCreateResult created = ccam_machine_create_validated(types, code, fuel, CCAM_RETURN_INT);
            if (!created.ok) { return false; }
            CCAMMachineState state = created.state;
            for (int n = 0; n < 6; n += 1) { ccam_machine_step(state); }
            string expected = "step_limit_exceeded";
            int steps = fuel;
            int pc = fuel;
            bool computed = fuel >= 4 && trap == "";
            bool returned = computed && fuel == 5;
            if (fuel >= 4 && trap != "") {
                expected = trap; steps = 4; pc = 3;
            } else if (returned) {
                expected = ""; pc = 4;
            }
            if (!state.halted || state.steps != steps || state.pc != pc ||
                state.trap_code != expected || state.halt_has_value != returned) { return false; }
            if (returned && state.halt_value != want) { return false; }
            for (int r = 0; r < 3; r += 1) {
                bool initialized = fuel > r;
                int value = 73;
                if (r == 0) { value = a; }
                if (r == 1) { value = b; }
                if (computed && r == dst) { value = want; }
                CCAMRegisterResult read = ccam_register_read_int(state.registers, r);
                if (read.ok != initialized) { return false; }
                if (initialized && read.int_value != value) { return false; }
                if (!initialized && read.trap != "uninitialised_register") { return false; }
            }
            if (state.output_bytes.len() != 0) { return false; }
            ccam_machine_step(state);
            if (state.steps != steps || state.pc != pc || state.trap_code != expected) { return false; }
        }
    }
    return true;
}

test "dispatch add alias and fuel row 0" {
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, CCAM_I64_MIN, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, -9223372036854775807, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, -3037000500, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, -3037000499, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, -2, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, -1, 0, "integer_overflow"));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 0, CCAM_I64_MIN, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 1, -9223372036854775807, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 2, -9223372036854775806, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 3037000499, -9223372033817775309, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 3037000500, -9223372033817775308, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, 9223372036854775806, -2, ""));
    assert(assurance_dispatch_case(CCAM_OP_ADD_I, CCAM_I64_MIN, CCAM_I64_MAX, -1, ""));
}

