// Register all supported checked source declarations in deterministic source order.
// No mutable AST nodes are retained by the executable snapshot.
import "ccam_aggregate_checked_source.cap";

struct AGSourceModuleResult {
    bool ok;
    AGSealedProgram program;
    List<string> function_names;
    List<string> record_names;
    string error;
}

AGSourceModuleResult ag_source_module_failure(string error) {
    return new AGSourceModuleResult{ok: false, program: ag_seal_failure(error).program,
        function_names: new List<string>(), record_names: new List<string>(), error: error};
}

AGSourceModuleResult ag_source_lower_checked(Ctx ctx, List<Node> declarations) {
    if (error_count(ctx) != 0) { return ag_source_module_failure("source_diagnostics"); }
    if (declarations.len() > AG_SOURCE_MAX_RECORDS + AG_SEALED_MAX_FUNCTIONS) {
        return ag_source_module_failure("source_declaration_limit");
    }
    Map<int> records = new Map<int>();
    Map<Node> record_nodes = new Map<Node>();
    Map<Node> constants = new Map<Node>();
    int total_fields = 0;
    Map<int> names = new Map<int>();
    List<string> record_names = new List<string>();
    List<string> function_names = new List<string>();
    for (int i = 0; i < declarations.len(); i += 1) {
        Node d = declarations[i];
        if (d.s.len() == 0 || d.s.len() > AG_SOURCE_MAX_NAME || names.has(d.s)) {
            return ag_source_module_failure("invalid_declaration_name");
        }
        names.set(d.s, 1);
        if (d.k == N_STRUCT) {
            if (d.s2 != "" || d.s3 != "" || record_names.len() >= AG_SOURCE_MAX_RECORDS) {
                return ag_source_module_failure("unsupported_record_declaration");
            }
            if (d.kids.len() > AG_SCHEMA_MAX_RECORD_FIELDS ||
                d.kids.len() > AG_SEALED_MAX_INSTRUCTIONS - total_fields) {
                return ag_source_module_failure("source_field_limit");
            }
            total_fields += d.kids.len();
            record_names.push(d.s);
            records.set(d.s, record_names.len());
            record_nodes.set(d.s, d);
        } else if (d.k == N_FN) {
            if (function_names.len() >= AG_SEALED_MAX_FUNCTIONS) {
                return ag_source_module_failure("source_function_limit");
            }
            function_names.push(d.s);
        } else if (d.k == N_CONST && d.kids.len() == 1) {
            Type t = ty_of(d);
            Node literal = d.kids[0];
            if (!((t.k == TY_INT && literal.k == N_INT) ||
                (t.k == TY_BOOL && literal.k == N_BOOL && (literal.n == 0 || literal.n == 1))) ||
                t.args.len() != 0 || t.name != "" || literal.kids.len() != 0) {
                return ag_source_module_failure("unsupported_constant");
            }
            constants.set(d.s, d);
        } else { return ag_source_module_failure("unsupported_top_level_declaration"); }
    }
    // Record shapes are lowered into constructor/field instruction operands.
    // The registry does not yet enforce a unique layout for externally supplied objects.
    List<AGFunction> functions = new List<AGFunction>();
    List<AGNominalSignature> signatures = new List<AGNominalSignature>();
    int total_registers = 0;
    int total_instructions = 0;
    int total_blocks = 0;
    for (int i = 0; i < declarations.len(); i += 1) {
        Node d = declarations[i];
        if (d.k == N_FN) {
            if (let lowered = ag_source_lower_function(d, records, record_nodes, constants)) {
                int registers = lowered.function.kinds.len();
                if (lowered.function.blocks.len() > AG_SEALED_MAX_BLOCKS - total_blocks) {
                    return ag_source_module_failure("source_module_limit");
                }
                total_blocks += lowered.function.blocks.len();
                int instructions = 0;
                for (int j = 0; j < lowered.function.blocks.len(); j += 1) {
                    instructions += lowered.function.blocks[j].instructions.len();
                }
                if (registers > AG_SEALED_MAX_REGISTERS - total_registers ||
                    instructions > AG_SEALED_MAX_INSTRUCTIONS - total_instructions) {
                    return ag_source_module_failure("source_module_limit");
                }
                total_registers += registers;
                total_instructions += instructions;
                functions.push(lowered.function);
                signatures.push(lowered.signature);
            } else { return ag_source_module_failure("unsupported_function_body"); }
        }
    }
    AGSealResult sealed = ag_seal_program(functions, signatures);
    if (!sealed.ok) { return ag_source_module_failure(sealed.error); }
    return new AGSourceModuleResult{ok: true, program: sealed.program,
        function_names: function_names, record_names: record_names, error: ""};
}
