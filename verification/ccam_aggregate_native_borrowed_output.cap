// Candidate Linux x86-64 borrowed regular-file FD output, NOT write_file.
// RAX=trusted immutable string handle, R8=caller-authorised fd, R9=limit.
// R12/R13/R14=trusted live record-stride arena; valid stack (4288 bytes
// scratch plus call returns), exclusive arena/FD identity and flags required.
// Membership, exact trusted string tag 4096, size 0..4096, readiness and
// canonical byte values all checked before output. Tainted tag rejected.
// F_GETFL rejects append, nonblocking, direct and O_PATH; fstat requires
// regular file. pwrite64 from offset zero, no seek/open/close/truncate.
// RAX=bytes actually written, RDX=0 on complete success, 1 on rejection
// or short-write failure. File changes cannot be rolled back; suffix is
// retained. No durability or concurrent-writer guarantees. No arena writes.
// Positive writes advance offset, bounded syscall count; no wall-clock bound.
// RBX/RBP/R12-R15 preserved. Trusted caller must prevent descriptor/flag
// races. No source opcode, authority acquisition or canonical ABI claim.
import "ccam_aggregate_native_record_boundary.cap";

// Global initialisers cannot resolve imported constants in the bootstrap.
const int AG_NATIVE_FD_OUTPUT_SIZE = 494;

bool ag_native_emit_borrowed_fd_output(List<int> b) {
    if (AG_NATIVE_FD_OUTPUT_SIZE != 316 + AG_NATIVE_RECORD_BOUNDARY_SIZE) { return false; }
    if (b.len() > AG_BYTE_LIMIT - AG_NATIVE_FD_OUTPUT_SIZE) { return false; }
    b.push(73); b.push(129); b.push(248); b.push(255); b.push(255); b.push(255); b.push(127); b.push(15);
