    b.push(16); b.push(0); b.push(0); b.push(195); b.push(49); b.push(192); b.push(186); b.push(1);
    b.push(0); b.push(0); b.push(0); b.push(195);
    return ag_native_emit_record_boundary(b);
}

test "borrowed FD output emission is bounded and exact" {
    List<int> b = new List<int>();
    assert(ag_native_emit_borrowed_fd_output(b));
    assert(b.len() == 494);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-borrowed-fd-output.bin", data));
}
