    b.push(114); b.push(16); b.push(72); b.push(141); b.push(188); b.push(36); b.push(192); b.push(0);
    b.push(0); b.push(0); b.push(72); b.push(133); b.push(201); b.push(116); b.push(40); b.push(72);
