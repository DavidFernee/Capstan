    b.push(192); b.push(16); b.push(0); b.push(0); b.push(76); b.push(137); b.push(4); b.push(36);
    b.push(72); b.push(137); b.push(76); b.push(36); b.push(8); b.push(72); b.push(199); b.push(68);
