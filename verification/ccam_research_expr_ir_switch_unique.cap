// Duplicate detection is quadratic; keep its input explicitly bounded.
bool ag_ir_switch_unique(List<int> keys) {
    if (keys.len() > 4096) { return false; }
    for (int i=0; i<keys.len(); i+=1) {
        for (int j=0; j<i; j+=1) {
            if (keys[i] == keys[j]) { return false; }
        }
    }
    return true;
}
