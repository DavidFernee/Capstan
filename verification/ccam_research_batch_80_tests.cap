// Compatibility adapter: the research AST append helper used the earlier
// abbreviated name; keep the adapter explicit until the module is reconciled.
bool ag_expr_node_valid(AGExpression node, int index) {
    return ag_expression_node_valid(node, index);
}

test "research expression helpers enforce precedence and associativity" {
    assert(ag_operator_class(43) == 6);
    assert(ag_operator_class(42) == 7);
    assert(ag_operator_class(124) == 1);
    assert(ag_operator_class(94) == 2);
    assert(ag_operator_class(38) == 3);
    assert(ag_operator_class(60) == 5);
    assert(ag_operator_class(61) == 4);
    assert(ag_unary_precedence(126) == 8);
    assert(!ag_operator_right_associative(94));
    assert(ag_operator_arity(42, false) == 2);
    assert(ag_operator_arity(43, true) == 1);
    assert(ag_operator_arity(43, false) == 2);
    assert(ag_operator_arity(33, true) == 1);
    assert(ag_operator_arity(33, false) == 2);
    assert(ag_operator_arity(126, true) == 1);
    assert(ag_operator_arity(126, false) == 0);
    assert(ag_should_reduce(42, 43));
    assert(!ag_should_reduce(43, 42));
    assert(ag_should_reduce(43, 124));
    assert(!ag_should_reduce(38, 60));
    assert(ag_should_reduce(60, 61));
    assert(!ag_should_reduce(61, 60));
    assert(ag_compare_opcode(60) != 0);
    assert(ag_bitwise_opcode(38) != 0);
    assert(ag_escape_valid(34));
    assert(!ag_escape_valid(65));
}

test "research AST helpers reject forward and out-of-range references" {
    List<AGExpression> nodes = new List<AGExpression>();
    AGExpression leaf = new AGExpression{kind:1,value:7,left:-1,right:-1};
    assert(ag_ast_append(nodes, leaf));
    assert(nodes.len() == 1);
    assert(!ag_ast_append(nodes, new AGExpression{kind:2,value:43,left:1,right:0}));
    assert(!ag_ast_append(nodes, new AGExpression{kind:2,value:43,left:-2,right:0}));
    assert(ag_expr_tree_order(nodes));
}

test "research IR helpers enforce identifier and resource boundaries" {
    assert(ag_ir_alignment(1));
    assert(ag_ir_alignment(4096));
    assert(!ag_ir_alignment(3));
    assert(ag_ir_block_id_valid(0,1));
    assert(!ag_ir_block_id_valid(1,1));
    assert(ag_ir_instruction_limit(65535,1));
    assert(!ag_ir_instruction_limit(65536,1));
    assert(ag_ir_const_width(64));
    assert(!ag_ir_const_width(128));
    assert(ag_ir_phi_arity(2,2));
    assert(!ag_ir_phi_arity(1,2));
    assert(ag_ir_type_id(AG_SCHEMA_INT));
    assert(!ag_ir_type_id(0));
}

test "research arithmetic guards reject undefined integer operations" {
    assert(ag_division_safe(10,2));
    assert(!ag_division_safe(10,0));
    assert(!ag_division_safe(-2147483648,-1));
    assert(ag_modulo_safe(10,3));
    assert(!ag_modulo_safe(10,0));
}

test "research x86 register and byte helpers are bounded" {
    List<int> bytes = new List<int>();
    assert(ag_x86_mov_rr(bytes,0,1));
    assert(bytes.len() == 3);
    int before = bytes.len();
    assert(!ag_x86_mov_rr(bytes,16,1));
    assert(bytes.len() == before);
    assert(ag_x86_jmp_rel32(bytes) >= 0);
    assert(bytes.len() == before + 5);
}

test "native stack adjustment and epilogue reserve complete encodings" {
    List<int> small = new List<int>();
    assert(ag_x86_stack_adjust(small,16));
    assert(small.len() == 4);
    List<int> large = new List<int>();
    assert(ag_x86_stack_adjust(large,128));
    assert(large.len() == 7);
    int before = large.len();
    assert(!ag_x86_stack_adjust(large,15));
    assert(!ag_x86_stack_adjust(large,1048592));
    assert(large.len() == before);
    List<int> epilogue = new List<int>();
    assert(ag_x86_epilogue(epilogue));
    assert(epilogue.len() == 5);
    assert(epilogue[4] == 195);
}

test "research binary typing distinguishes comparisons from scalar operators" {
    assert(ag_binary_result_type(43,AG_SCHEMA_INT,AG_SCHEMA_INT) == AG_SCHEMA_INT);
    assert(ag_binary_result_type(42,AG_SCHEMA_INT,AG_SCHEMA_INT) == AG_SCHEMA_INT);
    assert(ag_binary_result_type(60,AG_SCHEMA_INT,AG_SCHEMA_INT) == AG_SCHEMA_BOOL);
    assert(ag_binary_result_type(61,AG_SCHEMA_BOOL,AG_SCHEMA_BOOL) == AG_SCHEMA_BOOL);
    assert(ag_binary_result_type(43,AG_SCHEMA_INT,AG_SCHEMA_BOOL) == -1);
    assert(ag_binary_result_type(38,AG_SCHEMA_INT,AG_SCHEMA_INT) == AG_SCHEMA_INT);
    assert(ag_binary_result_type(38,AG_SCHEMA_BOOL,AG_SCHEMA_BOOL) == -1);
    assert(ag_binary_result_type(60,AG_SCHEMA_BOOL,AG_SCHEMA_BOOL) == -1);
    assert(ag_binary_result_type(61,AG_SCHEMA_BOOL,AG_SCHEMA_BOOL) == AG_SCHEMA_BOOL);
    assert(ag_binary_result_type(0,AG_SCHEMA_INT,AG_SCHEMA_INT) == -1);
}

test "keyword scanning validates spans before indexing" {
    List<int> b = new List<int>();
    b.push(119); b.push(104); b.push(105); b.push(108); b.push(101);
    assert(ag_keyword(b,0,5));
    assert(!ag_keyword(b,-1,4));
    assert(!ag_keyword(b,0,6));
    assert(!ag_keyword(b,4,3));
    assert(!ag_keyword(b,5,5));
    List<int> r = new List<int>();
    r.push(114); r.push(101); r.push(116); r.push(117); r.push(114); r.push(110);
    assert(ag_keyword(r,0,6));
}

test "UTF-8 lead classifier rejects negative and out-of-byte-range values" {
    assert(ag_utf8_width(0) == 1);
    assert(ag_utf8_width(127) == 1);
    assert(ag_utf8_width(194) == 2);
    assert(ag_utf8_width(244) == 4);
    assert(ag_utf8_width(-1) == 0);
    assert(ag_utf8_width(256) == 0);
}

test "switch uniqueness has an explicit quadratic-work bound" {
    List<int> keys = new List<int>();
    keys.push(1); keys.push(2); keys.push(3);
    assert(ag_ir_switch_unique(keys));
    assert(ag_ir_switch_count(4096));
    assert(!ag_ir_switch_count(4097));
    keys.push(2);
    assert(!ag_ir_switch_unique(keys));
}

test "x86 LEA emits correct SIB and zero-displacement base encodings" {
    List<int> bytes = new List<int>();
    assert(ag_x86_lea(bytes,0,1));
    assert(bytes[0] == 72 && bytes[1] == 141 && bytes[2] == 1);
    assert(ag_x86_lea(bytes,0,4));
    assert(bytes[3] == 72 && bytes[4] == 141 && bytes[5] == 4 && bytes[6] == 36);
    assert(ag_x86_lea(bytes,0,5));
    assert(bytes[7] == 72 && bytes[8] == 141 && bytes[9] == 69 && bytes[10] == 0);
    assert(ag_x86_lea(bytes,8,12));
    assert(bytes[11] == 77 && bytes[12] == 141 && bytes[13] == 4 && bytes[14] == 36);
    assert(ag_x86_lea(bytes,9,13));
    assert(bytes[15] == 77 && bytes[16] == 141 && bytes[17] == 77 && bytes[18] == 0);
    int before = bytes.len();
    assert(!ag_x86_lea(bytes,16,0));
    assert(bytes.len() == before);
}

test "parser cursor and budget enforce bounded mutable state" {
    AGExprTokenCursor cursor = new AGExprTokenCursor{position:0,count:2};
    assert(ag_expr_cursor_valid(cursor));
    assert(ag_expr_cursor_advance(cursor));
    assert(cursor.position == 1);
    assert(ag_expr_cursor_advance(cursor));
    assert(!ag_expr_cursor_advance(cursor));
    AGExprTokenCursor invalid = new AGExprTokenCursor{position:0,count:65537};
    assert(!ag_expr_cursor_valid(invalid));
    AGParseBudget budget = new AGParseBudget{remaining:10};
    assert(ag_parse_charge(budget,4));
    assert(budget.remaining == 6);
    assert(!ag_parse_charge(budget,7));
    assert(!ag_parse_charge(budget,-1));
    AGParseBudget oversized = new AGParseBudget{remaining:1048577};
    assert(!ag_parse_charge(oversized,1));
}

test "recursion guard rejects corrupt state and respects its configured maximum" {
    AGRecursionGuard guard = new AGRecursionGuard{depth:0,maximum:2};
    assert(ag_recursion_enter(guard));
    assert(ag_recursion_enter(guard));
    assert(!ag_recursion_enter(guard));
    assert(ag_recursion_leave(guard));
    assert(ag_recursion_leave(guard));
    assert(!ag_recursion_leave(guard));
    AGRecursionGuard corrupt = new AGRecursionGuard{depth:3,maximum:2};
    assert(!ag_recursion_leave(corrupt));
}

test "AST capacity and linear SSA helpers state their actual bounds" {
    assert(ag_ast_capacity(65536,0,65536));
    assert(!ag_ast_capacity(65536,1,65536));
    assert(!ag_ast_capacity(0,1,65537));
    assert(ag_ir_precedes(2,3));
    assert(!ag_ir_precedes(3,2));
    assert(ag_ir_use_def_valid(4,1,3,4));
    assert(!ag_ir_use_def_valid(4,4,3,4));
    assert(!ag_ir_use_def_valid(4,1,-1,4));
}

test "native rel32 patchers validate instruction provenance" {
    List<int> call = new List<int>();
    int call_patch = ag_x86_call_rel32(call);
    assert(call_patch == 1);
    assert(ag_x86_patch_call(call,call_patch,call.len()));
    assert(call[1] == 0 && call[2] == 0 && call[3] == 0 && call[4] == 0);
    assert(!ag_x86_patch_call(call,0,call.len()));
    List<int> wrong_call = new List<int>();
    wrong_call.push(144); wrong_call.push(0); wrong_call.push(0); wrong_call.push(0); wrong_call.push(0);
    assert(!ag_x86_patch_call(wrong_call,1,5));
    List<int> jump = new List<int>();
    int jump_patch = ag_x86_jmp_rel32(jump);
    assert(jump_patch == 1);
    assert(ag_x86_patch_branch(jump,jump_patch,jump.len()));
    assert(!ag_x86_patch_branch(jump,0,jump.len()));
    List<int> conditional = new List<int>();
    assert(ag_x86_jcc(conditional,4));
    assert(ag_x86_patch_branch(conditional,2,conditional.len()));
    List<int> wrong_branch = new List<int>();
    wrong_branch.push(144); wrong_branch.push(0); wrong_branch.push(0); wrong_branch.push(0); wrong_branch.push(0);
    assert(!ag_x86_patch_branch(wrong_branch,1,5));
}
