// Candidate Linux x86-64 native tainted byte slice, private SysV ABI.
// RDI=arena base, RSI=committed cursor pointer, RDX=capacity,
// RCX=source offset, R8=start, R9=end. RAX=offset, RDX=status.
// Caller owns live disjoint mapped backing, cursor storage and stack.
// Single-threaded immutable record headers; no mixing indexed arenas.
// Scan proves membership in record-only prefix, not reference authenticity.
// Validate every source byte pair before allocating. Retain tag 2045.
// No writes on failure; publish committed cursor last. No typed lowering claim.
// Reference assembly: research/native-bootstrap/tainted-slice-leaf.S.
import "ccam_aggregate_byte_buffer.cap";

const int AG_NATIVE_TAINTED_SLICE_SIZE = 396;

