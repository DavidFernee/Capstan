test "native tainted slice emits exact private leaf" {
    List<int> b = new List<int>();
    assert(ag_native_emit_tainted_slice(b));
    assert(b.len() == AG_NATIVE_TAINTED_SLICE_SIZE);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-tainted-slice.bin", data));
}
