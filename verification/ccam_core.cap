// Typed structural validation for the executable single-frame subset.
// This validates the already-decoded Capstan instruction representation. It
// is not a JSON decoder and cannot detect duplicate/unknown JSON object keys.
const int CCAM_RETURN_INT = 1;
const int CCAM_RETURN_BOOL = 2;
const int CCAM_RETURN_VOID = 3;

// Explicit limits for this in-memory executable subset. These are admission
// limits, not a substitute for bounding raw JSON bytes in a future decoder.
const int CCAM_MAX_REGISTERS = 4096;
const int CCAM_MAX_INSTRUCTIONS = 65536;

struct CCAMValidationResult {
    bool ok;
    string error;
}

CCAMValidationResult ccam_validation_error(string error) {
    return new CCAMValidationResult{ok: false, error: error};
}

CCAMValidationResult ccam_validation_ok() {
    return new CCAMValidationResult{ok: true, error: ""};
}

bool ccam_register_has_type(List<int> register_types, int index, int expected) {
    if (index < 0 || index >= register_types.len()) {
        return false;
    }
    return register_types[index] == expected;
}

bool ccam_valid_target(List<CCAMInstruction> instructions, int target) {
    return target >= 0 && target < instructions.len();
}

bool ccam_valid_trap_reason(string reason) {
    int n = reason.len();
    if (n == 0 || n > 64) {
        return false;
    }
    bool first_ok = false;
    string first = reason.slice(0, 1);
    for (int code = 97; code <= 122; code += 1) {
        if (first == char_str(code)) {
            first_ok = true;
        }
    }
    if (!first_ok) {
        return false;
    }
    for (int i = 1; i < n; i += 1) {
        string ch = reason.slice(i, i + 1);
        bool allowed = false;
        for (int code = 97; code <= 122; code += 1) {
            if (ch == char_str(code)) {
                allowed = true;
            }
        }
        for (int code = 48; code <= 57; code += 1) {
            if (ch == char_str(code)) {
                allowed = true;
            }
        }
        if (ch == "_") {
            allowed = true;
        }
        if (!allowed) {
            return false;
        }
    }
    return true;
}

CCAMValidationResult ccam_validate_single_frame(
    List<int> register_types,
    List<CCAMInstruction> instructions,
    int return_type
) {
    // Reject oversized structures before allocating register or reachability
    // storage. The future raw-program decoder must impose a byte limit too.
    if (register_types.len() > CCAM_MAX_REGISTERS) {
        return ccam_validation_error("register_limit_exceeded");
    }
    if (instructions.len() > CCAM_MAX_INSTRUCTIONS) {
        return ccam_validation_error("instruction_limit_exceeded");
    }
    CCAMRegisterFileResult register_check = ccam_registers_create(register_types);
    if (!register_check.ok) {
        return ccam_validation_error(register_check.error);
    }
    if (return_type != CCAM_RETURN_INT &&
        return_type != CCAM_RETURN_BOOL &&
        return_type != CCAM_RETURN_VOID) {
        return ccam_validation_error("invalid_return_type");
    }
    if (instructions.len() == 0) {
        return ccam_validation_error("empty_instruction_sequence");
    }

    // First validate every instruction, including unreachable instructions.
    // This pass is deliberately independent of control-flow reachability.
    for (int i = 0; i < instructions.len(); i += 1) {
        CCAMInstruction instruction = instructions[i];
        if (instruction.op == CCAM_OP_CONST_I) {
            if (!ccam_register_has_type(register_types, instruction.dst, CCAM_TYPE_INT)) {
                return ccam_validation_error("invalid_or_mistyped_destination");
            }
        } else if (instruction.op == CCAM_OP_CONST_B) {
            if (!ccam_register_has_type(register_types, instruction.dst, CCAM_TYPE_BOOL)) {
                return ccam_validation_error("invalid_or_mistyped_destination");
            }
        } else if (instruction.op == CCAM_OP_MOVE) {
            if (instruction.src < 0 || instruction.src >= register_types.len() ||
                instruction.dst < 0 || instruction.dst >= register_types.len()) {
                return ccam_validation_error("invalid_register");
            }
            if (register_types[instruction.src] != register_types[instruction.dst]) {
                return ccam_validation_error("register_type_mismatch");
            }
        } else if (instruction.op == CCAM_OP_ADD_I ||
                   instruction.op == CCAM_OP_SUB_I ||
                   instruction.op == CCAM_OP_MUL_I ||
                   instruction.op == CCAM_OP_DIV_I ||
                   instruction.op == CCAM_OP_REM_I) {
            if (!ccam_register_has_type(register_types, instruction.dst, CCAM_TYPE_INT) ||
                !ccam_register_has_type(register_types, instruction.lhs, CCAM_TYPE_INT) ||
                !ccam_register_has_type(register_types, instruction.rhs, CCAM_TYPE_INT)) {
                return ccam_validation_error("invalid_or_mistyped_integer_operand");
            }
        } else if (instruction.op == CCAM_OP_EQ_I || instruction.op == CCAM_OP_LT_I) {
            if (!ccam_register_has_type(register_types, instruction.dst, CCAM_TYPE_BOOL) ||
                !ccam_register_has_type(register_types, instruction.lhs, CCAM_TYPE_INT) ||
                !ccam_register_has_type(register_types, instruction.rhs, CCAM_TYPE_INT)) {
                return ccam_validation_error("invalid_or_mistyped_comparison_operand");
            }
        } else if (instruction.op == CCAM_OP_NOT_B) {
            if (!ccam_register_has_type(register_types, instruction.dst, CCAM_TYPE_BOOL) ||
                !ccam_register_has_type(register_types, instruction.lhs, CCAM_TYPE_BOOL)) {
                return ccam_validation_error("invalid_or_mistyped_boolean_operand");
            }
        } else if (instruction.op == CCAM_OP_JUMP) {
            if (!ccam_valid_target(instructions, instruction.target)) {
                return ccam_validation_error("invalid_branch_target");
            }
        } else if (instruction.op == CCAM_OP_BRANCH) {
            if (!ccam_register_has_type(register_types, instruction.lhs, CCAM_TYPE_BOOL)) {
                return ccam_validation_error("invalid_or_mistyped_branch_condition");
            }
            if (!ccam_valid_target(instructions, instruction.if_true) ||
                !ccam_valid_target(instructions, instruction.if_false)) {
                return ccam_validation_error("invalid_branch_target");
            }
        } else if (instruction.op == CCAM_OP_RET) {
            if (instruction.lhs < 0 || instruction.lhs >= register_types.len()) {
                return ccam_validation_error("invalid_return_register");
            }
            if (return_type == CCAM_RETURN_INT &&
                register_types[instruction.lhs] != CCAM_TYPE_INT) {
                return ccam_validation_error("return_type_mismatch");
            }
            if (return_type == CCAM_RETURN_BOOL &&
                register_types[instruction.lhs] != CCAM_TYPE_BOOL) {
                return ccam_validation_error("return_type_mismatch");
            }
            if (return_type == CCAM_RETURN_VOID) {
                return ccam_validation_error("return_type_mismatch");
            }
        } else if (instruction.op == CCAM_OP_RET_VOID) {
            if (return_type != CCAM_RETURN_VOID) {
                return ccam_validation_error("return_type_mismatch");
            }
        } else if (instruction.op == CCAM_OP_TRAP) {
            if (!ccam_valid_trap_reason(instruction.reason)) {
                return ccam_validation_error("invalid_trap_reason");
            }
        } else {
            return ccam_validation_error("invalid_instruction");
        }
    }

    // Traverse the control-flow graph with a worklist. Each instruction is
    // enqueued at most once, so reachability is O(V + E), including programs
    // whose edges point backwards through the instruction sequence.
    List<bool> reachable = new List<bool>();
    for (int i = 0; i < instructions.len(); i += 1) {
        reachable.push(false);
    }
    List<int> worklist = new List<int>();
    reachable[0] = true;
    worklist.push(0);
    int worklist_index = 0;
    while (worklist_index < worklist.len()) {
        int i = worklist[worklist_index];
        worklist_index += 1;
        CCAMInstruction instruction = instructions[i];
        if (instruction.op == CCAM_OP_JUMP) {
            if (!reachable[instruction.target]) {
                reachable[instruction.target] = true;
                worklist.push(instruction.target);
            }
        } else if (instruction.op == CCAM_OP_BRANCH) {
            if (!reachable[instruction.if_true]) {
                reachable[instruction.if_true] = true;
                worklist.push(instruction.if_true);
            }
            if (!reachable[instruction.if_false]) {
                reachable[instruction.if_false] = true;
                worklist.push(instruction.if_false);
            }
        } else if (instruction.op != CCAM_OP_RET &&
                   instruction.op != CCAM_OP_RET_VOID &&
                   instruction.op != CCAM_OP_TRAP) {
            if (i + 1 >= instructions.len()) {
                return ccam_validation_error("reachable_fallthrough");
            }
            if (!reachable[i + 1]) {
                reachable[i + 1] = true;
                worklist.push(i + 1);
            }
        }
    }
    return ccam_validation_ok();
}

// Safe construction path: callers must supply the declared return type and
// pass static validation before an executable state is created.
CCAMMachineCreateResult ccam_machine_create_validated(
    List<int> register_types,
    List<CCAMInstruction> instructions,
    int max_steps,
    int return_type
) {
    if (max_steps < 0) {
        List<CCAMRegister> empty_registers = new List<CCAMRegister>();
        List<CCAMInstruction> empty_instructions = new List<CCAMInstruction>();
        CCAMMachineState empty_state = new CCAMMachineState{
            registers: empty_registers,
            instructions: empty_instructions,
            pc: 0,
            steps: 0,
            max_steps: 0,
            halted: true,
            halt_has_value: false,
            halt_value: 0,
            halt_bool_value: false,
            trap_code: "",
            trap_detail: ""
        };
        return new CCAMMachineCreateResult{
            ok: false, state: empty_state, error: "invalid_step_limit"
        };
    }
    CCAMValidationResult validation = ccam_validate_single_frame(
        register_types, instructions, return_type);
    if (!validation.ok) {
        List<CCAMRegister> empty_registers = new List<CCAMRegister>();
        List<CCAMInstruction> empty_instructions = new List<CCAMInstruction>();
        CCAMMachineState empty_state = new CCAMMachineState{
            registers: empty_registers,
            instructions: empty_instructions,
            pc: 0,
            steps: 0,
            max_steps: 0,
            halted: true,
            halt_has_value: false,
            halt_value: 0,
            halt_bool_value: false,
            trap_code: "",
            trap_detail: ""
        };
        return new CCAMMachineCreateResult{
            ok: false, state: empty_state, error: validation.error
        };
    }
    return ccam_machine_create(register_types, instructions, max_steps);
}

test "CCAM validator enforces register and instruction admission limits" {
    List<int> at_register_limit = new List<int>();
    for (int i = 0; i < CCAM_MAX_REGISTERS; i += 1) {
        at_register_limit.push(CCAM_TYPE_INT);
    }
    List<CCAMInstruction> terminal = new List<CCAMInstruction>();
    terminal.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMValidationResult accepted = ccam_validate_single_frame(
        at_register_limit, terminal, CCAM_RETURN_VOID);
    assert(accepted.ok);

    at_register_limit.push(CCAM_TYPE_INT);
    CCAMValidationResult too_many_registers = ccam_validate_single_frame(
        at_register_limit, terminal, CCAM_RETURN_VOID);
    assert(!too_many_registers.ok &&
           too_many_registers.error == "register_limit_exceeded");

    List<int> no_registers = new List<int>();
    List<CCAMInstruction> at_instruction_limit = new List<CCAMInstruction>();
    for (int i = 0; i < CCAM_MAX_INSTRUCTIONS; i += 1) {
        at_instruction_limit.push(ccam_instruction(CCAM_OP_RET_VOID));
    }
    CCAMValidationResult instruction_boundary = ccam_validate_single_frame(
        no_registers, at_instruction_limit, CCAM_RETURN_VOID);
    assert(instruction_boundary.ok);

    at_instruction_limit.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMValidationResult too_many_instructions = ccam_validate_single_frame(
        no_registers, at_instruction_limit, CCAM_RETURN_VOID);
    assert(!too_many_instructions.ok &&
           too_many_instructions.error == "instruction_limit_exceeded");
    CCAMMachineCreateResult rejected = ccam_machine_create_validated(
        no_registers, at_instruction_limit, 8, CCAM_RETURN_VOID);
    assert(!rejected.ok && rejected.error == "instruction_limit_exceeded");
    assert(rejected.state.halted);
    assert(rejected.state.instructions.len() == 0);
}

test "CCAM validated constructor rejects a negative step limit directly" {
    List<int> no_registers = new List<int>();
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMMachineCreateResult rejected = ccam_machine_create_validated(
        no_registers, code, -1, CCAM_RETURN_VOID);
    assert(!rejected.ok && rejected.error == "invalid_step_limit");
    assert(rejected.state.halted);
    assert(rejected.state.instructions.len() == 0);
}

test "CCAM validator accepts and rejects canonical trap reasons" {
    assert(ccam_valid_trap_reason("deliberate_stop"));
    assert(ccam_valid_trap_reason("a"));
    assert(ccam_valid_trap_reason("a9_b"));

    assert(!ccam_valid_trap_reason(""));
    assert(!ccam_valid_trap_reason("Upper"));
    assert(!ccam_valid_trap_reason("_leading"));
    assert(!ccam_valid_trap_reason("bad-name"));
    assert(!ccam_valid_trap_reason("has space"));
    assert(!ccam_valid_trap_reason("nonascii_é"));

    string sixty_four = "";
    for (int i = 0; i < 64; i += 1) {
        sixty_four = sixty_four + "a";
    }
    assert(ccam_valid_trap_reason(sixty_four));
    assert(!ccam_valid_trap_reason(sixty_four + "a"));

    List<int> types = new List<int>();
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction trap = ccam_instruction(CCAM_OP_TRAP);
    trap.reason = "Bad";
    code.push(trap);
    CCAMValidationResult invalid = ccam_validate_single_frame(
        types, code, CCAM_RETURN_VOID);
    assert(!invalid.ok && invalid.error == "invalid_trap_reason");
}

test "CCAM validator accepts a typed arithmetic return program" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 19;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 23;
    code.push(i);
    i = ccam_instruction(CCAM_OP_ADD_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 2;
    code.push(i);
    CCAMValidationResult result = ccam_validate_single_frame(
        types, code, CCAM_RETURN_INT);
    assert(result.ok);
    CCAMMachineCreateResult created = ccam_machine_create_validated(
        types, code, 4, CCAM_RETURN_INT);
    assert(created.ok);
    CCAMMachineState state = created.state;
    while (!state.halted) {
        ccam_machine_step(state);
    }
    assert(state.halt_has_value && state.halt_value == 42);
}

test "CCAM validator rejects bad operand indices and static types" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_ADD_I);
    i.dst = 0;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    CCAMValidationResult result = ccam_validate_single_frame(
        types, code, CCAM_RETURN_INT);
    assert(!result.ok && result.error == "invalid_or_mistyped_integer_operand");

    List<CCAMInstruction> bad_index = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 9;
    bad_index.push(i);
    result = ccam_validate_single_frame(types, bad_index, CCAM_RETURN_INT);
    assert(!result.ok && result.error == "invalid_or_mistyped_destination");
}

test "CCAM validator rejects invalid branch targets and reachable fallthrough" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> bad_target = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_BRANCH);
    i.lhs = 0;
    i.if_true = 1;
    i.if_false = 7;
    bad_target.push(i);
    bad_target.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMValidationResult result = ccam_validate_single_frame(
        types, bad_target, CCAM_RETURN_VOID);
    assert(!result.ok && result.error == "invalid_branch_target");

    List<int> fallthrough_types = new List<int>();
    fallthrough_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> falls_through = new List<CCAMInstruction>();
    CCAMInstruction final_write = ccam_instruction(CCAM_OP_CONST_I);
    final_write.dst = 0;
    falls_through.push(final_write);
    result = ccam_validate_single_frame(
        fallthrough_types, falls_through, CCAM_RETURN_INT);
    assert(!result.ok && result.error == "reachable_fallthrough");
}

test "CCAM validator permits unreachable fallthrough but validates unreachable instructions" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_JUMP);
    i.target = 2;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    code.push(i);
    CCAMValidationResult result = ccam_validate_single_frame(
        types, code, CCAM_RETURN_INT);
    assert(result.ok);

    List<int> no_registers = new List<int>();
    List<CCAMInstruction> invalid_unreachable = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_JUMP);
    i.target = 2;
    invalid_unreachable.push(i);
    i = ccam_instruction(999);
    invalid_unreachable.push(i);
    i = ccam_instruction(CCAM_OP_RET_VOID);
    invalid_unreachable.push(i);
    result = ccam_validate_single_frame(
        no_registers, invalid_unreachable, CCAM_RETURN_VOID);
    assert(!result.ok && result.error == "invalid_instruction");
}

test "CCAM validator uses a worklist for backward control-flow chains" {
    List<int> no_registers = new List<int>();
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    const int instruction_count = 512;

    // The first jump reaches the final instruction. Each subsequent jump
    // walks one instruction backwards, requiring many full scans in the
    // former fixed-point implementation.
    CCAMInstruction first = ccam_instruction(CCAM_OP_JUMP);
    first.target = instruction_count - 1;
    code.push(first);
    code.push(ccam_instruction(CCAM_OP_RET_VOID));
    for (int i = 2; i < instruction_count; i += 1) {
        CCAMInstruction jump = ccam_instruction(CCAM_OP_JUMP);
        jump.target = i - 1;
        code.push(jump);
    }

    CCAMValidationResult result = ccam_validate_single_frame(
        no_registers, code, CCAM_RETURN_VOID);
    assert(result.ok);
}

test "CCAM validated constructor rejects malformed programs before execution" {
    List<int> no_registers = new List<int>();
    List<CCAMInstruction> malformed = new List<CCAMInstruction>();
    CCAMInstruction jump = ccam_instruction(CCAM_OP_JUMP);
    jump.target = 4;
    malformed.push(jump);
    malformed.push(ccam_instruction(CCAM_OP_RET_VOID));

    CCAMMachineCreateResult rejected = ccam_machine_create_validated(
        no_registers, malformed, 8, CCAM_RETURN_VOID);
    assert(!rejected.ok && rejected.error == "invalid_branch_target");
    assert(rejected.state.halted);
    assert(rejected.state.instructions.len() == 0);
}

test "CCAM validator enforces return contracts and terminal paths" {
    List<int> ints = new List<int>();
    ints.push(CCAM_TYPE_INT);
    List<CCAMInstruction> wrong_return = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_RET_VOID);
    wrong_return.push(i);
    CCAMValidationResult result = ccam_validate_single_frame(
        ints, wrong_return, CCAM_RETURN_INT);
    assert(!result.ok && result.error == "return_type_mismatch");

    List<CCAMInstruction> loop = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_JUMP);
    i.target = 0;
    loop.push(i);
    result = ccam_validate_single_frame(ints, loop, CCAM_RETURN_INT);
    assert(result.ok);
}


// Typed frame construction and atomic call/return substrate. CALL dispatch is
// intentionally a later integration step; this code establishes the frame
// invariants and transition helpers first.
struct CCAMFunction {
    string name;
    List<int> register_types;
    int parameter_count;
    int return_type;
    List<CCAMInstruction> instructions;
}
struct CCAMFrame {
    int function_index;
    int pc;
    int return_type;
    int caller_destination;
    List<CCAMRegister> registers;
    List<CCAMInstruction> instructions;
}
struct CCAMFrameCreateResult {
    bool ok;
    CCAMFrame frame;
    string error;
}
struct CCAMFrameStack {
    List<CCAMFrame> frames;
    int max_depth;
}
struct CCAMFrameStackCreateResult {
    bool ok;
    CCAMFrameStack stack;
    string error;
}
struct CCAMFrameReturnResult {
    bool ok;
    bool entry_return;
    bool entry_void;
    int int_value;
    bool bool_value;
    string error;
}

CCAMFrame ccam_empty_frame() {
    return new CCAMFrame{
        function_index: 0, pc: 0, return_type: CCAM_RETURN_VOID,
        caller_destination: -1,
        registers: new List<CCAMRegister>(),
        instructions: new List<CCAMInstruction>()
    };
}
CCAMFrameCreateResult ccam_frame_error(string error) {
    return new CCAMFrameCreateResult{
        ok: false, frame: ccam_empty_frame(), error: error
    };
}
CCAMFrameReturnResult ccam_frame_return_error(string error) {
    return new CCAMFrameReturnResult{
        ok: false, entry_return: false, entry_void: false,
        int_value: 0, bool_value: false, error: error
    };
}

CCAMFrameCreateResult ccam_frame_create(
    CCAMFunction function,
    int function_index,
    List<CCAMRegister> caller_registers,
    List<int> argument_registers,
    int caller_destination
) {
    if (function.name == "" || function_index < 0) {
        return ccam_frame_error("invalid_function");
    }
    if (function.parameter_count < 0 ||
        function.parameter_count > function.register_types.len() ||
        argument_registers.len() != function.parameter_count) {
        return ccam_frame_error("invalid_argument_count");
    }
    if (function.register_types.len() > CCAM_MAX_REGISTERS ||
        function.instructions.len() > CCAM_MAX_INSTRUCTIONS) {
        return ccam_frame_error("program_limit_exceeded");
    }
    CCAMValidationResult validation = ccam_validate_single_frame(
        function.register_types, function.instructions, function.return_type);
    if (!validation.ok) {
        return ccam_frame_error(validation.error);
    }

    // Read and snapshot arguments left-to-right before allocating the callee.
    List<CCAMRegister> values = new List<CCAMRegister>();
    for (int i = 0; i < argument_registers.len(); i += 1) {
        int source_index = argument_registers[i];
        if (source_index < 0 || source_index >= caller_registers.len()) {
            return ccam_frame_error("invalid_argument_register");
        }
        CCAMRegister source = caller_registers[source_index];
        if (!source.initialized) {
            return ccam_frame_error("uninitialised_register");
        }
        if (source.declared_type != function.register_types[i]) {
            return ccam_frame_error("argument_type_mismatch");
        }
        values.push(source);
    }

    CCAMRegisterFileResult created = ccam_registers_create(function.register_types);
    if (!created.ok) {
        return ccam_frame_error(created.error);
    }
    for (int i = 0; i < values.len(); i += 1) {
        CCAMRegister value = values[i];
        string error = "";
        if (value.declared_type == CCAM_TYPE_INT) {
            error = ccam_register_write_int(created.registers, i, value.int_value);
        } else if (value.declared_type == CCAM_TYPE_BOOL) {
            error = ccam_register_write_bool(created.registers, i, value.bool_value);
        } else {
            error = "argument_type_mismatch";
        }
        if (error != "") {
            return ccam_frame_error(error);
        }
    }

    List<CCAMInstruction> copied = new List<CCAMInstruction>();
    for (int i = 0; i < function.instructions.len(); i += 1) {
        copied.push(ccam_copy_instruction(function.instructions[i]));
    }
    CCAMFrame frame = new CCAMFrame{
        function_index: function_index, pc: 0,
        return_type: function.return_type,
        caller_destination: caller_destination,
        registers: created.registers, instructions: copied
    };
    return new CCAMFrameCreateResult{ok: true, frame: frame, error: ""};
}

CCAMFrameStackCreateResult ccam_frame_stack_create(
    CCAMFrame entry, int max_depth
) {
    if (max_depth < 1 || entry.caller_destination != -1 ||
        (entry.return_type != CCAM_RETURN_INT &&
         entry.return_type != CCAM_RETURN_VOID)) {
        return new CCAMFrameStackCreateResult{
            ok: false,
            stack: new CCAMFrameStack{
                frames: new List<CCAMFrame>(), max_depth: 0
            },
            error: "invalid_call_stack_configuration"
        };
    }
    List<CCAMFrame> frames = new List<CCAMFrame>();
    frames.push(entry);
    return new CCAMFrameStackCreateResult{
        ok: true,
        stack: new CCAMFrameStack{frames: frames, max_depth: max_depth},
        error: ""
    };
}

string ccam_frame_stack_push(CCAMFrameStack stack, CCAMFrame callee) {
    if (stack.frames.len() == 0) return "invalid_call_stack";
    if (stack.frames.len() >= stack.max_depth) return "call_depth_exceeded";
    CCAMFrame caller = stack.frames[stack.frames.len() - 1];
    if (callee.return_type == CCAM_RETURN_VOID) {
        if (callee.caller_destination != -1) return "return_type_mismatch";
    } else {
        int dst = callee.caller_destination;
        if (dst < 0 || dst >= caller.registers.len()) return "invalid_call_destination";
        int expected = CCAM_TYPE_INT;
        if (callee.return_type == CCAM_RETURN_BOOL) expected = CCAM_TYPE_BOOL;
        else if (callee.return_type != CCAM_RETURN_INT) return "invalid_return_type";
        if (caller.registers[dst].declared_type != expected) return "return_type_mismatch";
    }
    stack.frames.push(callee);
    return "";
}

CCAMFrameReturnResult ccam_frame_stack_return_int(
    CCAMFrameStack stack, int source_register
) {
    if (stack.frames.len() == 0) return ccam_frame_return_error("invalid_call_stack");
    int top = stack.frames.len() - 1;
    CCAMFrame callee = stack.frames[top];
    if (callee.return_type != CCAM_RETURN_INT) return ccam_frame_return_error("return_type_mismatch");
    CCAMRegisterResult value = ccam_register_read_int(callee.registers, source_register);
    if (!value.ok) return ccam_frame_return_error(value.trap);
    if (stack.frames.len() == 1) {
        return new CCAMFrameReturnResult{
            ok: true, entry_return: true, entry_void: false,
            int_value: value.int_value, bool_value: false, error: ""
        };
    }
    CCAMFrame caller = stack.frames[top - 1];
    int dst = callee.caller_destination;
    if (dst < 0 || dst >= caller.registers.len() ||
        caller.registers[dst].declared_type != CCAM_TYPE_INT) {
        return ccam_frame_return_error("return_type_mismatch");
    }
    // All fallible checks precede the caller write and callee pop.
    string error = ccam_register_write_int(caller.registers, dst, value.int_value);
    if (error != "") return ccam_frame_return_error(error);
    if (let _removed = stack.frames.pop()) {}
    return new CCAMFrameReturnResult{
        ok: true, entry_return: false, entry_void: false,
        int_value: value.int_value, bool_value: false, error: ""
    };
}

CCAMFrameReturnResult ccam_frame_stack_return_bool(
    CCAMFrameStack stack, int source_register
) {
    if (stack.frames.len() == 0) return ccam_frame_return_error("invalid_call_stack");
    int top = stack.frames.len() - 1;
    CCAMFrame callee = stack.frames[top];
    if (callee.return_type != CCAM_RETURN_BOOL) return ccam_frame_return_error("return_type_mismatch");
    CCAMRegisterResult value = ccam_register_read_bool(callee.registers, source_register);
    if (!value.ok) return ccam_frame_return_error(value.trap);
    if (stack.frames.len() == 1) {
        return new CCAMFrameReturnResult{
            ok: true, entry_return: true, entry_void: false,
            int_value: 0, bool_value: value.bool_value, error: ""
        };
    }
    CCAMFrame caller = stack.frames[top - 1];
    int dst = callee.caller_destination;
    if (dst < 0 || dst >= caller.registers.len() ||
        caller.registers[dst].declared_type != CCAM_TYPE_BOOL) {
        return ccam_frame_return_error("return_type_mismatch");
    }
    string error = ccam_register_write_bool(caller.registers, dst, value.bool_value);
    if (error != "") return ccam_frame_return_error(error);
    if (let _removed = stack.frames.pop()) {}
    return new CCAMFrameReturnResult{
        ok: true, entry_return: false, entry_void: false,
        int_value: 0, bool_value: value.bool_value, error: ""
    };
}

CCAMFrameReturnResult ccam_frame_stack_return_void(CCAMFrameStack stack) {
    if (stack.frames.len() == 0) return ccam_frame_return_error("invalid_call_stack");
    CCAMFrame callee = stack.frames[stack.frames.len() - 1];
    if (callee.return_type != CCAM_RETURN_VOID || callee.caller_destination != -1) {
        return ccam_frame_return_error("return_type_mismatch");
    }
    if (stack.frames.len() == 1) {
        return new CCAMFrameReturnResult{
            ok: true, entry_return: false, entry_void: true,
            int_value: 0, bool_value: false, error: ""
        };
    }
    if (let _removed = stack.frames.pop()) {}
    return new CCAMFrameReturnResult{
        ok: true, entry_return: false, entry_void: false,
        int_value: 0, bool_value: false, error: ""
    };
}

test "CCAM frame creation snapshots typed arguments left-to-right" {
    List<int> caller_types = new List<int>();
    caller_types.push(CCAM_TYPE_INT);
    caller_types.push(CCAM_TYPE_BOOL);
    CCAMRegisterFileResult caller = ccam_registers_create(caller_types);
    assert(caller.ok);
    assert(ccam_register_write_int(caller.registers, 0, 41) == "");
    assert(ccam_register_write_bool(caller.registers, 1, true) == "");

    List<int> callee_types = new List<int>();
    callee_types.push(CCAM_TYPE_INT);
    callee_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction ret = ccam_instruction(CCAM_OP_RET);
    ret.lhs = 0;
    code.push(ret);
    CCAMFunction function = new CCAMFunction{
        name: "callee", register_types: callee_types,
        parameter_count: 2, return_type: CCAM_RETURN_INT,
        instructions: code
    };
    List<int> args = new List<int>();
    args.push(0);
    args.push(1);
    CCAMFrameCreateResult frame = ccam_frame_create(
        function, 1, caller.registers, args, 2);
    assert(frame.ok);
    assert(frame.frame.function_index == 1 && frame.frame.pc == 0);
    assert(frame.frame.registers[0].initialized && frame.frame.registers[0].int_value == 41);
    assert(frame.frame.registers[1].initialized && frame.frame.registers[1].bool_value);
}

test "CCAM frame stack enforces depth and performs atomic integer return" {
    List<int> entry_types = new List<int>();
    entry_types.push(CCAM_TYPE_INT);
    entry_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> entry_code = new List<CCAMInstruction>();
    entry_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMFunction entry_function = new CCAMFunction{
        name: "entry", register_types: entry_types,
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: entry_code
    };
    List<CCAMRegister> no_regs = new List<CCAMRegister>();
    List<int> no_args = new List<int>();
    CCAMFrameCreateResult entry = ccam_frame_create(
        entry_function, 0, no_regs, no_args, -1);
    assert(entry.ok);
    CCAMRegisterFileResult caller_regs = ccam_registers_create(entry_types);
    assert(caller_regs.ok);
    assert(ccam_register_write_int(caller_regs.registers, 0, 42) == "");
    entry.frame.registers = caller_regs.registers;

    List<int> callee_types = new List<int>();
    callee_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> callee_code = new List<CCAMInstruction>();
    CCAMInstruction ret = ccam_instruction(CCAM_OP_RET);
    ret.lhs = 0;
    callee_code.push(ret);
    CCAMFunction callee_function = new CCAMFunction{
        name: "callee", register_types: callee_types,
        parameter_count: 1, return_type: CCAM_RETURN_INT,
        instructions: callee_code
    };
    List<int> args = new List<int>();
    args.push(0);
    CCAMFrameCreateResult callee = ccam_frame_create(
        callee_function, 1, caller_regs.registers, args, 1);
    assert(callee.ok);

    CCAMFrameStackCreateResult shallow = ccam_frame_stack_create(entry.frame, 1);
    CCAMFrameStackCreateResult stack = ccam_frame_stack_create(entry.frame, 2);
    assert(shallow.ok && stack.ok);
    assert(ccam_frame_stack_push(shallow.stack, callee.frame) == "call_depth_exceeded");
    assert(shallow.stack.frames.len() == 1);
    assert(ccam_frame_stack_push(stack.stack, callee.frame) == "");
    CCAMFrameReturnResult returned = ccam_frame_stack_return_int(stack.stack, 0);
    assert(returned.ok && !returned.entry_return && returned.int_value == 42);
    assert(stack.stack.frames.len() == 1);
    assert(ccam_register_read_int(stack.stack.frames[0].registers, 1).int_value == 42);
}

test "CCAM frame stack rejects return destination mismatch without popping" {
    List<int> entry_types = new List<int>();
    entry_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> entry_code = new List<CCAMInstruction>();
    entry_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMFunction entry_function = new CCAMFunction{
        name: "entry", register_types: entry_types,
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: entry_code
    };
    CCAMFrameCreateResult entry = ccam_frame_create(
        entry_function, 0, new List<CCAMRegister>(),
        new List<int>(), -1);
    assert(entry.ok);
    CCAMFrameStackCreateResult stack = ccam_frame_stack_create(entry.frame, 2);

    List<int> result_types = new List<int>();
    result_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> result_code = new List<CCAMInstruction>();
    CCAMInstruction ret = ccam_instruction(CCAM_OP_RET);
    ret.lhs = 0;
    result_code.push(ret);
    CCAMFunction result_function = new CCAMFunction{
        name: "result", register_types: result_types,
        parameter_count: 0, return_type: CCAM_RETURN_INT,
        instructions: result_code
    };
    CCAMFrameCreateResult callee = ccam_frame_create(
        result_function, 1, new List<CCAMRegister>(),
        new List<int>(), 0);
    assert(callee.ok);
    assert(ccam_frame_stack_push(stack.stack, callee.frame) == "return_type_mismatch");
    assert(stack.stack.frames.len() == 1);
}

test "CCAM frame creation rejects uninitialised arguments" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    CCAMRegisterFileResult caller = ccam_registers_create(types);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction ret = ccam_instruction(CCAM_OP_RET);
    ret.lhs = 0;
    code.push(ret);
    CCAMFunction function = new CCAMFunction{
        name: "callee", register_types: types,
        parameter_count: 1, return_type: CCAM_RETURN_INT,
        instructions: code
    };
    List<int> args = new List<int>();
    args.push(0);
    CCAMFrameCreateResult rejected = ccam_frame_create(
        function, 1, caller.registers, args, -1);
    assert(!rejected.ok && rejected.error == "uninitialised_register");
    assert(rejected.frame.instructions.len() == 0);
}

test "CCAM frame stack supports boolean and void nested returns" {
    List<int> caller_types = new List<int>();
    caller_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> caller_code = new List<CCAMInstruction>();
    caller_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMFunction entry_function = new CCAMFunction{
        name: "entry", register_types: caller_types,
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: caller_code
    };
    CCAMFrameCreateResult entry = ccam_frame_create(
        entry_function, 0, new List<CCAMRegister>(), new List<int>(), -1);
    assert(entry.ok);
    CCAMRegisterFileResult caller_regs = ccam_registers_create(caller_types);
    assert(ccam_register_write_bool(caller_regs.registers, 0, true) == "");
    entry.frame.registers = caller_regs.registers;

    List<int> bool_types = new List<int>();
    bool_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> bool_code = new List<CCAMInstruction>();
    CCAMInstruction bool_ret = ccam_instruction(CCAM_OP_RET);
    bool_ret.lhs = 0;
    bool_code.push(bool_ret);
    CCAMFunction bool_function = new CCAMFunction{
        name: "predicate", register_types: bool_types,
        parameter_count: 1, return_type: CCAM_RETURN_BOOL,
        instructions: bool_code
    };
    List<int> bool_args = new List<int>();
    bool_args.push(0);
    CCAMFrameCreateResult bool_frame = ccam_frame_create(
        bool_function, 1, caller_regs.registers, bool_args, 0);
    assert(bool_frame.ok);
    CCAMFrameStackCreateResult bool_stack = ccam_frame_stack_create(entry.frame, 2);
    assert(bool_stack.ok);
    assert(ccam_frame_stack_push(bool_stack.stack, bool_frame.frame) == "");
    CCAMFrameReturnResult bool_result = ccam_frame_stack_return_bool(
        bool_stack.stack, 0);
    assert(bool_result.ok && bool_result.bool_value);
    assert(bool_stack.stack.frames.len() == 1);
    assert(ccam_register_read_bool(bool_stack.stack.frames[0].registers, 0).bool_value);

    List<int> void_types = new List<int>();
    List<CCAMInstruction> void_code = new List<CCAMInstruction>();
    void_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMFunction void_function = new CCAMFunction{
        name: "side_effect", register_types: void_types,
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: void_code
    };
    CCAMFrameCreateResult void_frame = ccam_frame_create(
        void_function, 2, caller_regs.registers, new List<int>(), -1);
    assert(void_frame.ok);
    CCAMFrameStackCreateResult void_stack = ccam_frame_stack_create(entry.frame, 2);
    assert(void_stack.ok);
    assert(ccam_frame_stack_push(void_stack.stack, void_frame.frame) == "");
    CCAMFrameReturnResult void_result = ccam_frame_stack_return_void(void_stack.stack);
    assert(void_result.ok && !void_result.entry_void);
    assert(void_stack.stack.frames.len() == 1);

    CCAMFrameStackCreateResult invalid_entry = ccam_frame_stack_create(bool_frame.frame, 2);
    assert(!invalid_entry.ok && invalid_entry.error == "invalid_call_stack_configuration");
}
