// CCAM's first executable slice, implemented in Capstan itself.
// This file intentionally contains no host-language implementation.
//
// The result type makes arithmetic failure explicit so the evaluator never
// relies on the host runtime's overflow trap as a language-level outcome.

const int CCAM_I64_MAX = 0x7FFFFFFFFFFFFFFF;
const int CCAM_I64_MIN = -0x7FFFFFFFFFFFFFFF - 1;

struct CCAMIntResult {
    bool ok;
    int value;
    string trap;
}

CCAMIntResult ccam_add(int a, int b) {
    if (b > 0 && a > CCAM_I64_MAX - b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (b < 0 && a < CCAM_I64_MIN - b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a + b, trap: ""};
}

CCAMIntResult ccam_sub(int a, int b) {
    if (b < 0 && a > CCAM_I64_MAX + b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (b > 0 && a < CCAM_I64_MIN + b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a - b, trap: ""};
}

CCAMIntResult ccam_mul(int a, int b) {
    if (a == 0 || b == 0) {
        return new CCAMIntResult{ok: true, value: 0, trap: ""};
    }
    if ((a == CCAM_I64_MIN && b == -1) || (b == CCAM_I64_MIN && a == -1)) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (a > 0) {
        if (b > 0 && a > CCAM_I64_MAX / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
        if (b < 0 && b < CCAM_I64_MIN / a) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
    } else {
        if (b > 0 && a < CCAM_I64_MIN / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
        if (b < 0 && a < CCAM_I64_MAX / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
    }
    return new CCAMIntResult{ok: true, value: a * b, trap: ""};
}

CCAMIntResult ccam_div(int a, int b) {
    if (b == 0) {
        return new CCAMIntResult{ok: false, value: 0, trap: "division_by_zero"};
    }
    if (a == CCAM_I64_MIN && b == -1) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a / b, trap: ""};
}

CCAMIntResult ccam_rem(int a, int b) {
    if (b == 0) {
        return new CCAMIntResult{ok: false, value: 0, trap: "division_by_zero"};
    }
    if (a == CCAM_I64_MIN && b == -1) {
        return new CCAMIntResult{ok: true, value: 0, trap: ""};
    }
    return new CCAMIntResult{ok: true, value: a % b, trap: ""};
}

int main() {
    CCAMIntResult r = ccam_add(20, 22);
    if (!(r.ok && r.value == 42)) { return 1; }
    r = ccam_add(CCAM_I64_MAX, 1);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_sub(CCAM_I64_MIN, 1);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_sub(CCAM_I64_MAX, -1);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_sub(20, 22);
    if (!(r.ok && r.value == -2)) { return 1; }
    r = ccam_mul(6, 7);
    if (!(r.ok && r.value == 42)) { return 1; }
    r = ccam_mul(CCAM_I64_MIN, -1);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_mul(CCAM_I64_MIN, 1);
    if (!(r.ok && r.value == CCAM_I64_MIN)) { return 1; }
    r = ccam_mul(-3037000500, -3037000500);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_mul(-3037000499, -3037000499);
    if (!(r.ok)) { return 1; }
    r = ccam_div(-7, 3);
    if (!(r.ok && r.value == -2)) { return 1; }
    r = ccam_div(1, 0);
    if (!(!r.ok && r.trap == "division_by_zero")) { return 1; }
    r = ccam_rem(1, 0);
    if (!(!r.ok && r.trap == "division_by_zero")) { return 1; }
    r = ccam_div(CCAM_I64_MIN, -1);
    if (!(!r.ok && r.trap == "integer_overflow")) { return 1; }
    r = ccam_rem(-7, 3);
    if (!(r.ok && r.value == -1)) { return 1; }
    r = ccam_rem(7, -3);
    if (!(r.ok && r.value == 1)) { return 1; }
    r = ccam_rem(-7, -3);
    if (!(r.ok && r.value == -1)) { return 1; }
    r = ccam_rem(7, 3);
    if (!(r.ok && r.value == 1)) { return 1; }
    r = ccam_rem(CCAM_I64_MIN, -1);
    if (!(r.ok && r.value == 0)) { return 1; }
    println("CCAM Capstan arithmetic: ok");
    return 0;
}

test "CCAM addition traps on signed overflow" {
    CCAMIntResult r = ccam_add(CCAM_I64_MAX, 1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM multiplication traps on signed overflow" {
    CCAMIntResult r = ccam_mul(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM division truncates toward zero" {
    CCAMIntResult r = ccam_div(-7, 3);
    assert(r.ok && r.value == -2);
}

test "CCAM subtraction checks both overflow directions" {
    CCAMIntResult hi = ccam_sub(CCAM_I64_MAX, -1);
    CCAMIntResult lo = ccam_sub(CCAM_I64_MIN, 1);
    assert(!hi.ok && !lo.ok);
}

test "CCAM multiplication handles negative boundaries" {
    CCAMIntResult min_ok = ccam_mul(CCAM_I64_MIN, 1);
    CCAMIntResult overflow = ccam_mul(-3037000500, -3037000500);
    assert(min_ok.ok && min_ok.value == CCAM_I64_MIN);
    assert(!overflow.ok && overflow.trap == "integer_overflow");
}

test "CCAM division rejects minimum divided by negative one" {
    CCAMIntResult r = ccam_div(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM remainder has dividend sign for every sign combination" {
    CCAMIntResult a = ccam_rem(-7, 3);
    CCAMIntResult b = ccam_rem(7, -3);
    CCAMIntResult c = ccam_rem(-7, -3);
    CCAMIntResult d = ccam_rem(7, 3);
    assert(a.ok && a.value == -1);
    assert(b.ok && b.value == 1);
    assert(c.ok && c.value == -1);
    assert(d.ok && d.value == 1);
}

test "CCAM remainder of minimum by negative one is zero" {
    CCAMIntResult r = ccam_rem(CCAM_I64_MIN, -1);
    assert(r.ok && r.value == 0);
}


// Typed register-file substrate for the CCAM evaluator. Register contents are
// represented as Capstan values; the declared type and initialisation bit are
// independent, so an uninitialised read is never confused with integer zero.
const int CCAM_TYPE_INT = 1;
const int CCAM_TYPE_BOOL = 2;

struct CCAMRegister {
    int declared_type;
    bool initialized;
    int int_value;
    bool bool_value;
}

struct CCAMRegisterResult {
    bool ok;
    int int_value;
    bool bool_value;
    string trap;
}

struct CCAMRegisterFileResult {
    bool ok;
    List<CCAMRegister> registers;
    string error;
}

CCAMRegisterResult ccam_register_error(string trap) {
    return new CCAMRegisterResult{ok: false, int_value: 0, bool_value: false, trap: trap};
}

CCAMRegisterResult ccam_register_int(int value) {
    return new CCAMRegisterResult{ok: true, int_value: value, bool_value: false, trap: ""};
}

CCAMRegisterResult ccam_register_bool(bool value) {
    return new CCAMRegisterResult{ok: true, int_value: 0, bool_value: value, trap: ""};
}

CCAMRegisterFileResult ccam_registers_create(List<int> types) {
    // Validate the complete type vector before constructing any register.
    for (int i = 0; i < types.len(); i += 1) {
        int declared_type = types[i];
        if (declared_type != CCAM_TYPE_INT && declared_type != CCAM_TYPE_BOOL) {
            List<CCAMRegister> empty = new List<CCAMRegister>();
            return new CCAMRegisterFileResult{
                ok: false,
                registers: empty,
                error: "invalid_register_type"
            };
        }
    }

    List<CCAMRegister> registers = new List<CCAMRegister>();
    for (int i = 0; i < types.len(); i += 1) {
        int declared_type = types[i];
        CCAMRegister reg = new CCAMRegister{
            declared_type: declared_type,
            initialized: false,
            int_value: 0,
            bool_value: false
        };
        registers.push(reg);
    }
    return new CCAMRegisterFileResult{ok: true, registers: registers, error: ""};
}

CCAMRegisterResult ccam_register_read_int(List<CCAMRegister> registers, int index) {
    if (index < 0 || index >= registers.len()) {
        return ccam_register_error("invalid_register");
    }
    CCAMRegister reg = registers[index];
    if (!reg.initialized) {
        return ccam_register_error("uninitialised_register");
    }
    if (reg.declared_type != CCAM_TYPE_INT) {
        return ccam_register_error("register_type_mismatch");
    }
    return ccam_register_int(reg.int_value);
}

CCAMRegisterResult ccam_register_read_bool(List<CCAMRegister> registers, int index) {
    if (index < 0 || index >= registers.len()) {
        return ccam_register_error("invalid_register");
    }
    CCAMRegister reg = registers[index];
    if (!reg.initialized) {
        return ccam_register_error("uninitialised_register");
    }
    if (reg.declared_type != CCAM_TYPE_BOOL) {
        return ccam_register_error("register_type_mismatch");
    }
    return ccam_register_bool(reg.bool_value);
}

string ccam_register_write_int(List<CCAMRegister> registers, int index, int value) {
    if (index < 0 || index >= registers.len()) {
        return "invalid_register";
    }
    CCAMRegister reg = registers[index];
    if (reg.declared_type != CCAM_TYPE_INT) {
        return "register_type_mismatch";
    }
    reg.int_value = value;
    reg.initialized = true;
    return "";
}

string ccam_register_write_bool(List<CCAMRegister> registers, int index, bool value) {
    if (index < 0 || index >= registers.len()) {
        return "invalid_register";
    }
    CCAMRegister reg = registers[index];
    if (reg.declared_type != CCAM_TYPE_BOOL) {
        return "register_type_mismatch";
    }
    reg.bool_value = value;
    reg.initialized = true;
    return "";
}

test "CCAM register files preserve declared types and uninitialised state" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_BOOL);
    CCAMRegisterFileResult created = ccam_registers_create(types);
    assert(created.ok);
    List<CCAMRegister> registers = created.registers;
    CCAMRegisterResult read_int = ccam_register_read_int(registers, 0);
    assert(!read_int.ok && read_int.trap == "uninitialised_register");
    assert(ccam_register_write_int(registers, 0, 42) == "");
    assert(ccam_register_write_bool(registers, 1, true) == "");
    read_int = ccam_register_read_int(registers, 0);
    CCAMRegisterResult read_bool = ccam_register_read_bool(registers, 1);
    assert(read_int.ok && read_int.int_value == 42);
    assert(read_bool.ok && read_bool.bool_value);
}

test "CCAM register files reject invalid indices and type confusion" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    CCAMRegisterFileResult created = ccam_registers_create(types);
    assert(created.ok);
    List<CCAMRegister> registers = created.registers;
    assert(ccam_register_write_bool(registers, 0, true) == "register_type_mismatch");
    assert(ccam_register_write_int(registers, 1, 9) == "invalid_register");
    assert(ccam_register_write_int(registers, 0, 1) == "");
    CCAMRegisterResult wrong_type = ccam_register_read_bool(registers, 0);
    CCAMRegisterResult bad_index = ccam_register_read_int(registers, -1);
    assert(!wrong_type.ok && wrong_type.trap == "register_type_mismatch");
    assert(!bad_index.ok && bad_index.trap == "invalid_register");
}

test "CCAM remainder by zero traps" {
    CCAMIntResult r = ccam_rem(7, 0);
    assert(!r.ok && r.trap == "division_by_zero");
}


test "CCAM register-file constructor rejects unknown type tags" {
    List<int> unknown = new List<int>();
    unknown.push(0);
    CCAMRegisterFileResult zero = ccam_registers_create(unknown);
    assert(!zero.ok && zero.error == "invalid_register_type");

    List<int> negative = new List<int>();
    negative.push(-1);
    CCAMRegisterFileResult negative_result = ccam_registers_create(negative);
    assert(!negative_result.ok && negative_result.error == "invalid_register_type");

    List<int> future = new List<int>();
    future.push(3);
    CCAMRegisterFileResult future_result = ccam_registers_create(future);
    assert(!future_result.ok && future_result.error == "invalid_register_type");

    List<int> mixed = new List<int>();
    mixed.push(CCAM_TYPE_INT);
    mixed.push(CCAM_TYPE_BOOL);
    mixed.push(0);
    CCAMRegisterFileResult mixed_result = ccam_registers_create(mixed);
    assert(!mixed_result.ok && mixed_result.error == "invalid_register_type");
    assert(mixed_result.registers.len() == 0);
}


// CCAM single-frame executable evaluator, implemented in Capstan.
// This is a deliberately restricted execution slice over the existing typed
// register substrate in ccam_core.cap. It assumes the program has already
// passed the typed structural validator for this in-memory subset. It is not
// a JSON decoder or closed-schema validator, and it does not yet implement
// calls, frames, or source lowering.
//
// Semantic authority: docs/architecture/CCAM.md.
// The step counter is consumed before dispatch. A dynamic trap therefore
// consumes one instruction; a step-limit trap does not.

const int CCAM_OP_CONST_I = 1;
const int CCAM_OP_CONST_B = 2;
const int CCAM_OP_ADD_I = 3;
const int CCAM_OP_SUB_I = 4;
const int CCAM_OP_MUL_I = 5;
const int CCAM_OP_DIV_I = 6;
const int CCAM_OP_REM_I = 7;
const int CCAM_OP_EQ_I = 8;
const int CCAM_OP_LT_I = 9;
const int CCAM_OP_NOT_B = 10;
const int CCAM_OP_JUMP = 11;
const int CCAM_OP_BRANCH = 12;
const int CCAM_OP_RET = 13;
const int CCAM_OP_RET_VOID = 14;
const int CCAM_OP_TRAP = 15;
const int CCAM_OP_MOVE = 16;
const int CCAM_OP_EMIT_BYTES = 18;
const int CCAM_MAX_OUTPUT_BYTES = 1048576;

struct CCAMInstruction {
    int op;
    int dst;
    int lhs;
    int rhs;
    int src;
    int target;
    int if_true;
    int if_false;
    int int_value;
    bool bool_value;
    string reason;
    List<int> byte_data;
}

struct CCAMMachineState {
    List<CCAMRegister> registers;
    List<CCAMInstruction> instructions;
    int pc;
    int steps;
    int max_steps;
    bool halted;
    bool halt_has_value;
    int halt_value;
    bool halt_bool_value;
    string trap_code;
    string trap_detail;
    List<int> output_bytes;
    int max_output_bytes;
}

struct CCAMMachineCreateResult {
    bool ok;
    CCAMMachineState state;
    string error;
}

List<int> ccam_copy_byte_data(List<int> source) {
    List<int> copied = new List<int>();
    for (int i = 0; i < source.len(); i += 1) {
        copied.push(source[i]);
    }
    return copied;
}

CCAMInstruction ccam_copy_instruction(CCAMInstruction source) {
    return new CCAMInstruction{
        op: source.op,
        dst: source.dst,
        lhs: source.lhs,
        rhs: source.rhs,
        src: source.src,
        target: source.target,
        if_true: source.if_true,
        if_false: source.if_false,
        int_value: source.int_value,
        bool_value: source.bool_value,
        reason: source.reason,
        byte_data: ccam_copy_byte_data(source.byte_data)
    };
}

CCAMMachineCreateResult ccam_machine_create_with_output_budget(
    List<int> register_types,
    List<CCAMInstruction> instructions,
    int max_steps,
    int max_output_bytes
) {
    CCAMRegisterFileResult created = ccam_registers_create(register_types);
    if (!created.ok || max_steps < 0 || max_output_bytes < 0 ||
        max_output_bytes > CCAM_MAX_OUTPUT_BYTES) {
        List<CCAMRegister> empty_registers = new List<CCAMRegister>();
        List<CCAMInstruction> empty_instructions = new List<CCAMInstruction>();
        CCAMMachineState empty_state = new CCAMMachineState{
            registers: empty_registers,
            instructions: empty_instructions,
            pc: 0,
            steps: 0,
            max_steps: 0,
            halted: true,
            halt_has_value: false,
            halt_value: 0,
            halt_bool_value: false,
            trap_code: "",
            trap_detail: "",
            output_bytes: new List<int>(),
            max_output_bytes: 0
        };
        string error = "invalid_step_limit";
        if (!created.ok) {
            error = created.error;
        } else if (max_output_bytes < 0 || max_output_bytes > CCAM_MAX_OUTPUT_BYTES) {
            error = "invalid_output_limit";
        }
        return new CCAMMachineCreateResult{
            ok: false, state: empty_state, error: error
        };
    }
    // Snapshot the validated program so later mutation through the caller's
    // list or instruction references cannot change the executing program.
    List<CCAMInstruction> program = new List<CCAMInstruction>();
    for (int i = 0; i < instructions.len(); i += 1) {
        program.push(ccam_copy_instruction(instructions[i]));
    }
    CCAMMachineState state = new CCAMMachineState{
        registers: created.registers,
        instructions: program,
        pc: 0,
        steps: 0,
        max_steps: max_steps,
        halted: false,
        halt_has_value: false,
        halt_value: 0,
        halt_bool_value: false,
        trap_code: "",
        trap_detail: "",
        output_bytes: new List<int>(),
        max_output_bytes: max_output_bytes
    };
    return new CCAMMachineCreateResult{ok: true, state: state, error: ""};
}

CCAMMachineCreateResult ccam_machine_create(
    List<int> register_types,
    List<CCAMInstruction> instructions,
    int max_steps
) {
    return ccam_machine_create_with_output_budget(
        register_types, instructions, max_steps, CCAM_MAX_OUTPUT_BYTES);
}

CCAMMachineState ccam_machine_create_valid(List<int> register_types,
                                           List<CCAMInstruction> instructions,
                                           int max_steps) {
    CCAMMachineCreateResult created = ccam_machine_create(
        register_types, instructions, max_steps);
    if (!created.ok) {
        created.state.trap_code = created.error;
    }
    return created.state;
}

void ccam_machine_trap(CCAMMachineState state, string code) {
    state.halted = true;
    state.halt_has_value = false;
    state.trap_code = code;
    state.trap_detail = "";
}

void ccam_machine_advance(CCAMMachineState state) {
    state.pc += 1;
}

void ccam_machine_step(CCAMMachineState state) {
    if (state.halted) {
        return;
    }
    if (state.steps >= state.max_steps) {
        ccam_machine_trap(state, "step_limit_exceeded");
        return;
    }
    if (state.pc < 0 || state.pc >= state.instructions.len()) {
        // A validated program cannot reach this state. Keep the evaluator
        // fail-closed if its precondition is violated by an internal caller.
        ccam_machine_trap(state, "invalid_program_counter");
        return;
    }

    CCAMInstruction instruction = state.instructions[state.pc];
    state.steps += 1;

    if (instruction.op == CCAM_OP_EMIT_BYTES) {
        if (state.output_bytes.len() > state.max_output_bytes ||
            instruction.byte_data.len() >
                state.max_output_bytes - state.output_bytes.len()) {
            ccam_machine_trap(state, "output_limit");
            return;
        }
        // Validate the entire payload before appending any byte. This keeps
        // malformed internal instructions atomic even if validation was
        // accidentally bypassed by an internal caller.
        for (int i = 0; i < instruction.byte_data.len(); i += 1) {
            int value = instruction.byte_data[i];
            if (value < 0 || value > 255) {
                ccam_machine_trap(state, "invalid_instruction");
                return;
            }
        }
        for (int i = 0; i < instruction.byte_data.len(); i += 1) {
            state.output_bytes.push(instruction.byte_data[i]);
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_MOVE) {
        if (instruction.src < 0 || instruction.src >= state.registers.len() ||
            instruction.dst < 0 || instruction.dst >= state.registers.len()) {
            ccam_machine_trap(state, "invalid_register");
            return;
        }
        CCAMRegister source = state.registers[instruction.src];
        CCAMRegister destination = state.registers[instruction.dst];
        if (!source.initialized) {
            ccam_machine_trap(state, "uninitialised_register");
            return;
        }
        if (source.declared_type != destination.declared_type) {
            ccam_machine_trap(state, "register_type_mismatch");
            return;
        }
        string error = "";
        if (source.declared_type == CCAM_TYPE_INT) {
            error = ccam_register_write_int(
                state.registers, instruction.dst, source.int_value);
        } else if (source.declared_type == CCAM_TYPE_BOOL) {
            error = ccam_register_write_bool(
                state.registers, instruction.dst, source.bool_value);
        } else {
            ccam_machine_trap(state, "register_type_mismatch");
            return;
        }
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_CONST_I) {
        string error = ccam_register_write_int(
            state.registers, instruction.dst, instruction.int_value);
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_CONST_B) {
        string error = ccam_register_write_bool(
            state.registers, instruction.dst, instruction.bool_value);
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_ADD_I ||
        instruction.op == CCAM_OP_SUB_I ||
        instruction.op == CCAM_OP_MUL_I ||
        instruction.op == CCAM_OP_DIV_I ||
        instruction.op == CCAM_OP_REM_I) {
        // Reads are deliberately ordered lhs then rhs. A failed lhs read
        // prevents the rhs read and all arithmetic.
        CCAMRegisterResult lhs = ccam_register_read_int(
            state.registers, instruction.lhs);
        if (!lhs.ok) {
            ccam_machine_trap(state, lhs.trap);
            return;
        }
        CCAMRegisterResult rhs = ccam_register_read_int(
            state.registers, instruction.rhs);
        if (!rhs.ok) {
            ccam_machine_trap(state, rhs.trap);
            return;
        }

        CCAMIntResult result = ccam_add(0, 0);
        if (instruction.op == CCAM_OP_ADD_I) {
            result = ccam_add(lhs.int_value, rhs.int_value);
        } else if (instruction.op == CCAM_OP_SUB_I) {
            result = ccam_sub(lhs.int_value, rhs.int_value);
        } else if (instruction.op == CCAM_OP_MUL_I) {
            result = ccam_mul(lhs.int_value, rhs.int_value);
        } else if (instruction.op == CCAM_OP_DIV_I) {
            result = ccam_div(lhs.int_value, rhs.int_value);
        } else {
            result = ccam_rem(lhs.int_value, rhs.int_value);
        }
        if (!result.ok) {
            ccam_machine_trap(state, result.trap);
            return;
        }
        string error = ccam_register_write_int(
            state.registers, instruction.dst, result.value);
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_EQ_I || instruction.op == CCAM_OP_LT_I) {
        CCAMRegisterResult lhs = ccam_register_read_int(
            state.registers, instruction.lhs);
        if (!lhs.ok) {
            ccam_machine_trap(state, lhs.trap);
            return;
        }
        CCAMRegisterResult rhs = ccam_register_read_int(
            state.registers, instruction.rhs);
        if (!rhs.ok) {
            ccam_machine_trap(state, rhs.trap);
            return;
        }
        bool value = lhs.int_value == rhs.int_value;
        if (instruction.op == CCAM_OP_LT_I) {
            value = lhs.int_value < rhs.int_value;
        }
        string error = ccam_register_write_bool(
            state.registers, instruction.dst, value);
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_NOT_B) {
        CCAMRegisterResult source = ccam_register_read_bool(
            state.registers, instruction.lhs);
        if (!source.ok) {
            ccam_machine_trap(state, source.trap);
            return;
        }
        string error = ccam_register_write_bool(
            state.registers, instruction.dst, !source.bool_value);
        if (error != "") {
            ccam_machine_trap(state, error);
            return;
        }
        ccam_machine_advance(state);
        return;
    }

    if (instruction.op == CCAM_OP_JUMP) {
        state.pc = instruction.target;
        return;
    }

    if (instruction.op == CCAM_OP_BRANCH) {
        CCAMRegisterResult condition = ccam_register_read_bool(
            state.registers, instruction.lhs);
        if (!condition.ok) {
            ccam_machine_trap(state, condition.trap);
            return;
        }
        if (condition.bool_value) {
            state.pc = instruction.if_true;
        } else {
            state.pc = instruction.if_false;
        }
        return;
    }

    if (instruction.op == CCAM_OP_RET) {
        if (instruction.lhs < 0 || instruction.lhs >= state.registers.len()) {
            ccam_machine_trap(state, "invalid_register");
            return;
        }
        CCAMRegister source = state.registers[instruction.lhs];
        if (source.declared_type == CCAM_TYPE_INT) {
            CCAMRegisterResult value = ccam_register_read_int(
                state.registers, instruction.lhs);
            if (!value.ok) {
                ccam_machine_trap(state, value.trap);
                return;
            }
            state.halt_value = value.int_value;
            state.halt_bool_value = false;
        } else if (source.declared_type == CCAM_TYPE_BOOL) {
            CCAMRegisterResult value = ccam_register_read_bool(
                state.registers, instruction.lhs);
            if (!value.ok) {
                ccam_machine_trap(state, value.trap);
                return;
            }
            state.halt_value = 0;
            state.halt_bool_value = value.bool_value;
        } else {
            ccam_machine_trap(state, "register_type_mismatch");
            return;
        }
        state.halted = true;
        state.halt_has_value = true;
        return;
    }

    if (instruction.op == CCAM_OP_RET_VOID) {
        state.halted = true;
        state.halt_has_value = false;
        return;
    }

    if (instruction.op == CCAM_OP_TRAP) {
        state.halted = true;
        state.halt_has_value = false;
        state.trap_code = "explicit_trap";
        state.trap_detail = instruction.reason;
        return;
    }

    // Unknown opcodes are excluded by the structural validator. This branch
    // is defensive only and is not a substitute for validation.
    ccam_machine_trap(state, "invalid_instruction");
}

CCAMInstruction ccam_instruction(int op) {
    return new CCAMInstruction{
        op: op,
        dst: 0,
        lhs: 0,
        rhs: 0,
        src: 0,
        target: 0,
        if_true: 0,
        if_false: 0,
        int_value: 0,
        bool_value: false,
        reason: "",
        byte_data: new List<int>()
    };
}

test "CCAM machine creation rejects invalid register tags and step limits" {
    List<int> invalid_types = new List<int>();
    invalid_types.push(7);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMMachineCreateResult invalid_registers = ccam_machine_create(
        invalid_types, code, 1);
    assert(!invalid_registers.ok);
    assert(invalid_registers.error == "invalid_register_type");

    List<int> valid_types = new List<int>();
    CCAMMachineCreateResult invalid_limit = ccam_machine_create(
        valid_types, code, -1);
    assert(!invalid_limit.ok);
    assert(invalid_limit.error == "invalid_step_limit");
}

test "CCAM machine executes checked arithmetic and returns a value" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 19;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 23;
    code.push(i);
    i = ccam_instruction(CCAM_OP_ADD_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 2;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 4);
    for (int n = 0; n < 4; n += 1) {
        ccam_machine_step(state);
    }
    assert(state.halted && state.halt_has_value && state.halt_value == 42);
    assert(state.trap_code == "" && state.steps == 4);
}

test "CCAM machine snapshots instructions before execution" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 42;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 2);
    CCAMInstruction caller_owned = code[0];
    caller_owned.int_value = 99;
    code.push(ccam_instruction(CCAM_OP_TRAP));
    ccam_machine_step(state);
    ccam_machine_step(state);
    assert(state.halted && state.halt_has_value && state.halt_value == 42);
    assert(state.instructions.len() == 2 && state.steps == 2);
}

test "CCAM machine consumes a step for a dynamic arithmetic trap" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 7;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 0;
    code.push(i);
    i = ccam_instruction(CCAM_OP_DIV_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 3);
    ccam_machine_step(state);
    ccam_machine_step(state);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "division_by_zero");
    assert(state.steps == 3 && state.pc == 2);
}

test "CCAM machine checks the step limit before executing the next instruction" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 9;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 1);
    ccam_machine_step(state);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "step_limit_exceeded");
    assert(state.steps == 1 && state.pc == 1);
}

test "CCAM machine follows a boolean branch" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_B);
    i.dst = 0;
    i.bool_value = true;
    code.push(i);
    i = ccam_instruction(CCAM_OP_BRANCH);
    i.lhs = 0;
    i.if_true = 2;
    i.if_false = 4;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 42;
    code.push(i);
    i = ccam_instruction(CCAM_OP_JUMP);
    i.target = 5;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 99;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 1;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 5);
    for (int n = 0; n < 5; n += 1) {
        ccam_machine_step(state);
    }
    assert(state.halted && state.halt_has_value && state.halt_value == 42);
    assert(state.steps == 5);
}

test "CCAM machine compares integers and negates booleans" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 5;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 8;
    code.push(i);
    i = ccam_instruction(CCAM_OP_LT_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_NOT_B);
    i.dst = 3;
    i.lhs = 2;
    code.push(i);
    i = ccam_instruction(CCAM_OP_EQ_I);
    i.dst = 4;
    i.lhs = 0;
    i.rhs = 0;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 3;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 6);
    for (int n = 0; n < 6; n += 1) {
        ccam_machine_step(state);
    }
    CCAMRegister equality = state.registers[4];
    assert(state.halted && state.halt_has_value && !state.halt_bool_value);
    assert(equality.initialized && equality.bool_value);
    assert(state.steps == 6 && state.trap_code == "");
}

test "CCAM machine moves typed values and returns a boolean" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_B);
    i.dst = 0;
    i.bool_value = true;
    code.push(i);
    i = ccam_instruction(CCAM_OP_MOVE);
    i.dst = 1;
    i.src = 0;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 1;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 3);
    for (int n = 0; n < 3; n += 1) {
        ccam_machine_step(state);
    }
    assert(state.halted && state.halt_has_value && state.halt_bool_value);
    assert(state.steps == 3 && state.trap_code == "");
}

test "CCAM machine preserves the left operand trap precedence" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_ADD_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 1);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "uninitialised_register");
    assert(state.steps == 1 && state.pc == 0);
}

test "CCAM machine returns void and preserves explicit trap detail" {
    List<int> types = new List<int>();
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_RET_VOID);
    code.push(i);
    CCAMMachineState state = ccam_machine_create_valid(types, code, 1);
    ccam_machine_step(state);
    assert(state.halted && !state.halt_has_value && state.trap_code == "");

    List<CCAMInstruction> trapped_code = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_TRAP);
    i.reason = "deliberate_stop";
    trapped_code.push(i);
    CCAMMachineState trapped = ccam_machine_create_valid(types, trapped_code, 1);
    ccam_machine_step(trapped);
    assert(trapped.halted && trapped.trap_code == "explicit_trap");
    assert(trapped.trap_detail == "deliberate_stop");
}


test "CCAM machine follows the false branch arm" {
