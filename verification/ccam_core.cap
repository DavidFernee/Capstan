    assert(state.steps == 4 && state.trap_code == "");
}

test "CCAM machine rejects an uninitialised return source" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    code.push(i);
    CCAMMachineState state = ccam_machine_create_valid(types, code, 1);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "uninitialised_register");
    assert(state.steps == 1 && !state.halt_has_value);
}

test "CCAM machine fails closed on invalid destination and type" {
    List<int> int_types = new List<int>();
    int_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> bad_index_code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 7;
    bad_index_code.push(i);
    CCAMMachineState bad_index = ccam_machine_create_valid(int_types, bad_index_code, 1);
    ccam_machine_step(bad_index);
    assert(bad_index.halted && bad_index.trap_code == "invalid_register");
    assert(bad_index.steps == 1);

    List<int> bool_types = new List<int>();
    bool_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> bad_type_code = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 7;
    bad_type_code.push(i);
    CCAMMachineState bad_type = ccam_machine_create_valid(bool_types, bad_type_code, 1);
    ccam_machine_step(bad_type);
    assert(bad_type.halted && bad_type.trap_code == "register_type_mismatch");
    assert(bad_type.steps == 1);
}

test "CCAM machine traps defensively on invalid program counters and opcodes" {
    List<int> types = new List<int>();
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMMachineState bad_pc = ccam_machine_create_valid(types, code, 1);
    bad_pc.pc = 1;
    ccam_machine_step(bad_pc);
    assert(bad_pc.halted && bad_pc.trap_code == "invalid_program_counter");
    assert(bad_pc.steps == 0);

    List<CCAMInstruction> bad_opcode_code = new List<CCAMInstruction>();
    bad_opcode_code.push(ccam_instruction(999));
    CCAMMachineState bad_opcode = ccam_machine_create_valid(types, bad_opcode_code, 1);
    ccam_machine_step(bad_opcode);
    assert(bad_opcode.halted && bad_opcode.trap_code == "invalid_instruction");
    assert(bad_opcode.steps == 1);
}

test "CCAM machine checks a zero instruction budget before dispatch" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 7;
    code.push(i);
    CCAMMachineState state = ccam_machine_create_valid(types, code, 0);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "step_limit_exceeded");
    assert(state.steps == 0 && state.pc == 0);
}

test "CCAM machine fails closed after an invalid branch target" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_B);
    i.dst = 0;
    i.bool_value = false;
    code.push(i);
    i = ccam_instruction(CCAM_OP_BRANCH);
    i.lhs = 0;
    i.if_true = 2;
    i.if_false = 99;
    code.push(i);
    code.push(ccam_instruction(CCAM_OP_RET_VOID));
    CCAMMachineState state = ccam_machine_create_valid(types, code, 3);
    ccam_machine_step(state);
    ccam_machine_step(state);
    assert(!state.halted && state.pc == 99 && state.steps == 2);
    ccam_machine_step(state);
    assert(state.halted && state.trap_code == "invalid_program_counter");
    assert(state.steps == 2);
}


test "CCAM evaluator dispatches subtraction multiplication and remainder" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 20;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 6;
    code.push(i);
    i = ccam_instruction(CCAM_OP_SUB_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_MUL_I);
    i.dst = 3;
    i.lhs = 2;
    i.rhs = 2;
    code.push(i);
    i = ccam_instruction(CCAM_OP_REM_I);
    i.dst = 4;
    i.lhs = 3;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 4;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 6);
    for (int n = 0; n < 6; n += 1) {
        ccam_machine_step(state);
    }
    assert(state.halted && state.halt_has_value && state.halt_value == 4);
    assert(state.steps == 6 && state.trap_code == "");
}

test "CCAM evaluator traps on checked addition overflow" {
