    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_B);
    i.dst = 0;
    i.bool_value = true;
    code.push(i);
    i = ccam_instruction(CCAM_OP_BRANCH);
    i.lhs = 0;
    i.if_true = 2;
    i.if_false = 4;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 42;
    code.push(i);
    i = ccam_instruction(CCAM_OP_JUMP);
    i.target = 5;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 99;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 1;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 5);
    for (int n = 0; n < 5; n += 1) {
        ccam_machine_step(state);
    }
    assert(state.halted && state.halt_has_value && state.halt_value == 42);
    assert(state.steps == 5);
}

test "CCAM machine compares integers and negates booleans" {
    List<int> types = new List<int>();
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_INT);
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_BOOL);
    types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 5;
    code.push(i);
    i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 1;
    i.int_value = 8;
    code.push(i);
    i = ccam_instruction(CCAM_OP_LT_I);
    i.dst = 2;
    i.lhs = 0;
    i.rhs = 1;
    code.push(i);
    i = ccam_instruction(CCAM_OP_NOT_B);
    i.dst = 3;
    i.lhs = 2;
    code.push(i);
    i = ccam_instruction(CCAM_OP_EQ_I);
    i.dst = 4;
    i.lhs = 0;
    i.rhs = 0;
    code.push(i);
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 3;
    code.push(i);

    CCAMMachineState state = ccam_machine_create_valid(types, code, 6);
    for (int n = 0; n < 6; n += 1) {
        ccam_machine_step(state);
    }
    CCAMRegister equality = state.registers[4];
    assert(state.halted && state.halt_has_value && !state.halt_bool_value);
    assert(equality.initialized && equality.bool_value);
    assert(state.steps == 6 && state.trap_code == "");
}

