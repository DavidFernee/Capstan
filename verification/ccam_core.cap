// CCAM's first executable slice, implemented in Capstan itself.
// This file intentionally contains no host-language implementation.
//
// The result type makes arithmetic failure explicit so the evaluator never
// relies on the host runtime's overflow trap as a language-level outcome.

const int CCAM_I64_MAX = 0x7FFFFFFFFFFFFFFF;
const int CCAM_I64_MIN = -0x7FFFFFFFFFFFFFFF - 1;

struct CCAMIntResult {
    bool ok;
    int value;
    string trap;
}

CCAMIntResult ccam_add(int a, int b) {
    if (b > 0 && a > CCAM_I64_MAX - b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (b < 0 && a < CCAM_I64_MIN - b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a + b, trap: ""};
}

CCAMIntResult ccam_sub(int a, int b) {
    if (b < 0 && a > CCAM_I64_MAX + b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (b > 0 && a < CCAM_I64_MIN + b) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a - b, trap: ""};
}

CCAMIntResult ccam_mul(int a, int b) {
    if (a == 0 || b == 0) {
        return new CCAMIntResult{ok: true, value: 0, trap: ""};
    }
    if ((a == CCAM_I64_MIN && b == -1) || (b == CCAM_I64_MIN && a == -1)) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    if (a > 0) {
        if (b > 0 && a > CCAM_I64_MAX / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
        if (b < 0 && b < CCAM_I64_MIN / a) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
    } else {
        if (b > 0 && a < CCAM_I64_MIN / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
        if (b < 0 && a < CCAM_I64_MAX / b) {
            return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
        }
    }
    return new CCAMIntResult{ok: true, value: a * b, trap: ""};
}

CCAMIntResult ccam_div(int a, int b) {
    if (b == 0) {
        return new CCAMIntResult{ok: false, value: 0, trap: "division_by_zero"};
    }
    if (a == CCAM_I64_MIN && b == -1) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a / b, trap: ""};
}

CCAMIntResult ccam_rem(int a, int b) {
    if (b == 0) {
        return new CCAMIntResult{ok: false, value: 0, trap: "division_by_zero"};
    }
    if (a == CCAM_I64_MIN && b == -1) {
        return new CCAMIntResult{ok: false, value: 0, trap: "integer_overflow"};
    }
    return new CCAMIntResult{ok: true, value: a % b, trap: ""};
}

int main() {
    CCAMIntResult r = ccam_add(20, 22);
    assert(r.ok && r.value == 42);
    r = ccam_add(CCAM_I64_MAX, 1);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_sub(CCAM_I64_MIN, 1);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_sub(CCAM_I64_MAX, -1);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_sub(20, 22);
    assert(r.ok && r.value == -2);
    r = ccam_mul(6, 7);
    assert(r.ok && r.value == 42);
    r = ccam_mul(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_mul(CCAM_I64_MIN, 1);
    assert(r.ok && r.value == CCAM_I64_MIN);
    r = ccam_mul(-3037000500, -3037000500);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_mul(-3037000499, -3037000499);
    assert(r.ok);
    r = ccam_div(-7, 3);
    assert(r.ok && r.value == -2);
    r = ccam_div(1, 0);
    assert(!r.ok && r.trap == "division_by_zero");
    r = ccam_div(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
    r = ccam_rem(-7, 3);
    assert(r.ok && r.value == -1);
    r = ccam_rem(7, -3);
    assert(r.ok && r.value == 1);
    r = ccam_rem(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
    println("CCAM Capstan arithmetic: ok");
    return 0;
}

test "CCAM addition traps on signed overflow" {
    CCAMIntResult r = ccam_add(CCAM_I64_MAX, 1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM multiplication traps on signed overflow" {
    CCAMIntResult r = ccam_mul(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM division truncates toward zero" {
    CCAMIntResult r = ccam_div(-7, 3);
    assert(r.ok && r.value == -2);
}

test "CCAM subtraction checks both overflow directions" {
    CCAMIntResult hi = ccam_sub(CCAM_I64_MAX, -1);
    CCAMIntResult lo = ccam_sub(CCAM_I64_MIN, 1);
    assert(!hi.ok && !lo.ok);
}

test "CCAM multiplication handles negative boundaries" {
    CCAMIntResult min_ok = ccam_mul(CCAM_I64_MIN, 1);
    CCAMIntResult overflow = ccam_mul(-3037000500, -3037000500);
    assert(min_ok.ok && min_ok.value == CCAM_I64_MIN);
    assert(!overflow.ok && overflow.trap == "integer_overflow");
}

test "CCAM division rejects minimum divided by negative one" {
    CCAMIntResult r = ccam_div(CCAM_I64_MIN, -1);
    assert(!r.ok && r.trap == "integer_overflow");
}

test "CCAM remainder has dividend sign" {
    CCAMIntResult r = ccam_rem(-7, 3);
    assert(r.ok && r.value == -1);
}
