// All supported binary operators are left-associative, including bitwise XOR.
bool ag_operator_right_associative(int op) { return false; }
bool ag_should_reduce(int top,int incoming) {
    int a = ag_operator_class(top);
    int b = ag_operator_class(incoming);
    return a > b || (a == b && !ag_operator_right_associative(incoming));
}
