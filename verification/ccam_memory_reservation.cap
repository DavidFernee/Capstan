// CCAM v0.2 scratch reservation arithmetic prototype.
// This is an executable Capstan model of the pure reservation transition only.
// It does not allocate backing bytes, create capabilities, model ownership, or
// extend the normative CCAM v0.1 evaluator.

import "ccam_core.cap";

struct CCAMScratchViewPlan {
    bool ok;
    int offset;
    int count;
    int element_size;
    int alignment;
    int new_used;
    string error;
}

CCAMScratchViewPlan ccam_scratch_plan_error(string error) {
    return new CCAMScratchViewPlan{
        ok: false, offset: 0, count: 0, element_size: 0,
        alignment: 0, new_used: 0, error: error
    };
}

CCAMScratchViewPlan ccam_scratch_reservation_plan(
    int capacity,
    int used,
    int count,
    int element_size,
    int alignment
) {
    if (capacity < 0 || used < 0 || used > capacity) {
        return ccam_scratch_plan_error("invalid_region_state");
    }
    if (count < 0 ||
        !((element_size == 1 && alignment == 1) ||
          (element_size == 8 && alignment == 8))) {
        return ccam_scratch_plan_error("invalid_layout_or_count");
    }

    CCAMIntResult byte_count = ccam_mul(count, element_size);
    if (!byte_count.ok || byte_count.value < 0) {
        return ccam_scratch_plan_error("scratch_arithmetic_overflow");
    }

    int remainder = used % alignment;
    int padding = 0;
    if (remainder != 0) {
        padding = alignment - remainder;
    }
    CCAMIntResult aligned_start = ccam_add(used, padding);
    if (!aligned_start.ok) {
        return ccam_scratch_plan_error("scratch_arithmetic_overflow");
    }

    CCAMIntResult end = ccam_add(aligned_start.value, byte_count.value);
    if (!end.ok) {
        return ccam_scratch_plan_error("scratch_arithmetic_overflow");
    }
    if (end.value > capacity) {
        return ccam_scratch_plan_error("scratch_exhausted");
    }

    return new CCAMScratchViewPlan{
        ok: true,
        offset: aligned_start.value,
        count: count,
        element_size: element_size,
        alignment: alignment,
        new_used: end.value,
        error: ""
    };
}

test "scratch reservation aligns i64 and charges padding" {
    CCAMScratchViewPlan first = ccam_scratch_reservation_plan(32, 1, 2, 8, 8);
    assert(first.ok);
    assert(first.offset == 8);
    assert(first.new_used == 24);
}

test "scratch reservation exact capacity succeeds and one byte over fails" {
    CCAMScratchViewPlan exact = ccam_scratch_reservation_plan(16, 0, 2, 8, 8);
    CCAMScratchViewPlan over = ccam_scratch_reservation_plan(15, 0, 2, 8, 8);
    assert(exact.ok && exact.new_used == 16);
    assert(!over.ok && over.error == "scratch_exhausted");
}

test "failed scratch reservation has no committed cursor" {
    int old_used = 9;
    CCAMScratchViewPlan failed = ccam_scratch_reservation_plan(16, old_used, 1, 8, 8);
    assert(!failed.ok);
    assert(failed.new_used == 0);
    assert(old_used == 9);
}

test "zero length view is valid and preserves aligned cursor" {
    CCAMScratchViewPlan empty = ccam_scratch_reservation_plan(16, 3, 0, 8, 8);
    assert(empty.ok);
    assert(empty.offset == 8);
    assert(empty.new_used == 8);
    assert(empty.count == 0);
}

test "scratch reservation rejects invalid region state and layouts" {
    CCAMScratchViewPlan bad_state = ccam_scratch_reservation_plan(8, 9, 1, 1, 1);
    CCAMScratchViewPlan bad_align = ccam_scratch_reservation_plan(8, 0, 1, 1, 4);
    CCAMScratchViewPlan negative = ccam_scratch_reservation_plan(8, 0, -1, 1, 1);
    assert(!bad_state.ok && bad_state.error == "invalid_region_state");
    assert(!bad_align.ok && bad_align.error == "invalid_layout_or_count");
    assert(!negative.ok && negative.error == "invalid_layout_or_count");

    // The initial CCAM profile has exactly two scalar layouts: canonical
    // bool bytes and aligned i64 words. Arbitrary aggregate layouts are
    // deliberately not admitted by this prototype.
    CCAMScratchViewPlan bool_as_i64 = ccam_scratch_reservation_plan(16, 0, 1, 1, 8);
    CCAMScratchViewPlan i64_as_byte = ccam_scratch_reservation_plan(16, 0, 1, 8, 1);
    CCAMScratchViewPlan aggregate = ccam_scratch_reservation_plan(16, 0, 1, 3, 1);
    assert(!bool_as_i64.ok && bool_as_i64.error == "invalid_layout_or_count");
    assert(!i64_as_byte.ok && i64_as_byte.error == "invalid_layout_or_count");
    assert(!aggregate.ok && aggregate.error == "invalid_layout_or_count");
}

test "scratch reservation checks multiplication and end offset overflow" {
    CCAMScratchViewPlan product = ccam_scratch_reservation_plan(
        9223372036854775807, 0, 9223372036854775807, 8, 8
    );
    CCAMScratchViewPlan end = ccam_scratch_reservation_plan(
        9223372036854775807, 9223372036854775800, 8, 1, 1
    );
    assert(!product.ok && product.error == "scratch_arithmetic_overflow");
    assert(!end.ok && end.error == "scratch_arithmetic_overflow");
}
