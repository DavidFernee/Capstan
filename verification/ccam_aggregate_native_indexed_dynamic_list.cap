test "indexed dynamic scalar list leaf has exact extent" {
    List<int> b = new List<int>();
    assert(ag_native_emit_indexed_dynamic_list(b));
    assert(b.len() == 1153);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-indexed-dynamic-list.bin", data));
}
