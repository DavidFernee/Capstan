test "GC all three-slot object kind and root combinations" {
    for (int kinds = 0; kinds < 27; kinds += 1) {
        for (int roots = 0; roots < 8; roots += 1) {
            for (int budget = 0; budget <= 3; budget += 1) {
                GCSpec spec = gc_empty_spec(budget);
                List<bool> kept = new List<bool>();
                int k = kinds;
                int r = roots;
                int live = 0;
                for (int i = 0; i < 3; i += 1) {
                    int kind = 1 + k % 3;
                    bool root = r % 2 == 1;
                    spec.objects.push(gc_object(i, kind));
                    kept.push(root);
                    if (root) { spec.roots.push(gc_ref(i, 1)); live += 1; }
                    k = k / 3;
                    r = r / 2;
                }
                GCResult result = gc_collect(spec);
                if (budget < live) {
                    assert(result.status == GC_WORKLIST_FULL && result.work_items == budget);
                    assert(result.marked_ids.len() == 0 && result.reclaimed_ids.len() == 0);
                    for (int i = 0; i < 3; i += 1) {
                        assert(result.objects[i].allocated && !result.objects[i].secret_wiped);
                    }
                } else {
                    assert(result.status == GC_OK && result.work_items == live);
                    for (int i = 0; i < 3; i += 1) {
                        GCObject item = result.objects[i];
                        assert(item.allocated == kept[i] && item.marked == kept[i]);
                        assert(item.secret_wiped == (!kept[i] && item.kind == GC_KIND_SECRET));
                    }
                }
            }
        }
    }
}
