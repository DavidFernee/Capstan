test "systematic add boundary row 10" {
    assert(assurance_int_matches(ccam_add(1, CCAM_I64_MIN), true, -9223372036854775807, ""));
    assert(assurance_int_matches(ccam_add(1, -9223372036854775807), true, -9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(1, -9223372036854775806), true, -9223372036854775805, ""));
    assert(assurance_int_matches(ccam_add(1, -3037000500), true, -3037000499, ""));
    assert(assurance_int_matches(ccam_add(1, -3037000499), true, -3037000498, ""));
    assert(assurance_int_matches(ccam_add(1, -65536), true, -65535, ""));
    assert(assurance_int_matches(ccam_add(1, -3), true, -2, ""));
    assert(assurance_int_matches(ccam_add(1, -2), true, -1, ""));
    assert(assurance_int_matches(ccam_add(1, -1), true, 0, ""));
    assert(assurance_int_matches(ccam_add(1, 0), true, 1, ""));
    assert(assurance_int_matches(ccam_add(1, 1), true, 2, ""));
    assert(assurance_int_matches(ccam_add(1, 2), true, 3, ""));
    assert(assurance_int_matches(ccam_add(1, 3), true, 4, ""));
    assert(assurance_int_matches(ccam_add(1, 65536), true, 65537, ""));
    assert(assurance_int_matches(ccam_add(1, 3037000499), true, 3037000500, ""));
    assert(assurance_int_matches(ccam_add(1, 3037000500), true, 3037000501, ""));
    assert(assurance_int_matches(ccam_add(1, 9223372036854775805), true, 9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(1, 9223372036854775806), true, CCAM_I64_MAX, ""));
    assert(assurance_int_matches(ccam_add(1, CCAM_I64_MAX), false, 0, "integer_overflow"));
}

test "systematic add boundary row 11" {
    assert(assurance_int_matches(ccam_add(2, CCAM_I64_MIN), true, -9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(2, -9223372036854775807), true, -9223372036854775805, ""));
    assert(assurance_int_matches(ccam_add(2, -9223372036854775806), true, -9223372036854775804, ""));
    assert(assurance_int_matches(ccam_add(2, -3037000500), true, -3037000498, ""));
