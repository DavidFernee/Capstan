    assert(assurance_int_matches(ccam_add(-65536, -2), true, -65538, ""));
    assert(assurance_int_matches(ccam_add(-65536, -1), true, -65537, ""));
    assert(assurance_int_matches(ccam_add(-65536, 0), true, -65536, ""));
    assert(assurance_int_matches(ccam_add(-65536, 1), true, -65535, ""));
    assert(assurance_int_matches(ccam_add(-65536, 2), true, -65534, ""));
    assert(assurance_int_matches(ccam_add(-65536, 3), true, -65533, ""));
    assert(assurance_int_matches(ccam_add(-65536, 65536), true, 0, ""));
    assert(assurance_int_matches(ccam_add(-65536, 3037000499), true, 3036934963, ""));
    assert(assurance_int_matches(ccam_add(-65536, 3037000500), true, 3036934964, ""));
    assert(assurance_int_matches(ccam_add(-65536, 9223372036854775805), true, 9223372036854710269, ""));
    assert(assurance_int_matches(ccam_add(-65536, 9223372036854775806), true, 9223372036854710270, ""));
    assert(assurance_int_matches(ccam_add(-65536, CCAM_I64_MAX), true, 9223372036854710271, ""));
}

