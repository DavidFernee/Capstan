    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 1), true, CCAM_I64_MIN, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 2), true, -4611686018427387904, ""));
