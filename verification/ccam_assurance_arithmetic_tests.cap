    assert(assurance_int_matches(ccam_add(-3037000500, -3037000499), true, -6074000999, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, -65536), true, -3037066036, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, -3), true, -3037000503, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, -2), true, -3037000502, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, -1), true, -3037000501, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 0), true, -3037000500, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 1), true, -3037000499, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 2), true, -3037000498, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 3), true, -3037000497, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 65536), true, -3036934964, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 3037000499), true, -1, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 3037000500), true, 0, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 9223372036854775805), true, 9223372033817775305, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, 9223372036854775806), true, 9223372033817775306, ""));
    assert(assurance_int_matches(ccam_add(-3037000500, CCAM_I64_MAX), true, 9223372033817775307, ""));
}

