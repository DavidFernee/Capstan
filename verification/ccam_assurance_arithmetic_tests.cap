import "ccam_core.cap";

// Exact signed-64 fixtures independently computed with arbitrary-precision integers.
// All ordered pairs of 19 boundary values; expected outcomes are fixed literals.

bool assurance_int_matches(CCAMIntResult actual, bool ok, int value, string trap) {
    return actual.ok == ok && actual.value == value && actual.trap == trap;
}

test "systematic add boundary row 0" {
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, CCAM_I64_MIN), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -9223372036854775807), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -9223372036854775806), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -3037000500), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -3037000499), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -65536), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -3), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -2), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, -1), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 0), true, CCAM_I64_MIN, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 1), true, -9223372036854775807, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 2), true, -9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 3), true, -9223372036854775805, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 65536), true, -9223372036854710272, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 3037000499), true, -9223372033817775309, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 3037000500), true, -9223372033817775308, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 9223372036854775805), true, -3, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, 9223372036854775806), true, -2, ""));
    assert(assurance_int_matches(ccam_add(CCAM_I64_MIN, CCAM_I64_MAX), true, -1, ""));
}

test "systematic add boundary row 1" {
    assert(assurance_int_matches(ccam_add(-9223372036854775807, CCAM_I64_MIN), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -9223372036854775807), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -9223372036854775806), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -3037000500), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -3037000499), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -65536), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -3), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -2), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, -1), true, CCAM_I64_MIN, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 0), true, -9223372036854775807, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 1), true, -9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 2), true, -9223372036854775805, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 3), true, -9223372036854775804, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 65536), true, -9223372036854710271, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 3037000499), true, -9223372033817775308, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 3037000500), true, -9223372033817775307, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 9223372036854775805), true, -2, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, 9223372036854775806), true, -1, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775807, CCAM_I64_MAX), true, 0, ""));
}

test "systematic add boundary row 2" {
    assert(assurance_int_matches(ccam_add(-9223372036854775806, CCAM_I64_MIN), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, -9223372036854775807), false, 0, "integer_overflow"));
