test "systematic add boundary row 5" {
    assert(assurance_int_matches(ccam_add(-65536, CCAM_I64_MIN), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-65536, -9223372036854775807), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-65536, -9223372036854775806), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-65536, -3037000500), true, -3037066036, ""));
    assert(assurance_int_matches(ccam_add(-65536, -3037000499), true, -3037066035, ""));
    assert(assurance_int_matches(ccam_add(-65536, -65536), true, -131072, ""));
