    assert(assurance_int_matches(ccam_rem(9223372036854775805, 3), true, 2, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, 65536), true, 65533, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, 3037000499), true, 2891526305, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, 3037000500), true, 2891526305, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, 9223372036854775805), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, 9223372036854775806), true, 9223372036854775805, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775805, CCAM_I64_MAX), true, 9223372036854775805, ""));
}

test "systematic rem boundary row 17" {
    assert(assurance_int_matches(ccam_rem(9223372036854775806, CCAM_I64_MIN), true, 9223372036854775806, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -9223372036854775807), true, 9223372036854775806, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -9223372036854775806), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -3037000500), true, 2891526306, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -3037000499), true, 2891526306, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -65536), true, 65534, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -3), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -2), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, -1), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 0), false, 0, "division_by_zero"));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 1), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 2), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 3), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 65536), true, 65534, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 3037000499), true, 2891526306, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 3037000500), true, 2891526306, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 9223372036854775805), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, 9223372036854775806), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(9223372036854775806, CCAM_I64_MAX), true, 9223372036854775806, ""));
}

test "systematic rem boundary row 18" {
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, CCAM_I64_MIN), true, CCAM_I64_MAX, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -9223372036854775807), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -9223372036854775806), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -3037000500), true, 2891526307, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -3037000499), true, 2891526307, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -65536), true, 65535, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -3), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -2), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, -1), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 0), false, 0, "division_by_zero"));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 1), true, 0, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 2), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 3), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 65536), true, 65535, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 3037000499), true, 2891526307, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 3037000500), true, 2891526307, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 9223372036854775805), true, 2, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, 9223372036854775806), true, 1, ""));
    assert(assurance_int_matches(ccam_rem(CCAM_I64_MAX, CCAM_I64_MAX), true, 0, ""));
}
