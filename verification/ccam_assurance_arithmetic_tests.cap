    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, 65536), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, 3037000499), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, 3037000500), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, 9223372036854775805), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, 9223372036854775806), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_mul(CCAM_I64_MAX, CCAM_I64_MAX), false, 0, "integer_overflow"));
}

test "systematic div boundary row 0" {
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, CCAM_I64_MIN), true, 1, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, -9223372036854775807), true, 1, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, -9223372036854775806), true, 1, ""));
