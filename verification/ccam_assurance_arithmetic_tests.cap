    assert(assurance_int_matches(ccam_add(-9223372036854775806, -2), true, CCAM_I64_MIN, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, -1), true, -9223372036854775807, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 0), true, -9223372036854775806, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 1), true, -9223372036854775805, ""));
