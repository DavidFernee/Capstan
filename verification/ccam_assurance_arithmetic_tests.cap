    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 3037000499), true, -3037000500, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 3037000500), true, -3037000499, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 9223372036854775805), true, -1, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, 9223372036854775806), true, -1, ""));
    assert(assurance_int_matches(ccam_div(CCAM_I64_MIN, CCAM_I64_MAX), true, -1, ""));
}

