    assert(assurance_int_matches(ccam_add(-9223372036854775806, 3), true, -9223372036854775803, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 65536), true, -9223372036854710270, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 3037000499), true, -9223372033817775307, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 3037000500), true, -9223372033817775306, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 9223372036854775805), true, -1, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, 9223372036854775806), true, 0, ""));
    assert(assurance_int_matches(ccam_add(-9223372036854775806, CCAM_I64_MAX), true, 1, ""));
}

test "systematic add boundary row 3" {
    assert(assurance_int_matches(ccam_add(-3037000500, CCAM_I64_MIN), false, 0, "integer_overflow"));
    assert(assurance_int_matches(ccam_add(-3037000500, -9223372036854775807), false, 0, "integer_overflow"));
