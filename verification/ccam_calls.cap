test "CCAM multi-function evaluator traps at the call-depth limit" {
    List<int> caller_types = new List<int>();
    caller_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> caller_code = new List<CCAMInstruction>();
    CCAMInstruction i = ccam_instruction(CCAM_OP_CONST_I);
    i.dst = 0;
    i.int_value = 7;
    caller_code.push(i);
    caller_code.push(ccam_instruction(CCAM_OP_CALL));
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    caller_code.push(i);

    List<int> callee_types = new List<int>();
    callee_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> callee_code = new List<CCAMInstruction>();
    i = ccam_instruction(CCAM_OP_RET);
    i.lhs = 0;
    callee_code.push(i);
    List<int> args = new List<int>();
    args.push(0);
    List<CCAMCallSite> sites = new List<CCAMCallSite>();
    sites.push(new CCAMCallSite{
        instruction_index: 1, callee_index: 1,
        argument_registers: args, destination_register: 0,
        has_destination: true
    });
    List<CCAMFunction> functions = new List<CCAMFunction>();
    functions.push(new CCAMFunction{
        name: "main", register_types: caller_types, parameter_count: 0,
        return_type: CCAM_RETURN_INT, instructions: caller_code,
        call_sites: sites
    });
    functions.push(new CCAMFunction{
        name: "id", register_types: callee_types, parameter_count: 1,
        return_type: CCAM_RETURN_INT, instructions: callee_code,
        call_sites: new List<CCAMCallSite>()
    });
    CCAMCallMachineCreateResult created = ccam_call_machine_create(
        functions, 0, 8, 1);
    assert(created.ok);
    CCAMCallMachine machine = created.machine;
    ccam_call_machine_step(machine);
    ccam_call_machine_step(machine);
    assert(machine.halted && machine.trap_code == "call_depth_exceeded");
    assert(machine.steps == 2 && machine.trap_function == "main");
    assert(machine.trap_pc == 1 && machine.frame_depth == 1);
}

test "CCAM multi-function validator rejects mismatched call signatures" {
    List<int> entry_types = new List<int>();
    entry_types.push(CCAM_TYPE_BOOL);
    List<CCAMInstruction> entry_code = new List<CCAMInstruction>();
    entry_code.push(ccam_instruction(CCAM_OP_CALL));
    entry_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    List<int> callee_types = new List<int>();
    callee_types.push(CCAM_TYPE_INT);
    List<CCAMInstruction> callee_code = new List<CCAMInstruction>();
    callee_code.push(ccam_instruction(CCAM_OP_RET_VOID));
    List<int> args = new List<int>();
    args.push(0);
    List<CCAMCallSite> sites = new List<CCAMCallSite>();
    sites.push(new CCAMCallSite{
        instruction_index: 0, callee_index: 1,
        argument_registers: args, destination_register: 0,
        has_destination: false
    });
    List<CCAMFunction> functions = new List<CCAMFunction>();
    functions.push(new CCAMFunction{
        name: "main", register_types: entry_types, parameter_count: 0,
        return_type: CCAM_RETURN_VOID, instructions: entry_code,
        call_sites: sites
    });
    functions.push(new CCAMFunction{
        name: "f", register_types: callee_types, parameter_count: 1,
        return_type: CCAM_RETURN_VOID, instructions: callee_code,
        call_sites: new List<CCAMCallSite>()
    });
    CCAMValidationResult result = ccam_validate_multi_function(functions, 0);
    assert(!result.ok && result.error == "call_argument_type_mismatch");
}

test "CCAM multi-function validator enforces aggregate register limits" {
    List<CCAMFunction> functions = new List<CCAMFunction>();
    List<CCAMInstruction> terminal = new List<CCAMInstruction>();
    terminal.push(ccam_instruction(CCAM_OP_RET_VOID));
    for (int f = 0; f < 64; f += 1) {
        List<int> types = new List<int>();
        for (int r = 0; r < CCAM_MAX_REGISTERS; r += 1) types.push(CCAM_TYPE_INT);
        functions.push(new CCAMFunction{
            name: "f" + int_to_str(f), register_types: types,
            parameter_count: 0, return_type: CCAM_RETURN_VOID,
            instructions: terminal, call_sites: new List<CCAMCallSite>()
        });
    }
    assert(ccam_validate_multi_function(functions, 0).ok);
    List<int> extra = new List<int>();
    extra.push(CCAM_TYPE_INT);
    functions.push(new CCAMFunction{
        name: "over", register_types: extra,
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: terminal, call_sites: new List<CCAMCallSite>()
    });
    CCAMValidationResult rejected = ccam_validate_multi_function(functions, 0);
    assert(!rejected.ok && rejected.error == "total_register_limit_exceeded");
}

test "CCAM multi-function validator bounds names and rejects embedded NUL" {
    string name = "n";
    for (int i = 1; i < CCAM_MAX_FUNCTION_NAME_BYTES; i += 1) name = name + "a";
    List<CCAMInstruction> terminal = new List<CCAMInstruction>();
    terminal.push(ccam_instruction(CCAM_OP_RET_VOID));
    List<CCAMFunction> functions = new List<CCAMFunction>();
    functions.push(new CCAMFunction{
        name: name, register_types: new List<int>(),
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: terminal, call_sites: new List<CCAMCallSite>()
    });
    assert(ccam_validate_multi_function(functions, 0).ok);
    functions[0].name = name + "a";
    CCAMValidationResult too_long = ccam_validate_multi_function(functions, 0);
    assert(!too_long.ok && too_long.error == "function_name_limit_exceeded");
    functions[0].name = "bad" + char_str(0) + "name";
    CCAMValidationResult nul_name = ccam_validate_multi_function(functions, 0);
    assert(!nul_name.ok && nul_name.error == "invalid_function_name");
}

test "CCAM multi-function validator bounds aggregate function-name bytes" {
    string padding = "";
    for (int i = 0; i < CCAM_MAX_FUNCTION_NAME_BYTES; i += 1) padding = padding + "x";
    List<CCAMInstruction> terminal = new List<CCAMInstruction>();
    terminal.push(ccam_instruction(CCAM_OP_RET_VOID));
    List<CCAMFunction> functions = new List<CCAMFunction>();
    for (int i = 0; i < 256; i += 1) {
        string prefix = int_to_str(i);
        string name = prefix + padding.slice(0, CCAM_MAX_FUNCTION_NAME_BYTES - prefix.len());
        functions.push(new CCAMFunction{
            name: name, register_types: new List<int>(),
            parameter_count: 0, return_type: CCAM_RETURN_VOID,
            instructions: terminal, call_sites: new List<CCAMCallSite>()
        });
    }
    assert(ccam_validate_multi_function(functions, 0).ok);
    string prefix = "256";
    string over_name = prefix + padding.slice(0, CCAM_MAX_FUNCTION_NAME_BYTES - prefix.len());
    functions.push(new CCAMFunction{
        name: over_name, register_types: new List<int>(),
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: terminal, call_sites: new List<CCAMCallSite>()
    });
    CCAMValidationResult rejected = ccam_validate_multi_function(functions, 0);
    assert(!rejected.ok && rejected.error == "total_function_name_limit_exceeded");
}

test "CCAM call machine enforces configuration ceilings before construction" {
    List<CCAMInstruction> terminal = new List<CCAMInstruction>();
    terminal.push(ccam_instruction(CCAM_OP_RET_VOID));
    List<CCAMFunction> functions = new List<CCAMFunction>();
    functions.push(new CCAMFunction{
        name: "main", register_types: new List<int>(),
        parameter_count: 0, return_type: CCAM_RETURN_VOID,
        instructions: terminal, call_sites: new List<CCAMCallSite>()
    });
    CCAMCallMachineCreateResult exact = ccam_call_machine_create(
        functions, 0, CCAM_MAX_STEPS, CCAM_MAX_CALL_DEPTH);
    assert(exact.ok);
    CCAMCallMachineCreateResult too_many_steps = ccam_call_machine_create(
        functions, 0, CCAM_MAX_STEPS + 1, CCAM_MAX_CALL_DEPTH);
    assert(!too_many_steps.ok &&
           too_many_steps.error == "configured_step_limit_too_large");
    assert(too_many_steps.machine.halted && too_many_steps.machine.functions.len() == 0);
    CCAMCallMachineCreateResult too_deep = ccam_call_machine_create(
        functions, 0, CCAM_MAX_STEPS, CCAM_MAX_CALL_DEPTH + 1);
    assert(!too_deep.ok &&
           too_deep.error == "configured_call_depth_too_large");
    assert(too_deep.machine.halted && too_deep.machine.frames.len() == 0);
}

test "CCAM multi-function validator bounds call-site side tables" {
    List<CCAMInstruction> caller_code = new List<CCAMInstruction>();
    caller_code.push(ccam_instruction(CCAM_OP_CALL));
