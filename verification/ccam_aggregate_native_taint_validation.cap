test "native taint validation leaf emits exact bytes" {
    List<int> b = new List<int>();
    assert(ag_native_emit_taint_validation(b));
    assert(b.len() == 1059);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-taint-validation.bin", data));
}
