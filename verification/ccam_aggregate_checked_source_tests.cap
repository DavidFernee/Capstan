import "ccam_aggregate_checked_module.cap";

AGSourceModuleResult ag_source_test_compile(string text) {
    Ctx ctx = new Ctx{files: new List<string>(), sources: new List<Tainted>(),
        diags: new List<Diag>(), release: false, strict: false, keep_checks: false};
    ctx.files.push("aggregate-source.cap");
    Tainted source = taint(text);
    ctx.sources.push(source);
    List<Node> declarations = parse_program(ctx, lex(ctx, source, 0));
    if (error_count(ctx) == 0) { check_program(new_checker(ctx), declarations, false); }
    return ag_source_lower_checked(ctx, declarations);
}

test "checked aggregate source indexes nominal record arrays and measures collections" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Node { int number; } struct Budget { int number; } " +
        "Node select(List<Node> roots, int index) { Node selected = roots[index]; return selected; } " +
        "int count(List<Node> roots) { return roots.len(); } " +
        "int byte_at(string text, int index) { return text.at(index); }");
    assert(compiled.ok && compiled.function_names.len() == 3);
    assert(compiled.record_names[0] == "Node" && compiled.record_names[1] == "Budget");
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 64);
    assert(root.ok);
    CCAMAggregateMachine machine = root.machine;
    assert(ccam_aggregate_alloc_array(machine, 0, AG_SCHEMA_REF, 1, 2) == "");
    List<int> field_types = new List<int>(); field_types.push(AG_SCHEMA_INT);
    List<bool> field_mutable = new List<bool>(); field_mutable.push(true);
    CCAMHeapLayout layout = new CCAMHeapLayout{type_id: 1, field_types: field_types,
        field_ref_type_ids: new List<int>(), field_mutable: field_mutable};
    assert(ccam_aggregate_alloc_record(machine, 2, layout) == "");
    assert(ccam_aggregate_array_append(machine, 0, 2, AG_SCHEMA_REF) == "");
    assert(ccam_aggregate_write(machine, 1, ccam_heap_int(0)) == "");
    assert(ccam_aggregate_alloc_bytes(machine, 3, "A") == "");
    AGStackResult stack = ag_stack_create(machine, 4, 32);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0); args.push(1);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 2) == "");
    CCAMAggregateValueResult selected = ccam_aggregate_read(stack.stack.active, 2, AG_SCHEMA_REF);
    assert(selected.ok && ag_nominal_value_matches(machine.heap, selected.value, AG_SCHEMA_REF, 1));
    List<int> count_args = new List<int>(); count_args.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, count_args, 1) == "");
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 1);
    assert(ccam_aggregate_write(stack.stack.active, 1, ccam_heap_int(0)) == "");
    args[0] = 3;
    assert(ag_sealed_invoke(compiled.program, stack.stack, 2, args, 1) == "");
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 65);
}

test "checked source adapter refuses unsupported code without a partial executable" {
    AGSourceModuleResult invalid = ag_source_test_compile(
        "int first(List<int> values, int index) { return values[index]; } " +
        "int unsupported(int value) { List<List<int>> values = new List<List<int>>(); return value; }");
    assert(!invalid.ok && invalid.error == "unsupported_function_body");
    assert(invalid.function_names.len() == 0);
    AGSourceModuleResult wrong = ag_source_test_compile(
        "bool wrong(List<int> values, int index) { return values[index]; }");
    assert(!wrong.ok && wrong.error == "source_diagnostics");
    AGSourceModuleResult nested = ag_source_test_compile(
        "int nested(List<List<int>> values) { return values.len(); }");
    assert(!nested.ok);
}

test "checked source array indexing preserves out of bounds trap and caller destination" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "int get_item(List<int> values, int index) { return values[index]; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 16);
    assert(root.ok);
    assert(ccam_aggregate_alloc_array(root.machine, 0, AG_SCHEMA_INT, 0, 2) == "");
    assert(ccam_aggregate_write(root.machine, 1, ccam_heap_int(7)) == "");
    AGStackResult stack = ag_stack_create(root.machine, 4, 16);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0); args.push(1);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 1) == "array_bounds");
    assert(stack.stack.depth == 0 && stack.stack.slots == 2);
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 7);
}

test "checked source compiles the production budget constructor body and field reads" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct CompileBudget { int source_bytes; int tokens; int ast_nodes; int files; bool exhausted; } " +
        "CompileBudget new_compile_budget() { return new CompileBudget{source_bytes: 0, tokens: 0, ast_nodes: 0, files: 0, exhausted: false}; } " +
        "int ast_count(CompileBudget budget) { return budget.ast_nodes; } " +
        "bool exhausted(CompileBudget budget) { return budget.exhausted; }");
    assert(compiled.ok && compiled.function_names.len() == 3);
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_BOOL);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 64);
    assert(root.ok);
    AGStackResult stack = ag_stack_create(root.machine, 4, 32);
    assert(stack.ok);
    List<int> none_args = new List<int>();
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, none_args, 0) == "");
    CCAMAggregateValueResult budget = ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_REF);
    assert(budget.ok && ag_nominal_value_matches(root.machine.heap, budget.value, AG_SCHEMA_REF, 1));
    List<int> args = new List<int>(); args.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, args, 1) == "");
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 2, args, 2) == "");
    assert(!ccam_aggregate_read(stack.stack.active, 2, AG_SCHEMA_BOOL).value.bool_value);
    if (let reference = budget.value.reference) {
        for (int i = 0; i < 4; i += 1) {
            CCAMHeapValueResult field = ccam_heap_field_get(root.machine.heap, reference, 1, i);
            assert(field.ok && field.value.kind == AG_SCHEMA_INT && field.value.int_value == 0);
        }
        CCAMHeapValueResult field = ccam_heap_field_get(root.machine.heap, reference, 1, 4);
        assert(field.ok && field.value.kind == AG_SCHEMA_BOOL && !field.value.bool_value);
    } else { assert(false); }
}

test "checked source constructor preserves exact collection field shape" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Node { int number; } struct Budget { int number; } " +
        "struct Roots { List<Node> kids; } " +
        "Roots make_roots(List<Node> kids) { return new Roots{kids: kids}; } " +
        "List<Node> get_roots(Roots roots) { return roots.kids; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 32);
    assert(root.ok);
    assert(ccam_aggregate_alloc_array(root.machine, 0, AG_SCHEMA_REF, 1, 2) == "");
    AGStackResult stack = ag_stack_create(root.machine, 4, 16);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 1) == "");
    args[0] = 1;
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, args, 0) == "");
    CCAMAggregateValueResult result = ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_REF);
    assert(result.ok && ag_nominal_value_matches(root.machine.heap, result.value,
        AG_SCHEMA_REF, ag_nominal_record_array(1)));
}

test "checked aggregate CFG charges budget across a loop and early return" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Budget { int ast_nodes; bool exhausted; } " +
        "bool charge(Budget budget, List<int> roots, int limit) { " +
        "for (int i = 0; i < roots.len(); i += 1) { " +
        "if (budget.ast_nodes >= limit) { budget.exhausted = true; return false; } " +
        "budget.ast_nodes += 1; } return true; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_BOOL);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 256);
    assert(root.ok);
    CCAMAggregateMachine machine = root.machine;
    List<int> fields = new List<int>(); fields.push(AG_SCHEMA_INT); fields.push(AG_SCHEMA_BOOL);
    List<bool> mutability = new List<bool>(); mutability.push(true); mutability.push(true);
    CCAMHeapLayout layout = new CCAMHeapLayout{type_id: 1, field_types: fields,
        field_ref_type_ids: new List<int>(), field_mutable: mutability};
    assert(ccam_aggregate_alloc_record(machine, 0, layout) == "");
    assert(ccam_aggregate_write(machine, 2, ccam_heap_int(0)) == "");
    assert(ccam_aggregate_write(machine, 3, ccam_heap_bool(false)) == "");
    assert(ccam_aggregate_field_set(machine, 0, 1, 0, 2, AG_SCHEMA_INT) == "");
    assert(ccam_aggregate_field_set(machine, 0, 1, 1, 3, AG_SCHEMA_BOOL) == "");
    assert(ccam_aggregate_alloc_array(machine, 1, AG_SCHEMA_INT, 0, 3) == "");
    for (int i = 0; i < 3; i += 1) {
        assert(ccam_aggregate_array_append(machine, 1, 2, AG_SCHEMA_INT) == "");
    }
    assert(ccam_aggregate_write(machine, 2, ccam_heap_int(2)) == "");
    AGStackResult stack = ag_stack_create(machine, 4, 128);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0); args.push(1); args.push(2);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 3) == "");
    assert(!ccam_aggregate_read(stack.stack.active, 3, AG_SCHEMA_BOOL).value.bool_value);
    CCAMAggregateValueResult budget = ccam_aggregate_read(machine, 0, AG_SCHEMA_REF);
    if (let reference = budget.value.reference) {
        assert(ccam_heap_field_get(machine.heap, reference, 1, 0).value.int_value == 2);
        assert(ccam_heap_field_get(machine.heap, reference, 1, 1).value.bool_value);
    } else { assert(false); }
}

test "checked aggregate arithmetic overflow preserves the caller destination" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "int increment(int number) { return number + 1; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 32);
    assert(root.ok);
    assert(ccam_aggregate_write(root.machine, 0, ccam_heap_int(CCAM_I64_MAX)) == "");
    assert(ccam_aggregate_write(root.machine, 1, ccam_heap_int(42)) == "");
    AGStackResult stack = ag_stack_create(root.machine, 4, 16);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 1) == "integer_overflow");
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 42);
}

test "candidate checked source lowers production AST worklist traversal with reduced record schema" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "const int MAX_TOTAL_AST_NODES = 150000; " +
        "struct CompileBudget { int ast_nodes; bool exhausted; } " +
        "struct Node { List<Node> kids; } " +
        "bool charge_ast_nodes(CompileBudget budget, List<Node> roots) { " +
        "    List<Node> pending = new List<Node>(); " +
        "    for (int i = 0; i < roots.len(); i += 1) { pending.push(roots[i]); } " +
        "    while (pending.len() > 0) { " +
        "        Node node = pending[pending.len() - 1]; " +
        "        pending.pop(); " +
        "        if (budget.ast_nodes >= MAX_TOTAL_AST_NODES) { " +
        "            budget.exhausted = true; " +
        "            return false; " +
        "        } " +
        "        budget.ast_nodes += 1; " +
        "        for (int k = 0; k < node.kids.len(); k += 1) { pending.push(node.kids[k]); } " +
        "    } " +
        "    return true; " +
        "} ");
    assert(compiled.ok);
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_BOOL);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 8192, 32, 8192, 8192, 512);
    assert(root.ok);
    CCAMAggregateMachine machine = root.machine;
    List<int> fields = new List<int>(); fields.push(AG_SCHEMA_INT); fields.push(AG_SCHEMA_BOOL);
    List<bool> mutable_fields = new List<bool>(); mutable_fields.push(true); mutable_fields.push(true);
    CCAMHeapLayout budget_layout = new CCAMHeapLayout{type_id: 1, field_types: fields,
        field_ref_type_ids: new List<int>(), field_mutable: mutable_fields};
    assert(ccam_aggregate_alloc_record(machine, 0, budget_layout) == "");
    assert(ccam_aggregate_write(machine, 4, ccam_heap_int(149999)) == "");
    assert(ccam_aggregate_write(machine, 5, ccam_heap_bool(false)) == "");
    assert(ccam_aggregate_field_set(machine, 0, 1, 0, 4, AG_SCHEMA_INT) == "");
    assert(ccam_aggregate_field_set(machine, 0, 1, 1, 5, AG_SCHEMA_BOOL) == "");
    assert(ccam_aggregate_alloc_array(machine, 1, AG_SCHEMA_REF, 2, 2) == "");
    assert(ccam_aggregate_alloc_array(machine, 3, AG_SCHEMA_REF, 2, 0) == "");
    List<int> node_fields = new List<int>(); node_fields.push(AG_SCHEMA_REF);
    List<int> node_refs = new List<int>(); node_refs.push(0);
    List<bool> node_mutable = new List<bool>(); node_mutable.push(true);
    CCAMHeapLayout node_layout = new CCAMHeapLayout{type_id: 2, field_types: node_fields,
        field_ref_type_ids: node_refs, field_mutable: node_mutable};
    assert(ccam_aggregate_alloc_record(machine, 2, node_layout) == "");
    assert(ccam_aggregate_field_set(machine, 2, 2, 0, 3, AG_SCHEMA_REF) == "");
    assert(ccam_aggregate_array_append(machine, 1, 2, AG_SCHEMA_REF) == "");
    assert(ccam_aggregate_array_append(machine, 1, 2, AG_SCHEMA_REF) == "");
    AGStackResult stack = ag_stack_create(machine, 4, 256);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0); args.push(1);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 5) == "");
    assert(!ccam_aggregate_read(stack.stack.active, 5, AG_SCHEMA_BOOL).value.bool_value);
    CCAMAggregateValueResult budget = ccam_aggregate_read(machine, 0, AG_SCHEMA_REF);
    if (let reference = budget.value.reference) {
        assert(ccam_heap_field_get(machine.heap, reference, 1, 0).value.int_value == 150000);
        assert(ccam_heap_field_get(machine.heap, reference, 1, 1).value.bool_value);
    } else { assert(false); }
}

test "sealed direct calls compose record construction and mutation" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Budget { int nodes; } " +
        "Budget make_budget() { return new Budget{nodes: 0}; } " +
        "int charge(Budget budget, int amount) { budget.nodes += amount; return budget.nodes; } " +
        "int main() { Budget budget = make_budget(); int first = charge(budget, 20); return first + charge(budget, 2); }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 128);
    assert(root.ok);
    AGStackResult stack = ag_stack_create(root.machine, 4, 128);
    assert(stack.ok);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 2, new List<int>(), 0) == "");
    assert(stack.stack.depth == 0 && stack.stack.slots == 1);
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 42);
}

test "sealed recursion honours explicit depth and unwinds without publishing a result" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "int descend(int value) { if (value == 0) { return 7; } return descend(value - 1); }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 256);
    assert(root.ok);
    assert(ccam_aggregate_write(root.machine, 0, ccam_heap_int(8)) == "");
    AGStackResult stack = ag_stack_create(root.machine, 3, 128);
    assert(stack.ok);
    List<int> args = new List<int>(); args.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 0, args, 0) == "call_depth_limit");
    assert(stack.stack.depth == 0 && stack.stack.slots == 1);
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 8);
}

test "checked void calls mutate records without manufacturing a result register" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Budget { int nodes; } " +
        "void charge(Budget budget, int amount) { if (amount == 0) { return; } budget.nodes += amount; } " +
        "void empty() { } " +
        "int main() { Budget budget = new Budget{nodes: 1}; empty(); charge(budget, 0); charge(budget, 41); return budget.nodes; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 128);
    assert(root.ok);
    assert(ccam_aggregate_write(root.machine, 0, ccam_heap_int(99)) == "");
    AGStackResult stack = ag_stack_create(root.machine, 4, 128);
    assert(stack.ok);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, new List<int>(), -1) == "");
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 99);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 2, new List<int>(), 0) == "");
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 42);
    assert(stack.stack.depth == 0 && stack.stack.slots == 1);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, new List<int>(), 0) == "invalid_call");
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 42);
}

test "void calls propagate arithmetic failure through all opened frames" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "struct Budget { int nodes; } " +
        "void charge(Budget budget) { budget.nodes += 1; } " +
        "int run(Budget budget) { charge(budget); return budget.nodes; }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 128);
    assert(root.ok);
    List<int> fields = new List<int>(); fields.push(AG_SCHEMA_INT);
    List<bool> mutability = new List<bool>(); mutability.push(true);
    CCAMHeapLayout layout = new CCAMHeapLayout{type_id: 1, field_types: fields,
        field_ref_type_ids: new List<int>(), field_mutable: mutability};
    assert(ccam_aggregate_alloc_record(root.machine, 0, layout) == "");
    assert(ccam_aggregate_write(root.machine, 1, ccam_heap_int(CCAM_I64_MAX)) == "");
    assert(ccam_aggregate_field_set(root.machine, 0, 1, 0, 1, AG_SCHEMA_INT) == "");
    assert(ccam_aggregate_write(root.machine, 1, ccam_heap_int(42)) == "");
    AGStackResult stack = ag_stack_create(root.machine, 4, 128);
    assert(stack.ok);
    List<int> arguments = new List<int>(); arguments.push(0);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 1, arguments, 1) == "integer_overflow");
    assert(stack.stack.depth == 0 && stack.stack.slots == 2);
    assert(ccam_aggregate_read(stack.stack.active, 1, AG_SCHEMA_INT).value.int_value == 42);
    CCAMAggregateValueResult budget = ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_REF);
    if (let reference = budget.value.reference) {
        assert(ccam_heap_field_get(stack.stack.active.heap, reference, 1, 0).value.int_value == CCAM_I64_MAX);
    } else { assert(false); }
}

test "checked optional calls preserve present zero and absent values" {
    AGSourceModuleResult compiled = ag_source_test_compile(
        "int? choose(bool present) { if (present) { return 0; } return none; } " +
        "int read_value(int? value) { if (let number = value) { return number; } return 7; } " +
        "int main() { int? present = choose(true); int? absent = choose(false); return read_value(present) + read_value(absent); }");
    assert(compiled.ok);
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_INT);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 128);
    assert(root.ok);
    AGStackResult stack = ag_stack_create(root.machine, 4, 128);
    assert(stack.ok);
    assert(ag_sealed_invoke(compiled.program, stack.stack, 2, new List<int>(), 0) == "");
    assert(ccam_aggregate_read(stack.stack.active, 0, AG_SCHEMA_INT).value.int_value == 7);
    assert(stack.stack.depth == 0 && stack.stack.slots == 1);
}

