// Candidate Linux x86-64 private SysV arena LogText bridge.
// RDI=base RSI=cursor pointer RDX=capacity RCX=left offset
// R8=right offset R9=mode (0 escape, 1 contextual concat).
// Returns RAX=offset RDX=status. Exclusive mapped arena, disjoint cursor,
// immutable headers and valid stack required. No writes before preflight.
// Exact tags 4096 trusted, 2045 tainted, 2046 log. Concat rejects tainted
// operands and requires at least one LogText. All byte pairs canonical.
// Scratch 8224 bytes plus nested escape leaf; cursor publication last.
// The internal relative call targets the appended raw escape leaf.
// Reference: research/native-bootstrap/log-bridge-leaf.S.
import "ccam_aggregate_native_log_escape.cap";

