test "native LogText bridge emits exact composed leaf" {
    List<int> b = new List<int>();
    assert(ag_native_emit_log_bridge(b));
    assert(b.len() == AG_NATIVE_LOG_BRIDGE_SIZE);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-log-bridge.bin", data));
}
