test "candidate scalar record native leaves emit complete fixed byte fragments" {
    List<int> code = new List<int>();
    assert(ag_native_emit_scalar_record_alloc(code));
    assert(code.len() == AG_NATIVE_SCALAR_RECORD_ALLOC_SIZE);
    assert(ag_native_emit_scalar_record_load(code));
    assert(code.len() == AG_NATIVE_SCALAR_RECORD_ALLOC_SIZE + AG_NATIVE_SCALAR_RECORD_LOAD_SIZE);
    assert(ag_native_emit_scalar_record_store(code));
    assert(code.len() == 493);
    string data = "";
    for (int i = 0; i < code.len(); i += 1) { data = data + char_str(code[i]); }
    assert(data.len() == 493);
    assert(write_file("build/ccam-aggregate-native-scalar-record.bin", data));
}
