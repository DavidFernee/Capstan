// Candidate Linux x86-64 scalar-only record layout (not canonical CCAM ABI).
// Arena ABI R12=backing base, R13=committed bytes, R14=logical capacity.
// All backing, cursor, object-start offsets and expected layout descriptors
// are trusted compiler/runtime inputs, not forgeable language-level integers.
// No concurrency or re-entrance. All fields are mutable signed i64 values.
// Layout: descriptor:u64, count:u64, then count pairs (i64 value, u64 ready).
// Alloc: RAX=descriptor (1..4096), RSI=count (0..4096).
// Returns RAX=object offset, RDX=0; zero offset is valid on success.
// Load/store: RAX=offset, RSI=expected descriptor, RDI=expected count,
// R8=index, R9=store value. RDX=0; load returns value, store returns zero.
// Rejection: RAX=0, RDX=1; no writes and no cursor advance.
// Clobbers RCX,RDI,R8,R10,flags; allocation clears DF.
// Checks validate extent and header, not provenance of a fabricated interior
// offset. Typed handles, full layouts, GC and native lowering remain open.
import "ccam_aggregate_byte_buffer.cap";

const int AG_NATIVE_SCALAR_RECORD_ALLOC_SIZE = 137;
const int AG_NATIVE_SCALAR_RECORD_LOAD_SIZE = 171;
const int AG_NATIVE_SCALAR_RECORD_STORE_SIZE = 185;

