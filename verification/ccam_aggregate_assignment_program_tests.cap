import "ccam_aggregate_assignment_program.cap";
test "assignment program updates and reads variables" {
    List<int> source=new List<int>();
    source.push(120); source.push(61); source.push(49); source.push(48); source.push(59);
    source.push(120); source.push(61); source.push(120); source.push(43); source.push(50); source.push(59);
    source.push(120); source.push(42); source.push(50); source.push(43); source.push(49);
    AGProgramResult result=ag_compile_assignment_program(source);
    assert(result.ok && result.assignments==2 && result.value==25);
}
test "assignment program rejects unresolved variable" {
    List<int> source=new List<int>();
    source.push(120); source.push(43); source.push(49);
    AGProgramResult result=ag_compile_assignment_program(source);
    assert(!result.ok);
}
test "assignment program rejects malformed assignment" {
    List<int> source=new List<int>();
    source.push(120); source.push(61); source.push(59); source.push(49);
    assert(!ag_compile_assignment_program(source).ok);
}
test "assignment program rejects missing final expression" {
    List<int> source=new List<int>();
    source.push(120); source.push(61); source.push(49); source.push(59);
    assert(!ag_compile_assignment_program(source).ok);
}
