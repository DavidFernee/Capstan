// Capstan-native JSON string-body decoder.
// The caller supplies bytes between the surrounding quotation marks.
// Output remains Tainted. This routine validates UTF-8 and JSON escapes;
// it does not scan object/array structure or validate the enclosing document.

const int CCAM_JSON_MAX_STRING_BYTES = 1048576;
const int CCAM_JSON_MAX_STRING_TOKEN_BYTES = 6291456;
const int CCAM_JSON_JOIN_BATCH_PARTS = 4096;

struct CCAMJsonStringResult {
    bool ok;
    Tainted value;
    int error;
}

int ccam_json_hex_digit(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

int ccam_json_hex4(Tainted token, int pos) {
    if (pos < 0 || pos + 4 > token.len()) { return -1; }
    int value = 0;
    for (int j = 0; j < 4; j += 1) {
        int digit = ccam_json_hex_digit(token.at(pos + j));
        if (digit < 0) { return -1; }
        value = value * 16 + digit;
    }
    return value;
}

Tainted ccam_json_encode_scalar(int cp) {
    Tainted out = taint("");
    if (cp <= 0x7F) {
        return taint_char(cp);
    }
    if (cp <= 0x7FF) {
        out = out + taint_char(0xC0 | (cp >> 6));
        out = out + taint_char(0x80 | (cp & 0x3F));
        return out;
    }
    if (cp <= 0xFFFF) {
        out = out + taint_char(0xE0 | (cp >> 12));
        out = out + taint_char(0x80 | ((cp >> 6) & 0x3F));
        out = out + taint_char(0x80 | (cp & 0x3F));
        return out;
    }
    out = out + taint_char(0xF0 | (cp >> 18));
    out = out + taint_char(0x80 | ((cp >> 12) & 0x3F));
    out = out + taint_char(0x80 | ((cp >> 6) & 0x3F));
    out = out + taint_char(0x80 | (cp & 0x3F));
    return out;
}

CCAMJsonStringResult ccam_json_string_error(int code) {
    return new CCAMJsonStringResult{ok: false, value: taint(""), error: code};
}

CCAMJsonStringResult ccam_json_decode_string_body(Tainted token) {
    int n = token.len();
    if (n > CCAM_JSON_MAX_STRING_TOKEN_BYTES) { return ccam_json_string_error(1); }

    // Keep fragment accumulation bounded. Repeated Tainted concatenation
    // recopies the entire prefix and makes an attacker-controlled string
    // quadratic in both copied bytes and transient allocation.
    List<Tainted> chunks = new List<Tainted>();
    List<Tainted> pieces = new List<Tainted>();
    int output_bytes = 0;
    int i = 0;
    while (i < n) {
        int c = token.at(i);
        Tainted piece = taint("");
        int width = 1;

        if (c == 92) {
            if (i + 1 >= n) { return ccam_json_string_error(2); }
            int e = token.at(i + 1);
            if (e == 34 || e == 92 || e == 47) {
                piece = taint_char(e);
                width = 2;
            } else if (e == 'b') {
                piece = taint_char(8); width = 2;
            } else if (e == 'f') {
                piece = taint_char(12); width = 2;
            } else if (e == 'n') {
                piece = taint_char(10); width = 2;
            } else if (e == 'r') {
                piece = taint_char(13); width = 2;
            } else if (e == 't') {
                piece = taint_char(9); width = 2;
            } else if (e == 'u') {
                if (i + 6 > n) { return ccam_json_string_error(2); }
                int first = ccam_json_hex4(token, i + 2);
                if (first < 0) { return ccam_json_string_error(3); }
                int cp = first;
                width = 6;
                if (first >= 0xD800 && first <= 0xDBFF) {
                    if (i + 12 > n || token.at(i + 6) != 92 || token.at(i + 7) != 'u') {
                        return ccam_json_string_error(4);
                    }
                    int second = ccam_json_hex4(token, i + 8);
                    if (second < 0xDC00 || second > 0xDFFF) {
                        return ccam_json_string_error(4);
                    }
                    cp = 0x10000 + ((first - 0xD800) * 1024) + (second - 0xDC00);
                    width = 12;
                } else if (first >= 0xDC00 && first <= 0xDFFF) {
                    return ccam_json_string_error(4);
                }
                piece = ccam_json_encode_scalar(cp);
            } else {
                return ccam_json_string_error(3);
            }
        } else if (c < 0x20 || c == 34) {
            return ccam_json_string_error(3);
        } else if (c <= 0x7F) {
            piece = token.slice(i, i + 1);
        } else {
            if (c >= 0xC2 && c <= 0xDF) {
                width = 2;
                if (i + width > n || token.at(i + 1) < 0x80 || token.at(i + 1) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if (c == 0xE0) {
                width = 3;
                if (i + width > n || token.at(i + 1) < 0xA0 || token.at(i + 1) > 0xBF ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if ((c >= 0xE1 && c <= 0xEC) || (c >= 0xEE && c <= 0xEF)) {
                width = 3;
                if (i + width > n || token.at(i + 1) < 0x80 || token.at(i + 1) > 0xBF ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if (c == 0xED) {
                width = 3;
                if (i + width > n || token.at(i + 1) < 0x80 || token.at(i + 1) > 0x9F ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if (c == 0xF0) {
                width = 4;
                if (i + width > n || token.at(i + 1) < 0x90 || token.at(i + 1) > 0xBF ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF ||
                    token.at(i + 3) < 0x80 || token.at(i + 3) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if (c >= 0xF1 && c <= 0xF3) {
                width = 4;
                if (i + width > n || token.at(i + 1) < 0x80 || token.at(i + 1) > 0xBF ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF ||
                    token.at(i + 3) < 0x80 || token.at(i + 3) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else if (c == 0xF4) {
                width = 4;
                if (i + width > n || token.at(i + 1) < 0x80 || token.at(i + 1) > 0x8F ||
                    token.at(i + 2) < 0x80 || token.at(i + 2) > 0xBF ||
                    token.at(i + 3) < 0x80 || token.at(i + 3) > 0xBF) {
                    return ccam_json_string_error(5);
                }
            } else {
                return ccam_json_string_error(5);
            }
            piece = token.slice(i, i + width);
        }

        if (output_bytes > CCAM_JSON_MAX_STRING_BYTES - piece.len()) {
            return ccam_json_string_error(6);
        }
        output_bytes += piece.len();
        pieces.push(piece);
        if (pieces.len() >= CCAM_JSON_JOIN_BATCH_PARTS) {
            chunks.push(join(pieces, ""));
            pieces = new List<Tainted>();
        }
        i += width;
    }
    if (pieces.len() > 0) { chunks.push(join(pieces, "")); }
    Tainted out = join(chunks, "");
    return new CCAMJsonStringResult{ok: true, value: out, error: 0};
}


test "CCAM JSON string decoder decodes escapes and surrogate pairs" {
    CCAMJsonStringResult a = ccam_json_decode_string_body(taint("\\u0041\\u20AC"));
    assert(a.ok && a.value.len() == 4 && a.value.at(0) == 65);
    CCAMJsonStringResult b = ccam_json_decode_string_body(taint("\\uD83D\\uDE00"));
    assert(b.ok && b.value.len() == 4 && b.value.at(0) == 0xF0);
}

test "CCAM JSON string decoder rejects malformed escapes and surrogates" {
    assert(!ccam_json_decode_string_body(taint("\\uD800")).ok);
    assert(!ccam_json_decode_string_body(taint("\\uDC00")).ok);
    assert(!ccam_json_decode_string_body(taint("\\x41")).ok);
}

test "CCAM JSON string decoder rejects invalid UTF-8 and raw controls" {
    assert(!ccam_json_decode_string_body(taint_char(10)).ok);
    assert(!ccam_json_decode_string_body(taint_char(34)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xE2) + taint_char(0x82)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xC0) + taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xED) + taint_char(0xA0) + taint_char(0x80)).ok);
}

test "CCAM JSON string decoder accepts valid UTF-8 scalar boundaries" {
    CCAMJsonStringResult cent = ccam_json_decode_string_body(taint_char(0xC2) + taint_char(0xA2));
    assert(cent.ok && cent.value.len() == 2);
    CCAMJsonStringResult euro = ccam_json_decode_string_body(taint_char(0xE2) + taint_char(0x82) + taint_char(0xAC));
    assert(euro.ok && euro.value.len() == 3);
    CCAMJsonStringResult emoji = ccam_json_decode_string_body(taint_char(0xF0) + taint_char(0x9F) + taint_char(0x98) + taint_char(0x80));
    assert(emoji.ok && emoji.value.len() == 4);
    CCAMJsonStringResult maximum = ccam_json_decode_string_body(taint_char(0xF4) + taint_char(0x8F) + taint_char(0xBF) + taint_char(0xBF));
    assert(maximum.ok && maximum.value.len() == 4);
    CCAMJsonStringResult escaped_nul = ccam_json_decode_string_body(taint("\\u0000"));
    assert(escaped_nul.ok && escaped_nul.value.len() == 1 && escaped_nul.value.at(0) == 0);
}

test "CCAM JSON string decoder rejects invalid UTF-8 boundary sequences" {
    assert(!ccam_json_decode_string_body(taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xC2)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xE0) + taint_char(0x80) + taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xF0) + taint_char(0x80) + taint_char(0x80) + taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xF5) + taint_char(0x80) + taint_char(0x80) + taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xF4) + taint_char(0x90) + taint_char(0x80) + taint_char(0x80)).ok);
    assert(!ccam_json_decode_string_body(taint_char(0xF0) + taint_char(0x9F) + taint_char(0x98)).ok);
}


test "CCAM JSON string decoder handles large plain strings with linear joining" {
    List<Tainted> parts = new List<Tainted>();
    for (int i = 0; i < 65536; i += 1) { parts.push(taint("a")); }
    Tainted input = join(parts, "");
    CCAMJsonStringResult decoded = ccam_json_decode_string_body(input);
    assert(decoded.ok && decoded.value.len() == 65536);
    assert(decoded.value.at(0) == 'a' && decoded.value.at(65535) == 'a');
}

test "CCAM JSON string decoder handles many one-byte escape outputs" {
    List<Tainted> parts = new List<Tainted>();
    for (int i = 0; i < 8192; i += 1) { parts.push(taint("\\u0041")); }
    Tainted input = join(parts, "");
    CCAMJsonStringResult decoded = ccam_json_decode_string_body(input);
    assert(decoded.ok && decoded.value.len() == 8192);
    assert(decoded.value.at(0) == 'A' && decoded.value.at(8191) == 'A');
}
