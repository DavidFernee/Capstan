// Static transfer, independent of a machine or heap.
import "ccam_aggregate_flow.cap";

struct AGTransferResult { bool ok; List<bool> ready; }

// Check every read against the input state before applying destination writes.
// Allocation writes its destination; append/set mutate heap objects only.
AGTransferResult ag_transfer(List<int> kinds, List<bool> input, int opcode, int kind, List<int> operands) {
    List<bool> output = new List<bool>();
    if (input.len() != kinds.len() || !ag_schema_operands(kinds, opcode, kind, operands)) {
        return new AGTransferResult{ok: false, ready: output};
    }
    if (opcode == 1 || opcode == 2 || opcode == 3 || opcode == 4 || opcode == 7 || opcode == AG_OP_FIELD_GET || opcode == AG_OP_FIELD_SET) {
        if (!input[operands[1]]) { return new AGTransferResult{ok: false, ready: output}; }
    }
    if (opcode == 1 || opcode == 2 || opcode == 4) {
        if (!input[operands[2]]) { return new AGTransferResult{ok: false, ready: output}; }
    }
    if ((opcode == 2 || opcode == AG_OP_FIELD_SET) && !input[operands[0]]) {
        return new AGTransferResult{ok: false, ready: output};
    }
    if (opcode == 6 && (!input[operands[0]] || !input[operands[1]])) {
        return new AGTransferResult{ok: false, ready: output};
    }
    if (opcode == 8 &&
        (!input[operands[1]] || !input[operands[2]])) {
        return new AGTransferResult{ok: false, ready: output};
    }
    if (opcode >= AG_OP_MOVE && opcode <= AG_OP_NOT) {
        if (!input[operands[1]]) { return new AGTransferResult{ok: false, ready: output}; }
        if (opcode != AG_OP_MOVE && opcode != AG_OP_NOT && !input[operands[2]]) {
            return new AGTransferResult{ok: false, ready: output};
        }
    }
    for (int i = 0; i < input.len(); i += 1) {
        bool writes_destination = opcode == 1 || opcode == 3 || opcode == 4 ||
            opcode == 5 || opcode == 7 || opcode == 8 || opcode == AG_OP_FIELD_GET ||
            opcode == AG_OP_RECORD_ALLOC || opcode == AG_OP_SCALAR_CONST ||
            (opcode >= AG_OP_MOVE && opcode <= AG_OP_NOT);
        output.push(input[i] || (writes_destination && i == operands[0]));
    }
    return new AGTransferResult{ok: true, ready: output};
}


// Must-analysis generation transfer. This intentionally does not reject
// reads: backedge states are solved first, then ag_transfer checks reads at
// the fixed point. It only records which operations definitely write a
// destination register.
AGTransferResult ag_transfer_generation(
    List<int> kinds, List<bool> input, int opcode, int kind, List<int> operands
) {
    List<bool> output = new List<bool>();
    if (input.len() != kinds.len() ||
        !ag_schema_operands(kinds, opcode, kind, operands)) {
        return new AGTransferResult{ok: false, ready: output};
    }
    for (int i = 0; i < input.len(); i += 1) {
        bool writes_destination = opcode == 1 || opcode == 3 || opcode == 4 ||
            opcode == 5 || opcode == 7 || opcode == 8 || opcode == AG_OP_FIELD_GET ||
            opcode == AG_OP_RECORD_ALLOC || opcode == AG_OP_SCALAR_CONST ||
            (opcode >= AG_OP_MOVE && opcode <= AG_OP_NOT);
        output.push(input[i] || (writes_destination && i == operands[0]));
    }
    return new AGTransferResult{ok: true, ready: output};
}

bool ag_transfer_condition(List<int> kinds, List<bool> input, int condition) {
    if (input.len() != kinds.len() || !ag_schema_register(kinds, condition, AG_SCHEMA_BOOL)) { return false; }
    return input[condition];
}

test "static aggregate transfer checks alias reads before writes" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF);
    List<bool> input = new List<bool>();
    input.push(false); input.push(true);
    List<int> ops = new List<int>();
    ops.push(0); ops.push(1); ops.push(0);
    assert(!ag_transfer(kinds, input, 1, AG_SCHEMA_INT, ops).ok);
    assert(!ag_transfer(kinds, input, 2, AG_SCHEMA_INT, ops).ok);
    List<int> len_ops = new List<int>();
    len_ops.push(0); len_ops.push(1);
    AGTransferResult length = ag_transfer(kinds, input, 3, AG_SCHEMA_INT, len_ops);
    assert(length.ok && length.ready[0] && length.ready[1]);
    List<int> alloc_ops = new List<int>();
    alloc_ops.push(1); alloc_ops.push(0); alloc_ops.push(4);
    AGTransferResult allocated = ag_transfer(kinds, input, 5, AG_SCHEMA_INT, alloc_ops);
    // Allocation operands after the destination are immediates, not register writes.
    assert(allocated.ok && !allocated.ready[0] && allocated.ready[1]);
    assert(!input[0] && input[1]);
}

test "static aggregate transfer checks append reads and preserves register state" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    List<bool> ready = new List<bool>();
    ready.push(true); ready.push(false);
    List<int> append = new List<int>();
    append.push(0); append.push(1);
    assert(!ag_transfer(kinds, ready, 6, AG_SCHEMA_INT, append).ok);
    ready[1] = true;
    AGTransferResult appended = ag_transfer(kinds, ready, 6, AG_SCHEMA_INT, append);
    assert(appended.ok && appended.ready[0] && appended.ready[1]);
}

test "static aggregate transfer rejects inconsistent condition states" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_BOOL);
    List<bool> input = new List<bool>();
    assert(!ag_transfer_condition(kinds, input, 0));
    input.push(false);
    assert(!ag_transfer_condition(kinds, input, 0));
    input[0] = true;
    assert(ag_transfer_condition(kinds, input, 0));
    assert(!ag_transfer_condition(kinds, input, -1));
}

test "static byte concat reads aliased sources before writing destination" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    List<bool> ready = new List<bool>();
    ready.push(true); ready.push(true);
    List<int> concat = new List<int>();
    concat.push(0); concat.push(0); concat.push(1);
    AGTransferResult result = ag_transfer(kinds, ready, 8, AG_SCHEMA_REF, concat);
    assert(result.ok && result.ready[0] && result.ready[1]);
    ready[1] = false;
    assert(!ag_transfer(kinds, ready, 8, AG_SCHEMA_REF, concat).ok);
}
