// Candidate checked AGFunction -> Linux x86-64 ELF. Not canonical native CCAM.
// Only zero-argument, int-result functions, closed scalar, mixed-record and immutable byte-string instructions.
// Reference values originate in allocation or checked reference operations;
// headers are immutable, arena lifetime is one process invocation.
// No calls in this entry, external references, mutable collections, GC or source ABI claim.
// Result transport: one little-endian signed 64-bit stdout word, exit 0.
// Any runtime rejection exits 1 without a language result; I/O errors may
// have written a prefix. This is a test interface, not private transport.
import "ccam_aggregate_program.cap";
import "ccam_aggregate_native_arena_lifecycle.cap";
import "ccam_aggregate_native_record_boundary.cap";
import "ccam_aggregate_native_string_copy.cap";
import "ccam_aggregate_native_string_conversion.cap";
import "ccam_aggregate_native_scalar_list.cap";
import "ccam_aggregate_native_reference_list.cap";
import "ccam_aggregate_native_map.cap";
import "ccam_aggregate_native_taint_validation.cap";
import "ccam_aggregate_native_tainted_slice.cap";
import "ccam_aggregate_native_tainted_list.cap";
import "ccam_aggregate_native_log_bridge.cap";
import "ccam_aggregate_native_join.cap";
import "ccam_aggregate_native_stdout.cap";
import "ccam_aggregate_elf_image.cap";
import "ccam_aggregate_rel32.cap";
import "ccam_aggregate_exit_code.cap";

const int AG_NV_MAX_REGS = 256;
const int AG_NV_MAX_BLOCKS = 4096;
const int AG_NV_MAX_INS = 8192;
const int AG_NV_MAX_OPERANDS = 65536;
const int AG_NV_MAX_FUEL = 4096; // execution profile unchanged
// Candidate physical tag reserved for immutable strings. Source descriptor -1.
const int AG_NV_BYTES_TAG = 4096;
const int AG_NV_BYTES_DESCRIPTOR = -1;
const int AG_NV_TAINTED_DESCRIPTOR = -4102;
const int AG_NV_TAINTED_TAG = 2045;
const int AG_NV_LOG_DESCRIPTOR = -4103;
const int AG_NV_LOG_TAG = 2046;
const int AG_NV_OPT_LOG_TAG = 2047;
const int AG_NV_INT_LIST_TAG = 4094;
const int AG_NV_BOOL_LIST_TAG = 4095;
const int AG_NV_LIST_CAPACITY = 256;
const int AG_NV_INT_LIST_DESCRIPTOR = -2;
const int AG_NV_BOOL_LIST_DESCRIPTOR = -3;
const int AG_NV_RECORD_LIMIT = 1021;
const int AG_NV_OPT_INT_TAG = 1021;
const int AG_NV_OPT_BOOL_TAG = 1022;
const int AG_NV_OPT_STRING_TAG = 1023;
const int AG_NV_STRING_LIST_TAG = 4093;
// Between scalar optional tags (through 1023) and record optionals (1024 + positive ID).
const int AG_NV_EMPTY_TAINTED_LIST_TAG = 1024;

int ag_nv_ref_list_tag(int descriptor) {
    if (descriptor == -4101) { return AG_NV_EMPTY_TAINTED_LIST_TAG; }
    if (descriptor == -4100) { return AG_NV_STRING_LIST_TAG; }
    if (descriptor <= -4 && descriptor >= -1023) { return 2048 - (descriptor + 3); }
    return 0;
}

// Immutable optionals occupy one ordinary pair: payload and presence.
// The presence word is 0 for none and 1 for some, including offset zero.
// Reserve disjoint tags 1021..2044; list tags start at 2049.
int ag_nv_optional_tag(int descriptor) {
    if (descriptor == 8193) { return AG_NV_OPT_INT_TAG; }
    if (descriptor == 8194) { return AG_NV_OPT_BOOL_TAG; }
    if (descriptor == 8195) { return AG_NV_OPT_STRING_TAG; }
    if (descriptor == 8196) { return AG_NV_OPT_LOG_TAG; }
    if (descriptor > 10000 && descriptor < 10000 + AG_NV_RECORD_LIMIT) {
        return 1024 + descriptor - 10000;
    }
    return 0;
}

int ag_nv_optional_payload_descriptor(int descriptor) {
    if (descriptor == 8195) { return AG_NV_BYTES_DESCRIPTOR; }
    if (descriptor == 8196) { return AG_NV_LOG_DESCRIPTOR; }
    if (descriptor > 10000 && descriptor < 10000 + AG_NV_RECORD_LIMIT) {
        return descriptor - 10000;
    }
    return 0;
}

// Map physical tags occupy 3069..4092. Their distinct 129-pair extent
// excludes them from the 257-pair reference-list runtime profile.
const int AG_NV_MAP_CAPACITY = 64;
const int AG_NV_MAP_BASE = 20000;

int ag_nv_map_tag(int descriptor) {
    if (descriptor == 8193) { return 3069; }
    if (descriptor == 8194) { return 3070; }
    if (descriptor == 8195) { return 3071; }
    if (descriptor > 10000 && descriptor < 10000 + AG_NV_RECORD_LIMIT) {
        return 3072 + descriptor - 10000;
    }
    return 0;
}

bool ag_nv_map_descriptor(int descriptor) {
    return descriptor > AG_NV_MAP_BASE && descriptor <= AG_NV_MAP_BASE + 11020 &&
        ag_nv_map_tag(descriptor - AG_NV_MAP_BASE) != 0;
}

struct AGNVContext {
    List<int> code;
    List<int> patches;
    List<int> targets;
    List<int> labels;
    List<int> layouts;
    int trap;
}

AGImage ag_nv_failure() {
    return new AGImage{ok: false, bytes: new List<int>()};
}

// Structural and profile admission before any code emission. Layouts are
// globally consistent for each record descriptor, even in unreachable code.
// Field shapes: 0 int, -1 bool, -3 string, -4 int list, -5 bool list, positive record.
// Registry keys are unambiguous bounded decimal descriptor/index pairs.
int ag_nv_field_shape(int kind, int descriptor) {
    if (kind == AG_SCHEMA_INT && descriptor == 0) { return 0; }
    if (kind == AG_SCHEMA_BOOL && descriptor == 0) { return -1; }
    if (kind == AG_SCHEMA_REF && descriptor == AG_NV_BYTES_DESCRIPTOR) { return -3; }
    if (kind == AG_SCHEMA_REF && descriptor == AG_NV_TAINTED_DESCRIPTOR) { return -6; }
    if (kind == AG_SCHEMA_REF && descriptor == AG_NV_LOG_DESCRIPTOR) { return -7; }
    if (kind == AG_SCHEMA_REF && descriptor == AG_NV_INT_LIST_DESCRIPTOR) { return -4; }
    if (kind == AG_SCHEMA_REF && descriptor == AG_NV_BOOL_LIST_DESCRIPTOR) { return -5; }
    if (kind == AG_SCHEMA_REF && ag_nv_ref_list_tag(descriptor) != 0) { return -10000 + descriptor; }
    if (kind == AG_SCHEMA_REF && ag_nv_optional_tag(descriptor) != 0) { return -30000 - descriptor; }
    if (kind == AG_SCHEMA_REF && ag_nv_map_descriptor(descriptor)) { return -60000 - descriptor; }
    if (kind == AG_SCHEMA_REF && descriptor >= 1 && descriptor < AG_NV_RECORD_LIMIT) { return descriptor; }
    return -2;
}

string ag_nv_field_key(int descriptor, int index) {
    return int_to_str(descriptor) + ":" + int_to_str(index);
}

bool ag_nv_admit_function(AGFunction f, List<int> layouts, Map<int> fields, bool calls) {
    if ((!calls && (f.signature.parameters.len() != 0 || f.signature.result_kind != AG_SCHEMA_INT)) ||
        f.signature.parameters.len() > AG_NV_MAX_REGS ||
        f.kinds.len() > AG_NV_MAX_REGS ||
        f.blocks.len() == 0 || f.blocks.len() > AG_NV_MAX_BLOCKS ||
        f.returns.len() != f.blocks.len()) { return false; }
    if (layouts.len() != 4097) { return false; }
    for (int i = 0; i < f.signature.parameters.len(); i += 1) {
        if (!ag_schema_kind(f.signature.parameters[i])) { return false; }
    }
    int total = 0; int operands = 0;
    for (int b = 0; b < f.blocks.len(); b += 1) {
        AGCFGBlock block = f.blocks[b];
        if (block.instructions.len() > AG_NV_MAX_INS - total) { return false; }
        total += block.instructions.len();
        for (int i = 0; i < block.instructions.len(); i += 1) {
            AGBlockInstruction ins = block.instructions[i];
            List<int> op = ins.operands;
            if (op.len() > AG_NV_MAX_OPERANDS - operands ||
                !ag_schema_operands(f.kinds, ins.opcode, ins.kind, op)) { return false; }
            operands += op.len();
            if (ag_schema_taint_opcode(ins.opcode) || ag_schema_log_opcode(ins.opcode) || ag_schema_join_opcode(ins.opcode) || ag_schema_stdout_opcode(ins.opcode) || ag_schema_validation_opcode(ins.opcode) || ag_schema_taint_build_opcode(ins.opcode)) {
                // Closed schemas checked above; exact object tags are guarded at execution.
            } else if (ins.opcode == AG_OP_RECORD_ALLOC) {
                int id = op[1]; int count = (op.len() - 2) / 2;
                if (id < 1 || id >= AG_NV_RECORD_LIMIT || (layouts[id] != -1 && layouts[id] != count)) { return false; }
                for (int j = 2; j < op.len(); j += 2) {
                    int shape = ag_nv_field_shape(op[j], op[j + 1]);
                    if (shape == -2) { return false; }
                    string key = ag_nv_field_key(id, (j - 2) / 2);
                    if (let previous = fields.get(key)) {
                        if (previous != shape) { return false; }
                    } else { fields.set(key, shape); }
                }
                layouts[id] = count;
            } else if (ins.opcode == AG_OP_FIELD_GET || ins.opcode == AG_OP_FIELD_SET) {
                if (op[2] < 1 || op[2] >= AG_NV_RECORD_LIMIT || ag_nv_field_shape(ins.kind, op[4]) == -2) { return false; }
            } else if (ins.opcode == 5 || ins.opcode == 1 || ins.opcode == 2 ||
                ins.opcode == 3 || ins.opcode == AG_OP_LIST_PUSH || ins.opcode == AG_OP_LIST_POP_DISCARD) {
                if (!ag_schema_kind(ins.kind)) { return false; }
                // Only source-style empty list constructors, not fixed arrays.
                if (ins.opcode == 5) {
                    if (op[2] != 0) { return false; }
                    if (ins.kind == AG_SCHEMA_REF) {
                        if (op[1] != -2 && op[1] != -1 && (op[1] < 1 || op[1] >= AG_NV_RECORD_LIMIT)) { return false; }
                    } else if (op[1] != 0) { return false; }
                }
            } else if (ins.opcode == AG_OP_MAP_KEYS) {
                if (ag_nv_map_tag(op[2]) == 0) { return false; }
            } else if ((ins.opcode >= AG_OP_MAP_NEW && ins.opcode <= AG_OP_MAP_SET) || ins.opcode == AG_OP_MAP_REMOVE) {
                int descriptor = op[1];
                if (ins.opcode != AG_OP_MAP_NEW) { descriptor = op[3]; }
                if (ag_nv_map_tag(descriptor) == 0) { return false; }
            } else if (ins.opcode >= AG_OP_OPT_NONE && ins.opcode <= AG_OP_OPT_UNWRAP) {
                int descriptor = op[1];
                if (ins.opcode != AG_OP_OPT_NONE) { descriptor = op[2]; }
                if (ag_nv_optional_tag(descriptor) == 0) { return false; }
            } else if (ins.opcode == AG_OP_BYTES_LITERAL || ins.opcode == 4 || ins.opcode == 7 ||
                ins.opcode == AG_OP_BYTES_EQ || ins.opcode == AG_OP_BYTES_NE ||
                ins.opcode == 8 || ins.opcode == AG_OP_BYTES_SLICE ||
                (ins.opcode >= AG_OP_INT_TEXT && ins.opcode <= AG_OP_BOOL_TEXT)) {
                // Existing operand schemas admit closed immutable byte operations.
            } else if (calls && ins.opcode == AG_OP_DIRECT_CALL) {
                // Module-level nominal signature admission and boundary guards.
            } else if (ins.opcode < AG_OP_SCALAR_CONST || ins.opcode > AG_OP_NOT) { return false; }
        }
    }
    return true;
}

bool ag_nv_check_layouts(AGFunction f, List<int> layouts, Map<int> fields) {
    for (int b = 0; b < f.blocks.len(); b += 1) {
        for (int i = 0; i < f.blocks[b].instructions.len(); i += 1) {
            AGBlockInstruction ins = f.blocks[b].instructions[i];
            if (ins.opcode == AG_OP_FIELD_GET || ins.opcode == AG_OP_FIELD_SET) {
                List<int> a = ins.operands;
                if (a[3] >= layouts[a[2]]) { return false; }
                if (let shape = fields.get(ag_nv_field_key(a[2], a[3]))) {
                    if (shape != ag_nv_field_shape(ins.kind, a[4]) ||
                        (shape > 0 && layouts[shape] < 0)) { return false; }
                } else { return false; }
            } else if (ins.opcode == AG_OP_RECORD_ALLOC) {
                for (int j = 2; j < ins.operands.len(); j += 2) {
                    int shape = ag_nv_field_shape(ins.operands[j], ins.operands[j + 1]);
                    if (shape > 0 && layouts[shape] < 0) { return false; }
                }
            }
        }
    }
    return true;
}

bool ag_nv_admit(AGFunction f, List<int> layouts) {
    if (layouts.len() != 0) { return false; }
    for (int i = 0; i <= 4096; i += 1) { layouts.push(-1); }
    Map<int> fields = new Map<int>();
    return ag_nv_admit_function(f, layouts, fields, false) && ag_nv_check_layouts(f, layouts, fields) &&
        ag_function_validate(f);
}

// Signed immediate encoding without negating INT64_MIN or forming 2^64.
bool ag_nv_imm(List<int> code, int reg, int value) {
    if (reg < 0 || reg > 15 || code.len() > AG_BYTE_LIMIT - 10) { return false; }
    code.push(72 + reg / 8); code.push(184 + reg % 8);
    for (int i = 0; i < 8; i += 1) {
        int rem = value % 256;
        value = value / 256;
        if (rem < 0) { rem += 256; value -= 1; }
        code.push(rem);
    }
    return true;
}

// Fixed stack slots addressed only by admitted register indices; R15 is
// immutable frame base. REX.B selects R15 and REX.R selects high reg.
bool ag_nv_slot(List<int> code, bool store, int reg, int slot) {
    if (reg < 0 || reg > 15 || slot < 0 || slot > AG_NV_MAX_REGS ||
        code.len() > AG_BYTE_LIMIT - 7) { return false; }
    code.push(73 + 4 * (reg / 8));
    if (store) { code.push(137); } else { code.push(139); }
    code.push(135 + 8 * (reg % 8));
    return ag_u32(code, slot * 8);
}

bool ag_nv_edge(AGNVContext c, int op, int target) {
    if (target < 0 || target >= c.labels.len() || c.code.len() > AG_BYTE_LIMIT - 6) { return false; }
    if (op == 0) { c.code.push(233); }
    else if (op == 1) { c.code.push(232); }
    else { c.code.push(15); c.code.push(op); }
    c.patches.push(c.code.len()); c.targets.push(target);
    return ag_u32(c.code, 0);
}

bool ag_nv_call(AGNVContext c, int target) {
    if (!ag_nv_edge(c, 1, target)) { return false; }
    c.code.push(133); c.code.push(210); // test edx,edx
    return ag_nv_edge(c, 133, c.trap); // jne
}

bool ag_nv_fuel(AGNVContext c) {
    c.code.push(72); c.code.push(255); c.code.push(203); // dec rbx
    return ag_nv_edge(c, 136, c.trap); // js
}

// RAX holds an arena offset, never a machine address. The membership leaf
// preserves it and RSI/RDI. Only after membership succeeds inspect the
// immutable descriptor/count header; use the same global layout registry.
bool ag_nv_reference(AGNVContext c, int descriptor) {
    List<int> b = c.code;
    if (descriptor == AG_NV_BYTES_DESCRIPTOR || descriptor == AG_NV_TAINTED_DESCRIPTOR || descriptor == AG_NV_LOG_DESCRIPTOR) {
        int tag = AG_NV_BYTES_TAG;
        if (descriptor == AG_NV_TAINTED_DESCRIPTOR) { tag = AG_NV_TAINTED_TAG; }
        if (descriptor == AG_NV_LOG_DESCRIPTOR) { tag = AG_NV_LOG_TAG; }
        if (b.len() > AG_BYTE_LIMIT - 32 || !ag_nv_imm(b, 6, tag) ||
            !ag_nv_call(c, c.trap + 6)) { return false; }
        // Membership validates the dynamic length (0..4096) and extent.
        b.push(73); b.push(57); b.push(52); b.push(4);
        return ag_nv_edge(c, 133, c.trap);
    }
    if (ag_nv_map_descriptor(descriptor)) {
        if (b.len() > AG_BYTE_LIMIT - 96 || !ag_nv_imm(b, 6, ag_nv_map_tag(descriptor - AG_NV_MAP_BASE)) ||
            !ag_nv_call(c, c.trap + 6)) { return false; }
        b.push(73); b.push(57); b.push(52); b.push(4);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(129); b.push(124); b.push(4); b.push(8);
        if (!ag_u32(b, 129) || !ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(131); b.push(124); b.push(4); b.push(24); b.push(1);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(131); b.push(124); b.push(4); b.push(16); b.push(64);
        return ag_nv_edge(c, 135, c.trap);
    }
    if (ag_nv_optional_tag(descriptor) != 0) {
        if (b.len() > AG_BYTE_LIMIT - 96 || !ag_nv_imm(b, 6, ag_nv_optional_tag(descriptor)) ||
            !ag_nv_call(c, c.trap + 6)) { return false; }
        // Membership then exact tag, count, presence range.
        b.push(73); b.push(57); b.push(52); b.push(4);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(131); b.push(124); b.push(4); b.push(8); b.push(1);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(131); b.push(124); b.push(4); b.push(24); b.push(1);
        if (!ag_nv_edge(c, 135, c.trap)) { return false; }
        return true;
    }
    if (descriptor == AG_NV_INT_LIST_DESCRIPTOR || descriptor == AG_NV_BOOL_LIST_DESCRIPTOR || ag_nv_ref_list_tag(descriptor) != 0) {
        int tag = AG_NV_INT_LIST_TAG;
        if (descriptor == AG_NV_BOOL_LIST_DESCRIPTOR) { tag = AG_NV_BOOL_LIST_TAG; }
        else if (ag_nv_ref_list_tag(descriptor) != 0) { tag = ag_nv_ref_list_tag(descriptor); }
        if (b.len() > AG_BYTE_LIMIT - 96 || !ag_nv_imm(b, 6, tag) ||
            !ag_nv_call(c, c.trap + 6)) { return false; }
        // Membership proves readable header/extent, before loading list metadata.
        b.push(73); b.push(57); b.push(52); b.push(4); // cmp [r12+rax],rsi
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(129); b.push(124); b.push(4); b.push(8);
        if (!ag_u32(b, 257) || !ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(131); b.push(124); b.push(4); b.push(24); b.push(1);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(129); b.push(124); b.push(4); b.push(16);
        return ag_u32(b, AG_NV_LIST_CAPACITY) && ag_nv_edge(c, 135, c.trap);
    }
    if (descriptor < 1 || descriptor >= AG_NV_RECORD_LIMIT || c.layouts[descriptor] < 0 ||
        b.len() > AG_BYTE_LIMIT - 64 ||
        !ag_nv_imm(b, 6, descriptor) || !ag_nv_imm(b, 7, c.layouts[descriptor]) ||
        !ag_nv_call(c, c.trap + 6)) { return false; }
    // cmp [r12+rax],rsi ; jne trap
    b.push(73); b.push(57); b.push(52); b.push(4);
    if (!ag_nv_edge(c, 133, c.trap)) { return false; }
    // cmp [r12+rax+8],rdi ; jne trap
    b.push(73); b.push(57); b.push(124); b.push(4); b.push(8);
    return ag_nv_edge(c, 133, c.trap);
}

// RAX is the payload word. Booleans require exact canonical representation.
bool ag_nv_field_value(AGNVContext c, int kind, int descriptor) {
    if (kind == AG_SCHEMA_REF) { return ag_nv_reference(c, descriptor); }
    if (kind == AG_SCHEMA_BOOL) {
        if (c.code.len() > AG_BYTE_LIMIT - 10) { return false; }
        c.code.push(72); c.code.push(131); c.code.push(248); c.code.push(1);
        return ag_nv_edge(c, 135, c.trap); // ja, including negative words
    }
    return kind == AG_SCHEMA_INT;
}

// A string is an immutable arena object with tag 4096, byte length in
// the count word, and one canonical zero-extended byte per existing
// value/readiness pair. Literal initialization is private and completes
// before the handle is published; no language opcode can store its fields.
bool ag_nv_bytes_literal(AGNVContext c, List<int> a) {
    List<int> b = c.code;
    int count = a.len() - 1;
    if (count < 0 || count > AG_STRING_MAX_LITERAL ||
        b.len() > AG_BYTE_LIMIT - 64 - count * 22 ||
        !ag_nv_imm(b, 0, AG_NV_BYTES_TAG) || !ag_nv_imm(b, 6, count) ||
        !ag_nv_call(c, c.trap + 3)) { return false; }
    // lea r10,[r12+rax]; store each payload and readiness word.
    b.push(77); b.push(141); b.push(20); b.push(4);
    for (int i = 0; i < count; i += 1) {
        b.push(73); b.push(199); b.push(130);
        if (!ag_u32(b, 16 + i * 16) || !ag_u32(b, a[i + 1])) { return false; }
        b.push(73); b.push(199); b.push(130);
        if (!ag_u32(b, 24 + i * 16) || !ag_u32(b, 1)) { return false; }
    }
    return ag_nv_slot(b, true, 0, a[0]);
}

bool ag_nv_bytes_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    if (ins.opcode == AG_OP_BYTES_LITERAL) { return ag_nv_bytes_literal(c, a); }
    int descriptor = AG_NV_BYTES_DESCRIPTOR;
    if (ins.opcode == AG_OP_TAINT_LEN || ins.opcode == AG_OP_TAINT_AT) { descriptor = AG_NV_TAINTED_DESCRIPTOR; }
    if (!ag_nv_slot(b, false, 0, a[1]) || !ag_nv_reference(c, descriptor)) { return false; }
    if (ins.opcode == 7 || ins.opcode == AG_OP_TAINT_LEN) {
        // mov rax,[r12+rax+8]
        b.push(73); b.push(139); b.push(68); b.push(4); b.push(8);
    } else if (ins.opcode == 4 || ins.opcode == AG_OP_TAINT_AT) {
        if (!ag_nv_slot(b, false, 8, a[2])) { return false; }
        // cmp r8,[r12+rax+8]; jae trap (also rejects negative index)
        b.push(77); b.push(59); b.push(68); b.push(4); b.push(8);
        if (!ag_nv_edge(c, 131, c.trap)) { return false; }
        // shl r8,4; lea r10,[r12+rax]; lea r10,[r10+r8+16]
        b.push(73); b.push(193); b.push(224); b.push(4);
        b.push(77); b.push(141); b.push(20); b.push(4);
        b.push(79); b.push(141); b.push(84); b.push(2); b.push(16);
        b.push(73); b.push(131); b.push(122); b.push(8); b.push(1);
        if (!ag_nv_edge(c, 133, c.trap)) { return false; }
        b.push(73); b.push(139); b.push(2);
        b.push(72); b.push(61);
        if (!ag_u32(b, 255) || !ag_nv_edge(c, 135, c.trap)) { return false; }
    } else if (ins.opcode == AG_OP_BYTES_SLICE) {
        if (!ag_nv_slot(b, false, 8, a[2]) || !ag_nv_slot(b, false, 9, a[3]) ||
            !ag_nv_call(c, c.trap + 9)) { return false; }
    } else if (ins.opcode == 8) {
        // Guard both source objects before entering the trusted copy leaf.
        if (!ag_nv_slot(b, false, 0, a[2]) || !ag_nv_reference(c, AG_NV_BYTES_DESCRIPTOR) ||
            !ag_nv_slot(b, false, 0, a[1]) || !ag_nv_slot(b, false, 8, a[2]) ||
            !ag_nv_call(c, c.trap + 8)) { return false; }
    } else {
        // Both operands are validated before the read-only comparison leaf.
        if (!ag_nv_slot(b, false, 0, a[2]) || !ag_nv_reference(c, AG_NV_BYTES_DESCRIPTOR) ||
            !ag_nv_slot(b, false, 0, a[1]) || !ag_nv_slot(b, false, 8, a[2]) ||
            !ag_nv_edge(c, 1, c.trap + 7)) { return false; }
        if (ins.opcode == AG_OP_BYTES_NE) { b.push(72); b.push(131); b.push(240); b.push(1); }
    }
    return ag_nv_slot(b, true, 0, a[0]);
}

// Validated immutable strings only; no mutation and at most 4096 iterations.
// RAX/R8 are offsets; RAX=canonical bool. RCX,R10,R11,flags clobbered.
bool ag_nv_emit_bytes_equal(List<int> b) {
    if (b.len() > AG_BYTE_LIMIT - 61) { return false; }
    b.push(77); b.push(141); b.push(20); b.push(4); b.push(79); b.push(141); b.push(28); b.push(4);
    b.push(73); b.push(139); b.push(74); b.push(8); b.push(73); b.push(59); b.push(75); b.push(8);
    b.push(117); b.push(40); b.push(73); b.push(131); b.push(194); b.push(16); b.push(73); b.push(131);
    b.push(195); b.push(16); b.push(72); b.push(133); b.push(201); b.push(116); b.push(21); b.push(73);
    b.push(139); b.push(2); b.push(73); b.push(59); b.push(3); b.push(117); b.push(19); b.push(73);
    b.push(131); b.push(194); b.push(16); b.push(73); b.push(131); b.push(195); b.push(16); b.push(72);
    b.push(255); b.push(201); b.push(117); b.push(235); b.push(184); b.push(1); b.push(0); b.push(0);
    b.push(0); b.push(195); b.push(49); b.push(192); b.push(195);
    return true;
}

// Native scalar list operation. All raw offsets are membership-checked
// before the leaf reads object metadata. Allocation privately sets length
// readiness before publishing its new stable handle.
bool ag_nv_list_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    int descriptor = AG_NV_INT_LIST_DESCRIPTOR;
    int tag = AG_NV_INT_LIST_TAG;
    if (ins.kind == AG_SCHEMA_BOOL) { descriptor = AG_NV_BOOL_LIST_DESCRIPTOR; tag = AG_NV_BOOL_LIST_TAG; }
    else if (ins.kind == AG_SCHEMA_REF) {
        if (ins.opcode != 5) { return ag_nv_ref_list_instruction(c, ins); }
        if (a[1] == -2) { tag = AG_NV_EMPTY_TAINTED_LIST_TAG; }
        else if (a[1] == -1) { tag = AG_NV_STRING_LIST_TAG; }
        else { tag = 2048 + a[1]; }
    } else if (ins.kind != AG_SCHEMA_INT) { return false; }
    if (ins.opcode == 5) {
        if (!ag_nv_imm(b, 0, tag) || !ag_nv_imm(b, 6, AG_NV_LIST_CAPACITY + 1) ||
            !ag_nv_call(c, c.trap + 3)) { return false; }
        // mov qword [r12+rax+24],1 (length value already zeroed by allocator)
        b.push(73); b.push(199); b.push(68); b.push(4); b.push(24);
        if (!ag_u32(b, 1)) { return false; }
        return ag_nv_slot(b, true, 0, a[0]);
    }
    int receiver = a[0];
    int mode = 0;
    if (ins.opcode != AG_OP_LIST_POP_DISCARD && ins.opcode != AG_OP_LIST_PUSH) { receiver = a[1]; }
    if (ins.opcode == 1) { mode = 1; }
    else if (ins.opcode == 2) { mode = 2; }
    else if (ins.opcode == AG_OP_LIST_PUSH) { mode = 3; }
    else if (ins.opcode == AG_OP_LIST_POP_DISCARD) { mode = 4; }
    else if (ins.opcode != 3) { return false; }
    if (!ag_nv_slot(b, false, 0, receiver) || !ag_nv_reference(c, descriptor) ||
        !ag_nv_imm(b, 6, tag) || !ag_nv_imm(b, 7, mode)) { return false; }
    if ((mode == 1 || mode == 2) && !ag_nv_slot(b, false, 8, a[2])) { return false; }
    if (mode == 2 && !ag_nv_slot(b, false, 9, a[0])) { return false; }
    if (mode == 3 && !ag_nv_slot(b, false, 9, a[1])) { return false; }
    if (!ag_nv_call(c, c.trap + 11)) { return false; }
    if (mode == 0 || mode == 1) { return ag_nv_slot(b, true, 0, a[0]); }
    return true;
}

// Coarse list opcodes do not carry the exact nominal receiver descriptor.
// The private leaf derives the actual element type from the immutable
// allocation tag; production source checking enforces the static shape.
bool ag_nv_ref_list_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    int receiver = a[0]; int mode = 0;
    if (ins.opcode != AG_OP_LIST_POP_DISCARD && ins.opcode != AG_OP_LIST_PUSH) { receiver = a[1]; }
    if (ins.opcode == 1) { mode = 1; }
    else if (ins.opcode == 2) { mode = 2; }
    else if (ins.opcode == AG_OP_LIST_PUSH) { mode = 3; }
    else if (ins.opcode == AG_OP_LIST_POP_DISCARD) { mode = 4; }
    else if (ins.opcode != 3) { return false; }
    if (!ag_nv_slot(b, false, 0, receiver) || !ag_nv_imm(b, 7, mode)) { return false; }
    if ((mode == 1 || mode == 2) && !ag_nv_slot(b, false, 8, a[2])) { return false; }
    if (mode == 2 && !ag_nv_slot(b, false, 9, a[0])) { return false; }
    if (mode == 3 && !ag_nv_slot(b, false, 9, a[1])) { return false; }
    if (!ag_nv_call(c, c.trap + 12)) { return false; }
    if (mode == 0 || mode == 1) { return ag_nv_slot(b, true, 0, a[0]); }
    return true;
}

// Validate payload before allocating some. Allocation privately writes
// the pair and publishes the handle last. No public field opcode admits
// an optional's physical tag. Unwrap checks presence before reading.
bool ag_nv_optional_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    int descriptor = a[1];
    if (ins.opcode != AG_OP_OPT_NONE) { descriptor = a[2]; }
    int tag = ag_nv_optional_tag(descriptor);
    if (tag == 0 || b.len() > AG_BYTE_LIMIT - 256) { return false; }
    int payload_kind = ag_schema_optional_payload(descriptor);
    int payload_descriptor = ag_nv_optional_payload_descriptor(descriptor);
    if (ins.opcode == AG_OP_OPT_NONE || ins.opcode == AG_OP_OPT_SOME) {
        if (ins.opcode == AG_OP_OPT_SOME) {
            if (!ag_nv_slot(b, false, 0, a[1]) ||
                !ag_nv_field_value(c, payload_kind, payload_descriptor)) { return false; }
        }
        if (!ag_nv_imm(b, 0, tag) || !ag_nv_imm(b, 6, 1) ||
            !ag_nv_call(c, c.trap + 3)) { return false; }
        if (ins.opcode == AG_OP_OPT_SOME) {
            if (!ag_nv_slot(b, false, 9, a[1])) { return false; }
            // mov [r12+rax+16],r9; mov qword [r12+rax+24],1
            b.push(77); b.push(137); b.push(76); b.push(4); b.push(16);
            b.push(73); b.push(199); b.push(68); b.push(4); b.push(24);
            if (!ag_u32(b, 1)) { return false; }
        }
    } else {
        if (!ag_nv_slot(b, false, 0, a[1]) || !ag_nv_reference(c, descriptor)) { return false; }
        if (ins.opcode == AG_OP_OPT_PRESENT) {
            b.push(73); b.push(139); b.push(68); b.push(4); b.push(24);
        } else if (ins.opcode == AG_OP_OPT_UNWRAP) {
            b.push(73); b.push(131); b.push(124); b.push(4); b.push(24); b.push(1);
            if (!ag_nv_edge(c, 133, c.trap)) { return false; }
            b.push(73); b.push(139); b.push(68); b.push(4); b.push(16);
            if (!ag_nv_field_value(c, payload_kind, payload_descriptor)) { return false; }
        } else { return false; }
    }
    return ag_nv_slot(b, true, 0, a[0]);
}

// Map writes admit the exact value before the leaf can mutate storage.
// The read path produces a fresh optional or a canonical boolean.
bool ag_nv_map_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    int descriptor = a[1];
    if (ins.opcode == AG_OP_MAP_KEYS) { descriptor = a[2]; }
    else if (ins.opcode != AG_OP_MAP_NEW) { descriptor = a[3]; }
    int tag = ag_nv_map_tag(descriptor);
    if (tag == 0 || b.len() > AG_BYTE_LIMIT - 320) { return false; }
    if (ins.opcode == AG_OP_MAP_NEW) {
        if (!ag_nv_imm(b, 0, tag) || !ag_nv_imm(b, 6, 129) ||
            !ag_nv_call(c, c.trap + 3)) { return false; }
        b.push(73); b.push(199); b.push(68); b.push(4); b.push(24);
        if (!ag_u32(b, 1)) { return false; }
        return ag_nv_slot(b, true, 0, a[0]);
    }
    if (ins.opcode == AG_OP_MAP_KEYS) {
        return ag_nv_slot(b, false, 0, a[1]) &&
            ag_nv_reference(c, AG_NV_MAP_BASE + descriptor) &&
            ag_nv_call(c, c.trap + 14) && ag_nv_slot(b, true, 0, a[0]);
    }
    int map_reg = a[1]; int key_reg = a[2]; int mode = 0;
    if (ins.opcode == AG_OP_MAP_SET) {
        map_reg = a[0]; key_reg = a[1]; mode = 2;
        if (!ag_nv_slot(b, false, 0, a[2]) ||
            !ag_nv_field_value(c, ins.kind, ag_nv_optional_payload_descriptor(descriptor))) { return false; }
    } else if (ins.opcode == AG_OP_MAP_GET) { mode = 1; }
    else if (ins.opcode == AG_OP_MAP_REMOVE) { mode = 3; }
    else if (ins.opcode != AG_OP_MAP_HAS) { return false; }
    if (!ag_nv_slot(b, false, 0, key_reg) || !ag_nv_reference(c, AG_NV_BYTES_DESCRIPTOR) ||
        !ag_nv_slot(b, false, 0, map_reg) || !ag_nv_reference(c, AG_NV_MAP_BASE + descriptor) ||
        !ag_nv_slot(b, false, 8, key_reg) || !ag_nv_imm(b, 7, mode) ||
        !ag_nv_imm(b, 6, ag_nv_optional_tag(descriptor))) { return false; }
    if (mode == 2 && !ag_nv_slot(b, false, 9, a[2])) { return false; }
    if (!ag_nv_call(c, c.trap + 13)) { return false; }
    if (mode != 2) { return ag_nv_slot(b, true, 0, a[0]); }
    return true;
}

// Native taint adapters. The private SysV leaves preserve RBX/RBP/R12-R15.
// Slice receives a stack copy of R13 as its cursor pointer; restore the
// updated cursor before checking status. No host calls or external ABI.
bool ag_nv_taint_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands; int op = ins.opcode;
    if (op == AG_OP_TAINT_LEN || op == AG_OP_TAINT_AT) { return ag_nv_bytes_instruction(c, ins); }
    if (op == AG_OP_TAINT || ag_schema_validation_opcode(op)) {
        int mode = 3;
        if (op == AG_OP_VALIDATE_INT) { mode = 0; }
        if (op == AG_OP_VALIDATE_IDENT) { mode = 1; }
        if (op == AG_OP_ESCAPE_C) { mode = 2; }
        return ag_nv_slot(b, false, 0, a[1]) && ag_nv_imm(b, 8, mode) &&
            ag_nv_call(c, c.trap + 16) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (op == AG_OP_TAINT_SLICE) {
        if (!ag_nv_slot(b, false, 1, a[1]) || !ag_nv_slot(b, false, 8, a[2]) ||
            !ag_nv_slot(b, false, 9, a[3])) { return false; }
        b.push(65); b.push(85); // push r13: private cursor storage
        b.push(76); b.push(137); b.push(231); // mov rdi,r12
        b.push(72); b.push(137); b.push(230); // mov rsi,rsp
        b.push(76); b.push(137); b.push(242); // mov rdx,r14
        if (!ag_nv_edge(c, 1, c.trap + 17)) { return false; }
        b.push(65); b.push(93); // pop r13 (unchanged on rejection)
        b.push(133); b.push(210);
        return ag_nv_edge(c, 133, c.trap) && ag_nv_slot(b, true, 0, a[0]);
    }
    int mode = 0; int receiver = a[0];
    if (op != AG_OP_TAINT_LIST_PUSH && op != AG_OP_TAINT_LIST_POP) { receiver = a[1]; }
    if (op == AG_OP_TAINT_LIST_GET) { mode = 1; }
    else if (op == AG_OP_TAINT_LIST_SET) { mode = 2; }
    else if (op == AG_OP_TAINT_LIST_PUSH) { mode = 3; receiver = a[0]; }
    else if (op == AG_OP_TAINT_LIST_POP) { mode = 4; receiver = a[0]; }
    else if (op != AG_OP_TAINT_LIST_LEN) { return false; }
    b.push(76); b.push(137); b.push(231); // mov rdi,r12
    b.push(76); b.push(137); b.push(238); // mov rsi,r13
    if (!ag_nv_slot(b, false, 2, receiver) || !ag_nv_imm(b, 1, mode)) { return false; }
    if ((mode == 1 || mode == 2) && !ag_nv_slot(b, false, 8, a[2])) { return false; }
    if (mode == 2 && !ag_nv_slot(b, false, 9, a[0])) { return false; }
    if (mode == 3 && !ag_nv_slot(b, false, 9, a[1])) { return false; }
    if (!ag_nv_call(c, c.trap + 18)) { return false; }
    if (mode == 0 || mode == 1) { return ag_nv_slot(b, true, 0, a[0]); }
    return true;
}

// Dedicated LogText bridge; R13 is restored before branching on failure.
// No stack pointer is exposed to the candidate language.
bool ag_nv_log_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    if (!ag_nv_slot(b, false, 1, a[1])) { return false; }
    int mode = 0;
    if (ins.opcode == AG_OP_LOG_CONCAT) {
        mode = 1;
        if (!ag_nv_slot(b, false, 8, a[2])) { return false; }
    } else if (ins.opcode != AG_OP_ESCAPE_LOG) { return false; }
    if (!ag_nv_imm(b, 9, mode)) { return false; }
    b.push(65); b.push(85);
    b.push(76); b.push(137); b.push(231);
    b.push(72); b.push(137); b.push(230);
    b.push(76); b.push(137); b.push(242);
    if (!ag_nv_edge(c, 1, c.trap + 19)) { return false; }
    b.push(65); b.push(93);
    b.push(133); b.push(210);
    return ag_nv_edge(c, 133, c.trap) && ag_nv_slot(b, true, 0, a[0]);
}

bool ag_nv_join_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> b = c.code; List<int> a = ins.operands;
    int mode = 0;
    if (ins.opcode == AG_OP_JOIN_TAINTED) { mode = 1; }
    else if (ins.opcode != AG_OP_JOIN_BYTES) { return false; }
    if (!ag_nv_slot(b, false, 1, a[1]) || !ag_nv_slot(b, false, 8, a[2]) ||
        !ag_nv_imm(b, 9, mode)) { return false; }
    b.push(65); b.push(85);
    b.push(76); b.push(137); b.push(231);
    b.push(72); b.push(137); b.push(230);
    b.push(76); b.push(137); b.push(242);
    if (!ag_nv_edge(c, 1, c.trap + 20)) { return false; }
    b.push(65); b.push(93);
    b.push(133); b.push(210);
    return ag_nv_edge(c, 133, c.trap) && ag_nv_slot(b, true, 0, a[0]);
}

bool ag_nv_stdout_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> a = ins.operands;
    int mode = 0; int target = c.trap + 21;
    if (ins.opcode == AG_OP_PRINTLN) { mode = 1; }
    else if (ins.opcode != AG_OP_PRINT) { return false; }
    if (a[1] == AG_NV_LOG_DESCRIPTOR) { target = c.trap + 22; }
    else if (a[1] != AG_NV_BYTES_DESCRIPTOR) { return false; }
    return ag_nv_slot(c.code, false, 0, a[0]) &&
        ag_nv_imm(c.code, 7, mode) && ag_nv_call(c, target);
}

bool ag_nv_has_stdout(AGFunction f, int descriptor) {
    for (int i = 0; i < f.blocks.len(); i += 1) {
        for (int j = 0; j < f.blocks[i].instructions.len(); j += 1) {
            AGBlockInstruction ins = f.blocks[i].instructions[j];
            if (ag_schema_stdout_opcode(ins.opcode) && ins.operands[1] == descriptor) { return true; }
        }
    }
    return false;
}

bool ag_nv_emit_stdout_leaves(AGNVContext c, bool trusted, bool log) {
    if (trusted) {
        c.labels[c.trap + 21] = c.code.len();
        if (!ag_nv_emit_stdout_tag(c.code, AG_NV_BYTES_TAG)) { return false; }
    }
    if (log) {
        c.labels[c.trap + 22] = c.code.len();
        if (!ag_nv_emit_stdout_tag(c.code, AG_NV_LOG_TAG)) { return false; }
    }
    return true;
}

// Both offsets are checked against their exact declared nominal class.
// Existing copy leaf relies on canonical immutable pairs; no mutation of sources.
bool ag_nv_taint_build_instruction(AGNVContext c, AGBlockInstruction ins) {
    List<int> a = ins.operands; List<int> b = c.code;
    if (ins.opcode == AG_OP_TAINT_CHAR) {
        return ag_nv_slot(b, false, 0, a[1]) && ag_nv_imm(b, 8, 1) &&
            ag_nv_call(c, c.trap + 24) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (ins.opcode != AG_OP_TAINT_CONCAT) { return false; }
    return ag_nv_slot(b, false, 0, a[2]) && ag_nv_reference(c, a[4]) &&
        ag_nv_slot(b, false, 0, a[1]) && ag_nv_reference(c, a[3]) &&
        ag_nv_slot(b, false, 0, a[1]) && ag_nv_slot(b, false, 8, a[2]) &&
        ag_nv_call(c, c.trap + 23) && ag_nv_slot(b, true, 0, a[0]);
}

bool ag_nv_has_taint_build(AGFunction f) {
    for (int i = 0; i < f.blocks.len(); i += 1) {
        for (int j = 0; j < f.blocks[i].instructions.len(); j += 1) {
            if (ag_schema_taint_build_opcode(f.blocks[i].instructions[j].opcode)) { return true; }
        }
    }
    return false;
}
bool ag_nv_emit_taint_build(AGNVContext c) {
    c.labels[c.trap + 23] = c.code.len();
    if (!ag_nv_emit_bytes_concat_tag(c.code, AG_NV_TAINTED_TAG)) { return false; }
    c.labels[c.trap + 24] = c.code.len();
    return ag_nv_emit_bytes_conversion_tag(c.code, AG_NV_TAINTED_TAG);
}

bool ag_nv_has_join(AGFunction f) {
    for (int i = 0; i < f.blocks.len(); i += 1) {
        for (int j = 0; j < f.blocks[i].instructions.len(); j += 1) {
            if (ag_schema_join_opcode(f.blocks[i].instructions[j].opcode)) { return true; }
        }
    }
    return false;
}

bool ag_nv_has_log(AGFunction f) {
    for (int i = 0; i < f.blocks.len(); i += 1) {
        for (int j = 0; j < f.blocks[i].instructions.len(); j += 1) {
            if (ag_schema_log_opcode(f.blocks[i].instructions[j].opcode)) { return true; }
        }
    }
    return false;
}

bool ag_nv_has_taint(AGFunction f) {
    for (int i = 0; i < f.blocks.len(); i += 1) {
        for (int j = 0; j < f.blocks[i].instructions.len(); j += 1) {
            if (ag_schema_taint_opcode(f.blocks[i].instructions[j].opcode) || ag_schema_validation_opcode(f.blocks[i].instructions[j].opcode)) { return true; }
        }
    }
    return false;
}

bool ag_nv_emit_taint_leaves(AGNVContext c) {
    c.labels[c.trap + 16] = c.code.len();
    if (!ag_native_emit_taint_validation(c.code)) { return false; }
    c.labels[c.trap + 17] = c.code.len();
    if (!ag_native_emit_tainted_slice(c.code)) { return false; }
    c.labels[c.trap + 18] = c.code.len();
    return ag_native_emit_tainted_list(c.code);
}

bool ag_nv_instruction(AGNVContext c, AGBlockInstruction ins) {
    if (c.code.len() > AG_BYTE_LIMIT - 256 || !ag_nv_fuel(c)) { return false; }
    List<int> b = c.code; List<int> a = ins.operands; int op = ins.opcode;
    if (ag_schema_taint_opcode(op) || ag_schema_validation_opcode(op)) { return ag_nv_taint_instruction(c, ins); }
    if (ag_schema_log_opcode(op)) { return ag_nv_log_instruction(c, ins); }
    if (ag_schema_join_opcode(op)) { return ag_nv_join_instruction(c, ins); }
    if (ag_schema_stdout_opcode(op)) { return ag_nv_stdout_instruction(c, ins); }
    if (ag_schema_taint_build_opcode(op)) { return ag_nv_taint_build_instruction(c, ins); }
    if (op == AG_OP_BYTES_LITERAL || op == 4 || op == 7 || op == AG_OP_BYTES_EQ || op == AG_OP_BYTES_NE ||
        op == 8 || op == AG_OP_BYTES_SLICE) {
        return ag_nv_bytes_instruction(c, ins);
    }
    if (op == 5 || op == 1 || op == 2 || op == 3 || op == AG_OP_LIST_PUSH || op == AG_OP_LIST_POP_DISCARD) {
        return ag_nv_list_instruction(c, ins);
    }
    if ((op >= AG_OP_MAP_NEW && op <= AG_OP_MAP_SET) || op == AG_OP_MAP_KEYS || op == AG_OP_MAP_REMOVE) {
        return ag_nv_map_instruction(c, ins);
    }
    if (op >= AG_OP_OPT_NONE && op <= AG_OP_OPT_UNWRAP) {
        return ag_nv_optional_instruction(c, ins);
    }
    if (op >= AG_OP_INT_TEXT && op <= AG_OP_BOOL_TEXT) {
        return ag_nv_slot(b, false, 0, a[1]) &&
            ag_nv_imm(b, 8, op - AG_OP_INT_TEXT) &&
            ag_nv_call(c, c.trap + 10) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (op == AG_OP_SCALAR_CONST) {
        return ag_nv_imm(b, 0, a[1]) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (op == AG_OP_MOVE || op == AG_OP_NOT) {
        if (!ag_nv_slot(b, false, 0, a[1])) { return false; }
        if (op == AG_OP_NOT) { b.push(72); b.push(131); b.push(240); b.push(1); }
        return ag_nv_slot(b, true, 0, a[0]);
    }
    if (op == AG_OP_RECORD_ALLOC) {
        return ag_nv_imm(b, 0, a[1]) && ag_nv_imm(b, 6, c.layouts[a[1]]) &&
            ag_nv_call(c, c.trap + 3) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (op == AG_OP_FIELD_GET || op == AG_OP_FIELD_SET) {
        // Validate payload before any store. Reload object and payload from
        // their independent frame slots after the guard clobbers scratch regs.
        if (op == AG_OP_FIELD_SET && ins.kind != AG_SCHEMA_INT) {
            if (!ag_nv_slot(b, false, 0, a[0]) || !ag_nv_field_value(c, ins.kind, a[4])) { return false; }
        }
        if (!ag_nv_slot(b, false, 0, a[1]) || !ag_nv_imm(b, 6, a[2]) ||
            !ag_nv_imm(b, 7, c.layouts[a[2]]) || !ag_nv_imm(b, 8, a[3])) { return false; }
        if (op == AG_OP_FIELD_SET) {
            return ag_nv_slot(b, false, 9, a[0]) && ag_nv_call(c, c.trap + 5);
        }
        return ag_nv_call(c, c.trap + 4) && ag_nv_field_value(c, ins.kind, a[4]) && ag_nv_slot(b, true, 0, a[0]);
    }
    if (!ag_nv_slot(b, false, 0, a[1]) || !ag_nv_slot(b, false, 1, a[2])) { return false; }
    if (op == AG_OP_ADD || op == AG_OP_SUB || op == AG_OP_MUL) {
        b.push(72);
        if (op == AG_OP_ADD) { b.push(1); b.push(200); }
        else if (op == AG_OP_SUB) { b.push(41); b.push(200); }
        else { b.push(15); b.push(175); b.push(193); }
        if (!ag_nv_edge(c, 128, c.trap)) { return false; } // jo
    } else if (op == AG_OP_DIV || op == AG_OP_REM) {
        b.push(72); b.push(133); b.push(201); // test rcx,rcx
        if (!ag_nv_edge(c, 132, c.trap)) { return false; } // jz
        // Handle min/-1 without hardware divide exception. Remainder is 0.
        b.push(72); b.push(131); b.push(249); b.push(255);
        b.push(15); b.push(133); int not_minus = b.len(); if (!ag_u32(b, 0)) { return false; }
        if (!ag_nv_imm(b, 2, CCAM_I64_MIN)) { return false; }
        b.push(72); b.push(57); b.push(208); // cmp rax,rdx
        if (op == AG_OP_DIV) {
            if (!ag_nv_edge(c, 132, c.trap)) { return false; }
            if (!ag_rel32(b, not_minus, b.len())) { return false; }
            b.push(72); b.push(153); b.push(72); b.push(247); b.push(249);
        } else {
            b.push(15); b.push(133); int not_min = b.len(); if (!ag_u32(b, 0)) { return false; }
            b.push(49); b.push(192); // zero remainder
            b.push(233); int done = b.len(); if (!ag_u32(b, 0)) { return false; }
            if (!ag_rel32(b, not_minus, b.len()) || !ag_rel32(b, not_min, b.len())) { return false; }
            b.push(72); b.push(153); b.push(72); b.push(247); b.push(249);
            b.push(72); b.push(137); b.push(208); // mov rax,rdx
            if (!ag_rel32(b, done, b.len())) { return false; }
        }
    } else {
        int cc = 0;
        if (op == AG_OP_EQ) { cc = 148; }
        if (op == AG_OP_NE) { cc = 149; }
        if (op == AG_OP_LT) { cc = 156; }
        if (op == AG_OP_LE) { cc = 158; }
        if (op == AG_OP_GT) { cc = 159; }
        if (op == AG_OP_GE) { cc = 157; }
        if (cc == 0) { return false; }
        b.push(72); b.push(57); b.push(200); // cmp rax,rcx
        b.push(15); b.push(cc); b.push(192); // setcc al
        b.push(72); b.push(15); b.push(182); b.push(192); // movzx rax,al
    }
    return ag_nv_slot(b, true, 0, a[0]);
}

bool ag_nv_return(AGNVContext c, int source, int result_slot) {
    List<int> b = c.code;
    if (!ag_nv_slot(b, false, 0, source) || !ag_nv_slot(b, true, 0, result_slot) ||
        !ag_nv_call(c, c.trap + 2)) { return false; }
    // lea rsi,[r15+result_slot*8]; write(1, result, 8).
    b.push(73); b.push(141); b.push(183);
    if (!ag_u32(b, result_slot * 8) || !ag_nv_imm(b, 0, 1) ||
        !ag_nv_imm(b, 7, 1) || !ag_nv_imm(b, 2, 8)) { return false; }
    b.push(15); b.push(5);
    b.push(72); b.push(131); b.push(248); b.push(8);
    return ag_nv_edge(c, 133, c.trap) && ag_exit_code(b, 0);
}

AGImage ag_nv_compile(AGFunction f, int fuel) {
    List<int> layouts = new List<int>();
    if (fuel < 1 || fuel > AG_NV_MAX_FUEL || !ag_nv_admit(f, layouts)) { return ag_nv_failure(); }
    int count = f.blocks.len();
    AGNVContext c = new AGNVContext{code: new List<int>(), patches: new List<int>(),
        targets: new List<int>(), labels: new List<int>(), layouts: layouts, trap: count};
    for (int i = 0; i < count + 25; i += 1) { c.labels.push(-1); }
    List<int> b = c.code;
    // Stack frame: one slot per register and one private return word.
    b.push(72); b.push(129); b.push(236);
    if (!ag_u32(b, 8 * (f.kinds.len() + 1))) { return ag_nv_failure(); }
    b.push(73); b.push(137); b.push(231); // mov r15,rsp
    if (!ag_nv_imm(b, 12, 0) || !ag_nv_imm(b, 13, 0) || !ag_nv_imm(b, 14, 0) ||
        !ag_nv_imm(b, 3, fuel) || !ag_nv_imm(b, 0, AG_NATIVE_SCALAR_RECORD_MAX_CAPACITY) ||
        !ag_nv_call(c, count + 1)) { return ag_nv_failure(); }
    for (int i = 0; i < count; i += 1) {
        c.labels[i] = b.len();
        AGCFGBlock block = f.blocks[i];
        for (int j = 0; j < block.instructions.len(); j += 1) {
            if (!ag_nv_instruction(c, block.instructions[j])) { return ag_nv_failure(); }
        }
        if (b.len() > AG_BYTE_LIMIT - 256 || !ag_nv_fuel(c)) { return ag_nv_failure(); }
        if (block.terminator == 0) {
            if (!ag_nv_return(c, f.returns[i], f.kinds.len())) { return ag_nv_failure(); }
        } else if (block.terminator == 1) {
            if (!ag_nv_edge(c, 0, block.yes)) { return ag_nv_failure(); }
        } else {
            if (!ag_nv_slot(b, false, 0, block.condition)) { return ag_nv_failure(); }
            b.push(72); b.push(133); b.push(192);
            if (!ag_nv_edge(c, 133, block.yes) || !ag_nv_edge(c, 0, block.no)) { return ag_nv_failure(); }
        }
    }
    c.labels[count] = b.len();
    if (!ag_exit_code(b, 1)) { return ag_nv_failure(); }
    c.labels[count + 1] = b.len(); if (!ag_native_emit_arena_init(b)) { return ag_nv_failure(); }
    c.labels[count + 2] = b.len(); if (!ag_native_emit_arena_release(b)) { return ag_nv_failure(); }
    c.labels[count + 3] = b.len(); if (!ag_native_emit_scalar_record_alloc(b)) { return ag_nv_failure(); }
    c.labels[count + 4] = b.len(); if (!ag_native_emit_guarded_record_access(b, false)) { return ag_nv_failure(); }
    c.labels[count + 5] = b.len(); if (!ag_native_emit_guarded_record_access(b, true)) { return ag_nv_failure(); }
    c.labels[count + 6] = b.len(); if (!ag_native_emit_record_boundary(b)) { return ag_nv_failure(); }
    c.labels[count + 7] = b.len(); if (!ag_nv_emit_bytes_equal(b)) { return ag_nv_failure(); }
    c.labels[count + 8] = b.len(); if (!ag_nv_emit_bytes_concat(b)) { return ag_nv_failure(); }
    c.labels[count + 9] = b.len(); if (!ag_nv_emit_bytes_slice(b)) { return ag_nv_failure(); }
    c.labels[count + 10] = b.len(); if (!ag_nv_emit_bytes_conversion(b)) { return ag_nv_failure(); }
    c.labels[count + 11] = b.len(); if (!ag_nv_emit_scalar_list(b)) { return ag_nv_failure(); }
    c.labels[count + 12] = b.len(); if (!ag_nv_emit_reference_list(b)) { return ag_nv_failure(); }
    c.labels[count + 13] = b.len();
    c.labels[count + 14] = b.len() + AG_NV_MAP_KEYS_OFFSET;
    if (!ag_nv_emit_map(b)) { return ag_nv_failure(); }
    if (ag_nv_has_taint(f) && !ag_nv_emit_taint_leaves(c)) { return ag_nv_failure(); }
    if (ag_nv_has_log(f)) {
        c.labels[count + 19] = b.len();
        if (!ag_native_emit_log_bridge(b)) { return ag_nv_failure(); }
    }
    if (ag_nv_has_join(f)) {
        c.labels[count + 20] = b.len();
        if (!ag_native_emit_join(b)) { return ag_nv_failure(); }
    }
    if (ag_nv_has_taint_build(f) && !ag_nv_emit_taint_build(c)) { return ag_nv_failure(); }
    if (!ag_nv_emit_stdout_leaves(c, ag_nv_has_stdout(f, AG_NV_BYTES_DESCRIPTOR),
        ag_nv_has_stdout(f, AG_NV_LOG_DESCRIPTOR))) { return ag_nv_failure(); }
    for (int i = 0; i < c.patches.len(); i += 1) {
        if (!ag_rel32(b, c.patches[i], c.labels[c.targets[i]])) { return ag_nv_failure(); }
    }
    return ag_nv_image(b);
}

AGImage ag_nv_image(List<int> b) {
    // Existing direct ELF builder; add explicit non-executable stack header.
    AGImage image = ag_elf_image(b);
    if (!image.ok || image.bytes.len() < 4096) { return ag_nv_failure(); }
    image.bytes[56] = 2; // e_phnum
    List<int> stack = new List<int>();
    if (!ag_u32(stack, 1685382481) || !ag_u32(stack, 6)) { return ag_nv_failure(); }
    for (int i = 0; i < 5; i += 1) { if (!ag_u64(stack, 0)) { return ag_nv_failure(); } }
    if (!ag_u64(stack, 16) || stack.len() != 56) { return ag_nv_failure(); }
    for (int i = 0; i < stack.len(); i += 1) { image.bytes[120 + i] = stack[i]; }
    return image;
}
