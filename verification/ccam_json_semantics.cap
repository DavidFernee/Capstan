// Whole-program CCAM JSON validation.
// This pass establishes register typing, branch bounds, call signatures,
// return contracts and reachable termination before a caller may build frames.
// It consumes only the already structurally and schema-validated token tape.

import "ccam_json_schema.cap";

int ccam_json_semantic_int(Tainted source, List<CCAMJsonToken> tokens, int at) {
    if (at < 0 || at >= tokens.len()) { return -1; }
    CCAMJsonToken token = tokens[at];
    int? parsed = ccam_json_parse_i64(source.slice(token.start, token.end));
    if (let value = parsed) { return value; }
    return -1;
}

int ccam_json_semantic_field_int(
    Tainted source, List<CCAMJsonToken> tokens, int object_at, string field
) {
    return ccam_json_semantic_int(
        source, tokens, ccam_json_schema_find(source, tokens, object_at, field)
    );
}

bool ccam_json_semantic_register(
    List<int> register_types, int index, int expected
) {
    return index >= 0 && index < register_types.len() &&
        (expected == 0 || register_types[index] == expected);
}

bool ccam_json_semantic_target(int target, int instruction_count) {
    return target >= 0 && target < instruction_count;
}

bool ccam_json_semantic_null(List<CCAMJsonToken> tokens, int at) {
    return at >= 0 && at < tokens.len() && tokens[at].kind == CCAM_JSON_T_NULL;
}

int ccam_json_semantic_function_index(List<Tainted> names, Tainted wanted) {
    for (int i = 0; i < names.len(); i += 1) {
        if (names[i] == wanted) { return i; }
    }
    return -1;
}

bool ccam_json_semantic_reachable_termination(
    Tainted source,
    List<CCAMJsonToken> tokens,
    int instructions_at,
    int instruction_count
) {
    List<int> instruction_positions = new List<int>();
    int instruction_cursor = instructions_at + 1;
    for (int i = 0; i < instruction_count; i += 1) {
        instruction_positions.push(instruction_cursor);
        instruction_cursor = ccam_json_schema_array_next(tokens, instruction_cursor);
    }
    List<bool> reachable = new List<bool>();
    for (int i = 0; i < instruction_count; i += 1) { reachable.push(false); }
    List<int> worklist = new List<int>();
    reachable[0] = true;
    worklist.push(0);
    int cursor = 0;
    while (cursor < worklist.len()) {
        int pc = worklist[cursor];
        cursor += 1;
        int instruction_at = instruction_positions[pc];
        int op_at = ccam_json_schema_find(source, tokens, instruction_at, "op");
        bool terminal = ccam_json_schema_string_eq(source, tokens, op_at, "ret") ||
            ccam_json_schema_string_eq(source, tokens, op_at, "ret_void") ||
            ccam_json_schema_string_eq(source, tokens, op_at, "trap");
        if (ccam_json_schema_string_eq(source, tokens, op_at, "jump")) {
            int target = ccam_json_semantic_field_int(source, tokens, instruction_at, "target");
            if (!reachable[target]) { reachable[target] = true; worklist.push(target); }
        } else if (ccam_json_schema_string_eq(source, tokens, op_at, "branch")) {
            int yes = ccam_json_semantic_field_int(source, tokens, instruction_at, "if_true");
            int no = ccam_json_semantic_field_int(source, tokens, instruction_at, "if_false");
            if (!reachable[yes]) { reachable[yes] = true; worklist.push(yes); }
            if (!reachable[no]) { reachable[no] = true; worklist.push(no); }
        } else if (!terminal) {
            if (pc + 1 >= instruction_count) { return false; }
            if (!reachable[pc + 1]) {
                reachable[pc + 1] = true;
                worklist.push(pc + 1);
            }
        }
    }
    return true;
}

CCAMJsonSchemaResult ccam_json_validate_program_semantics(Tainted source) {
    CCAMJsonSchemaResult schema = ccam_json_validate_program_schema(source);
    if (!schema.ok) { return schema; }
    CCAMJsonScanResult scanned = ccam_json_scan(source);
    List<CCAMJsonToken> tokens = scanned.tokens;
    int functions_at = ccam_json_schema_find(source, tokens, 0, "functions");
    List<Tainted> names = new List<Tainted>();
    List<List<int>> register_types_by_function = new List<List<int>>();
    List<int> parameter_counts = new List<int>();
    List<int> return_types = new List<int>();
    List<int> instruction_arrays = new List<int>();
    List<int> instruction_counts = new List<int>();

    int function_cursor = functions_at + 1;
    for (int f = 0; f < schema.function_count; f += 1) {
        int function_at = function_cursor;
        int name_at = ccam_json_schema_find(source, tokens, function_at, "name");
        names.push(ccam_json_schema_decoded_string(source, tokens, name_at));
        int regs_at = ccam_json_schema_find(source, tokens, function_at, "register_types");
        int reg_count = ccam_json_schema_array_count(tokens, regs_at);
        List<int> register_types = new List<int>();
        int register_cursor = regs_at + 1;
        for (int r = 0; r < reg_count; r += 1) {
            int type_at = register_cursor;
            int type = 0;
            if (ccam_json_schema_string_eq(source, tokens, type_at, "int")) { type = 1; }
            else if (ccam_json_schema_string_eq(source, tokens, type_at, "bool")) { type = 2; }
            register_types.push(type);
            register_cursor = ccam_json_schema_array_next(tokens, register_cursor);
        }
        register_types_by_function.push(register_types);
        parameter_counts.push(ccam_json_semantic_field_int(source, tokens, function_at, "parameter_count"));
        int ret_at = ccam_json_schema_find(source, tokens, function_at, "return_type");
        int ret = 0;
        if (ccam_json_schema_string_eq(source, tokens, ret_at, "int")) { ret = 1; }
        else if (ccam_json_schema_string_eq(source, tokens, ret_at, "bool")) { ret = 2; }
        else { ret = 3; }
        return_types.push(ret);
        int instructions_at = ccam_json_schema_find(source, tokens, function_at, "instructions");
        instruction_arrays.push(instructions_at);
        instruction_counts.push(ccam_json_schema_array_count(tokens, instructions_at));
        function_cursor = ccam_json_schema_array_next(tokens, function_cursor);
    }

    function_cursor = functions_at + 1;
    for (int f = 0; f < schema.function_count; f += 1) {
        List<int> regs = register_types_by_function[f];
        int instruction_count = instruction_counts[f];
        int instructions_at = instruction_arrays[f];
        int function_at = function_cursor;
        int instruction_cursor = instructions_at + 1;
        for (int pc = 0; pc < instruction_count; pc += 1) {
            int at = instruction_cursor;
            int op_at = ccam_json_schema_find(source, tokens, at, "op");
            if (ccam_json_schema_string_eq(source, tokens, op_at, "const_i")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                if (!ccam_json_semantic_register(regs, dst, 1)) { return ccam_json_schema_error(60, tokens[at].start); }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "const_b")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                if (!ccam_json_semantic_register(regs, dst, 2)) { return ccam_json_schema_error(61, tokens[at].start); }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "move")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                int src = ccam_json_semantic_field_int(source, tokens, at, "src");
                if (!ccam_json_semantic_register(regs, dst, 0) ||
                    !ccam_json_semantic_register(regs, src, 0) || regs[dst] != regs[src]) {
                    return ccam_json_schema_error(62, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "not_b")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                int src = ccam_json_semantic_field_int(source, tokens, at, "src");
                if (!ccam_json_semantic_register(regs, dst, 2) ||
                    !ccam_json_semantic_register(regs, src, 2)) {
                    return ccam_json_schema_error(63, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "add_i") ||
                       ccam_json_schema_string_eq(source, tokens, op_at, "sub_i") ||
                       ccam_json_schema_string_eq(source, tokens, op_at, "mul_i") ||
                       ccam_json_schema_string_eq(source, tokens, op_at, "div_i") ||
                       ccam_json_schema_string_eq(source, tokens, op_at, "rem_i")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                int lhs = ccam_json_semantic_field_int(source, tokens, at, "lhs");
                int rhs = ccam_json_semantic_field_int(source, tokens, at, "rhs");
                if (!ccam_json_semantic_register(regs, dst, 1) ||
                    !ccam_json_semantic_register(regs, lhs, 1) ||
                    !ccam_json_semantic_register(regs, rhs, 1)) {
                    return ccam_json_schema_error(64, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "eq_i") ||
                       ccam_json_schema_string_eq(source, tokens, op_at, "lt_i")) {
                int dst = ccam_json_semantic_field_int(source, tokens, at, "dst");
                int lhs = ccam_json_semantic_field_int(source, tokens, at, "lhs");
                int rhs = ccam_json_semantic_field_int(source, tokens, at, "rhs");
                if (!ccam_json_semantic_register(regs, dst, 2) ||
                    !ccam_json_semantic_register(regs, lhs, 1) ||
                    !ccam_json_semantic_register(regs, rhs, 1)) {
                    return ccam_json_schema_error(65, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "jump")) {
                int target = ccam_json_semantic_field_int(source, tokens, at, "target");
                if (!ccam_json_semantic_target(target, instruction_count)) {
                    return ccam_json_schema_error(66, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "branch")) {
                int cond = ccam_json_semantic_field_int(source, tokens, at, "cond");
                int yes = ccam_json_semantic_field_int(source, tokens, at, "if_true");
                int no = ccam_json_semantic_field_int(source, tokens, at, "if_false");
                if (!ccam_json_semantic_register(regs, cond, 2) ||
                    !ccam_json_semantic_target(yes, instruction_count) ||
                    !ccam_json_semantic_target(no, instruction_count)) {
                    return ccam_json_schema_error(67, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "call")) {
                int callee_at = ccam_json_schema_find(source, tokens, at, "function");
                Tainted callee_name = ccam_json_schema_decoded_string(source, tokens, callee_at);
                int callee = ccam_json_semantic_function_index(names, callee_name);
                if (callee < 0) { return ccam_json_schema_error(68, tokens[at].start); }
                int args_at = ccam_json_schema_find(source, tokens, at, "args");
                int arg_count = ccam_json_schema_array_count(tokens, args_at);
                if (arg_count != parameter_counts[callee]) {
                    return ccam_json_schema_error(69, tokens[at].start);
                }
                int arg_cursor = args_at + 1;
                for (int a = 0; a < arg_count; a += 1) {
                    int arg = ccam_json_semantic_int(source, tokens, arg_cursor);
                    if (!ccam_json_semantic_register(regs, arg, 0) ||
                        regs[arg] != register_types_by_function[callee][a]) {
                        return ccam_json_schema_error(70, tokens[at].start);
                    }
                    arg_cursor = ccam_json_schema_array_next(tokens, arg_cursor);
                }
                int dst_at = ccam_json_schema_find(source, tokens, at, "dst");
                if (return_types[callee] == 3) {
                    if (!ccam_json_semantic_null(tokens, dst_at)) {
                        return ccam_json_schema_error(71, tokens[at].start);
                    }
                } else {
                    int dst = ccam_json_semantic_int(source, tokens, dst_at);
                    if (ccam_json_semantic_null(tokens, dst_at) ||
                        !ccam_json_semantic_register(regs, dst, return_types[callee])) {
                        return ccam_json_schema_error(72, tokens[at].start);
                    }
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "ret")) {
                int src = ccam_json_semantic_field_int(source, tokens, at, "src");
                if (return_types[f] == 3 ||
                    !ccam_json_semantic_register(regs, src, return_types[f])) {
                    return ccam_json_schema_error(73, tokens[at].start);
                }
            } else if (ccam_json_schema_string_eq(source, tokens, op_at, "ret_void")) {
                if (return_types[f] != 3) { return ccam_json_schema_error(74, tokens[at].start); }
            }
        }
            instruction_cursor = ccam_json_schema_array_next(tokens, instruction_cursor);
        }
        function_cursor = ccam_json_schema_array_next(tokens, function_cursor);
        if (!ccam_json_semantic_reachable_termination(
            source, tokens, instructions_at, instruction_count
        )) {
            return ccam_json_schema_error(75, tokens[function_at].start);
        }
    }

    return schema;
}

test "CCAM whole-program validation checks register types and indices" {
    assert(ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[\"int\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"const_i\",\"dst\":0,\"value\":42},{\"op\":\"ret\",\"src\":0}]}]}")).ok);
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[\"bool\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"const_i\",\"dst\":0,\"value\":42},{\"op\":\"ret\",\"src\":0}]}]}")).ok);
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"ret\",\"src\":0}]}]}")).ok);
}

test "CCAM whole-program validation checks calls and return destinations" {
    Tainted good = taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[\"int\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"call\",\"dst\":0,\"function\":\"answer\",\"args\":[]},{\"op\":\"ret\",\"src\":0}]},{\"name\":\"answer\",\"register_types\":[\"int\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"const_i\",\"dst\":0,\"value\":42},{\"op\":\"ret\",\"src\":0}]}]}");
    assert(ccam_json_validate_program_semantics(good).ok);
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"call\",\"dst\":null,\"function\":\"absent\",\"args\":[]},{\"op\":\"ret_void\"}]}]}")).ok);
}

test "CCAM whole-program validation rejects branch errors and reachable fall-through" {
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"jump\",\"target\":9}]}]}")).ok);
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[\"int\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"const_i\",\"dst\":0,\"value\":1}]}]}")).ok);
    assert(!ccam_json_validate_program_semantics(taint("{\"entry\":\"main\",\"functions\":[{\"name\":\"main\",\"register_types\":[\"bool\"],\"parameter_count\":0,\"return_type\":\"int\",\"instructions\":[{\"op\":\"branch\",\"cond\":0,\"if_true\":1,\"if_false\":2},{\"op\":\"ret_void\"},{\"op\":\"ret_void\"}]}]}")).ok);
}
