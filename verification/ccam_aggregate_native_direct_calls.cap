// Candidate multi-function Linux x86-64 backend. Internal calls carry only
// scalars (int/bool); void has no destination. References remain local to
// their originating function. Every runtime rejection terminates the process.
// R15 = current frame base; RBP = remaining language depth; RBX = shared fuel.
// R12-R14 are shared arena state. The caller owns and restores each frame.
// Fixed 256-slot maximum and 32 active language frames bound stack use.
// No external ABI, canonical fuel equivalence, or complete compiler claim.
import "ccam_aggregate_native_record_lowering.cap";
import "ccam_aggregate_sealed_program.cap";

const int AG_NVC_MAX_FUNCTIONS = 32;
const int AG_NVC_MAX_DEPTH = 32;

bool ag_nvc_admit(List<AGFunction> functions, int entry, List<int> layouts) {
    if (functions.len() == 0 || functions.len() > AG_NVC_MAX_FUNCTIONS ||
        entry < 0 || entry >= functions.len() || layouts.len() != 0) { return false; }
    if (functions[entry].signature.parameters.len() != 0 ||
        functions[entry].signature.result_kind != AG_SCHEMA_INT) { return false; }
    for (int i = 0; i <= 4096; i += 1) { layouts.push(-1); }
    int blocks = 0; int instructions = 0; int operands = 0;
    for (int i = 0; i < functions.len(); i += 1) {
        AGFunction f = functions[i];
        if (f.blocks.len() > AG_NV_MAX_BLOCKS - blocks ||
            !ag_nv_admit_function(f, layouts, true)) { return false; }
        blocks += f.blocks.len();
        for (int j = 0; j < f.blocks.len(); j += 1) {
            AGCFGBlock b = f.blocks[j];
            if (b.instructions.len() > AG_NV_MAX_INS - instructions) { return false; }
            instructions += b.instructions.len();
            for (int k = 0; k < b.instructions.len(); k += 1) {
                if (b.instructions[k].operands.len() > AG_NV_MAX_OPERANDS - operands) { return false; }
                operands += b.instructions[k].operands.len();
            }
        }
    }
    for (int i = 0; i < functions.len(); i += 1) {
        if (!ag_nv_check_layouts(functions[i], layouts)) { return false; }
    }
    return ag_program_validate(functions) && ag_seal_validate_edges(functions);
}

bool ag_nvc_stack_adjust(List<int> b, bool allocate, int slots) {
    if (slots < 0 || slots > AG_NV_MAX_REGS || b.len() > AG_BYTE_LIMIT - 7) { return false; }
    b.push(72); b.push(129);
    if (allocate) { b.push(236); } else { b.push(196); }
    return ag_u32(b, slots * 8);
}

// R15 remains the caller base during argument copying. No callee code
// executes until the new frame is established and all parameter words copied.
bool ag_nvc_enter(AGNVContext c, int label, int slots, List<int> args) {
    List<int> b = c.code;
    if (args.len() > slots || b.len() > AG_BYTE_LIMIT - 64 - args.len() * 16) { return false; }
    b.push(72); b.push(255); b.push(205); // dec rbp
    if (!ag_nv_edge(c, 136, c.trap)) { return false; } // js
    b.push(65); b.push(87); // push r15
    if (!ag_nvc_stack_adjust(b, true, slots)) { return false; }
    for (int i = 0; i < args.len(); i += 1) {
        if (!ag_nv_slot(b, false, 0, args[i])) { return false; }
        b.push(72); b.push(137); b.push(132); b.push(36); // mov [rsp+disp32],rax
        if (!ag_u32(b, i * 8)) { return false; }
    }
    b.push(73); b.push(137); b.push(231); // mov r15,rsp
    if (!ag_nv_edge(c, 1, label) || !ag_nvc_stack_adjust(b, false, slots)) { return false; }
    b.push(65); b.push(95); // pop r15
    b.push(72); b.push(255); b.push(197); // inc rbp
    return true;
}

bool ag_nvc_instruction(AGNVContext c, AGBlockInstruction ins,
    List<AGFunction> functions, List<int> starts) {
    if (ins.opcode != AG_OP_DIRECT_CALL) { return ag_nv_instruction(c, ins); }
    if (!ag_nv_fuel(c)) { return false; }
    int id = ins.operands[1];
    List<int> args = new List<int>();
    for (int i = 2; i < ins.operands.len(); i += 1) { args.push(ins.operands[i]); }
    if (!ag_nvc_enter(c, starts[id], functions[id].kinds.len(), args)) { return false; }
    if (ins.kind == AG_RESULT_VOID) { return true; }
    return ag_nv_slot(c.code, true, 0, ins.operands[0]);
}

bool ag_nvc_function(AGNVContext c, List<AGFunction> functions, List<int> starts, int id) {
    AGFunction f = functions[id]; List<int> b = c.code;
    int start = starts[id];
    for (int i = 0; i < f.blocks.len(); i += 1) {
        c.labels[start + i] = b.len();
        AGCFGBlock block = f.blocks[i];
        for (int j = 0; j < block.instructions.len(); j += 1) {
            if (!ag_nvc_instruction(c, block.instructions[j], functions, starts)) { return false; }
        }
        if (b.len() > AG_BYTE_LIMIT - 256 || !ag_nv_fuel(c)) { return false; }
        if (block.terminator == 0) {
            if (f.signature.result_kind != AG_RESULT_VOID) {
                if (!ag_nv_slot(b, false, 0, f.returns[i])) { return false; }
            } else { b.push(49); b.push(192); }
            b.push(195); // ret, caller restores frame and depth
        } else if (block.terminator == 1) {
            if (!ag_nv_edge(c, 0, start + block.yes)) { return false; }
        } else {
            if (!ag_nv_slot(b, false, 0, block.condition)) { return false; }
            b.push(72); b.push(133); b.push(192);
            if (!ag_nv_edge(c, 133, start + block.yes) || !ag_nv_edge(c, 0, start + block.no)) { return false; }
        }
    }
    return true;
}

AGImage ag_nvc_compile(List<AGFunction> functions, int entry, int fuel, int depth) {
    List<int> layouts = new List<int>();
    if (fuel < 1 || fuel > AG_NV_MAX_FUEL || depth < 1 || depth > AG_NVC_MAX_DEPTH ||
        !ag_nvc_admit(functions, entry, layouts)) { return ag_nv_failure(); }
    List<int> starts = new List<int>();
    int count = 0;
    for (int i = 0; i < functions.len(); i += 1) {
        starts.push(count); count += functions[i].blocks.len();
    }
    AGNVContext c = new AGNVContext{code: new List<int>(), patches: new List<int>(),
        targets: new List<int>(), labels: new List<int>(), layouts: layouts, trap: count};
    for (int i = 0; i < count + 6; i += 1) { c.labels.push(-1); }
    List<int> b = c.code;
    // Root scratch frame is not a language call; entry consumes one depth.
    if (!ag_nvc_stack_adjust(b, true, 1)) { return ag_nv_failure(); }
    b.push(73); b.push(137); b.push(231);
    if (!ag_nv_imm(b, 12, 0) || !ag_nv_imm(b, 13, 0) || !ag_nv_imm(b, 14, 0) ||
        !ag_nv_imm(b, 3, fuel) || !ag_nv_imm(b, 5, depth) ||
        !ag_nv_imm(b, 0, AG_NATIVE_SCALAR_RECORD_MAX_CAPACITY) || !ag_nv_call(c, count + 1) ||
        !ag_nvc_enter(c, starts[entry], functions[entry].kinds.len(), new List<int>()) ||
        !ag_nv_slot(b, true, 0, 0) || !ag_nv_return(c, 0, 0)) { return ag_nv_failure(); }
    for (int i = 0; i < functions.len(); i += 1) {
        if (!ag_nvc_function(c, functions, starts, i)) { return ag_nv_failure(); }
    }
    c.labels[count] = b.len(); if (!ag_exit_code(b, 1)) { return ag_nv_failure(); }
    c.labels[count + 1] = b.len(); if (!ag_native_emit_arena_init(b)) { return ag_nv_failure(); }
    c.labels[count + 2] = b.len(); if (!ag_native_emit_arena_release(b)) { return ag_nv_failure(); }
    c.labels[count + 3] = b.len(); if (!ag_native_emit_scalar_record_alloc(b)) { return ag_nv_failure(); }
    c.labels[count + 4] = b.len(); if (!ag_native_emit_guarded_record_access(b, false)) { return ag_nv_failure(); }
    c.labels[count + 5] = b.len(); if (!ag_native_emit_guarded_record_access(b, true)) { return ag_nv_failure(); }
    for (int i = 0; i < c.patches.len(); i += 1) {
        int target = c.labels[c.targets[i]];
        if (target < 0 || !ag_rel32(b, c.patches[i], target)) { return ag_nv_failure(); }
    }
    return ag_nv_image(b);
}
