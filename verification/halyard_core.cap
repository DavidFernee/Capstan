// Halyard Core MC1 first vertical-slice regression suite.
// Run: bin/capstan test verification/halyard_core.cap

import "../lib/halyard/core.cap";

int main() {
    List<int> input = new List<int>();
    input.push(1); input.push(2); input.push(3); input.push(4);
    HalyardByteSourceResult created = halyard_source_from_list(input, 4);
    if (!created.ok) { return 1; }
    if (let source = created.source) {
        input[0] = 99; // the source owns a defensive snapshot
        HalyardReadResult first = halyard_read_u8(source);
        if (!(first.ok && first.value == 1)) { return 2; }
        HalyardReadResult word = halyard_read_u32_be(source);
        if (!( !word.ok && word.error == "truncated")) { return 3; }
        if (halyard_source_remaining(source) != 3) { return 4; }
        HalyardBytesResult rest = halyard_read_exact(source, 3);
        if (!rest.ok || rest.bytes.len() != 3) { return 5; }
        if (!(rest.bytes[0] == 2 && rest.bytes[1] == 3 && rest.bytes[2] == 4)) { return 6; }
        if (halyard_source_remaining(source) != 0) { return 7; }
        HalyardReadResult eof = halyard_read_u8(source);
        if (!( !eof.ok && eof.error == "eof")) { return 8; }
        if (!halyard_source_close(source)) { return 9; }
        HalyardReadResult closed = halyard_read_u8(source);
        if (!( !closed.ok && closed.error == "closed")) { return 10; }
    } else { return 11; }

    List<int> big_endian = new List<int>();
    big_endian.push(1); big_endian.push(2); big_endian.push(3); big_endian.push(4);
    HalyardByteSourceResult word_source_result = halyard_source_from_list(big_endian, 4);
    if (!word_source_result.ok) { return 12; }
    if (let word_source = word_source_result.source) {
        HalyardReadResult word = halyard_read_u32_be(word_source);
        if (!(word.ok && word.value == 16909060)) { return 13; }
    } else { return 14; }

    List<int> invalid = new List<int>();
    invalid.push(256);
    if (halyard_source_from_list(invalid, 1).ok) { return 15; }
    if (halyard_source_from_list(big_endian, 3).ok) { return 16; }
    if (halyard_source_from_list(big_endian, -1).ok) { return 17; }

    HalyardLedgerResult ledger_result = halyard_ledger_create(10, 20, 30, 40, 50);
    if (!ledger_result.ok) { return 18; }
    if (let ledger = ledger_result.ledger) {
        HalyardBudgetCharge exact = new HalyardBudgetCharge{
            input_bytes: 10, retained_bytes: 20, output_bytes: 30,
            decoded_units: 40, work_units: 50
        };
        if (!halyard_ledger_reserve(ledger, exact)) { return 19; }
        HalyardBudgetCharge one_more = new HalyardBudgetCharge{
            input_bytes: 1, retained_bytes: 0, output_bytes: 0,
            decoded_units: 0, work_units: 0
        };
        if (halyard_ledger_reserve(ledger, one_more)) { return 20; }
        // Failed multi-dimensional reservation must leave every counter intact.
        if (!(ledger.used_input_bytes == 10 &&
              ledger.used_retained_bytes == 20 &&
              ledger.used_output_bytes == 30 &&
              ledger.used_decoded_units == 40 &&
              ledger.used_work_units == 50)) { return 21; }
        HalyardBudgetCharge release = new HalyardBudgetCharge{
            input_bytes: 10, retained_bytes: 20, output_bytes: 30,
            decoded_units: 40, work_units: 50
        };
        if (!halyard_ledger_release(ledger, release)) { return 22; }
        if (!(ledger.used_input_bytes == 0 &&
              ledger.used_retained_bytes == 0 &&
              ledger.used_output_bytes == 0 &&
              ledger.used_decoded_units == 0 &&
              ledger.used_work_units == 0)) { return 23; }
        if (halyard_ledger_release(ledger, release)) { return 24; }
        if (!(ledger.used_input_bytes == 0 && ledger.used_work_units == 0)) { return 25; }
        HalyardBudgetCharge negative = new HalyardBudgetCharge{
            input_bytes: -1, retained_bytes: 0, output_bytes: 0,
            decoded_units: 0, work_units: 0
        };
        if (halyard_ledger_reserve(ledger, negative)) { return 26; }
    } else { return 27; }

    if (halyard_ledger_create(-1, 0, 0, 0, 0).ok) { return 28; }
    println("Halyard Core bounded source and ledger: ok");
    return 0;
}
