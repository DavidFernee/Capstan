import "ccam_aggregate_register_allocation_validator.cap";

bool assurance_allowed_register(int r) {
    return r == 0 || r == 1 || r == 2 || r == 6 || r == 7 ||
        r == 8 || r == 9 || r == 10 || r == 11;
}

// Independent quadratic checker for small inputs. It uses pairwise overlap,
// rather than sorting and the production validator's last-end mechanism.
bool assurance_allocation_oracle(List<AGLiveInterval> intervals, AGAllocationResult result) {
    if (!result.ok || result.assignments.len() != intervals.len() ||
        result.spill_count < 0 || result.spill_count > intervals.len()) { return false; }
    int spills = 0;
    for (int i = 0; i < intervals.len(); i += 1) {
        int found = -1;
        for (int j = 0; j < result.assignments.len(); j += 1) {
            if (result.assignments[j].virtual_id == intervals[i].virtual_id) {
                if (found >= 0) { return false; }
                found = j;
            }
        }
        if (found < 0) { return false; }
        AGRegisterAssignment a = result.assignments[found];
        if (a.physical_reg == -1) {
            if (a.spill_slot < 0 || a.spill_slot >= result.spill_count) { return false; }
            spills += 1;
        } else if (!assurance_allowed_register(a.physical_reg) || a.spill_slot != -1) { return false; }
        for (int k = 0; k < i; k += 1) {
            for (int j = 0; j < result.assignments.len(); j += 1) {
                AGRegisterAssignment b = result.assignments[j];
                if (b.virtual_id == intervals[k].virtual_id) {
                    if (a.physical_reg == -1 && b.physical_reg == -1 && a.spill_slot == b.spill_slot) { return false; }
                    if (a.physical_reg >= 0 && a.physical_reg == b.physical_reg &&
                        intervals[i].start < intervals[k].end && intervals[k].start < intervals[i].end) { return false; }
                }
            }
        }
    }
    return spills == result.spill_count;
}

test "allocator pressure and input permutation preserve exact deterministic assignments" {
    for (int count = 1; count <= 20; count += 1) {
        for (int pattern = 0; pattern < 32; pattern += 1) {
            List<AGLiveInterval> forward = new List<AGLiveInterval>();
            List<AGLiveInterval> reverse = new List<AGLiveInterval>();
            for (int i = 0; i < count; i += 1) {
                int start = i % (1 + pattern % 5);
                int end = start + 1 + (i * 7 + pattern) % 12;
                forward.push(new AGLiveInterval{virtual_id: i, start: start, end: end});
            }
            for (int i = count - 1; i >= 0; i -= 1) { reverse.push(forward[i]); }
            AGAllocationResult a = ag_linear_scan_allocate(forward);
            AGAllocationResult b = ag_linear_scan_allocate(reverse);
            assert(assurance_allocation_oracle(forward, a));
            assert(assurance_allocation_oracle(reverse, b));
            assert(ag_allocation_validate(forward, a) && ag_allocation_validate(reverse, b));
            assert(a.spill_count == b.spill_count);
            for (int i = 0; i < count; i += 1) {
                assert(a.assignments[i].virtual_id == b.assignments[i].virtual_id);
                assert(a.assignments[i].physical_reg == b.assignments[i].physical_reg);
                assert(a.assignments[i].spill_slot == b.assignments[i].spill_slot);
                assert(forward[i].virtual_id == i && reverse[i].virtual_id == count - 1 - i);
            }
        }
    }
}

test "allocation validator matches independent oracle for forged assignment pairs" {
    for (int overlap = 0; overlap <= 1; overlap += 1) {
        List<AGLiveInterval> intervals = new List<AGLiveInterval>();
        intervals.push(new AGLiveInterval{virtual_id: 0, start: 0, end: 2});
        intervals.push(new AGLiveInterval{virtual_id: 1, start: 2 - overlap, end: 4});
        for (int r0 = -2; r0 <= 16; r0 += 1) {
            for (int r1 = -2; r1 <= 16; r1 += 1) {
                for (int s0 = -1; s0 <= 2; s0 += 1) {
                    for (int s1 = -1; s1 <= 2; s1 += 1) {
                        for (int count = 0; count <= 2; count += 1) {
                            List<AGRegisterAssignment> assignments = new List<AGRegisterAssignment>();
                            assignments.push(new AGRegisterAssignment{virtual_id: 0, physical_reg: r0, spill_slot: s0});
                            assignments.push(new AGRegisterAssignment{virtual_id: 1, physical_reg: r1, spill_slot: s1});
                            AGAllocationResult candidate = new AGAllocationResult{ok: true, spill_count: count, assignments: assignments};
                            assert(ag_allocation_validate(intervals, candidate) ==
                                assurance_allocation_oracle(intervals, candidate));
                        }
                    }
                }
            }
        }
    }
}
