import "ccam_aggregate_invoke.cap";

CCAMHeapLayout ag_nominal_test_layout(int descriptor) {
    return new CCAMHeapLayout{type_id: descriptor, field_types: new List<int>(),
        field_ref_type_ids: new List<int>(), field_mutable: new List<bool>()};
}

AGNominalSignature ag_nominal_test_signature(int argument_descriptor, int result_descriptor) {
    List<int> parameters = new List<int>();
    parameters.push(AG_SCHEMA_REF);
    List<int> descriptors = new List<int>();
    descriptors.push(argument_descriptor);
    return new AGNominalSignature{
        coarse: new AGCallSignature{parameters: parameters, result_kind: AG_SCHEMA_REF},
        parameter_descriptors: descriptors, result_descriptor: result_descriptor
    };
}

test "nominal invocation returns the same arena reference through a real continuation" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 16);
    assert(root.ok);
    assert(ccam_aggregate_alloc_record(root.machine, 0, ag_nominal_test_layout(7)) == "");
    assert(ccam_aggregate_alloc_record(root.machine, 1, ag_nominal_test_layout(8)) == "");
    AGNominalSignature signature = ag_nominal_test_signature(7, 7);
    List<int> callee_kinds = new List<int>();
    callee_kinds.push(AG_SCHEMA_REF);
    List<AGCFGBlock> blocks = new List<AGCFGBlock>();
    blocks.push(new AGCFGBlock{instructions: new List<AGBlockInstruction>(),
        terminator: 0, condition: -1, yes: -1, no: -1});
    List<int> returns = new List<int>();
    returns.push(0);
    List<AGFunction> functions = new List<AGFunction>();
    functions.push(new AGFunction{signature: signature.coarse,
        kinds: callee_kinds, blocks: blocks, returns: returns});
    List<int> arguments = new List<int>();
    arguments.push(0);
    AGStackResult created = ag_stack_create(root.machine, 4, 16);
    assert(created.ok);
    AGStack stack = created.stack;
    assert(ag_nominal_invoke(stack, functions, 0, signature, arguments, 1) == "");
    assert(stack.depth == 0 && stack.slots == 2);
    assert(stack.active.steps == 5);
    CCAMAggregateValueResult returned = ccam_aggregate_read(stack.active, 1, AG_SCHEMA_REF);
    assert(returned.ok && ccam_heap_value_has_type(stack.active.heap, returned.value, AG_SCHEMA_REF, 7));
}

test "nominal stack rejects incompatible result atomically and snapshots return descriptor" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 16);
    assert(root.ok);
    assert(ccam_aggregate_alloc_record(root.machine, 0, ag_nominal_test_layout(7)) == "");
    assert(ccam_aggregate_alloc_record(root.machine, 1, ag_nominal_test_layout(8)) == "");
    AGStackResult created = ag_stack_create(root.machine, 4, 16);
    assert(created.ok);
    AGStack stack = created.stack;
    AGNominalSignature signature = ag_nominal_test_signature(7, 7);
    List<int> args = new List<int>(); args.push(0);
    assert(ag_stack_nominal_call(stack, signature, kinds, args, 1) == "");
    signature.result_descriptor = 9;
    assert(ccam_aggregate_alloc_record(stack.active, 1, ag_nominal_test_layout(9)) == "");
    assert(ag_stack_return(stack, 1) == "return_descriptor_mismatch");
    assert(stack.depth == 0 && stack.slots == 2);
    CCAMAggregateValueResult preserved = ccam_aggregate_read(stack.active, 1, AG_SCHEMA_REF);
    assert(preserved.ok && ccam_heap_value_has_type(stack.active.heap, preserved.value, AG_SCHEMA_REF, 8));
}

test "collection call contracts distinguish scalar arrays record arrays and bytes" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 32);
    assert(root.ok);
    CCAMAggregateMachine machine = root.machine;
    assert(ccam_aggregate_alloc_array(machine, 0, AG_SCHEMA_INT, 0, 2) == "");
    assert(ccam_aggregate_alloc_array(machine, 1, AG_SCHEMA_BOOL, 0, 2) == "");
    assert(ccam_aggregate_alloc_array(machine, 2, AG_SCHEMA_REF, 7, 2) == "");
    assert(ccam_aggregate_alloc_array(machine, 3, AG_SCHEMA_REF, 8, 2) == "");
    assert(ccam_aggregate_alloc_bytes(machine, 4, "abc") == "");
    int nodes = ag_nominal_record_array(7);
    assert(nodes == -10 && ag_nominal_record_array(0) == 0);
    List<int> shapes = new List<int>();
    shapes.push(AG_NOMINAL_INT_ARRAY); shapes.push(AG_NOMINAL_BOOL_ARRAY);
    shapes.push(nodes); shapes.push(ag_nominal_record_array(8));
    shapes.push(AG_NOMINAL_BYTES);
    for (int i = 0; i < kinds.len(); i += 1) {
        CCAMAggregateValueResult value = ccam_aggregate_read(machine, i, AG_SCHEMA_REF);
        assert(value.ok);
        for (int j = 0; j < shapes.len(); j += 1) {
            assert(ag_nominal_value_matches(machine.heap, value.value, AG_SCHEMA_REF, shapes[j]) == (i == j));
        }
        assert(!ag_nominal_value_matches(machine.heap, value.value, AG_SCHEMA_REF, 7));
    }
    List<int> args = new List<int>(); args.push(3);
    AGNominalSignature signature = ag_nominal_test_signature(nodes, nodes);
    int before = machine.steps;
    AGFrameResult rejected = ag_nominal_open(machine, signature, kinds, args, 4, 5);
    assert(!rejected.ok && rejected.error == "argument_descriptor_mismatch");
    assert(machine.steps == before && machine.trap_code == "");
    args[0] = 2;
    AGStackResult created = ag_stack_create(machine, 4, 16);
    assert(created.ok);
    assert(ag_stack_nominal_call(created.stack, signature, kinds, args, 4) == "");
    assert(ag_stack_return(created.stack, 0) == "");
    CCAMAggregateValueResult result = ccam_aggregate_read(created.stack.active, 4, AG_SCHEMA_REF);
    assert(result.ok && ag_nominal_value_matches(machine.heap, result.value, AG_SCHEMA_REF, nodes));
}

test "collection return mismatch preserves existing caller destination" {
    List<int> kinds = new List<int>(); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult root = ccam_aggregate_create(kinds, 4096, 16, 4096, 4096, 16);
    assert(root.ok);
    assert(ccam_aggregate_alloc_array(root.machine, 0, AG_SCHEMA_INT, 0, 2) == "");
    assert(ccam_aggregate_alloc_bytes(root.machine, 1, "preserve") == "");
    AGNominalSignature signature = ag_nominal_test_signature(AG_NOMINAL_INT_ARRAY, AG_NOMINAL_INT_ARRAY);
    List<int> args = new List<int>(); args.push(0);
    AGStackResult created = ag_stack_create(root.machine, 4, 16);
    assert(created.ok);
    assert(ag_stack_nominal_call(created.stack, signature, kinds, args, 1) == "");
    assert(ccam_aggregate_alloc_array(created.stack.active, 1, AG_SCHEMA_BOOL, 0, 2) == "");
    assert(ag_stack_return(created.stack, 1) == "return_descriptor_mismatch");
    assert(created.stack.depth == 0 && created.stack.slots == 2);
    CCAMAggregateValueResult preserved = ccam_aggregate_read(created.stack.active, 1, AG_SCHEMA_REF);
    assert(preserved.ok && ag_nominal_value_matches(root.machine.heap, preserved.value, AG_SCHEMA_REF, AG_NOMINAL_BYTES));
}
