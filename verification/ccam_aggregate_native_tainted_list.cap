test "native tainted list emits exact private leaf" {
    List<int> b = new List<int>();
    assert(ag_native_emit_tainted_list(b));
    assert(b.len() == AG_NATIVE_TAINTED_LIST_SIZE);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-tainted-list.bin", data));
}
