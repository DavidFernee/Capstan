// Candidate Linux x86-64 native tainted-list operations, private SysV ABI.
// RDI=arena base, RSI=used extent, RDX=receiver offset, RCX=mode,
// R8=index, R9=payload offset. RAX=value, RDX=status.
// Modes 0 len, 1 get, 2 set, 3 push, 4 discarded pop (empty is no-op).
// Exact list tag 1024, 257 pairs; exact payload tag 2045 and canonical
// bytes/readiness. Membership precedes access; zero is a valid offset.
// Caller owns valid exclusive mapped backing and immutable headers.
// Reject without writes, clear retired slots, publish length last.
// No source lowering or canonical ABI claim.
// Reference: research/native-bootstrap/tainted-list-leaf.S.
import "ccam_aggregate_byte_buffer.cap";

