// Candidate reference-element list leaf. RAX=receiver offset, RDI=mode
// (0 len,1 get,2 set,3 push,4 discarded pop), R8=index,R9=payload.
// List tag 2048+record ID (1..2044), or 4093 for string elements.
// Membership precedes all metadata/payload accesses. Get and set/push
// require payload tag matching receiver's element type. Fixed extent
// 257 pairs, 256 elements. Pop clears retired slot. No writes on failure.
// RAX=result,RDX=status. RBX/RBP/R12-R15 preserved. Trusted mapped arena,
// immutable headers, single-threaded process lifetime. No canonical ABI.
// Private membership guard appended at exact offset 363.
import "ccam_aggregate_native_record_boundary.cap";

bool ag_nv_emit_reference_list(List<int> b) {
    if (b.len() > AG_BYTE_LIMIT - 363 - AG_NATIVE_RECORD_BOUNDARY_SIZE) { return false; }
