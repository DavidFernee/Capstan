test "indexed arena allocation and constant-work membership leaf extents" {
    List<int> b = new List<int>();
    assert(ag_native_emit_indexed_arena(b));
    assert(AG_INDEXED_ARENA_GUARD_OFFSET == 138 && b.len() == 350);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-indexed-arena.bin", data));
}
