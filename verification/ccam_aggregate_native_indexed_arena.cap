// Opt-in candidate indexed arena prototype, Linux x86-64, not canonical.
// R12=arena base (16-byte aligned), R13=committed bytes, R14=capacity
// (positive multiple of 1024, <=64 MiB). RDI=bitmap base (8-byte aligned),
// RSI=exact bitmap length capacity/128. Disjoint live backing mappings,
// exclusively owned and zero-initialised at creation. All allocations MUST
// maintain this index; no raw reservations, old leaves, freeing or concurrency.
// One bit per 16-byte object-start slot. The bitmap is trusted private
// metadata, never writable through language-level operations. Numeric checks
// do not prove OS mapping, ownership, bitmap integrity or lifetime.
// Allocation entry: RAX=descriptor 1..4096, R8=count 0..4096.
// Before first write, checks metadata, extent and unused start bit.
// Initializes header and pairs, sets bit, publishes cursor last.
// Guard entry: RAX=offset; constant-work metadata, alignment, committed
// range, bitmap bit, tag/count and extent validation. No arena scan.
// RDX=0 success or 1 rejection; allocation returns offset/zero on failure;
// guard preserves RAX. R12/R14/RBX/RBP/R15 and bitmap arguments preserved;
// R13 advances only on successful allocation. RCX/R9-R11/flags clobbered.
// These routines MUST NOT be mixed with existing unindexed allocations.
import "ccam_aggregate_byte_buffer.cap";

const int AG_INDEXED_ARENA_CAPACITY = 67108864;
const int AG_INDEXED_ARENA_GUARD_OFFSET = 138;
const int AG_INDEXED_ARENA_LEAF_SIZE = 350;

