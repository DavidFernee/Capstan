// Recognise only the supported keywords, after validating the complete span.
bool ag_keyword(List<int> b,int s,int e) {
    if (s < 0 || e < s || e > b.len()) { return false; }
    if (e - s == 5) {
        return b[s] == 119 && b[s+1] == 104 && b[s+2] == 105 &&
            b[s+3] == 108 && b[s+4] == 101;
    }
    if (e - s == 6) {
        return b[s] == 114 && b[s+1] == 101 && b[s+2] == 116 &&
            b[s+3] == 117 && b[s+4] == 114 && b[s+5] == 110;
    }
    return false;
}
