// Candidate nominal record call boundary, layered over existing aggregate frames.
// Candidate shape encoding: zero for scalars; positive record descriptor IDs;
// -1 bytes, -2 int arrays, -3 bool arrays, -(record descriptor + 3) record arrays.
// Nested arrays and maps remain outside this candidate profile.
import "ccam_aggregate_frames.cap";

struct AGNominalSignature {
    AGCallSignature coarse;
    List<int> parameter_descriptors;
    int result_descriptor;
}

const int AG_NOMINAL_BYTES = -1;
const int AG_NOMINAL_INT_ARRAY = -2;
const int AG_NOMINAL_BOOL_ARRAY = -3;
const int AG_NOMINAL_STRING_ARRAY = -4100;
const int AG_NOMINAL_TAINTED_ARRAY = -4101;
// Distinct immutable tainted byte value; never a trusted byte or record array.
const int AG_NOMINAL_TAINTED = -4102;

// A zero result indicates an unrepresentable array descriptor, never a reference type.
int ag_nominal_record_array(int descriptor) {
    if (descriptor <= 0 || descriptor > AG_OPTIONAL_RECORD_MAX) { return 0; }
    return -descriptor - 3;
}

bool ag_nominal_kind(int kind, int descriptor) {
    if (kind == AG_SCHEMA_REF) {
        return (descriptor > 0 && descriptor <= AG_OPTIONAL_RECORD_MAX) ||
            (descriptor < 0 && descriptor >= -AG_OPTIONAL_RECORD_MAX - 3) || descriptor == AG_NOMINAL_STRING_ARRAY ||
            descriptor == AG_NOMINAL_TAINTED_ARRAY || descriptor == AG_NOMINAL_TAINTED ||
            (ccam_heap_optional_descriptor(descriptor) || ccam_heap_map_descriptor(descriptor));
    }
    return (kind == AG_SCHEMA_INT || kind == AG_SCHEMA_BOOL) && descriptor == 0;
}

bool ag_nominal_value_matches(CCAMHeap heap, CCAMHeapValue value, int kind, int descriptor) {
    if (!ag_nominal_kind(kind, descriptor) || value.kind != kind) { return false; }
    if (kind == AG_SCHEMA_REF && ccam_heap_map_descriptor(descriptor)) {
        return ccam_heap_map_matches(heap, value, descriptor);
    }
    if (kind == AG_SCHEMA_REF && ccam_heap_optional_descriptor(descriptor)) {
        return ccam_heap_optional_matches(heap, value, descriptor);
    }
    if (kind != AG_SCHEMA_REF || descriptor > 0) {
        return ccam_heap_value_has_type(heap, value, kind, descriptor);
    }
    if (descriptor == AG_NOMINAL_BYTES) {
        return ccam_heap_value_is_bytes(heap, value);
    }
    if (descriptor == AG_NOMINAL_TAINTED) {
        return ccam_heap_value_has_type(heap, value, AG_SCHEMA_REF, CCAM_HEAP_ELEMENT_TAINTED);
    }
    if (descriptor == AG_NOMINAL_INT_ARRAY) {
        return ccam_heap_value_has_array_type(heap, value, AG_SCHEMA_INT, 0);
    }
    if (descriptor == AG_NOMINAL_BOOL_ARRAY) {
        return ccam_heap_value_has_array_type(heap, value, AG_SCHEMA_BOOL, 0);
    }
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) {
        return ccam_heap_value_has_array_type(heap, value, AG_SCHEMA_REF, CCAM_HEAP_ELEMENT_TAINTED);
    }
    if (descriptor == AG_NOMINAL_STRING_ARRAY) {
        return ccam_heap_value_has_array_type(heap, value, AG_SCHEMA_REF, CCAM_HEAP_ELEMENT_BYTES);
    }
    // Addition before negation avoids negating the signed minimum.
    return ccam_heap_value_has_array_type(heap, value, AG_SCHEMA_REF, -(descriptor + 3));
}

bool ag_nominal_signature(AGNominalSignature signature) {
    if (!ag_call_signature(signature.coarse) ||
        signature.parameter_descriptors.len() != signature.coarse.parameters.len() ||
        !(ag_nominal_kind(signature.coarse.result_kind, signature.result_descriptor) ||
            (signature.coarse.result_kind == AG_RESULT_VOID && signature.result_descriptor == 0))) {
        return false;
    }
    for (int i = 0; i < signature.parameter_descriptors.len(); i += 1) {
        if (!ag_nominal_kind(signature.coarse.parameters[i],
            signature.parameter_descriptors[i])) { return false; }
    }
    return true;
}

AGFrameResult ag_nominal_open(CCAMAggregateMachine caller, AGNominalSignature signature,
    List<int> callee_kinds, List<int> arguments, int destination, int remaining_slots) {
    if (caller.trap_code != "") {
        return new AGFrameResult{ok: false, frame: caller, error: caller.trap_code};
    }
    if (!ag_nominal_signature(signature) ||
        arguments.len() != signature.coarse.parameters.len()) {
        return new AGFrameResult{ok: false, frame: caller, error: "invalid_call"};
    }
    for (int i = 0; i < arguments.len(); i += 1) {
        CCAMAggregateValueResult value = ccam_aggregate_read(
            caller, arguments[i], signature.coarse.parameters[i]);
        if (!value.ok) {
            return new AGFrameResult{ok: false, frame: caller, error: value.trap};
        }
        if (!ag_nominal_value_matches(caller.heap, value.value,
            signature.coarse.parameters[i], signature.parameter_descriptors[i])) {
            return new AGFrameResult{ok: false, frame: caller, error: "argument_descriptor_mismatch"};
        }
    }
    return ag_frame_open(caller, signature.coarse, callee_kinds,
        arguments, destination, remaining_slots);
}

// Candidate preflight only. The trusted stack controller must retain the
// matching caller, callee and signature; this helper does not authenticate them.
bool ag_nominal_result_matches(CCAMAggregateMachine callee,
    AGNominalSignature signature, int source) {
    if (!ag_nominal_signature(signature) || callee.trap_code != "") { return false; }
    if (signature.coarse.result_kind == AG_RESULT_VOID) { return source == -1; }
    CCAMAggregateValueResult value = ccam_aggregate_read(
        callee, source, signature.coarse.result_kind);
    return value.ok && ag_nominal_value_matches(callee.heap, value.value,
        signature.coarse.result_kind, signature.result_descriptor);
}

test "nominal aggregate calls reject wrong record before opening a frame" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF);
    CCAMAggregateCreateResult created = ccam_aggregate_create(
        kinds, 4096, 16, 4096, 4096, 16);
    assert(created.ok);
    CCAMAggregateMachine caller = created.machine;
    CCAMHeapLayout node = new CCAMHeapLayout{
        type_id: 7, field_types: new List<int>(),
        field_ref_type_ids: new List<int>(), field_mutable: new List<bool>()
    };
    CCAMHeapLayout budget = new CCAMHeapLayout{
        type_id: 8, field_types: new List<int>(),
        field_ref_type_ids: new List<int>(), field_mutable: new List<bool>()
    };
    assert(ccam_aggregate_alloc_record(caller, 0, node) == "");
    assert(ccam_aggregate_alloc_record(caller, 1, budget) == "");
    List<int> parameters = new List<int>();
    parameters.push(AG_SCHEMA_REF);
    List<int> descriptors = new List<int>();
    descriptors.push(7);
    AGNominalSignature signature = new AGNominalSignature{
        coarse: new AGCallSignature{parameters: parameters, result_kind: AG_SCHEMA_REF},
        parameter_descriptors: descriptors, result_descriptor: 7
    };
    List<int> arguments = new List<int>();
    arguments.push(1);
    int before = caller.steps;
    AGFrameResult rejected = ag_nominal_open(caller, signature, kinds, arguments, 1, 2);
    assert(!rejected.ok && rejected.error == "argument_descriptor_mismatch");
    assert(caller.steps == before && caller.trap_code == "");
    arguments[0] = 0;
    AGFrameResult accepted = ag_nominal_open(caller, signature, kinds, arguments, 1, 2);
    assert(accepted.ok);
    assert(ag_nominal_result_matches(accepted.frame, signature, 0));
    assert(!ag_nominal_result_matches(accepted.frame, signature, 1));
    assert(ccam_aggregate_alloc_record(accepted.frame, 1, budget) == "");
    assert(!ag_nominal_result_matches(accepted.frame, signature, 1));
    descriptors[0] = 0;
    assert(!ag_nominal_signature(signature));
}

test "nominal call shapes distinguish tainted bytes from trusted strings and lists" {
    CCAMHeapCreateResult created = ccam_heap_create(4096, 32);
    assert(created.ok);
    CCAMHeap heap = created.heap;
    CCAMHeapRefResult trusted = ccam_heap_alloc_bytes(heap, "abc");
    assert(trusted.ok);
    CCAMHeapRefResult tainted = ccam_heap_taint_bytes(heap, trusted.reference);
    CCAMHeapRefResult list = ccam_heap_alloc_typed_array(heap, CCAM_HEAP_VALUE_REF, CCAM_HEAP_ELEMENT_TAINTED, 0);
    assert(tainted.ok && list.ok);
    CCAMHeapValue a = ccam_heap_ref_value(trusted.reference);
    CCAMHeapValue b = ccam_heap_ref_value(tainted.reference);
    CCAMHeapValue c = ccam_heap_ref_value(list.reference);
    assert(ag_nominal_kind(AG_SCHEMA_REF, AG_NOMINAL_TAINTED));
    assert(!ag_nominal_kind(AG_SCHEMA_INT, AG_NOMINAL_TAINTED));
    assert(ag_nominal_value_matches(heap, b, AG_SCHEMA_REF, AG_NOMINAL_TAINTED));
    assert(!ag_nominal_value_matches(heap, a, AG_SCHEMA_REF, AG_NOMINAL_TAINTED));
    assert(!ag_nominal_value_matches(heap, c, AG_SCHEMA_REF, AG_NOMINAL_TAINTED));
    assert(!ag_nominal_value_matches(heap, b, AG_SCHEMA_REF, AG_NOMINAL_BYTES));
    assert(!ag_nominal_value_matches(heap, b, AG_SCHEMA_REF, AG_NOMINAL_TAINTED_ARRAY));
    assert(ag_nominal_value_matches(heap, c, AG_SCHEMA_REF, AG_NOMINAL_TAINTED_ARRAY));
    assert(!ag_nominal_value_matches(heap, c, AG_SCHEMA_REF, AG_NOMINAL_STRING_ARRAY));
}
