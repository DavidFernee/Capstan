// Candidate native scalar list leaf. Membership MUST be checked by caller.
// Immutable extent: 257 pairs (length/ready plus 256 element pairs).
// Physical tags 4094=int list, 4095=bool list, disjoint from strings/records.
// RAX=offset, RSI=expected tag, RDI=mode (0 len,1 get,2 set,3 push,4 pop),
// R8=index, R9=value. RAX=result, RDX=status (0 success/1 rejection).
// Validates exact tag/count, logical length, flags and canonical bool words.
// No writes on rejection; pop clears retired value and readiness.
// Backing is fixed capacity, NOT dynamic capacity growth. Process-local,
// single-threaded trusted arena; no external authority or canonical ABI.
import "ccam_aggregate_byte_buffer.cap";

bool ag_nv_emit_scalar_list(List<int> b) {
    if (b.len() > AG_BYTE_LIMIT - 306) { return false; }
    b.push(77); b.push(141); b.push(20); b.push(4); b.push(72); b.push(129); b.push(254); b.push(254);
    b.push(15); b.push(0); b.push(0); b.push(116); b.push(13); b.push(72); b.push(129); b.push(254);
