    b.push(131); b.push(255); b.push(4); b.push(15); b.push(132); b.push(143); b.push(0); b.push(0);
    b.push(0); b.push(72); b.push(131); b.push(255); b.push(3); b.push(116); b.push(47); b.push(72);
