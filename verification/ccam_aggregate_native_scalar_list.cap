test "native scalar list leaf emits fixed bytes" {
    List<int> b = new List<int>();
    assert(ag_nv_emit_scalar_list(b));
    assert(b.len() == 306);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-scalar-list.bin", data));
}
