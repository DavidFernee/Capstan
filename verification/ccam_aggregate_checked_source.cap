// Checked production AST adapter for the experimental aggregate evaluator.
// No source checker replacement, native ABI, or full compiler coverage claim.
// Supported candidate functions: scalar operations, local assignment, public
// record construction/fields, list/byte reads, if/while/for and terminal returns.
// Value-producing pop remains deferred.
import "ccam_aggregate_sealed_program.cap";

const int AG_SOURCE_MAX_NAME = 256;
const int AG_SOURCE_MAX_RECORDS = 4096;
const int AG_SOURCE_MAX_EXPR_DEPTH = 64;
const int AG_SOURCE_MAX_BODY = 4096;

struct AGSourceShape {
    int kind;
    int descriptor;
}

AGSourceShape ag_source_invalid_shape() {
    return new AGSourceShape{kind: 0, descriptor: 0};
}

AGSourceShape ag_source_shape(Type t, Map<int> records) {
    if (t.k == TY_MAP && t.args.len() == 1 && t.name == "") {
        Type inner = t.args[0];
        if (inner.args.len() != 0) { return ag_source_invalid_shape(); }
        AGSourceShape optional = ag_source_shape(mk_wrap(TY_OPT, inner), records);
        if (!ccam_heap_optional_descriptor(optional.descriptor) || optional.descriptor == AG_OPTIONAL_LOG) { return ag_source_invalid_shape(); }
        return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_MAP_DESCRIPTOR_BASE + optional.descriptor};
    }
    if (t.k == TY_OPT && t.args.len() == 1 && t.name == "") {
        Type inner = t.args[0];
        if (inner.args.len() != 0) { return ag_source_invalid_shape(); }
        int descriptor = 0;
        if (inner.k == TY_INT && inner.name == "") { descriptor = AG_OPTIONAL_INT; }
        if (inner.k == TY_BOOL && inner.name == "") { descriptor = AG_OPTIONAL_BOOL; }
        if (inner.k == TY_STR && inner.name == "") { descriptor = AG_OPTIONAL_BYTES; }
        if (inner.k == TY_LOG && inner.name == "") { descriptor = AG_OPTIONAL_LOG; }
        if (inner.k == TY_STRUCT) {
            if (let id = records.get(inner.name)) { descriptor = AG_OPTIONAL_RECORD_BASE + id; }
        }
        if (!ccam_heap_optional_descriptor(descriptor)) { return ag_source_invalid_shape(); }
        return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: descriptor};
    }
    if (t.k == TY_LIST) {
        if (t.args.len() != 1 || t.name != "") { return ag_source_invalid_shape(); }
        Type element = t.args[0];
        if (element.args.len() != 0) { return ag_source_invalid_shape(); }
        if (element.k == TY_INT && element.name == "") {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_INT_ARRAY};
        }
        if (element.k == TY_BOOL && element.name == "") {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_BOOL_ARRAY};
        }
        if (element.k == TY_TAINT && element.name == "") {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_TAINTED_ARRAY};
        }
        if (element.k == TY_STR && element.name == "") {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_STRING_ARRAY};
        }
        if (element.k == TY_TAINT && element.name == "") {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_TAINTED_ARRAY};
        }
        if (element.k == TY_STRUCT) {
            if (let descriptor = records.get(element.name)) {
                return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: ag_nominal_record_array(descriptor)};
            }
        }
        return ag_source_invalid_shape();
    }
    if (t.args.len() != 0) { return ag_source_invalid_shape(); }
    if (t.k == TY_STRUCT) {
        if (let descriptor = records.get(t.name)) {
            return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: descriptor};
        }
        return ag_source_invalid_shape();
    }
    if (t.name != "") { return ag_source_invalid_shape(); }
    if (t.k == TY_INT) { return new AGSourceShape{kind: AG_SCHEMA_INT, descriptor: 0}; }
    if (t.k == TY_BOOL) { return new AGSourceShape{kind: AG_SCHEMA_BOOL, descriptor: 0}; }
    if (t.k == TY_STR) { return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_BYTES}; }
    if (t.k == TY_TAINT) { return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_TAINTED}; }
    if (t.k == TY_LOG) { return new AGSourceShape{kind: AG_SCHEMA_REF, descriptor: AG_NOMINAL_LOG}; }
    return ag_source_invalid_shape();
}

bool ag_source_shape_equal(AGSourceShape a, AGSourceShape b) {
    return a.kind != 0 && a.kind == b.kind && a.descriptor == b.descriptor;
}

struct AGSourceContext {
    Map<int> records;
    Map<Node> record_nodes;
    Map<Node> constants;
    Map<Node> function_nodes;
    Map<int> function_indices;
    Map<int> bindings;
    List<int> kinds;
    List<int> descriptors;
    List<AGBlockInstruction> code;
    List<AGCFGBlock> blocks;
    List<int> returns;
    int current;
    int emitted;
}

int ag_source_register(AGSourceContext c, AGSourceShape shape) {
    if (!ag_nominal_kind(shape.kind, shape.descriptor) ||
        c.kinds.len() >= AG_SOURCE_MAX_BODY) { return -1; }
    int id = c.kinds.len();
    c.kinds.push(shape.kind); c.descriptors.push(shape.descriptor);
    return id;
}

bool ag_source_register_matches(AGSourceContext c, int id, AGSourceShape shape) {
    return id >= 0 && id < c.kinds.len() && shape.kind != 0 &&
        c.kinds[id] == shape.kind && c.descriptors[id] == shape.descriptor;
}

int ag_source_element_kind(int descriptor) {
    if (descriptor == AG_NOMINAL_INT_ARRAY) { return AG_SCHEMA_INT; }
    if (descriptor == AG_NOMINAL_BOOL_ARRAY) { return AG_SCHEMA_BOOL; }
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return AG_SCHEMA_REF; }
    if (descriptor == AG_NOMINAL_TAINTED) { return 0; } // never an array
    if (descriptor < -3) { return AG_SCHEMA_REF; }
    return 0;
}

int ag_source_element_descriptor(int descriptor) {
    if (descriptor == AG_NOMINAL_STRING_ARRAY) { return AG_NOMINAL_BYTES; }
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return AG_NOMINAL_TAINTED; }
    if (descriptor < -3 && descriptor >= -AG_OPTIONAL_RECORD_MAX - 3) { return -(descriptor + 3); }
    return 0;
}

int ag_source_emit_read(AGSourceContext c, int opcode, int kind,
    AGSourceShape shape, int receiver, int index) {
    if (c.emitted >= AG_SOURCE_MAX_BODY) { return -1; }
    int dest = ag_source_register(c, shape);
    if (dest < 0) { return -1; }
    List<int> operands = new List<int>();
    operands.push(dest); operands.push(receiver);
    if (opcode == 1 || opcode == 4 || opcode == AG_OP_TAINT_AT || opcode == AG_OP_TAINT_LIST_GET) { operands.push(index); }
    if (!ag_source_emit(c, opcode, kind, operands)) { return -1; }
    return dest;
}

int ag_source_field_index(Node record, string name) {
    if (record.kids.len() > AG_SCHEMA_MAX_RECORD_FIELDS) { return -1; }
    for (int i = 0; i < record.kids.len(); i += 1) {
        Node field = record.kids[i];
        if (field.k == N_FIELD && field.s == name && field.s2 == "") { return i; }
    }
    return -1;
}

bool ag_source_emit(AGSourceContext c, int opcode, int kind, List<int> operands) {
    if (c.emitted >= AG_SOURCE_MAX_BODY ||
        !ag_schema_operands(c.kinds, opcode, kind, operands)) { return false; }
    c.code.push(new AGBlockInstruction{opcode: opcode, kind: kind, operands: operands});
    c.emitted += 1;
    return true;
}

int ag_source_constant(AGSourceContext c, AGSourceShape shape, int value) {
    int dest = ag_source_register(c, shape);
    if (dest < 0) { return -1; }
    List<int> operands = new List<int>(); operands.push(dest); operands.push(value);
    if (!ag_source_emit(c, AG_OP_SCALAR_CONST, shape.kind, operands)) { return -1; }
    return dest;
}

// Contextual optional injection: no implicit conversion between optional types.
int ag_source_expected(AGSourceContext c, Node e, AGSourceShape expected, int depth) {
    if (depth >= AG_SOURCE_MAX_EXPR_DEPTH || expected.kind == 0) { return -1; }
    if (expected.kind != AG_SCHEMA_REF || !ccam_heap_optional_descriptor(expected.descriptor)) {
        int value = ag_source_expr(c, e, depth);
        if (ag_source_register_matches(c, value, expected)) { return value; }
        return -1;
    }
    List<int> operands = new List<int>();
    int dest = -1;
    if (e.k == N_NONE && e.kids.len() == 0) {
        dest = ag_source_register(c, expected);
        if (dest < 0) { return -1; }
        operands.push(dest); operands.push(expected.descriptor);
        if (!ag_source_emit(c, AG_OP_OPT_NONE, AG_SCHEMA_REF, operands)) { return -1; }
        return dest;
    }
    int value = ag_source_expr(c, e, depth);
    if (ag_source_register_matches(c, value, expected)) { return value; }
    int kind = ccam_heap_optional_payload_kind(expected.descriptor);
    int descriptor = 0;
    if (expected.descriptor == AG_OPTIONAL_BYTES) { descriptor = AG_NOMINAL_BYTES; }
    if (expected.descriptor == AG_OPTIONAL_LOG) { descriptor = AG_NOMINAL_LOG; }
    if (expected.descriptor > AG_OPTIONAL_RECORD_BASE) {
        descriptor = expected.descriptor - AG_OPTIONAL_RECORD_BASE;
    }
    if (!ag_source_register_matches(c, value, new AGSourceShape{kind: kind, descriptor: descriptor})) { return -1; }
    dest = ag_source_register(c, expected);
    if (dest < 0) { return -1; }
    operands.push(dest); operands.push(value); operands.push(expected.descriptor);
    if (!ag_source_emit(c, AG_OP_OPT_SOME, AG_SCHEMA_REF, operands)) { return -1; }
    return dest;
}

int ag_source_construct(AGSourceContext c, Node e, AGSourceShape shape, int depth) {
    if (shape.kind != AG_SCHEMA_REF || shape.descriptor <= 0 ||
        ty_of(e).name != e.s) { return -1; }
    if (let record = c.record_nodes.get(e.s)) {
        if (record.kids.len() > AG_SCHEMA_MAX_RECORD_FIELDS ||
            record.kids.len() != e.kids.len()) { return -1; }
        int dest = ag_source_register(c, shape);
        if (dest < 0) { return -1; }
        List<int> layout = new List<int>();
        layout.push(dest); layout.push(shape.descriptor);
        for (int i = 0; i < record.kids.len(); i += 1) {
            Node field = record.kids[i];
            AGSourceShape field_shape = ag_source_shape(ty_of(field), c.records);
            if (field.k != N_FIELD || field.s2 != "" || field_shape.kind == 0) { return -1; }
            layout.push(field_shape.kind); layout.push(field_shape.descriptor);
        }
        if (!ag_source_emit(c, AG_OP_RECORD_ALLOC, AG_SCHEMA_REF, layout)) { return -1; }
        List<bool> seen = new List<bool>();
        for (int i = 0; i < record.kids.len(); i += 1) { seen.push(false); }
        // Allocate first and evaluate initialisers in their original source order.
        for (int i = 0; i < e.kids.len(); i += 1) {
            Node init = e.kids[i];
            int index = ag_source_field_index(record, init.s);
            if (init.k != N_INIT || init.kids.len() != 1 || index < 0 || seen[index]) { return -1; }
            AGSourceShape field_shape = ag_source_shape(ty_of(record.kids[index]), c.records);
            int value = ag_source_expected(c, init.kids[0], field_shape, depth + 1);
            if (!ag_source_register_matches(c, value, field_shape)) { return -1; }
            List<int> operands = new List<int>();
            operands.push(value); operands.push(dest); operands.push(shape.descriptor);
            operands.push(index); operands.push(field_shape.descriptor);
            if (!ag_source_emit(c, AG_OP_FIELD_SET, field_shape.kind, operands)) { return -1; }
            seen[index] = true;
        }
        return dest;
    }
    return -1;
}

int ag_source_field_read(AGSourceContext c, Node e, AGSourceShape shape, int depth) {
    if (e.kids.len() != 1) { return -1; }
    Type receiver_type = ty_of(e.kids[0]);
    if (receiver_type.k != TY_STRUCT) { return -1; }
    if (let record = c.record_nodes.get(receiver_type.name)) {
        int index = ag_source_field_index(record, e.s);
        if (index < 0 || !ag_source_shape_equal(shape,
            ag_source_shape(ty_of(record.kids[index]), c.records))) { return -1; }
        int receiver = ag_source_expr(c, e.kids[0], depth + 1);
        if (receiver < 0 || c.descriptors[receiver] <= 0 ||
            c.kinds[receiver] != AG_SCHEMA_REF) { return -1; }
        int dest = ag_source_register(c, shape);
        if (dest < 0) { return -1; }
        List<int> operands = new List<int>();
        operands.push(dest); operands.push(receiver); operands.push(c.descriptors[receiver]);
        operands.push(index); operands.push(shape.descriptor);
        if (!ag_source_emit(c, AG_OP_FIELD_GET, shape.kind, operands)) { return -1; }
        return dest;
    }
    return -1;
}

int ag_source_binary_opcode(string op) {
    if (op == "+") { return AG_OP_ADD; }
    if (op == "-") { return AG_OP_SUB; }
    if (op == "*") { return AG_OP_MUL; }
    if (op == "/") { return AG_OP_DIV; }
    if (op == "%") { return AG_OP_REM; }
    if (op == "==") { return AG_OP_EQ; }
    if (op == "!=") { return AG_OP_NE; }
    if (op == "<") { return AG_OP_LT; }
    if (op == "<=") { return AG_OP_LE; }
    if (op == ">") { return AG_OP_GT; }
    if (op == ">=") { return AG_OP_GE; }
    return 0;
}

int ag_source_binary(AGSourceContext c, int opcode, AGSourceShape shape, int left, int right) {
    if (opcode == 0 || left < 0 || right < 0 ||
        c.kinds[left] != c.kinds[right]) { return -1; }
    if (opcode <= AG_OP_REM && shape.kind != AG_SCHEMA_INT) { return -1; }
    if (opcode >= AG_OP_EQ && shape.kind != AG_SCHEMA_BOOL) { return -1; }
    int dest = ag_source_register(c, shape);
    if (dest < 0) { return -1; }
    List<int> operands = new List<int>();
    operands.push(dest); operands.push(left); operands.push(right);
    if (!ag_source_emit(c, opcode, c.kinds[left], operands)) { return -1; }
    return dest;
}

bool ag_source_move(AGSourceContext c, int destination, int source) {
    if (destination < 0 || source < 0 ||
        c.kinds[destination] != c.kinds[source] ||
        c.descriptors[destination] != c.descriptors[source]) { return false; }
    List<int> operands = new List<int>(); operands.push(destination); operands.push(source);
    return ag_source_emit(c, AG_OP_MOVE, c.kinds[destination], operands);
}

// Snapshot each argument in evaluation order. Resolve the callee solely
// through the checked module's deterministic function index.
// Void is a result contract only, never a value shape or register.
AGSourceShape ag_source_result_shape(Type t, Map<int> records) {
    if (t.k == TY_VOID && t.args.len() == 0 && t.name == "") {
        return new AGSourceShape{kind: AG_RESULT_VOID, descriptor: 0};
    }
    return ag_source_shape(t, records);
}

const int AG_SOURCE_VOID_CALL_OK = -2;

int ag_source_direct_call(AGSourceContext c, Node e, AGSourceShape result, int depth) {
    if (let f = c.function_nodes.get(e.s)) {
        if (let id = c.function_indices.get(e.s)) {
            if (f.k != N_FN || f.s2 != "" || f.n < 0 || f.n > AG_CALL_MAX_ARGS ||
                f.n != e.kids.len() || f.kids.len() != f.n + 1 ||
                !ag_source_shape_equal(result, ag_source_result_shape(ty_of(f), c.records))) { return -1; }
            int destination = -1;
            if (result.kind != AG_RESULT_VOID) {
                destination = ag_source_register(c, result);
                if (destination < 0) { return -1; }
            }
            List<int> operands = new List<int>(); operands.push(destination); operands.push(id);
            for (int i = 0; i < f.n; i += 1) {
                AGSourceShape expected = ag_source_shape(ty_of(f.kids[i]), c.records);
                int value = ag_source_expected(c, e.kids[i], expected, depth + 1);
                if (!ag_source_register_matches(c, value, expected)) { return -1; }
                int saved = ag_source_register(c, expected);
                if (!ag_source_move(c, saved, value)) { return -1; }
                operands.push(saved);
            }
            if (!ag_source_emit(c, AG_OP_DIRECT_CALL, result.kind, operands)) { return -1; }
            if (result.kind == AG_RESULT_VOID) { return AG_SOURCE_VOID_CALL_OK; }
            return destination;
        }
    }
    return -1;
}

// Evaluate receiver before key, with the exact checked map payload contract.
int ag_source_map_lookup(AGSourceContext c, Node e, AGSourceShape shape, int depth) {
    int receiver = ag_source_snapshot(c, ag_source_expr(c, e.kids[0], depth + 1));
    if (receiver < 0 || !ccam_heap_map_descriptor(c.descriptors[receiver])) { return -1; }
    int descriptor = c.descriptors[receiver] - AG_MAP_DESCRIPTOR_BASE;
    int key = ag_source_expected(c, e.kids[1], new AGSourceShape{kind: AG_SCHEMA_REF,
        descriptor: AG_NOMINAL_BYTES}, depth + 1);
    if (key < 0) { return -1; }
    int opcode = AG_OP_MAP_GET;
    if (e.s == "has" || e.s == "remove") {
        opcode = AG_OP_MAP_HAS;
        if (e.s == "remove") { opcode = AG_OP_MAP_REMOVE; }
        if (shape.kind != AG_SCHEMA_BOOL || shape.descriptor != 0) { return -1; }
    } else if (shape.kind != AG_SCHEMA_REF || shape.descriptor != descriptor) { return -1; }
    int destination = ag_source_register(c, shape);
    if (destination < 0) { return -1; }
    List<int> operands = new List<int>();
    operands.push(destination); operands.push(receiver); operands.push(key); operands.push(descriptor);
    if (!ag_source_emit(c, opcode, shape.kind, operands)) { return -1; }
    return destination;
}

bool ag_source_map_assignment(AGSourceContext c, Node e) {
    if (e.k != N_METHOD || e.s != "set" || e.kids.len() != 3) { return false; }
    Type t = ty_of(e.kids[0]);
    if (t.k != TY_MAP || t.args.len() != 1) { return false; }
    int receiver = ag_source_snapshot(c, ag_source_expr(c, e.kids[0], 0));
    if (receiver < 0 || !ccam_heap_map_descriptor(c.descriptors[receiver])) { return false; }
    int descriptor = c.descriptors[receiver] - AG_MAP_DESCRIPTOR_BASE;
    int key = ag_source_expected(c, e.kids[1], new AGSourceShape{kind: AG_SCHEMA_REF,
        descriptor: AG_NOMINAL_BYTES}, 0);
    key = ag_source_snapshot(c, key);
    if (key < 0) { return false; }
    AGSourceShape payload = ag_source_shape(t.args[0], c.records);
    int value = ag_source_expected(c, e.kids[2], payload, 0);
    if (value < 0) { return false; }
    List<int> operands = new List<int>();
    operands.push(receiver); operands.push(key); operands.push(value); operands.push(descriptor);
    return ag_source_emit(c, AG_OP_MAP_SET, payload.kind, operands);
}

// The production lexer stores escape_c(decoded) plus the original byte count.
// Invert that exact representation, not the user's raw source spelling.
int ag_source_string_literal(AGSourceContext c, Node e, AGSourceShape shape) {
    if (shape.kind != AG_SCHEMA_REF || shape.descriptor != AG_NOMINAL_BYTES ||
        e.n < 0 || e.n > AG_STRING_MAX_LITERAL ||
        e.s.len() > AG_STRING_MAX_LITERAL * 4) { return -1; }
    int dest = ag_source_register(c, shape);
    if (dest < 0) { return -1; }
    List<int> operands = new List<int>(); operands.push(dest);
    int pos = 0;
    while (pos < e.s.len()) {
        int byte = e.s.at(pos);
        pos += 1;
        if (byte == 92) {
            if (pos >= e.s.len()) { return -1; }
            byte = e.s.at(pos);
            pos += 1;
            if (byte != 92 && byte != 34 && byte != 63) {
                if (byte < 48 || byte > 51 || pos + 2 > e.s.len()) { return -1; }
                int middle = e.s.at(pos);
                int last = e.s.at(pos + 1);
                if (middle < 48 || middle > 55 || last < 48 || last > 55) { return -1; }
                byte = (byte - 48) * 64 + (middle - 48) * 8 + last - 48;
                pos += 2;
                if (byte >= 32 && byte < 127) { return -1; }
            }
        } else if (byte < 32 || byte >= 127 || byte == 34 || byte == 63) { return -1; }
        if (operands.len() - 1 >= e.n) { return -1; }
        operands.push(byte);
    }
    if (operands.len() - 1 != e.n || !ag_source_emit(c, AG_OP_BYTES_LITERAL, AG_SCHEMA_REF, operands)) {
        return -1;
    }
    return dest;
}

int ag_source_string_binary(AGSourceContext c, string operation, AGSourceShape shape, int left, int right) {
    if (left < 0 || right < 0 || c.descriptors[left] != AG_NOMINAL_BYTES ||
        c.descriptors[right] != AG_NOMINAL_BYTES) { return -1; }
    int opcode = 0;
    if (operation == "+" && shape.kind == AG_SCHEMA_REF && shape.descriptor == AG_NOMINAL_BYTES) { opcode = 8; }
    if (operation == "==" && shape.kind == AG_SCHEMA_BOOL) { opcode = AG_OP_BYTES_EQ; }
    if (operation == "!=" && shape.kind == AG_SCHEMA_BOOL) { opcode = AG_OP_BYTES_NE; }
    if (opcode == 0) { return -1; }
    int dest = ag_source_register(c, shape);
    if (dest < 0) { return -1; }
    List<int> operands = new List<int>(); operands.push(dest); operands.push(left); operands.push(right);
    if (!ag_source_emit(c, opcode, shape.kind, operands)) { return -1; }
    return dest;
}

// Logical operators are control flow, not eager scalar operations. The
// left result is materialised before branching; only the required edge
// evaluates the right operand. Both incoming edges initialise the result.
int ag_source_short_circuit(AGSourceContext c, Node e, AGSourceShape shape, int depth) {
    if (shape.kind != AG_SCHEMA_BOOL || shape.descriptor != 0 ||
        e.kids.len() != 2 || (e.s != "&&" && e.s != "||")) { return -1; }
    int left = ag_source_expr(c, e.kids[0], depth + 1);
    if (!ag_source_register_matches(c, left, shape)) { return -1; }
    int result = ag_source_register(c, shape);
    if (!ag_source_move(c, result, left)) { return -1; }
    int rhs = ag_source_new_block(c);
    int join_id = ag_source_new_block(c);
    if (rhs < 0 || join_id < 0) { return -1; }
    int yes = rhs;
    int no = join_id;
    if (e.s == "||") { yes = join_id; no = rhs; }
    if (!ag_source_close(c, 2, result, yes, no, -1) ||
        !ag_source_enter(c, rhs)) { return -1; }
    int right = ag_source_expr(c, e.kids[1], depth + 1);
    if (!ag_source_register_matches(c, right, shape) ||
        !ag_source_move(c, result, right) || !ag_source_jump(c, join_id) ||
        !ag_source_enter(c, join_id)) { return -1; }
    return result;
}

// Materialise the value before evaluating a subsequent operand. A reference
// retains its object identity rather than cloning the mutable object.
int ag_source_snapshot(AGSourceContext c, int source) {
    if (source < 0 || source >= c.kinds.len()) { return -1; }
    AGSourceShape shape = new AGSourceShape{kind: c.kinds[source], descriptor: c.descriptors[source]};
    int saved = ag_source_register(c, shape);
    if (!ag_source_move(c, saved, source)) { return -1; }
    return saved;
}

// Only the checked trusted int/bool/string overloads are admitted. No
// conversion of tainted, secret, optional or context-escaped text.
int ag_source_conversion(AGSourceContext c, Node e, AGSourceShape shape, int depth) {
    if (e.kids.len() != 1 || shape.kind != AG_SCHEMA_REF ||
        shape.descriptor != AG_NOMINAL_BYTES || c.function_nodes.has(e.s)) { return -1; }
    Type input = ty_of(e.kids[0]);
    int opcode = 0;
    if (e.s == "int_to_str" && input.k == TY_INT) { opcode = AG_OP_INT_TEXT; }
    if (e.s == "char_str" && input.k == TY_INT) { opcode = AG_OP_CHAR_TEXT; }
    if (e.s == "to_text") {
        if (input.k == TY_INT) { opcode = AG_OP_INT_TEXT; }
        if (input.k == TY_BOOL) { opcode = AG_OP_BOOL_TEXT; }
        if (input.k == TY_STR) { return ag_source_expected(c, e.kids[0], shape, depth + 1); }
    }
    if (opcode == 0) { return -1; }
    int source = ag_source_expr(c, e.kids[0], depth + 1);
    if (source < 0) { return -1; }
    int destination = ag_source_register(c, shape);
    if (destination < 0) { return -1; }
    List<int> operands = new List<int>(); operands.push(destination); operands.push(source);
    if (!ag_source_emit(c, opcode, AG_SCHEMA_REF, operands)) { return -1; }
    return destination;
}

int ag_source_expr(AGSourceContext c, Node e, int depth) {
    if (depth >= AG_SOURCE_MAX_EXPR_DEPTH) { return -1; }
    AGSourceShape shape = ag_source_shape(ty_of(e), c.records);
    if (shape.kind == 0) { return -1; }
    if (e.k == N_STR && e.kids.len() == 0) { return ag_source_string_literal(c, e, shape); }
    if (e.k == N_INT && e.kids.len() == 0 && shape.kind == AG_SCHEMA_INT) {
        return ag_source_constant(c, shape, e.n);
    }
    if (e.k == N_BOOL && e.kids.len() == 0 && shape.kind == AG_SCHEMA_BOOL &&
        (e.n == 0 || e.n == 1)) { return ag_source_constant(c, shape, e.n); }
    if (e.k == N_BIN && e.kids.len() == 2) {
        if (e.s == "&&" || e.s == "||") {
            return ag_source_short_circuit(c, e, shape, depth);
        }
        int opcode = ag_source_binary_opcode(e.s);
        if (opcode == 0) { return -1; }
        int left = ag_source_snapshot(c, ag_source_expr(c, e.kids[0], depth + 1));
        if (left < 0) { return -1; }
        int right = ag_source_expr(c, e.kids[1], depth + 1);
        if (right < 0) { return -1; }
        if (c.descriptors[left] == AG_NOMINAL_LOG || c.descriptors[right] == AG_NOMINAL_LOG) {
            if (e.s != "+" || shape.kind != AG_SCHEMA_REF || shape.descriptor != AG_NOMINAL_LOG ||
                (c.descriptors[left] != AG_NOMINAL_LOG && c.descriptors[left] != AG_NOMINAL_BYTES) ||
                (c.descriptors[right] != AG_NOMINAL_LOG && c.descriptors[right] != AG_NOMINAL_BYTES)) { return -1; }
            int dest = ag_source_register(c, shape);
            if (dest < 0) { return -1; }
            List<int> operands = new List<int>(); operands.push(dest); operands.push(left); operands.push(right);
            if (!ag_source_emit(c, AG_OP_LOG_CONCAT, AG_SCHEMA_REF, operands)) { return -1; }
            return dest;
        }
        if (c.descriptors[left] == AG_NOMINAL_BYTES || c.descriptors[right] == AG_NOMINAL_BYTES) {
            return ag_source_string_binary(c, e.s, shape, left, right);
        }
        return ag_source_binary(c, opcode, shape, left, right);
    }
    if (e.k == N_NEG && e.kids.len() == 1 && shape.kind == AG_SCHEMA_INT) {
        int value = ag_source_expr(c, e.kids[0], depth + 1);
        if (value < 0) { return -1; }
        int zero = ag_source_constant(c, shape, 0);
        return ag_source_binary(c, AG_OP_SUB, shape, zero, value);
    }
    if (e.k == N_NOT && e.kids.len() == 1 && shape.kind == AG_SCHEMA_BOOL) {
        int value = ag_source_expr(c, e.kids[0], depth + 1);
        if (value < 0) { return -1; }
        int dest = ag_source_register(c, shape);
        if (dest < 0) { return -1; }
        List<int> operands = new List<int>(); operands.push(dest); operands.push(value);
        if (!ag_source_emit(c, AG_OP_NOT, AG_SCHEMA_BOOL, operands)) { return -1; }
        return dest;
    }
    if (e.k == N_NEWMAP && e.kids.len() == 0 && shape.kind == AG_SCHEMA_REF &&
        ccam_heap_map_descriptor(shape.descriptor)) {
        int destination = ag_source_register(c, shape);
        if (destination < 0) { return -1; }
        List<int> operands = new List<int>();
        operands.push(destination); operands.push(shape.descriptor - AG_MAP_DESCRIPTOR_BASE);
        if (!ag_source_emit(c, AG_OP_MAP_NEW, AG_SCHEMA_REF, operands)) { return -1; }
        return destination;
    }
    if (e.k == N_METHOD && e.kids.len() == 2 &&
        (e.s == "get" || e.s == "has" || e.s == "remove") && ty_of(e.kids[0]).k == TY_MAP) {
        return ag_source_map_lookup(c, e, shape, depth);
    }
    if (e.k == N_METHOD && e.s == "keys" && e.kids.len() == 1 &&
        ty_of(e.kids[0]).k == TY_MAP && shape.kind == AG_SCHEMA_REF &&
        shape.descriptor == AG_NOMINAL_STRING_ARRAY) {
        int receiver = ag_source_expr(c, e.kids[0], depth + 1);
        if (receiver < 0 || !ccam_heap_map_descriptor(c.descriptors[receiver])) { return -1; }
        int destination = ag_source_register(c, shape);
        if (destination < 0) { return -1; }
        List<int> operands = new List<int>();
        operands.push(destination); operands.push(receiver); operands.push(c.descriptors[receiver] - AG_MAP_DESCRIPTOR_BASE);
        if (!ag_source_emit(c, AG_OP_MAP_KEYS, AG_SCHEMA_REF, operands)) { return -1; }
        return destination;
    }
    if (e.k == N_NEWLIST && e.kids.len() == 0 && shape.kind == AG_SCHEMA_REF) {
        int kind = ag_source_element_kind(shape.descriptor);
        if (shape.descriptor == AG_NOMINAL_TAINTED_ARRAY) { kind = AG_SCHEMA_REF; }
        if (kind == 0) { return -1; }
        int descriptor = 0;
        if (kind == AG_SCHEMA_REF) {
            descriptor = ag_source_element_descriptor(shape.descriptor);
            if (shape.descriptor == AG_NOMINAL_STRING_ARRAY) { descriptor = CCAM_HEAP_ELEMENT_BYTES; }
            if (shape.descriptor == AG_NOMINAL_TAINTED_ARRAY) { descriptor = CCAM_HEAP_ELEMENT_TAINTED; }
        }
        int destination = ag_source_register(c, shape);
        if (destination < 0) { return -1; }
        List<int> operands = new List<int>();
        operands.push(destination); operands.push(descriptor); operands.push(0);
        if (!ag_source_emit(c, 5, kind, operands)) { return -1; }
        return destination;
    }
    if (e.k == N_VAR && e.kids.len() == 0 && e.binding_id == 0) {
        if (let constant = c.constants.get(e.s)) {
            if (!ag_source_shape_equal(shape, ag_source_shape(ty_of(constant), c.records))) { return -1; }
            Node literal = constant.kids[0];
            if (literal.k == N_STR) { return ag_source_string_literal(c, literal, shape); }
            return ag_source_constant(c, shape, literal.n);
        }
        return -1;
    }
    if (e.k == N_CALL) {
        if (e.s == "join" && !c.function_nodes.has(e.s) && e.kids.len() == 2 && shape.kind == AG_SCHEMA_REF) {
            int expected = AG_NOMINAL_STRING_ARRAY;
            int opcode = AG_OP_JOIN_BYTES;
            if (shape.descriptor == AG_NOMINAL_TAINTED) {
                expected = AG_NOMINAL_TAINTED_ARRAY; opcode = AG_OP_JOIN_TAINTED;
            } else if (shape.descriptor != AG_NOMINAL_BYTES) { return -1; }
            int parts = ag_source_snapshot(c, ag_source_expr(c, e.kids[0], depth + 1));
            if (parts < 0 || c.descriptors[parts] != expected) { return -1; }
            int separator = ag_source_expr(c, e.kids[1], depth + 1);
            if (separator < 0 || c.descriptors[separator] != AG_NOMINAL_BYTES) { return -1; }
            int dest = ag_source_register(c, shape);
            if (dest < 0) { return -1; }
            List<int> operands = new List<int>();
            operands.push(dest); operands.push(parts); operands.push(separator);
            if (!ag_source_emit(c, opcode, AG_SCHEMA_REF, operands)) { return -1; }
            return dest;
        }
        if (e.s == "escape_log" && !c.function_nodes.has(e.s) && e.kids.len() == 1 &&
            shape.kind == AG_SCHEMA_REF && shape.descriptor == AG_NOMINAL_LOG) {
            int value = ag_source_expr(c, e.kids[0], depth + 1);
            if (value < 0 || (c.descriptors[value] != AG_NOMINAL_BYTES &&
                c.descriptors[value] != AG_NOMINAL_TAINTED && c.descriptors[value] != AG_NOMINAL_LOG)) { return -1; }
            return ag_source_emit_read(c, AG_OP_ESCAPE_LOG, AG_SCHEMA_REF, shape, value, -1);
        }
        if (e.s == "taint" && !c.function_nodes.has(e.s) && e.kids.len() == 1 &&
            shape.kind == AG_SCHEMA_REF && shape.descriptor == AG_NOMINAL_TAINTED) {
            int value = ag_source_expr(c, e.kids[0], depth + 1);
            if (value < 0 || c.descriptors[value] != AG_NOMINAL_BYTES) { return -1; }
            return ag_source_emit_read(c, AG_OP_TAINT, AG_SCHEMA_REF, shape, value, -1);
        }
        if (!c.function_nodes.has(e.s) &&
            (e.s == "int_to_str" || e.s == "char_str" || e.s == "to_text")) {
            return ag_source_conversion(c, e, shape, depth);
        }
        return ag_source_direct_call(c, e, shape, depth);
    }
    if (e.k == N_NEW) { return ag_source_construct(c, e, shape, depth); }
    if (e.k == N_GETF) { return ag_source_field_read(c, e, shape, depth); }
    if (e.k == N_VAR && e.kids.len() == 0 && e.binding_id > 0) {
        if (let id = c.bindings.get(int_to_str(e.binding_id))) {
            if (ag_source_register_matches(c, id, shape)) { return id; }
        }
        return -1;
    }
    if (e.k == N_METHOD && e.s == "slice" && e.kids.len() == 3 &&
        shape.kind == AG_SCHEMA_REF && (shape.descriptor == AG_NOMINAL_BYTES || shape.descriptor == AG_NOMINAL_TAINTED)) {
        int receiver = ag_source_snapshot(c, ag_source_expr(c, e.kids[0], depth + 1));
        if (receiver < 0 || c.descriptors[receiver] != shape.descriptor) { return -1; }
        int start = ag_source_snapshot(c, ag_source_expr(c, e.kids[1], depth + 1));
        if (start < 0) { return -1; }
        int end = ag_source_expr(c, e.kids[2], depth + 1);
        if (start < 0 || end < 0 || c.kinds[start] != AG_SCHEMA_INT || c.kinds[end] != AG_SCHEMA_INT) { return -1; }
        int dest = ag_source_register(c, shape);
        if (dest < 0) { return -1; }
        List<int> operands = new List<int>();
        operands.push(dest); operands.push(receiver); operands.push(start); operands.push(end);
        int opcode = AG_OP_BYTES_SLICE;
        if (shape.descriptor == AG_NOMINAL_TAINTED) { opcode = AG_OP_TAINT_SLICE; }
        if (!ag_source_emit(c, opcode, AG_SCHEMA_REF, operands)) { return -1; }
        return dest;
    }
    bool length = e.k == N_METHOD && e.s == "len" && e.kids.len() == 1;
    bool byte_at = e.k == N_METHOD && e.s == "at" && e.kids.len() == 2;
    bool array_at = e.k == N_INDEX && e.kids.len() == 2;
    if (!length && !byte_at && !array_at) { return -1; }
    int receiver = ag_source_expr(c, e.kids[0], depth + 1);
    if (receiver < 0 || c.kinds[receiver] != AG_SCHEMA_REF) { return -1; }
    int descriptor = c.descriptors[receiver];
    int element = ag_source_element_kind(descriptor);
    if (length) {
        if (shape.kind != AG_SCHEMA_INT) { return -1; }
        if (descriptor == AG_NOMINAL_BYTES) {
            return ag_source_emit_read(c, 7, AG_SCHEMA_INT, shape, receiver, -1);
        }
        if (descriptor == AG_NOMINAL_TAINTED) { return ag_source_emit_read(c, AG_OP_TAINT_LEN, AG_SCHEMA_INT, shape, receiver, -1); }
        if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return ag_source_emit_read(c, AG_OP_TAINT_LIST_LEN, AG_SCHEMA_REF, shape, receiver, -1); }
        if (element == 0) { return -1; }
        return ag_source_emit_read(c, 3, element, shape, receiver, -1);
    }
    receiver = ag_source_snapshot(c, receiver);
    if (receiver < 0) { return -1; }
    int index = ag_source_expr(c, e.kids[1], depth + 1);
    if (index < 0 || c.kinds[index] != AG_SCHEMA_INT) { return -1; }
    if (byte_at) {
        if (shape.kind != AG_SCHEMA_INT) { return -1; }
        if (descriptor == AG_NOMINAL_TAINTED) { return ag_source_emit_read(c, AG_OP_TAINT_AT, AG_SCHEMA_INT, shape, receiver, index); }
        if (descriptor != AG_NOMINAL_BYTES) { return -1; }
        return ag_source_emit_read(c, 4, AG_SCHEMA_INT, shape, receiver, index);
    }
    if (element == 0 || shape.kind != element) { return -1; }
    if (element == AG_SCHEMA_REF && shape.descriptor != ag_source_element_descriptor(descriptor)) { return -1; }
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return ag_source_emit_read(c, AG_OP_TAINT_LIST_GET, element, shape, receiver, index); }
    return ag_source_emit_read(c, 1, element, shape, receiver, index);
}

// Allocate block identities before edges; only the active block can emit.
// Every published block is terminated, including a loop backedge.
int ag_source_new_block(AGSourceContext c) {
    if (c.blocks.len() >= AG_SOURCE_MAX_BODY) { return -1; }
    int id = c.blocks.len();
    c.blocks.push(new AGCFGBlock{instructions: new List<AGBlockInstruction>(),
        terminator: -1, condition: -1, yes: -1, no: -1});
    c.returns.push(-1);
    return id;
}

bool ag_source_enter(AGSourceContext c, int id) {
    if (c.current != -1 || id < 0 || id >= c.blocks.len() ||
        c.blocks[id].terminator != -1) { return false; }
    c.current = id;
    c.code = c.blocks[id].instructions;
    return true;
}

bool ag_source_close(AGSourceContext c, int terminator, int condition, int yes, int no, int returned) {
    if (c.current < 0) { return false; }
    int id = c.current;
    c.blocks[id].terminator = terminator;
    c.blocks[id].condition = condition;
    c.blocks[id].yes = yes;
    c.blocks[id].no = no;
    c.returns[id] = returned;
    c.current = -1;
    return true;
}

bool ag_source_jump(AGSourceContext c, int target) {
    if (target < 0 || target >= c.blocks.len()) { return false; }
    return ag_source_close(c, 1, -1, target, -1, -1);
}

// Evaluate the receiver once. For compound assignments, read its old value
// before evaluating the RHS, as in the production scalar lowering path.
bool ag_source_field_assignment(AGSourceContext c, Node target, Node rhs, string operation) {
    if (target.kids.len() != 1) { return false; }
    Type receiver_type = ty_of(target.kids[0]);
    if (receiver_type.k != TY_STRUCT) { return false; }
    if (let record = c.record_nodes.get(receiver_type.name)) {
        int field = ag_source_field_index(record, target.s);
        if (field < 0) { return false; }
        AGSourceShape shape = ag_source_shape(ty_of(record.kids[field]), c.records);
        if (!ag_source_shape_equal(shape, ag_source_shape(ty_of(target), c.records))) { return false; }
        int receiver = ag_source_snapshot(c, ag_source_expr(c, target.kids[0], 0));
        if (receiver < 0 || c.kinds[receiver] != AG_SCHEMA_REF || c.descriptors[receiver] <= 0) { return false; }
        int old = -1;
        if (operation == "+=" || operation == "-=") {
            if (shape.kind != AG_SCHEMA_INT) { return false; }
            old = ag_source_register(c, shape);
            if (old < 0) { return false; }
            List<int> read = new List<int>();
            read.push(old); read.push(receiver); read.push(c.descriptors[receiver]);
            read.push(field); read.push(shape.descriptor);
            if (!ag_source_emit(c, AG_OP_FIELD_GET, shape.kind, read)) { return false; }
        } else if (operation != "=") { return false; }
        int value = ag_source_expected(c, rhs, shape, 0);
        if (!ag_source_register_matches(c, value, shape)) { return false; }
        if (old >= 0) {
            int opcode = AG_OP_ADD;
            if (operation == "-=") { opcode = AG_OP_SUB; }
            value = ag_source_binary(c, opcode, shape, old, value);
            if (value < 0) { return false; }
        }
        List<int> write = new List<int>();
        write.push(value); write.push(receiver); write.push(c.descriptors[receiver]);
        write.push(field); write.push(shape.descriptor);
        return ag_source_emit(c, AG_OP_FIELD_SET, shape.kind, write);
    }
    return false;
}

// Capture list identity and index before evaluating a potentially mutating RHS.
// Compound assignment reads the old element before RHS; the final setter
// checks the live bounds again, so shrinking the list cannot bypass checks.
bool ag_source_index_assignment(AGSourceContext c, Node target, Node rhs, string operation) {
    if (target.kids.len() != 2 || ty_of(target.kids[0]).k != TY_LIST) { return false; }
    AGSourceShape shape = ag_source_shape(ty_of(target), c.records);
    int receiver = ag_source_snapshot(c, ag_source_expr(c, target.kids[0], 0));
    if (receiver < 0 || c.kinds[receiver] != AG_SCHEMA_REF) { return false; }
    int descriptor = c.descriptors[receiver];
    if (shape.kind == 0 || ag_source_element_kind(descriptor) != shape.kind ||
        ag_source_element_descriptor(descriptor) != shape.descriptor) { return false; }
    int index = ag_source_snapshot(c, ag_source_expr(c, target.kids[1], 0));
    if (index < 0 || c.kinds[index] != AG_SCHEMA_INT) { return false; }
    int old = -1;
    if (operation == "+=" || operation == "-=") {
        if (shape.kind != AG_SCHEMA_INT) { return false; }
        old = ag_source_emit_read(c, 1, shape.kind, shape, receiver, index);
        if (old < 0) { return false; }
    } else if (operation != "=") { return false; }
    int value = ag_source_expected(c, rhs, shape, 0);
    if (!ag_source_register_matches(c, value, shape)) { return false; }
    if (old >= 0) {
        int opcode = AG_OP_ADD;
        if (operation == "-=") { opcode = AG_OP_SUB; }
        value = ag_source_binary(c, opcode, shape, old, value);
        if (value < 0) { return false; }
    }
    List<int> operands = new List<int>();
    operands.push(value); operands.push(receiver); operands.push(index);
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return ag_source_emit(c, AG_OP_TAINT_LIST_SET, shape.kind, operands); }
    return ag_source_emit(c, 2, shape.kind, operands);
}

// List mutation is admitted only when the optional pop result is discarded.
bool ag_source_list_statement(AGSourceContext c, Node e) {
    if (e.k != N_METHOD || e.kids.len() == 0) { return false; }
    bool push = e.s == "push" && e.kids.len() == 2;
    bool pop = e.s == "pop" && e.kids.len() == 1;
    if (!push && !pop) { return false; }
    if (ty_of(e.kids[0]).k != TY_LIST) { return false; }
    int receiver = ag_source_expr(c, e.kids[0], 0);
    if (receiver < 0 || c.kinds[receiver] != AG_SCHEMA_REF) { return false; }
    int descriptor = c.descriptors[receiver];
    int kind = ag_source_element_kind(descriptor);
    if (kind == 0) { return false; }
    List<int> operands = new List<int>(); operands.push(receiver);
    if (pop) {
        if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return ag_source_emit(c, AG_OP_TAINT_LIST_POP, kind, operands); }
        return ag_source_emit(c, AG_OP_LIST_POP_DISCARD, kind, operands);
    }
    receiver = ag_source_snapshot(c, receiver);
    if (receiver < 0) { return false; }
    operands[0] = receiver;
    int value = ag_source_expr(c, e.kids[1], 0);
    if (value < 0 || c.kinds[value] != kind) { return false; }
    if (kind == AG_SCHEMA_REF && c.descriptors[value] != ag_source_element_descriptor(descriptor)) { return false; }
    operands.push(value);
    if (descriptor == AG_NOMINAL_TAINTED_ARRAY) { return ag_source_emit(c, AG_OP_TAINT_LIST_PUSH, kind, operands); }
    return ag_source_emit(c, AG_OP_LIST_PUSH, kind, operands);
}

bool ag_source_statement(AGSourceContext c, Node statement, AGSourceShape result,
    int depth, int break_target, int continue_target) {
    if (depth >= AG_SOURCE_MAX_EXPR_DEPTH || c.current < 0) { return false; }
    if (statement.k == N_BLOCK) {
        if (statement.kids.len() > AG_SOURCE_MAX_BODY) { return false; }
        for (int i = 0; i < statement.kids.len(); i += 1) {
            // Fail closed on unreachable source rather than skipping its validation.
            if (c.current < 0 || !ag_source_statement(c, statement.kids[i], result,
                depth + 1, break_target, continue_target)) { return false; }
        }
        return true;
    }
    if (statement.k == N_DECL) {
        if (statement.kids.len() != 1 || statement.binding_id <= 0 ||
            c.bindings.has(int_to_str(statement.binding_id))) { return false; }
        AGSourceShape shape = ag_source_shape(ty_of(statement), c.records);
        int value = ag_source_expected(c, statement.kids[0], shape, 0);
        if (!ag_source_register_matches(c, value, shape)) { return false; }
        int destination = ag_source_register(c, shape);
        if (!ag_source_move(c, destination, value)) { return false; }
        c.bindings.set(int_to_str(statement.binding_id), destination);
        return true;
    }
    if (statement.k == N_EXPR && statement.kids.len() == 1) {
        Node expression = statement.kids[0];
        if (expression.k == N_CALL && ty_of(expression).k == TY_VOID) {
            return ag_source_direct_call(c, expression,
                ag_source_result_shape(ty_of(expression), c.records), 0) == AG_SOURCE_VOID_CALL_OK;
        }
        if (expression.k == N_METHOD && expression.kids.len() > 0 &&
            ty_of(expression.kids[0]).k == TY_MAP) {
            if (expression.s == "remove" && expression.kids.len() == 2) {
                return ag_source_expr(c, expression, 0) >= 0;
            }
            return ag_source_map_assignment(c, expression);
        }
        return ag_source_list_statement(c, expression);
    }
    if (statement.k == N_ASSIGN && statement.kids.len() == 2) {
        Node target = statement.kids[0];
        if (target.k == N_GETF) {
            return ag_source_field_assignment(c, target, statement.kids[1], statement.s);
        }
        if (target.k == N_INDEX) {
            return ag_source_index_assignment(c, target, statement.kids[1], statement.s);
        }
        if (target.k != N_VAR) { return false; }
        int destination = ag_source_expr(c, target, 0);
        if (destination < 0) { return false; }
        int value = ag_source_expected(c, statement.kids[1], ag_source_shape(ty_of(target), c.records), 0);
        if (value < 0) { return false; }
        if (statement.s == "+=" || statement.s == "-=") {
            int opcode = AG_OP_ADD;
            if (statement.s == "-=") { opcode = AG_OP_SUB; }
            value = ag_source_binary(c, opcode, new AGSourceShape{kind: AG_SCHEMA_INT, descriptor: 0},
                destination, value);
        } else if (statement.s != "=") { return false; }
        return ag_source_move(c, destination, value);
    }
    if (statement.k == N_RETURN && statement.kids.len() == 0) {
        return result.kind == AG_RESULT_VOID && ag_source_close(c, 0, -1, -1, -1, -1);
    }
    if (statement.k == N_RETURN && statement.kids.len() == 1) {
        if (result.kind == AG_RESULT_VOID) { return false; }
        int value = ag_source_expected(c, statement.kids[0], result, 0);
        if (!ag_source_register_matches(c, value, result)) { return false; }
        return ag_source_close(c, 0, -1, -1, -1, value);
    }
    if (statement.k == N_BREAK && statement.kids.len() == 0) {
        return ag_source_jump(c, break_target);
    }
    if (statement.k == N_CONTINUE && statement.kids.len() == 0) {
        return ag_source_jump(c, continue_target);
    }
    if (statement.k == N_IF && (statement.kids.len() == 2 || statement.kids.len() == 3)) {
        int condition = -1;
        int optional = -1;
        AGSourceShape payload = ag_source_invalid_shape();
        if (statement.n == 1 && statement.s2 != "" && statement.binding_id > 0) {
            Type t = ty_of(statement.kids[0]);
            if (t.k != TY_OPT || t.args.len() != 1 ||
                c.bindings.has(int_to_str(statement.binding_id))) { return false; }
            optional = ag_source_expr(c, statement.kids[0], 0);
            if (optional < 0 || !ccam_heap_optional_descriptor(c.descriptors[optional])) { return false; }
            payload = ag_source_shape(t.args[0], c.records);
            condition = ag_source_register(c, new AGSourceShape{kind: AG_SCHEMA_BOOL, descriptor: 0});
            if (condition < 0) { return false; }
            List<int> presence = new List<int>();
            presence.push(condition); presence.push(optional); presence.push(c.descriptors[optional]);
            if (!ag_source_emit(c, AG_OP_OPT_PRESENT, AG_SCHEMA_BOOL, presence)) { return false; }
        } else if (statement.n == 0 && statement.s2 == "") {
            condition = ag_source_expr(c, statement.kids[0], 0);
        } else { return false; }
        if (condition < 0 || c.kinds[condition] != AG_SCHEMA_BOOL) { return false; }
        int yes = ag_source_new_block(c);
        int no = ag_source_new_block(c);
        if (yes < 0 || no < 0 || !ag_source_close(c, 2, condition, yes, no, -1) ||
            !ag_source_enter(c, yes)) { return false; }
        if (optional >= 0) {
            int bound = ag_source_register(c, payload);
            if (bound < 0) { return false; }
            List<int> unwrap = new List<int>();
            unwrap.push(bound); unwrap.push(optional); unwrap.push(c.descriptors[optional]);
            if (!ag_source_emit(c, AG_OP_OPT_UNWRAP, payload.kind, unwrap)) { return false; }
            c.bindings.set(int_to_str(statement.binding_id), bound);
        }
        if (!ag_source_statement(c, statement.kids[1], result, depth + 1,
            break_target, continue_target)) { return false; }
        int yes_end = c.current;
        c.current = -1;
        if (!ag_source_enter(c, no)) { return false; }
        if (statement.kids.len() == 3 &&
            !ag_source_statement(c, statement.kids[2], result, depth + 1,
            break_target, continue_target)) { return false; }
        int no_end = c.current;
        c.current = -1;
        if (yes_end < 0 && no_end < 0) { return true; }
        int join_id = ag_source_new_block(c);
        if (join_id < 0) { return false; }
        if (yes_end >= 0 && (!ag_source_enter(c, yes_end) || !ag_source_jump(c, join_id))) { return false; }
        if (no_end >= 0 && (!ag_source_enter(c, no_end) || !ag_source_jump(c, join_id))) { return false; }
        return ag_source_enter(c, join_id);
    }
    bool is_for = statement.k == N_FOR && statement.kids.len() == 4;
    bool is_while = statement.k == N_WHILE && statement.kids.len() == 2;
    if (is_for || is_while) {
        int condition_index = 0;
        int body_index = 1;
        if (is_for) {
            if (!ag_source_statement(c, statement.kids[0], result, depth + 1,
                break_target, continue_target) || c.current < 0) { return false; }
            condition_index = 1; body_index = 3;
        }
        int header = ag_source_new_block(c);
        int body = ag_source_new_block(c);
        int exit_block = ag_source_new_block(c);
        int step = header;
        if (is_for) { step = ag_source_new_block(c); }
        if (header < 0 || body < 0 || exit_block < 0 || step < 0 ||
            !ag_source_jump(c, header) || !ag_source_enter(c, header)) { return false; }
        int condition = ag_source_expr(c, statement.kids[condition_index], 0);
        if (condition < 0 || c.kinds[condition] != AG_SCHEMA_BOOL ||
            !ag_source_close(c, 2, condition, body, exit_block, -1) ||
            !ag_source_enter(c, body)) { return false; }
        if (!ag_source_statement(c, statement.kids[body_index], result, depth + 1,
            exit_block, step)) { return false; }
        if (c.current >= 0 && !ag_source_jump(c, step)) { return false; }
        if (is_for) {
            if (!ag_source_enter(c, step) ||
                !ag_source_statement(c, statement.kids[2], result, depth + 1,
                    break_target, continue_target) || c.current < 0 ||
                !ag_source_jump(c, header)) { return false; }
        }
        return ag_source_enter(c, exit_block);
    }
    return false;
}

struct AGSourceFunction {
    AGFunction function;
    AGNominalSignature signature;
}

AGSourceFunction? ag_source_lower_function(Node f, Map<int> records, Map<Node> record_nodes, Map<Node> constants,
    Map<Node> function_nodes, Map<int> function_indices) {
    if (f.k != N_FN || f.s2 != "" || f.n < 0 || f.n > AG_CALL_MAX_ARGS ||
        f.kids.len() != f.n + 1 || f.kids[f.n].k != N_BLOCK) { return none; }
    AGSourceShape result = ag_source_result_shape(ty_of(f), records);
    if (result.kind == 0) { return none; }
    AGSourceContext c = new AGSourceContext{records: records, record_nodes: record_nodes, constants: constants,
        function_nodes: function_nodes, function_indices: function_indices, bindings: new Map<int>(),
        kinds: new List<int>(), descriptors: new List<int>(), code: new List<AGBlockInstruction>(),
        blocks: new List<AGCFGBlock>(), returns: new List<int>(), current: -1, emitted: 0};
    List<int> parameters = new List<int>();
    List<int> descriptors = new List<int>();
    for (int i = 0; i < f.n; i += 1) {
        Node p = f.kids[i];
        if (p.k != N_PARAM || p.binding_id <= 0 || c.bindings.has(int_to_str(p.binding_id))) { return none; }
        AGSourceShape shape = ag_source_shape(ty_of(p), records);
        int id = ag_source_register(c, shape);
        if (id < 0) { return none; }
        c.bindings.set(int_to_str(p.binding_id), id);
        parameters.push(shape.kind); descriptors.push(shape.descriptor);
    }
    int entry = ag_source_new_block(c);
    if (!ag_source_enter(c, entry) ||
        !ag_source_statement(c, f.kids[f.n], result, 0, -1, -1)) { return none; }
    if (c.current >= 0) {
        if (result.kind != AG_RESULT_VOID || !ag_source_close(c, 0, -1, -1, -1, -1)) { return none; }
    }
    AGCallSignature coarse = new AGCallSignature{parameters: parameters, result_kind: result.kind};
    return new AGSourceFunction{
        function: new AGFunction{signature: coarse, kinds: c.kinds, blocks: c.blocks, returns: c.returns},
        signature: new AGNominalSignature{coarse: coarse, parameter_descriptors: descriptors,
            result_descriptor: result.descriptor}
    };
}
