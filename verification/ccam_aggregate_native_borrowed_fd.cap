test "borrowed FD reader emission is bounded and exact" {
    List<int> b = new List<int>();
    assert(ag_native_emit_borrowed_fd_read(b));
    assert(b.len() == AG_NATIVE_FD_READ_SIZE);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-borrowed-fd-read.bin", data));
}
