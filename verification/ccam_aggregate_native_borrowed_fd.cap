// Candidate Linux x86-64 borrowed-FD input leaf, NOT source read_file.
// RAX=caller-owned, already authorised regular-file fd; R8=limit 0..4096.
// R12/R13/R14=trusted live arena base/committed bytes/logical capacity.
// Caller guarantees mapped arena, valid stack (4288 bytes plus call return),
// live FD identity and exclusive ownership of arena. This leaf does not
// open, close, seek, duplicate or acquire authority. Linux fstat + pread64.
// EINTR/other syscall failure, nonregular file, invalid limit, oversize or
// capacity failure return RAX=0/RDX=1 with arena and cursor unchanged.
// Success: RAX=new offset/RDX=0; publishes cursor last. Immutable tag 2045,
// distinct from trusted string tag 4096; exact payload bytes and readiness.
// Reads at most limit+1 bytes; each non-EOF read advances offset. File
// contents need not be a coherent snapshot if a writer changes them.
// Syscall count is bounded, NOT wall-clock time or OS scheduling latency.
// RBX/RBP/R12/R14/R15 preserved. No source opcode, canonical ABI or
// declassification: consuming tainted bytes remains a separate contract.
import "ccam_aggregate_byte_buffer.cap";

const int AG_NATIVE_FD_READ_SIZE = 278;
const int AG_NATIVE_FD_TAINT_TAG = 2045;
const int AG_NATIVE_FD_READ_LIMIT = 4096;

bool ag_native_emit_borrowed_fd_read(List<int> b) {
    if (b.len() > AG_BYTE_LIMIT - AG_NATIVE_FD_READ_SIZE) { return false; }
