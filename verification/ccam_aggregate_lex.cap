import "ccam_aggregate_scan.cap";
import "ccam_aggregate_token.cap";
struct AGLexResult { bool ok; List<AGToken> tokens; }
AGLexResult ag_lex_bytes(List<int> bytes) {
 List<AGToken> tokens = new List<AGToken>();
 if (bytes.len() > 1048576) { return new AGLexResult{ok:false,tokens:tokens}; }
 int i=0;
 while (i<bytes.len()) {
  int ch=bytes[i]; int end=i+1; int kind=3;
  if (ag_space(ch)) { i+=1; continue; }
  if (ag_letter(ch)) { end=ag_scan_identifier(bytes,i); kind=1; }
  else if (ag_digit(ch)) { end=ag_scan_number(bytes,i); kind=2; }
  else if (ch!=40 && ch!=41 && ch!=43 && ch!=45 && ch!=42 && ch!=47 && ch!=59 && ch!=61) { return new AGLexResult{ok:false,tokens:tokens}; }
  tokens.push(new AGToken{kind:kind,spelling:"",start:i,end:end}); i=end;
 }
 tokens.push(new AGToken{kind:0,spelling:"",start:i,end:i});
 return new AGLexResult{ok:true,tokens:tokens};
}
