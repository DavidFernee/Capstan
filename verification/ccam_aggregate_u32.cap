import "ccam_aggregate_byte_buffer.cap";
import "native_binary_fields.cap";

bool ag_u32(List<int> b, int v) {
    if (b.len() > AG_BYTE_LIMIT - 4) { return false; }
    NativeBinaryField field = native_binary_field(v, 4);
    if (!field.ok) { return false; }
    for (int i = 0; i < 4; i += 1) { b.push(field.bytes[i]); }
    return true;
}
test "aggregate u32 preserves bytes on invalid value" {
    List<int> b = new List<int>();
    assert(ag_u32(b, 4294967295));
    assert(!ag_u32(b, 4294967296));
    assert(!ag_u32(b, -1));
    assert(b.len() == 4);
    for (int i = 0; i < 4; i += 1) { assert(b[i] == 255); }
}
