import "ccam_aggregate_checked_sub.cap";
import "ccam_aggregate_checked_mul.cap";
import "ccam_aggregate_checked_div.cap";
AGCheckedInt ag_arithmetic(int op,int a,int b){if(op==2){return ag_checked_add(a,b);}if(op==3){return ag_checked_sub(a,b);}if(op==4){return ag_checked_mul(a,b);}if(op==5){return ag_checked_div(a,b);}if(op==6){if(a<b){return new AGCheckedInt{ok:true,value:1};}return new AGCheckedInt{ok:true,value:0};}if(op==7){if(a>b){return new AGCheckedInt{ok:true,value:1};}return new AGCheckedInt{ok:true,value:0};}return new AGCheckedInt{ok:false,value:0};}
