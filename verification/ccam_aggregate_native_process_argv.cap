    return true;
}

test "candidate Linux process argv leaf emits exact extent" {
    List<int> b = new List<int>();
    assert(ag_nv_emit_process_argv(b));
    assert(b.len() == 353);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-process-argv.bin", data));
}
