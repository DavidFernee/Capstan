// Linux x86-64 initial process argv capture, candidate profile.
// RAX = original trusted kernel stack pointer, R12/R13/R14 live arena.
// Only the entry trampoline may invoke this leaf. Excludes argv[0].
// Fixed bounds: 256 arguments, 4096 bytes per arg, 1048576 total bytes.
// Preflight all lengths and exact word-pair arena cost before writes.
// Two passes assume kernel-provided argv bytes stable in this single-threaded
// entry; no language-controlled pointers or concurrent mutation.
// RAX = fresh string-list offset, RDX = status (0 success, 1 rejection).
// Cursor published last, unchanged on rejection. RBX/RBP/R12/R14/R15 preserved.
// No environment capture, authority grants, source args() builtin or canonical ABI.
import "ccam_aggregate_byte_buffer.cap";

bool ag_nv_emit_process_argv(List<int> b) {
    if (b.len() > AG_BYTE_LIMIT - 353) { return false; }
    b.push(72); b.push(131); b.push(236); b.push(32); b.push(72); b.push(137); b.push(4); b.push(36);
