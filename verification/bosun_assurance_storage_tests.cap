import "bosuns_locker_protocol.cap";

// Exercise every six-event history in the bounded WAL alphabet. The oracle
// records persisted positions and commit identity separately from model state.
bool assurance_wal_history(int encoded) {
    BLStorageState state = bl_storage_initial();
    int written = 0; int durable = 0; int page = 0; int commit = 0;
    bool ack = false;
    for (int i = 0; i < 6; i += 1) {
        int event = encoded % 8; encoded = encoded / 8;
        int action = BL_STORAGE_APPEND_UPDATE; int argument = 0;
        if (event == 1) { action = BL_STORAGE_APPEND_COMMIT; }
        if (event == 2) { action = BL_STORAGE_FLUSH_LOG; argument = written; }
        if (event == 3) { action = BL_STORAGE_FLUSH_LOG; argument = durable - 1; }
        if (event == 4) { action = BL_STORAGE_FLUSH_PAGE; argument = durable; }
        if (event == 5) { action = BL_STORAGE_FLUSH_PAGE; argument = durable + 1; }
        if (event == 6) { action = BL_STORAGE_ACK_COMMIT; }
        if (event == 7) { action = BL_STORAGE_FLUSH_PAGE; argument = page - 1; }
        bool permitted = false;
        if (event == 0 || event == 1) { permitted = commit == 0; }
        if (event == 2) { permitted = true; }
        if (event == 4) { permitted = durable > 0; }
        if (event == 6) { permitted = commit > 0 && durable >= commit; }
        if (event == 7) { permitted = false; }
        BLStorageTransition step = bl_storage_step(state, action, argument);
        if (step.accepted != permitted) { return false; }
        if (permitted) {
            if (event == 0 || event == 1) { written += 1; }
            if (event == 1) { commit = written; }
            if (event == 2) { durable = written; }
            if (event == 4) { page = durable; }
            if (event == 6) { ack = true; }
        }
        state = step.state;
        if (state.next_lsn != written || state.durable_lsn != durable ||
            state.page_lsn != page || state.page_persisted != (page > 0) ||
            state.commit_lsn != commit || state.acknowledged != ack ||
            bl_storage_commit_survives_crash(state) != (commit > 0 && durable >= commit) ||
            !bl_storage_invariant(state)) { return false; }
    }
    return true;
}
bool assurance_wal_shard(int shard) {
    for (int history = shard * 8192; history < (shard + 1) * 8192; history += 1) {
        if (!assurance_wal_history(history)) { return false; }
    }
    return true;
}
test "Bosun WAL six-event ordering shard 0" {
    assert(assurance_wal_shard(0));
}

test "Bosun WAL six-event ordering shard 1" {
    assert(assurance_wal_shard(1));
}

test "Bosun WAL six-event ordering shard 2" {
    assert(assurance_wal_shard(2));
}

