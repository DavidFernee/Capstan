test "Bosun recovery at each transaction lifecycle boundary" {
    for (int budget = 0; budget <= 8; budget += 1) {
        BLTxnState state = bl_txn_initial(budget);
        assert(!bl_recover(state, false).valid && !bl_recover(state, true).valid);
        state = bl_txn_step(state, BL_ACTION_BEGIN).state;
        for (int n = 0; n <= budget; n += 1) {
            BLRecoveryResult absent = bl_recover(state, false);
            assert(absent.valid && absent.state.phase == BL_PHASE_ABORTED);
            assert(!bl_recover(state, true).valid);
            BLTxnTransition operation = bl_txn_step(state, BL_ACTION_OPERATION);
            assert(operation.accepted == (n < budget));
            state = operation.state;
        }
        state = bl_txn_step(state, BL_ACTION_PREPARE).state;
        assert(bl_recover(state, false).state.phase == BL_PHASE_ABORTED);
        assert(!bl_recover(state, true).valid);
        state = bl_txn_step(state, BL_ACTION_COMMIT_DECISION).state;
        BLRecoveryResult lost = bl_recover(state, false);
        BLRecoveryResult saved = bl_recover(state, true);
        assert(lost.valid && lost.state.phase == BL_PHASE_ABORTED && !lost.state.writes_visible);
        assert(saved.valid && saved.state.phase == BL_PHASE_DURABLE_COMMITTED && saved.state.writes_visible);
        assert(!saved.state.acknowledged && !bl_recover(saved.state, false).valid);
        assert(bl_recover(saved.state, true).valid);
        assert(bl_recover(lost.state, false).valid && !bl_recover(lost.state, true).valid);
    }
}
