import "ccam_aggregate_scalar_ir.cap";
import "ccam_aggregate_arithmetic.cap";
AGCheckedInt ag_scalar_machine(List<AGScalarInstruction> instructions){List<int> values=new List<int>();if(instructions.len()==0||instructions.len()>65536){return new AGCheckedInt{ok:false,value:0};}for(int i=0;i<instructions.len();i+=1){AGScalarInstruction ins=instructions[i];if(!ag_scalar_shape(ins,instructions.len())||ins.dest!=i){return new AGCheckedInt{ok:false,value:0};}if(ins.opcode==1){values.push(ins.immediate);}else{if(ins.left>=i||ins.right>=i){return new AGCheckedInt{ok:false,value:0};}AGCheckedInt result=ag_arithmetic(ins.opcode,values[ins.left],values[ins.right]);if(!result.ok){return result;}values.push(result.value);}}return new AGCheckedInt{ok:true,value:values[values.len()-1]};}
