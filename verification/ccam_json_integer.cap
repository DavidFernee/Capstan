// First executable component of the bounded CCAM JSON decoder.
// Accepts only JSON integer lexemes representable as signed i64. Input remains
// Tainted; the caller chooses the field type before invoking this routine.

import "ccam_json_integer_core.cap";
int main() {
    if (let v = ccam_json_parse_i64(taint("0"))) { if (v != 0) { return 1; } } else { return 1; }
    if (let v = ccam_json_parse_i64(taint("-0"))) { if (v != 0) { return 1; } } else { return 1; }
    if (let v = ccam_json_parse_i64(taint("42"))) { if (v != 42) { return 1; } } else { return 1; }
    if (let v = ccam_json_parse_i64(taint("-42"))) { if (v != -42) { return 1; } } else { return 1; }
    if (let v = ccam_json_parse_i64(taint("9223372036854775807"))) { if (v != JSON_I64_MAX) { return 1; } } else { return 1; }
    if (let v = ccam_json_parse_i64(taint("-9223372036854775808"))) { if (v != JSON_I64_MIN) { return 1; } } else { return 1; }

    if (ccam_json_parse_i64(taint("")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("-")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("+1")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("01")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("-01")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("1.0")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("1e0")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("--1")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("9223372036854775808")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("-9223372036854775809")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("99999999999999999999")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("true")) != none) { return 1; }
    if (ccam_json_parse_i64(taint("null")) != none) { return 1; }
    println("CCAM JSON signed integer parser: ok");
    return 0;
}

test "CCAM JSON integer parser accepts signed 64-bit boundaries" {
    if (let hi = ccam_json_parse_i64(taint("9223372036854775807"))) { assert(hi == JSON_I64_MAX); } else { assert(false); }
    if (let lo = ccam_json_parse_i64(taint("-9223372036854775808"))) { assert(lo == JSON_I64_MIN); } else { assert(false); }
}

test "CCAM JSON integer parser rejects overflow" {
    assert(ccam_json_parse_i64(taint("9223372036854775808")) == none);
    assert(ccam_json_parse_i64(taint("-9223372036854775809")) == none);
    assert(ccam_json_parse_i64(taint("99999999999999999999")) == none);
}

test "CCAM JSON integer parser rejects non-integer number forms" {
    assert(ccam_json_parse_i64(taint("1.0")) == none);
    assert(ccam_json_parse_i64(taint("1e0")) == none);
    assert(ccam_json_parse_i64(taint("+1")) == none);
    assert(ccam_json_parse_i64(taint("01")) == none);
    assert(ccam_json_parse_i64(taint("-01")) == none);
}

test "CCAM JSON integer parser rejects truncated and non-number tokens" {
    assert(ccam_json_parse_i64(taint("")) == none);
    assert(ccam_json_parse_i64(taint("-")) == none);
    assert(ccam_json_parse_i64(taint("true")) == none);
    assert(ccam_json_parse_i64(taint("null")) == none);
}
