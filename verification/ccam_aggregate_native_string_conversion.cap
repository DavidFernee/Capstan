    b.push(0); b.push(72); b.push(131); b.push(196); b.push(32); b.push(195);
    return true;
}

test "native scalar conversion leaf has fixed size" {
    List<int> b = new List<int>();
    assert(ag_nv_emit_bytes_conversion(b));
    assert(b.len() == 262);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-string-conversion.bin", data));
}
