// The parser supplies operand position because '+', '-', and '!' can denote
// either unary or binary operators depending on context.
int ag_operator_arity(int op, bool unary_context) {
    if (unary_context) { return ag_unary_operator(op) ? 1 : 0; }
    return ag_operator_class(op) > 0 ? 2 : 0;
}
