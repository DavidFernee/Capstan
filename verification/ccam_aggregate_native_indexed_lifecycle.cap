// Linux x86-64 opt-in indexed arena lifecycle; private trusted ABI.
// Init RAX=capacity (1024-byte multiple, 1 KiB..64 MiB); R12/R13/R14/
// RDI/RSI must all be zero. One private anonymous RW mmap, no executable
// pages. Logical arena and bitmap occupy disjoint contiguous regions.
// Success RAX=R12=base, R13=0, R14=capacity, RDI=base+capacity,
// RSI=capacity/128, RDX=0. Kernel zero-initialises both regions.
// Release requires those exact live, exclusively owned mapping identities;
// checks numerical layout, not ownership. One munmap covers both regions;
// on success all five metadata registers cleared. Invalid state or syscall
// failure returns RAX=0/RDX=1, preserves original metadata.
// Linux rounds mapping length up to pages. Logical limits exclude padding.
// No mixing with unindexed allocators, concurrent access, GC or canonical ABI.
import "ccam_aggregate_native_indexed_arena.cap";

const int AG_INDEXED_LIFECYCLE_RELEASE_OFFSET = 144;
const int AG_INDEXED_LIFECYCLE_SIZE = 265;

