test "indexed arena lifecycle and allocator emit exact leaf lengths" {
    List<int> b = new List<int>();
    assert(ag_native_emit_indexed_lifecycle(b));
    assert(b.len() == 265 && AG_INDEXED_LIFECYCLE_RELEASE_OFFSET == 144);
    string data = "";
    for (int i = 0; i < b.len(); i += 1) { data = data + char_str(b[i]); }
    assert(write_file("build/ccam-native-indexed-lifecycle.bin", data));
}
