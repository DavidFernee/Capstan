// Candidate Linux x86-64 freestanding arena reservation leaf.
// Internal ABI: R12=nonzero trusted backing base, R13=used, R14=capacity,
// RAX=requested bytes. Returns RAX=old base+used, RDX=0 on success;
// RAX=0,RDX=1 on failure. R13 changes only on success.
// RCX/R8/flags clobbered. No memory access other than RET. Caller must
// establish mapped writable backing, alignment and ownership. Zero-byte
// reservations at the end are permitted but cannot be dereferenced.
// The fixed short branches all target offset 59; no external relocation.
import "ccam_aggregate_byte_buffer.cap";

const int AG_NATIVE_RESERVE_SIZE = 67;

bool ag_native_emit_arena_reserve(List<int> code) {
    if (code.len() > AG_BYTE_LIMIT - AG_NATIVE_RESERVE_SIZE) { return false; }
    code.push(77); code.push(133); code.push(228); code.push(116); code.push(54);
    code.push(72); code.push(133); code.push(192); code.push(120); code.push(49);
    code.push(77); code.push(133); code.push(237); code.push(120); code.push(44);
    code.push(77); code.push(133); code.push(246); code.push(120); code.push(39);
    code.push(77); code.push(57); code.push(245); code.push(119); code.push(34);
    code.push(76); code.push(137); code.push(225); code.push(76); code.push(1); code.push(241); code.push(114); code.push(26);
    code.push(76); code.push(137); code.push(241); code.push(76); code.push(41); code.push(233); code.push(72); code.push(57); code.push(200);
    code.push(119); code.push(15); code.push(77); code.push(137); code.push(224); code.push(77); code.push(1); code.push(232); code.push(73); code.push(1); code.push(197); code.push(76); code.push(137); code.push(192); code.push(49);
    code.push(210); code.push(195);
    code.push(49); code.push(192); code.push(186); code.push(1); code.push(0); code.push(0); code.push(0); code.push(195);
    return true;
}

test "native arena reserve fragment has checked common failure edges and atomic size admission" {
    List<int> code = new List<int>();
    code.push(144);
    assert(ag_native_emit_arena_reserve(code));
    assert(code.len() == AG_NATIVE_RESERVE_SIZE + 1 && code[0] == 144);
    List<int> branches = new List<int>();
    branches.push(3); branches.push(8); branches.push(13); branches.push(18);
    branches.push(23); branches.push(31); branches.push(42);
    for (int i = 0; i < branches.len(); i += 1) {
        int branch = branches[i];
        assert(branch + 2 + code[branch + 2] == 59);
    }
    assert(code[59] == 195 && code[67] == 195);
}
