// Candidate cyclic CFG must-initialisation analysis.
// Reachability and generation are solved before read checks, so transient
// approximations cannot produce spurious acceptance.
import "ccam_aggregate_cfg.cap";

const int AG_FP_MAX_WORK = 16777216;

// Logical work units, not host allocation/time guarantees. Width and operand
// lengths are admitted independently; precharge each full-width transfer.
struct AGFPBudget { int remaining; }

bool ag_fp_charge(AGFPBudget budget, int amount) {
    if (budget.remaining < 0 || budget.remaining > AG_FP_MAX_WORK ||
        amount < 0 || amount > budget.remaining) { return false; }
    budget.remaining -= amount;
    return true;
}

bool ag_fp_charge_transfer(AGFPBudget budget, int width, AGBlockInstruction instruction) {
    if (width < 0 || width > AG_SCHEMA_MAX_REGS ||
        instruction.operands.len() > AG_SCHEMA_MAX_OPERANDS) { return false; }
    return ag_fp_charge(budget, 1 + 2 * width + instruction.operands.len());
}

bool ag_fp_target(int count, int target) {
    return target >= 0 && target < count;
}

bool ag_fp_equal(List<bool> a, List<bool> b) {
    if (a.len() != b.len()) { return false; }
    for (int i = 0; i < a.len(); i += 1) {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

// Return the converged entry state for every block so the function validator
// can additionally prove that each reachable return register is initialised.
bool ag_fp_validate(
    List<int> kinds, List<bool> entry, List<AGCFGBlock> blocks,
    List<AGCFGState> final_states
) {
    return ag_fp_validate_budget(kinds, entry, blocks, final_states,
        new AGFPBudget{remaining: AG_FP_MAX_WORK});
}

bool ag_fp_validate_budget(List<int> kinds, List<bool> entry, List<AGCFGBlock> blocks,
    List<AGCFGState> final_states, AGFPBudget budget) {
    int count = blocks.len();
    int width = kinds.len();
    if (count <= 0 || count > AG_FLOW_MAX_BLOCKS || width > AG_SCHEMA_MAX_REGS ||
        entry.len() != width || width > AG_CFG_MAX_CELLS / count ||
        final_states.len() != 0) { return false; }
    if (!ag_fp_charge(budget, width + count)) { return false; }
    for (int r = 0; r < width; r += 1) {
        if (!ag_schema_kind(kinds[r])) { return false; }
    }
    int total = 0;
    List<AGCFGState> states = new List<AGCFGState>();
    for (int i = 0; i < count; i += 1) {
        AGCFGBlock block = blocks[i];
        if (block.instructions.len() > AG_CFG_MAX_INSTRUCTIONS - total) { return false; }
        total += block.instructions.len();
        for (int j = 0; j < block.instructions.len(); j += 1) {
            AGBlockInstruction ins = block.instructions[j];
            if (ins.operands.len() > AG_SCHEMA_MAX_OPERANDS ||
                !ag_fp_charge(budget, 1 + ins.operands.len()) ||
                !ag_schema_operands(kinds, ins.opcode, ins.kind, ins.operands)) { return false; }
        }
        if (block.terminator == 0) {
            if (block.condition != -1 || block.yes != -1 || block.no != -1) { return false; }
        } else if (block.terminator == 1) {
            if (block.condition != -1 || block.no != -1 || !ag_fp_target(count, block.yes)) { return false; }
        } else if (block.terminator == 2) {
            if (!ag_schema_register(kinds, block.condition, AG_SCHEMA_BOOL) ||
                !ag_fp_target(count, block.yes) || !ag_fp_target(count, block.no)) { return false; }
        } else { return false; }
        states.push(new AGCFGState{reached: false, ready: new List<bool>()});
    }
    states[0] = new AGCFGState{reached: true, ready: entry};
    bool changed = true;
    while (changed) {
        changed = false;
        for (int i = 0; i < count; i += 1) {
            AGCFGBlock block = blocks[i];
            if (!ag_fp_charge(budget, 1 + 6 * width)) { return false; }
            AGCFGState state = states[i];
            if (state.reached) {
                List<bool> output = new List<bool>();
                for (int r = 0; r < width; r += 1) { output.push(state.ready[r]); }
                for (int j = 0; j < block.instructions.len(); j += 1) {
                    AGBlockInstruction ins = block.instructions[j];
                    if (!ag_fp_charge_transfer(budget, width, ins)) { return false; }
                    AGTransferResult generated = ag_transfer_generation(
                        kinds, output, ins.opcode, ins.kind, ins.operands
                    );
                    if (!generated.ok) { return false; }
                    output = generated.ready;
                }
                if (block.terminator != 0) {
                    AGCFGState before = states[block.yes];
                    if (!ag_cfg_propagate(states, block.yes, output)) { return false; }
                    if (!before.reached || !ag_fp_equal(before.ready, states[block.yes].ready)) { changed = true; }
                }
                if (block.terminator == 2) {
                    AGCFGState before_no = states[block.no];
                    if (!ag_cfg_propagate(states, block.no, output)) { return false; }
                    if (!before_no.reached || !ag_fp_equal(before_no.ready, states[block.no].ready)) { changed = true; }
                }
            }
        }
    }
    // At convergence, check every reachable read against its must-state.
    for (int i = 0; i < count; i += 1) {
        if (!ag_fp_charge(budget, 1 + width)) { return false; }
        if (states[i].reached) {
            List<bool> ready = new List<bool>();
            for (int r = 0; r < width; r += 1) { ready.push(states[i].ready[r]); }
            AGCFGBlock block = blocks[i];
            for (int j = 0; j < block.instructions.len(); j += 1) {
                AGBlockInstruction ins = block.instructions[j];
                if (!ag_fp_charge_transfer(budget, width, ins)) { return false; }
                AGTransferResult next = ag_transfer(
                    kinds, ready, ins.opcode, ins.kind, ins.operands
                );
                if (!next.ok) { return false; }
                ready = next.ready;
            }
            if (block.terminator == 2 &&
                !ag_transfer_condition(kinds, ready, block.condition)) { return false; }
        }
    }
    // Publish only after the entire validation succeeds.
    if (!ag_fp_charge(budget, count)) { return false; }
    for (int i = 0; i < count; i += 1) { final_states.push(states[i]); }
    return true;
}

test "cyclic aggregate CFG does not bootstrap readiness from a backedge" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF);
    List<bool> entry = new List<bool>();
    entry.push(false); entry.push(true);
    List<int> get_ops = new List<int>();
    get_ops.push(0); get_ops.push(1); get_ops.push(0);
    List<int> len_ops = new List<int>();
    len_ops.push(0); len_ops.push(1);
    List<AGBlockInstruction> reads = new List<AGBlockInstruction>();
    reads.push(new AGBlockInstruction{opcode: 1, kind: AG_SCHEMA_INT, operands: get_ops});
    List<AGBlockInstruction> writes = new List<AGBlockInstruction>();
    writes.push(new AGBlockInstruction{opcode: 3, kind: AG_SCHEMA_INT, operands: len_ops});
    List<AGCFGBlock> blocks = new List<AGCFGBlock>();
    blocks.push(new AGCFGBlock{instructions: reads, terminator: 1, condition: -1, yes: 1, no: -1});
    blocks.push(new AGCFGBlock{instructions: writes, terminator: 1, condition: -1, yes: 0, no: -1});
    List<AGCFGState> states = new List<AGCFGState>();
    assert(!ag_fp_validate(kinds, entry, blocks, states));
    entry[0] = true;
    states = new List<AGCFGState>();
    assert(ag_fp_validate(kinds, entry, blocks, states));
    assert(states.len() == 2 && states[0].reached && states[1].reached);
}

test "fixedpoint transfer handles array allocation append and byte operations" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_INT);
    List<bool> entry = new List<bool>();
    entry.push(false); entry.push(true); entry.push(false);
    List<int> allocation = new List<int>();
    allocation.push(0); allocation.push(0); allocation.push(4);
    List<int> append = new List<int>();
    append.push(0); append.push(1);
    List<int> length = new List<int>();
    length.push(2); length.push(0);
    List<AGBlockInstruction> instructions = new List<AGBlockInstruction>();
    instructions.push(new AGBlockInstruction{opcode: 5, kind: AG_SCHEMA_INT, operands: allocation});
    instructions.push(new AGBlockInstruction{opcode: 6, kind: AG_SCHEMA_INT, operands: append});
    instructions.push(new AGBlockInstruction{opcode: 3, kind: AG_SCHEMA_INT, operands: length});
    List<AGCFGBlock> blocks = new List<AGCFGBlock>();
    blocks.push(new AGCFGBlock{instructions: instructions, terminator: 0, condition: -1, yes: -1, no: -1});
    List<AGCFGState> states = new List<AGCFGState>();
    assert(ag_fp_validate(kinds, entry, blocks, states));
    assert(states[0].ready[0] == false && states[0].ready[2] == false);
}

test "fixedpoint rejects uninitialised array append values" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    List<bool> entry = new List<bool>();
    entry.push(true); entry.push(false);
    List<int> append = new List<int>();
    append.push(0); append.push(1);
    List<AGBlockInstruction> instructions = new List<AGBlockInstruction>();
    instructions.push(new AGBlockInstruction{opcode: 6, kind: AG_SCHEMA_INT, operands: append});
    List<AGCFGBlock> blocks = new List<AGCFGBlock>();
    blocks.push(new AGCFGBlock{instructions: instructions, terminator: 0, condition: -1, yes: -1, no: -1});
    List<AGCFGState> states = new List<AGCFGState>();
    assert(!ag_fp_validate(kinds, entry, blocks, states));
}

test "fixedpoint transfer handles aliased immutable byte operations" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    List<bool> entry = new List<bool>();
    entry.push(true); entry.push(true); entry.push(false);
    List<int> concat = new List<int>();
    concat.push(0); concat.push(0); concat.push(1);
    List<int> length = new List<int>();
    length.push(2); length.push(0);
    List<AGBlockInstruction> instructions = new List<AGBlockInstruction>();
    instructions.push(new AGBlockInstruction{opcode: 8, kind: AG_SCHEMA_REF, operands: concat});
    instructions.push(new AGBlockInstruction{opcode: 7, kind: AG_SCHEMA_INT, operands: length});
    List<AGCFGBlock> blocks = new List<AGCFGBlock>();
    blocks.push(new AGCFGBlock{instructions: instructions, terminator: 0, condition: -1, yes: -1, no: -1});
    List<AGCFGState> states = new List<AGCFGState>();
    assert(ag_fp_validate(kinds, entry, blocks, states));
}
