// Candidate aggregate operand schema, independent of scalar CCAM v0.1.
// Structural checks only: no layout, control-flow or provenance theorem.
const int AG_SCHEMA_MAX_REGS = 262144;
const int AG_SCHEMA_INT = 1;
const int AG_SCHEMA_BOOL = 2;
const int AG_SCHEMA_REF = 3;
const int AG_SCHEMA_MAX_ARRAY_CAPACITY = 65536;

bool ag_schema_kind(int kind) {
    return kind == AG_SCHEMA_INT || kind == AG_SCHEMA_BOOL || kind == AG_SCHEMA_REF;
}

bool ag_schema_register(List<int> kinds, int index, int expected) {
    if (kinds.len() > AG_SCHEMA_MAX_REGS || index < 0 || index >= kinds.len()) { return false; }
    return ag_schema_kind(expected) && kinds[index] == expected;
}

// 1 array_get [destination,array,index]; 2 array_set [value,array,index];
// 3 array_len [destination,array]; 4 byte_get [destination,bytes,index];
// 5 array_alloc [destination,reference-element-type-id,capacity];
// 6 array_append [array,value]. Immediate operands are bounded integers.
bool ag_schema_operands(List<int> kinds, int opcode, int element_kind, List<int> operands) {
    if (kinds.len() > AG_SCHEMA_MAX_REGS || !ag_schema_kind(element_kind)) { return false; }
    if (opcode == 1 || opcode == 2 || opcode == 4) {
        if (operands.len() != 3 || (opcode == 4 && element_kind != AG_SCHEMA_INT)) { return false; }
        return ag_schema_register(kinds, operands[0], element_kind) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[2], AG_SCHEMA_INT);
    }
    if (opcode == 3) {
        if (operands.len() != 2) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_INT) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
    }
    if (opcode == 5) {
        if (operands.len() != 3 ||
            !ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) ||
            operands[1] < 0 || operands[2] < 0 ||
            operands[2] > AG_SCHEMA_MAX_ARRAY_CAPACITY) { return false; }
        return element_kind == AG_SCHEMA_REF || operands[1] == 0;
    }
    if (opcode == 6) {
        if (operands.len() != 2) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], element_kind);
    }
    return false;
}

test "aggregate schema accepts typed dynamic indices and array lifecycle" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    List<int> indexed = new List<int>();
    indexed.push(0); indexed.push(1); indexed.push(2);
    assert(ag_schema_operands(kinds, 1, AG_SCHEMA_INT, indexed));
    assert(ag_schema_operands(kinds, 2, AG_SCHEMA_INT, indexed));
    assert(ag_schema_operands(kinds, 4, AG_SCHEMA_INT, indexed));
    List<int> length = new List<int>();
    length.push(0); length.push(1);
    assert(ag_schema_operands(kinds, 3, AG_SCHEMA_BOOL, length));
    List<int> allocation = new List<int>();
    allocation.push(1); allocation.push(0); allocation.push(32);
    assert(ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    List<int> append = new List<int>();
    append.push(1); append.push(0);
    assert(ag_schema_operands(kinds, 6, AG_SCHEMA_INT, append));
    assert(!ag_schema_operands(kinds, 7, AG_SCHEMA_INT, indexed));
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, new List<int>()));
}

test "aggregate schema rejects wrong kinds and invalid allocation immediates" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_BOOL);
    List<int> indexed = new List<int>();
    indexed.push(0); indexed.push(1); indexed.push(2);
    assert(!ag_schema_operands(kinds, 1, AG_SCHEMA_INT, indexed));
    List<int> allocation = new List<int>();
    allocation.push(1); allocation.push(0); allocation.push(65537);
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[2] = -1;
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[2] = 2; allocation[1] = 9;
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[1] = 7;
    assert(ag_schema_operands(kinds, 5, AG_SCHEMA_REF, allocation));
    List<int> append = new List<int>();
    append.push(1); append.push(2);
    assert(!ag_schema_operands(kinds, 6, AG_SCHEMA_INT, append));
}
