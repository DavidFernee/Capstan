// Candidate aggregate operand schema, independent of scalar CCAM v0.1.
// Structural checks only: no layout, control-flow or provenance theorem.
const int AG_SCHEMA_MAX_REGS = 262144;
const int AG_SCHEMA_INT = 1;
const int AG_SCHEMA_BOOL = 2;
const int AG_SCHEMA_REF = 3;
// Result-only tag; deliberately excluded from ag_schema_kind.
const int AG_RESULT_VOID = 4;
const int AG_SCHEMA_MAX_ARRAY_CAPACITY = 65536;

bool ag_schema_kind(int kind) {
    return kind == AG_SCHEMA_INT || kind == AG_SCHEMA_BOOL || kind == AG_SCHEMA_REF;
}

bool ag_schema_register(List<int> kinds, int index, int expected) {
    if (kinds.len() > AG_SCHEMA_MAX_REGS || index < 0 || index >= kinds.len()) { return false; }
    return ag_schema_kind(expected) && kinds[index] == expected;
}

// 1 array_get [destination,array,index]; 2 array_set [value,array,index];
// 3 array_len [destination,array]; 4 byte_get [destination,bytes,index];
// 5 array_alloc [destination,reference-element-type-id,capacity];
// 6 array_append [array,value]; 7 bytes_len [destination,bytes];
// 8 bytes_concat [destination,left,right]. Immediate operands are bounded integers.
// Candidate record operations (not canonical scalar CCAM).
const int AG_OP_FIELD_GET = 9;
const int AG_OP_FIELD_SET = 10;
const int AG_OP_RECORD_ALLOC = 11;
const int AG_OP_SCALAR_CONST = 12;
const int AG_SCHEMA_MAX_RECORD_FIELDS = 4096;
const int AG_SCHEMA_MAX_OPERANDS = 8194;

bool ag_schema_value_shape(int kind, int descriptor) {
    if (kind == AG_SCHEMA_REF) { return descriptor != 0; }
    return (kind == AG_SCHEMA_INT || kind == AG_SCHEMA_BOOL) && descriptor == 0;
}

// Field operands: [value register, object register, record ID, field index, value shape].
// Allocation operands: [destination, record ID, (field kind, field shape)*].
// Scalar constant operands: [destination, value]; booleans are exactly 0 or 1.
bool ag_schema_record_immediates(int opcode, int kind, List<int> operands) {
    if (opcode == AG_OP_FIELD_GET || opcode == AG_OP_FIELD_SET) {
        return operands.len() == 5 && operands[2] > 0 &&
            operands[3] >= 0 && operands[3] < AG_SCHEMA_MAX_RECORD_FIELDS &&
            ag_schema_value_shape(kind, operands[4]);
    }
    if (opcode == AG_OP_RECORD_ALLOC) {
        if (kind != AG_SCHEMA_REF || operands.len() < 2 ||
            operands.len() > AG_SCHEMA_MAX_OPERANDS || operands.len() % 2 != 0 ||
            operands[1] <= 0) { return false; }
        for (int i = 2; i < operands.len(); i += 2) {
            if (!ag_schema_value_shape(operands[i], operands[i + 1])) { return false; }
        }
        return true;
    }
    if (opcode == AG_OP_SCALAR_CONST) {
        return operands.len() == 2 && (kind == AG_SCHEMA_INT ||
            (kind == AG_SCHEMA_BOOL && (operands[1] == 0 || operands[1] == 1)));
    }
    return false;
}

// Candidate scalar operations in aggregate CFGs. Arithmetic is signed i64.
const int AG_OP_MOVE = 13;
const int AG_OP_ADD = 14;
const int AG_OP_SUB = 15;
const int AG_OP_MUL = 16;
const int AG_OP_DIV = 17;
const int AG_OP_REM = 18;
const int AG_OP_EQ = 19;
const int AG_OP_LT = 20;
const int AG_OP_LE = 21;
const int AG_OP_NE = 22;
const int AG_OP_GT = 23;
const int AG_OP_GE = 24;
const int AG_OP_NOT = 25;

bool ag_schema_scalar_operands(List<int> kinds, int opcode, int kind, List<int> operands) {
    if (opcode == AG_OP_MOVE) {
        return operands.len() == 2 && ag_schema_register(kinds, operands[0], kind) &&
            ag_schema_register(kinds, operands[1], kind);
    }
    if (opcode == AG_OP_NOT) {
        return kind == AG_SCHEMA_BOOL && operands.len() == 2 &&
            ag_schema_register(kinds, operands[0], AG_SCHEMA_BOOL) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_BOOL);
    }
    if (opcode < AG_OP_ADD || opcode > AG_OP_GE || operands.len() != 3) { return false; }
    if (opcode <= AG_OP_REM) {
        return kind == AG_SCHEMA_INT && ag_schema_register(kinds, operands[0], AG_SCHEMA_INT) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_INT) &&
            ag_schema_register(kinds, operands[2], AG_SCHEMA_INT);
    }
    if (kind != AG_SCHEMA_INT &&
        !(kind == AG_SCHEMA_BOOL && (opcode == AG_OP_EQ || opcode == AG_OP_NE))) { return false; }
    return ag_schema_register(kinds, operands[0], AG_SCHEMA_BOOL) &&
        ag_schema_register(kinds, operands[1], kind) &&
        ag_schema_register(kinds, operands[2], kind);
}

// Growable push [array,value], discarded optional pop [array].
const int AG_OP_LIST_PUSH = 26;
const int AG_OP_LIST_POP_DISCARD = 27;

// Direct call operands: [destination, function index, argument registers...].
const int AG_OP_DIRECT_CALL = 28;
const int AG_DIRECT_MAX_ARGS = 256;

// Optional operations carry the expected exact descriptor as an immediate.
const int AG_OP_OPT_NONE = 29;
const int AG_OP_OPT_SOME = 30;
const int AG_OP_OPT_PRESENT = 31;
const int AG_OP_OPT_UNWRAP = 32;

bool ag_schema_optional_descriptor(int descriptor) {
    return descriptor == 8193 || descriptor == 8194 || descriptor == 8195 ||
        (descriptor > 10000 && descriptor <= 14096);
}

int ag_schema_optional_payload(int descriptor) {
    if (descriptor == 8193) { return AG_SCHEMA_INT; }
    if (descriptor == 8194) { return AG_SCHEMA_BOOL; }
    if (ag_schema_optional_descriptor(descriptor)) { return AG_SCHEMA_REF; }
    return 0;
}

bool ag_schema_optional_operands(List<int> kinds, int opcode, int kind, List<int> operands) {
    if (opcode == AG_OP_OPT_NONE) {
        return kind == AG_SCHEMA_REF && operands.len() == 2 &&
            ag_schema_optional_descriptor(operands[1]) &&
            ag_schema_register(kinds, operands[0], AG_SCHEMA_REF);
    }
    if (operands.len() != 3 || !ag_schema_optional_descriptor(operands[2])) { return false; }
    int payload = ag_schema_optional_payload(operands[2]);
    if (opcode == AG_OP_OPT_SOME) {
        return kind == AG_SCHEMA_REF && ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], payload);
    }
    if (opcode == AG_OP_OPT_PRESENT) {
        return kind == AG_SCHEMA_BOOL && ag_schema_register(kinds, operands[0], AG_SCHEMA_BOOL) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
    }
    return opcode == AG_OP_OPT_UNWRAP && kind == payload &&
        ag_schema_register(kinds, operands[0], payload) &&
        ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
}

// Map allocation [dest,payload optional descriptor], get/has [dest,map,key,descriptor],
// set [map,key,value,descriptor]. Maps have no source len method.
const int AG_OP_MAP_NEW = 33;
const int AG_OP_MAP_GET = 34;
const int AG_OP_MAP_HAS = 35;
const int AG_OP_MAP_SET = 36;

bool ag_schema_map_operands(List<int> kinds, int opcode, int kind, List<int> operands) {
    if (opcode == AG_OP_MAP_NEW) {
        return kind == AG_SCHEMA_REF && operands.len() == 2 &&
            ag_schema_optional_descriptor(operands[1]) &&
            ag_schema_register(kinds, operands[0], AG_SCHEMA_REF);
    }
    if (operands.len() != 4 || !ag_schema_optional_descriptor(operands[3])) { return false; }
    if (opcode == AG_OP_MAP_SET) {
        return kind == ag_schema_optional_payload(operands[3]) &&
            ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[2], kind);
    }
    int result = AG_SCHEMA_REF;
    if (opcode == AG_OP_MAP_HAS) { result = AG_SCHEMA_BOOL; }
    return (opcode == AG_OP_MAP_GET || opcode == AG_OP_MAP_HAS) && kind == result &&
        ag_schema_register(kinds, operands[0], result) &&
        ag_schema_register(kinds, operands[1], AG_SCHEMA_REF) &&
        ag_schema_register(kinds, operands[2], AG_SCHEMA_REF);
}

bool ag_schema_operands(List<int> kinds, int opcode, int element_kind, List<int> operands) {
    if (kinds.len() > AG_SCHEMA_MAX_REGS) { return false; }
    if (opcode >= AG_OP_MAP_NEW && opcode <= AG_OP_MAP_SET) {
        return ag_schema_map_operands(kinds, opcode, element_kind, operands);
    }
    if (opcode >= AG_OP_OPT_NONE && opcode <= AG_OP_OPT_UNWRAP) {
        return ag_schema_optional_operands(kinds, opcode, element_kind, operands);
    }
    if (opcode == AG_OP_DIRECT_CALL) {
        if (operands.len() < 2 || operands.len() > AG_DIRECT_MAX_ARGS + 2 ||
            operands[1] < 0) { return false; }
        if (element_kind == AG_RESULT_VOID) {
            if (operands[0] != -1) { return false; }
        } else if (!ag_schema_register(kinds, operands[0], element_kind)) { return false; }
        for (int i = 2; i < operands.len(); i += 1) {
            int reg = operands[i];
            if (reg < 0 || reg >= kinds.len() || !ag_schema_kind(kinds[reg])) { return false; }
        }
        return true;
    }
    if (opcode == AG_OP_LIST_PUSH) {
        return operands.len() == 2 && ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], element_kind);
    }
    if (opcode == AG_OP_LIST_POP_DISCARD) {
        return ag_schema_kind(element_kind) && operands.len() == 1 &&
            ag_schema_register(kinds, operands[0], AG_SCHEMA_REF);
    }
    if (kinds.len() > AG_SCHEMA_MAX_REGS || !ag_schema_kind(element_kind)) { return false; }
    if (opcode >= AG_OP_MOVE && opcode <= AG_OP_NOT) {
        return ag_schema_scalar_operands(kinds, opcode, element_kind, operands);
    }
    if (opcode >= AG_OP_FIELD_GET && opcode <= AG_OP_SCALAR_CONST) {
        if (!ag_schema_record_immediates(opcode, element_kind, operands) ||
            !ag_schema_register(kinds, operands[0], element_kind)) { return false; }
        if (opcode == AG_OP_FIELD_GET || opcode == AG_OP_FIELD_SET) {
            return ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
        }
        return true;
    }
    if (opcode == 1 || opcode == 2 || opcode == 4) {
        if (operands.len() != 3 || (opcode == 4 && element_kind != AG_SCHEMA_INT)) { return false; }
        return ag_schema_register(kinds, operands[0], element_kind) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[2], AG_SCHEMA_INT);
    }
    if (opcode == 3) {
        if (operands.len() != 2) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_INT) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
    }
    if (opcode == 5) {
        if (operands.len() != 3 ||
            !ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) ||
            operands[1] < 0 || operands[2] < 0 ||
            operands[2] > AG_SCHEMA_MAX_ARRAY_CAPACITY) { return false; }
        return element_kind == AG_SCHEMA_REF || operands[1] == 0;
    }
    if (opcode == 6) {
        if (operands.len() != 2) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], element_kind);
    }
    if (opcode == 7) {
        if (operands.len() != 2 || element_kind != AG_SCHEMA_INT) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_INT) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF);
    }
    if (opcode == 8) {
        if (operands.len() != 3 || element_kind != AG_SCHEMA_REF) { return false; }
        return ag_schema_register(kinds, operands[0], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[1], AG_SCHEMA_REF) &&
            ag_schema_register(kinds, operands[2], AG_SCHEMA_REF);
    }
    return false;
}

test "aggregate schema accepts typed dynamic indices and array lifecycle" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_INT);
    List<int> indexed = new List<int>();
    indexed.push(0); indexed.push(1); indexed.push(2);
    assert(ag_schema_operands(kinds, 1, AG_SCHEMA_INT, indexed));
    assert(ag_schema_operands(kinds, 2, AG_SCHEMA_INT, indexed));
    assert(ag_schema_operands(kinds, 4, AG_SCHEMA_INT, indexed));
    List<int> length = new List<int>();
    length.push(0); length.push(1);
    assert(ag_schema_operands(kinds, 3, AG_SCHEMA_BOOL, length));
    List<int> allocation = new List<int>();
    allocation.push(1); allocation.push(0); allocation.push(32);
    assert(ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    List<int> append = new List<int>();
    append.push(1); append.push(0);
    assert(ag_schema_operands(kinds, 6, AG_SCHEMA_INT, append));
    assert(!ag_schema_operands(kinds, 7, AG_SCHEMA_INT, indexed));
    List<int> byte_length = new List<int>();
    byte_length.push(0); byte_length.push(1);
    assert(ag_schema_operands(kinds, 7, AG_SCHEMA_INT, byte_length));
    List<int> byte_concat = new List<int>();
    byte_concat.push(1); byte_concat.push(1); byte_concat.push(1);
    assert(ag_schema_operands(kinds, 8, AG_SCHEMA_REF, byte_concat));
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, new List<int>()));
}

test "aggregate schema rejects wrong kinds and invalid allocation immediates" {
    List<int> kinds = new List<int>();
    kinds.push(AG_SCHEMA_INT); kinds.push(AG_SCHEMA_REF); kinds.push(AG_SCHEMA_BOOL);
    List<int> indexed = new List<int>();
    indexed.push(0); indexed.push(1); indexed.push(2);
    assert(!ag_schema_operands(kinds, 1, AG_SCHEMA_INT, indexed));
    List<int> allocation = new List<int>();
    allocation.push(1); allocation.push(0); allocation.push(65537);
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[2] = -1;
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[2] = 2; allocation[1] = 9;
    assert(!ag_schema_operands(kinds, 5, AG_SCHEMA_INT, allocation));
    allocation[1] = 7;
    assert(ag_schema_operands(kinds, 5, AG_SCHEMA_REF, allocation));
    List<int> append = new List<int>();
    append.push(1); append.push(2);
    assert(!ag_schema_operands(kinds, 6, AG_SCHEMA_INT, append));
}
