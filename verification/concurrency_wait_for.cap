// Bounded executable wait-for classifier for two tasks.
//
// This first executable slice covers typed JOIN and external EVENT waits.
// It is intentionally finite and closed over two task identities; it is not
// a general resource graph, scheduler, or parameterised deadlock proof.
// Classification is derived from runnable tasks, satisfied join predicates,
// explicit environment state, and exploration completeness.

const int CWF_TASK_RUNNABLE = 1;
const int CWF_TASK_BLOCKED = 2;
const int CWF_TASK_DONE = 3;
const int CWF_TASK_CANCELLED = 4;
const int CWF_TASK_FAILED = 5;

const int CWF_WAIT_NONE = 0;
const int CWF_WAIT_JOIN = 1;
const int CWF_WAIT_EVENT = 2;

const int CWF_ENV_CLOSED = 0;
const int CWF_ENV_LIVE = 1;
const int CWF_ENV_UNKNOWN = 2;

const int CWF_RESULT_INVALID = 0;
const int CWF_RESULT_TERMINAL_SUCCESS = 1;
const int CWF_RESULT_TERMINAL_FAILURE = 2;
const int CWF_RESULT_TERMINAL_CANCELLED = 3;
const int CWF_RESULT_PROGRESS_ENABLED = 4;
const int CWF_RESULT_ENVIRONMENT_WAIT = 5;
const int CWF_RESULT_DEADLOCK = 6;
const int CWF_RESULT_BOUNDED_UNKNOWN = 7;

struct CWFState {
    int task_a_status;
    int task_b_status;
    int task_a_wait_kind;
    int task_b_wait_kind;
    int task_a_wait_target;
    int task_b_wait_target;
    int environment;
    bool exploration_complete;
}

struct CWFClassification {
    int result;
    int witness_task;
    int witness_target;
    string reason;
}

bool cwf_terminal(int status) {
    return status == CWF_TASK_DONE ||
        status == CWF_TASK_CANCELLED ||
        status == CWF_TASK_FAILED;
}

bool cwf_status_valid(int status) {
    return status == CWF_TASK_RUNNABLE ||
        status == CWF_TASK_BLOCKED || cwf_terminal(status);
}

// A task is blocked iff it has exactly one typed wait. JOIN targets are
// another task in this finite model; EVENT waits use target -1.
bool cwf_task_valid(int task_id, int status, int wait_kind, int target) {
    if (status == CWF_TASK_BLOCKED) {
        if (wait_kind == CWF_WAIT_JOIN) {
            return target >= 0 && target <= 1 && target != task_id;
        }
        if (wait_kind == CWF_WAIT_EVENT) { return target == -1; }
        return false;
    }
    return wait_kind == CWF_WAIT_NONE && target == -1;
}

bool cwf_invariant(CWFState state) {
    if (!cwf_status_valid(state.task_a_status) ||
        !cwf_status_valid(state.task_b_status)) { return false; }
    if (!cwf_task_valid(0, state.task_a_status,
        state.task_a_wait_kind, state.task_a_wait_target)) { return false; }
    if (!cwf_task_valid(1, state.task_b_status,
        state.task_b_wait_kind, state.task_b_wait_target)) { return false; }
    if (state.environment != CWF_ENV_CLOSED &&
        state.environment != CWF_ENV_LIVE &&
        state.environment != CWF_ENV_UNKNOWN) { return false; }
    return true;
}

bool cwf_join_ready(CWFState state) {
    if (state.task_a_status == CWF_TASK_BLOCKED &&
        state.task_a_wait_kind == CWF_WAIT_JOIN &&
        ((state.task_a_wait_target == 0 && cwf_terminal(state.task_a_status)) ||
         (state.task_a_wait_target == 1 && cwf_terminal(state.task_b_status)))) {
        return true;
    }
    if (state.task_b_status == CWF_TASK_BLOCKED &&
        state.task_b_wait_kind == CWF_WAIT_JOIN &&
        ((state.task_b_wait_target == 0 && cwf_terminal(state.task_a_status)) ||
         (state.task_b_wait_target == 1 && cwf_terminal(state.task_b_status)))) {
        return true;
    }
    return false;
}

bool cwf_all_terminal(CWFState state) {
    return cwf_terminal(state.task_a_status) &&
        cwf_terminal(state.task_b_status);
}

bool cwf_has_event_wait(CWFState state) {
    return (state.task_a_status == CWF_TASK_BLOCKED &&
        state.task_a_wait_kind == CWF_WAIT_EVENT) ||
        (state.task_b_status == CWF_TASK_BLOCKED &&
        state.task_b_wait_kind == CWF_WAIT_EVENT);
}

CWFClassification cwf_result(int result, int task, int target, string reason) {
    return new CWFClassification{
        result: result,
        witness_task: task,
        witness_target: target,
        reason: reason
    };
}

// Conservative precedence:
// invalid state -> known progress -> terminal -> incomplete/unknown ->
// admitted external wait -> unknown environment -> closed-world deadlock.
CWFClassification cwf_classify(CWFState state) {
    if (!cwf_invariant(state)) {
        return cwf_result(CWF_RESULT_INVALID, -1, -1, "state_invariant_failed");
    }
    if (state.task_a_status == CWF_TASK_RUNNABLE ||
        state.task_b_status == CWF_TASK_RUNNABLE || cwf_join_ready(state)) {
        return cwf_result(CWF_RESULT_PROGRESS_ENABLED, -1, -1,
            "runnable_task_or_satisfied_join");
    }
    if (cwf_all_terminal(state)) {
        if (state.task_a_status == CWF_TASK_FAILED ||
            state.task_b_status == CWF_TASK_FAILED) {
            return cwf_result(CWF_RESULT_TERMINAL_FAILURE, -1, -1,
                "all_required_tasks_terminal_with_failure");
        }
        if (state.task_a_status == CWF_TASK_CANCELLED ||
            state.task_b_status == CWF_TASK_CANCELLED) {
            return cwf_result(CWF_RESULT_TERMINAL_CANCELLED, -1, -1,
                "all_required_tasks_terminal_with_cancellation");
        }
        return cwf_result(CWF_RESULT_TERMINAL_SUCCESS, -1, -1,
            "all_required_tasks_completed");
    }
    if (!state.exploration_complete) {
        return cwf_result(CWF_RESULT_BOUNDED_UNKNOWN, -1, -1,
            "state_or_transition_exploration_incomplete");
    }
    if (cwf_has_event_wait(state) && state.environment == CWF_ENV_LIVE) {
        if (state.task_a_wait_kind == CWF_WAIT_EVENT) {
            return cwf_result(CWF_RESULT_ENVIRONMENT_WAIT, 0, -1,
                "declared_external_event_can_satisfy_wait");
        }
        return cwf_result(CWF_RESULT_ENVIRONMENT_WAIT, 1, -1,
            "declared_external_event_can_satisfy_wait");
    }
    if (cwf_has_event_wait(state) && state.environment == CWF_ENV_UNKNOWN) {
        return cwf_result(CWF_RESULT_BOUNDED_UNKNOWN, -1, -1,
            "external_event_availability_unknown");
    }
    if (state.task_a_status == CWF_TASK_BLOCKED) {
        return cwf_result(CWF_RESULT_DEADLOCK, 0, state.task_a_wait_target,
            "closed_finite_state_has_nonterminal_waits_and_no_enabled_transition");
    }
    return cwf_result(CWF_RESULT_DEADLOCK, 1, state.task_b_wait_target,
        "closed_finite_state_has_nonterminal_waits_and_no_enabled_transition");
}

CWFState cwf_join_cycle() {
    return new CWFState{
        task_a_status: CWF_TASK_BLOCKED,
        task_b_status: CWF_TASK_BLOCKED,
        task_a_wait_kind: CWF_WAIT_JOIN,
        task_b_wait_kind: CWF_WAIT_JOIN,
        task_a_wait_target: 1,
        task_b_wait_target: 0,
        environment: CWF_ENV_CLOSED,
        exploration_complete: true
    };
}

test "CWF mutual join cycle is a closed-world deadlock" {
    CWFClassification result = cwf_classify(cwf_join_cycle());
    assert(result.result == CWF_RESULT_DEADLOCK);
    assert(result.witness_task == 0 && result.witness_target == 1);
    assert(result.reason == "closed_finite_state_has_nonterminal_waits_and_no_enabled_transition");
}

test "CWF runnable provider prevents deadlock classification" {
    CWFState state = cwf_join_cycle();
    state.task_b_status = CWF_TASK_RUNNABLE;
    state.task_b_wait_kind = CWF_WAIT_NONE;
    state.task_b_wait_target = -1;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_PROGRESS_ENABLED);
}

test "CWF join of terminal task is enabled progress" {
    CWFState state = cwf_join_cycle();
    state.task_a_status = CWF_TASK_DONE;
    state.task_a_wait_kind = CWF_WAIT_NONE;
    state.task_a_wait_target = -1;
    state.task_b_wait_target = 0;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_PROGRESS_ENABLED);
}

test "CWF live external event is environment wait, not deadlock" {
    CWFState state = cwf_join_cycle();
    state.task_a_wait_kind = CWF_WAIT_EVENT;
    state.task_a_wait_target = -1;
    state.environment = CWF_ENV_LIVE;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_ENVIRONMENT_WAIT);
    assert(result.witness_task == 0);
}

test "CWF unknown external event availability fails closed" {
    CWFState state = cwf_join_cycle();
    state.task_a_wait_kind = CWF_WAIT_EVENT;
    state.task_a_wait_target = -1;
    state.environment = CWF_ENV_UNKNOWN;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_BOUNDED_UNKNOWN);
}

test "CWF explicitly closed event source is a deadlock" {
    CWFState state = cwf_join_cycle();
    state.task_a_wait_kind = CWF_WAIT_EVENT;
    state.task_a_wait_target = -1;
    state.environment = CWF_ENV_CLOSED;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_DEADLOCK);
    assert(result.witness_task == 0 && result.witness_target == -1);
}

test "CWF self-join is rejected as an invalid dependency" {
    CWFState state = cwf_join_cycle();
    state.task_a_wait_target = 0;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_INVALID);
}

test "CWF incomplete exploration cannot certify deadlock" {
    CWFState state = cwf_join_cycle();
    state.exploration_complete = false;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_BOUNDED_UNKNOWN);
}

test "CWF terminal outcomes remain distinct" {
    CWFState state = cwf_join_cycle();
    state.task_a_status = CWF_TASK_DONE;
    state.task_b_status = CWF_TASK_DONE;
    state.task_a_wait_kind = CWF_WAIT_NONE;
    state.task_b_wait_kind = CWF_WAIT_NONE;
    state.task_a_wait_target = -1;
    state.task_b_wait_target = -1;
    CWFClassification success = cwf_classify(state);
    assert(success.result == CWF_RESULT_TERMINAL_SUCCESS);
    state.task_b_status = CWF_TASK_FAILED;
    CWFClassification failure = cwf_classify(state);
    assert(failure.result == CWF_RESULT_TERMINAL_FAILURE);
    state.task_b_status = CWF_TASK_CANCELLED;
    CWFClassification cancelled = cwf_classify(state);
    assert(cancelled.result == CWF_RESULT_TERMINAL_CANCELLED);
}

test "CWF malformed blocked task without wait is invalid" {
    CWFState state = cwf_join_cycle();
    state.task_a_wait_kind = CWF_WAIT_NONE;
    state.task_a_wait_target = -1;
    CWFClassification result = cwf_classify(state);
    assert(result.result == CWF_RESULT_INVALID);
}
