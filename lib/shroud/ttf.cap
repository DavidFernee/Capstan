// Shroud: TrueType fonts.
//
// Font files are untrusted input. Font parsers written in C have a long record of
// memory-corruption vulnerabilities (FreeType CVE-2020-15999, exploited in the wild;
// Windows ATMFD CVE-2015-2426; Apple's TrueType CVE-2015-1155), because every table
// carries offsets and counts that point elsewhere in the file. In Capstan an
// out-of-range offset cannot corrupt memory, and this parser goes further: it never
// reads outside the file at all. Every read goes through a FontReader, which returns
// 0 and records the failure for any read out of bounds, so a damaged or hostile font
// is refused (font_load gives none) or a damaged glyph is drawn empty, never a stop.
//
// Supported: TrueType outlines ('glyf'), simple and composite glyphs, 'cmap' formats 4
// and 12, horizontal metrics. Not yet: CFF outlines (.otf), hinting, variable fonts,
// kerning and shaping (see docs/SHROUD.md).

// Limits on what a font may make us do (CWE-400).
const int MAX_FONT_BYTES = 33554432;        // 32 MiB
const int MAX_GLYPH_POINTS = 4096;
const int MAX_COMPOSITE_DEPTH = 8;
const int MAX_COMPOSITE_PARTS = 64;
const int MAX_CACHED_GLYPHS = 4096;         // rasterised glyphs kept per font
const int MAX_GLYPH_MASK_PIXELS = 262144;   // at most 256K alpha pixels in one glyph
const int MAX_CACHED_GLYPH_PIXELS = 1048576; // aggregate alpha pixels per font

struct FontReader {
    List<int> b;
    bool ok;

    int u8(int at) {
        if (at < 0 || at >= self.b.len()) {
            self.ok = false;
            return 0;
        }
        return self.b[at];
    }

    int u16(int at) { return (self.u8(at) << 8) | self.u8(at + 1); }

    int i16(int at) {
        int v = self.u16(at);
        if (v >= 32768) { return v - 65536; }
        return v;
    }

    int u32(int at) { return (self.u16(at) << 16) | self.u16(at + 2); }
}

struct Font {
    FontReader r;
    int units_per_em;
    int ascent;             // font units, positive up
    int descent;            // font units, negative
    int line_gap;
    int num_glyphs;
    int num_hmetrics;
    int loca_long;
    int t_loca;
    int t_glyf;
    int glyf_len;
    int t_hmtx;
    int cmap_at;            // the chosen cmap subtable
    int cmap_format;
    Map<GlyphMask> cache;
    int cached;
    int cached_pixels;
}

// One rasterised glyph: an alpha mask whose top-left pixel is at (left, top)
// relative to the pen position on the baseline.
struct GlyphMask {
    int left;
    int top;
    int w;
    int h;
    List<int> alpha;
}

bool glyph_mask_size_valid(int w, int h) {
    if (w < 1 || h < 1) { return false; }
    return w <= MAX_GLYPH_MASK_PIXELS / h;
}

bool glyph_cache_fits(int current, int added) {
    if (current < 0 || added < 0 || current > MAX_CACHED_GLYPH_PIXELS) { return false; }
    return added <= MAX_CACHED_GLYPH_PIXELS - current;
}

int tag_of(string t) { return (t.at(0) << 24) | (t.at(1) << 16) | (t.at(2) << 8) | t.at(3); }

// Offset of table `tag`, checked to lie within the file with at least `min_len`
// bytes, or -1. Its length goes to lens[0].
int find_table(FontReader r, string tag, int min_len, List<int> lens) {
    int want = tag_of(tag);
    int n = r.u16(4);
    for (int i = 0; i < n; i += 1) {
        int rec = 12 + 16 * i;
        if (r.u32(rec) == want) {
            int off = r.u32(rec + 8);
            int len = r.u32(rec + 12);
            if (!r.ok || len < min_len || off + len > r.b.len()) { return -1; }
            lens[0] = len;
            return off;
        }
    }
    return -1;
}

Font? font_load(Tainted data) {
    if (data.len() < 12 || data.len() > MAX_FONT_BYTES) { return none; }
    List<int> bytes = new List<int>();
    for (int i = 0; i < data.len(); i += 1) { bytes.push(data.at(i)); }
    FontReader r = new FontReader{b: bytes, ok: true};
    int version = r.u32(0);
    if (version != 0x00010000 && version != tag_of("true")) { return none; }
    List<int> len = new List<int>();
    len.push(0);
    int head = find_table(r, "head", 54, len);
    int hhea = find_table(r, "hhea", 36, len);
    int maxp = find_table(r, "maxp", 6, len);
    int cmap = find_table(r, "cmap", 4, len);
    int loca = find_table(r, "loca", 0, len);
    int hmtx = find_table(r, "hmtx", 0, len);
    int glyf = find_table(r, "glyf", 0, len);
    int glyf_len = len[0];
    if (head < 0 || hhea < 0 || maxp < 0 || cmap < 0 || loca < 0 || hmtx < 0 || glyf < 0) { return none; }
    int upem = r.u16(head + 18);
    if (upem < 16 || upem > 16384) { return none; }
    Font f = new Font{r: r, units_per_em: upem, ascent: r.i16(hhea + 4), descent: r.i16(hhea + 6), line_gap: r.i16(hhea + 8), num_glyphs: r.u16(maxp + 4), num_hmetrics: r.u16(hhea + 34), loca_long: r.i16(head + 50), t_loca: loca, t_glyf: glyf, glyf_len: glyf_len, t_hmtx: hmtx, cmap_at: -1, cmap_format: 0, cache: new Map<GlyphMask>(), cached: 0, cached_pixels: 0};
    if (f.num_hmetrics < 1 || f.num_hmetrics > f.num_glyphs) { return none; }
    // Prefer a full-Unicode subtable (format 12), then the BMP one (format 4).
    int nsub = r.u16(cmap + 2);
    for (int s = 0; s < nsub; s += 1) {
        int platform = r.u16(cmap + 4 + 8 * s);
        int encoding = r.u16(cmap + 6 + 8 * s);
        int at = cmap + r.u32(cmap + 8 + 8 * s);
        int format = r.u16(at);
        bool unicode = platform == 0 || (platform == 3 && (encoding == 1 || encoding == 10));
        if (unicode && format == 12) {
            f.cmap_at = at;
            f.cmap_format = 12;
        } else if (unicode && format == 4 && f.cmap_format != 12) {
            f.cmap_at = at;
            f.cmap_format = 4;
        }
    }
    if (f.cmap_at < 0 || !r.ok) { return none; }
    return f;
}

// The glyph for code point cp, or 0 (the font's "missing" glyph).
int glyph_index(Font f, int cp) {
    FontReader r = f.r;
    int at = f.cmap_at;
    if (f.cmap_format == 12) {
        int groups = r.u32(at + 12);
        int lo = 0;
        int hi = int_min(groups, 1000000) - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int g = at + 16 + 12 * mid;
            int start = r.u32(g);
            int end = r.u32(g + 4);
            if (cp < start) {
                hi = mid - 1;
            } else if (cp > end) {
                lo = mid + 1;
            } else {
                return checked_glyph(f, r.u32(g + 8) + cp - start);
            }
        }
        return 0;
    }
    if (cp > 0xFFFF) { return 0; }
    int segx2 = r.u16(at + 6);
    int ends = at + 14;
    int starts = ends + segx2 + 2;
    int deltas = starts + segx2;
    int ranges = deltas + segx2;
    for (int i = 0; i < segx2; i += 2) {
        if (cp <= r.u16(ends + i)) {
            int start2 = r.u16(starts + i);
            if (cp < start2) { return 0; }
            int delta = r.u16(deltas + i);
            int ro = r.u16(ranges + i);
            if (ro == 0) { return checked_glyph(f, (cp + delta) & 0xFFFF); }
            int gi = r.u16(ranges + i + ro + 2 * (cp - start2));
            if (gi == 0) { return 0; }
            return checked_glyph(f, (gi + delta) & 0xFFFF);
        }
    }
    return 0;
}

int checked_glyph(Font f, int g) {
    if (g < 0 || g >= f.num_glyphs || !f.r.ok) { return 0; }
    return g;
}

// Advance width of glyph g, in font units.
int advance_units(Font f, int g) {
    int m = int_min(g, f.num_hmetrics - 1);
    return f.r.u16(f.t_hmtx + 4 * m);
}

// Start and end of glyph g's data in the 'glyf' table, relative to the table.
int glyph_start(Font f, int g) {
    if (f.loca_long == 0) { return f.r.u16(f.t_loca + 2 * g) * 2; }
    return f.r.u32(f.t_loca + 4 * g);
}

// Appends glyph g's outline to p, scaled by num / den from font units to FX, with
// the origin at (ox, oy) in FX and y pointing down. The transform (a, b, c, d) in
// 1/16384 units (F2Dot14) and offset (dx, dy) in font units apply first, for parts of
// composite glyphs. Returns false if the glyph is damaged.
bool glyph_outline(Font f, int g, Path p, int num, int den, int ox, int oy, List<int> m, int depth) {
    if (g < 0 || g >= f.num_glyphs || depth > MAX_COMPOSITE_DEPTH) { return false; }
    FontReader r = f.r;
    int start = glyph_start(f, g);
    int end = glyph_start(f, g + 1);
    if (!r.ok || end < start || end > f.glyf_len) { return false; }
    if (end == start) { return true; }       // empty glyph, such as a space
    int at = f.t_glyf + start;
    int contours = r.i16(at);
    if (contours < 0) { return composite_outline(f, at, end + f.t_glyf, p, num, den, ox, oy, m, depth); }
    int ep = at + 10;
    int npts = 0;
    List<int> ends = new List<int>();
    for (int c = 0; c < contours; c += 1) {
        int e = r.u16(ep + 2 * c);
        if (e < npts) { return false; }         // end points must increase
        ends.push(e);
        npts = e + 1;
    }
    if (npts > MAX_GLYPH_POINTS) { return false; }
    int ins = ep + 2 * contours;
    int pos = ins + 2 + r.u16(ins);
    List<int> flags = new List<int>();
    while (flags.len() < npts) {
        int fl = r.u8(pos);
        pos += 1;
        flags.push(fl);
        if ((fl & 8) != 0) {
            int rep = r.u8(pos);
            pos += 1;
            for (int k = 0; k < rep && flags.len() < npts; k += 1) { flags.push(fl); }
        }
        if (!r.ok) { return false; }
    }
    List<int> xs = new List<int>();
    int x = 0;
    for (int i = 0; i < npts; i += 1) {
        int fx2 = flags[i];
        if ((fx2 & 2) != 0) {
            int dx = r.u8(pos);
            pos += 1;
            if ((fx2 & 16) != 0) { x += dx; } else { x -= dx; }
        } else if ((fx2 & 16) == 0) {
            x += r.i16(pos);
            pos += 2;
        }
        xs.push(x);
    }
    List<int> ys = new List<int>();
    int y = 0;
    for (int j = 0; j < npts; j += 1) {
        int fy = flags[j];
        if ((fy & 4) != 0) {
            int dy = r.u8(pos);
            pos += 1;
            if ((fy & 32) != 0) { y += dy; } else { y -= dy; }
        } else if ((fy & 32) == 0) {
            y += r.i16(pos);
            pos += 2;
        }
        ys.push(y);
    }
    if (!r.ok || pos > end + f.t_glyf) { return false; }
    // Transform every point to FX, y down.
    List<int> px = new List<int>();
    List<int> py = new List<int>();
    for (int q = 0; q < npts; q += 1) {
        int tx = (m[0] * xs[q] + m[2] * ys[q]) / 16384 + m[4];
        int ty = (m[1] * xs[q] + m[3] * ys[q]) / 16384 + m[5];
        px.push(ox + mul_div(tx, num, den));
        py.push(oy - mul_div(ty, num, den));
    }
    int first = 0;
    for (int c2 = 0; c2 < contours; c2 += 1) {
        emit_contour(p, px, py, flags, first, ends[c2]);
        first = ends[c2] + 1;
    }
    return true;
}

// One TrueType contour: quadratic splines where two off-curve points in a row imply
// an on-curve point midway between them.
void emit_contour(Path p, List<int> px, List<int> py, List<int> flags, int first, int last) {
    if (last <= first) { return; }
    int n = last - first + 1;
    // Start at an on-curve point, or at the midpoint of the first two if there is none.
    int s = -1;
    for (int i = 0; i < n; i += 1) {
        if ((flags[first + i] & 1) != 0 && s < 0) { s = i; }
    }
    int sx = 0;
    int sy = 0;
    if (s >= 0) {
        sx = px[first + s];
        sy = py[first + s];
    } else {
        s = 0;
        sx = (px[first] + px[first + 1]) / 2;
        sy = (py[first] + py[first + 1]) / 2;
    }
    p.move_to(sx, sy);
    bool have_ctrl = false;
    int cx = 0;
    int cy = 0;
    for (int k = 1; k <= n; k += 1) {
        int i2 = first + (s + k) % n;
        int x = px[i2];
        int y = py[i2];
        if ((flags[i2] & 1) != 0) {
            if (have_ctrl) { p.quad_to(cx, cy, x, y); } else { p.line_to(x, y); }
            have_ctrl = false;
        } else {
            if (have_ctrl) { p.quad_to(cx, cy, (cx + x) / 2, (cy + y) / 2); }
            cx = x;
            cy = y;
            have_ctrl = true;
        }
    }
    if (have_ctrl) { p.quad_to(cx, cy, sx, sy); }
    p.close();
}

bool composite_outline(Font f, int at, int limit, Path p, int num, int den, int ox, int oy, List<int> m, int depth) {
    FontReader r = f.r;
    int pos = at + 10;
    int parts = 0;
    bool more = true;
    while (more) {
        if (parts >= MAX_COMPOSITE_PARTS || pos + 4 > limit) { return false; }
        parts += 1;
        int flags = r.u16(pos);
        int g = r.u16(pos + 2);
        pos += 4;
        int dx = 0;
        int dy = 0;
        if ((flags & 1) != 0) {
            dx = r.i16(pos);
            dy = r.i16(pos + 2);
            pos += 4;
        } else {
            dx = r.u8(pos);
            dy = r.u8(pos + 1);
            if (dx >= 128) { dx -= 256; }
            if (dy >= 128) { dy -= 256; }
            pos += 2;
        }
        // Only offsets are supported for placing parts, not matching points (flag 2 clear).
        if ((flags & 2) == 0) { return false; }
        int a = 16384;
        int b = 0;
        int c = 0;
        int d = 16384;
        if ((flags & 8) != 0) {
            a = r.i16(pos);
            d = a;
            pos += 2;
        } else if ((flags & 64) != 0) {
            a = r.i16(pos);
            d = r.i16(pos + 2);
            pos += 4;
        } else if ((flags & 128) != 0) {
            a = r.i16(pos);
            b = r.i16(pos + 2);
            c = r.i16(pos + 4);
            d = r.i16(pos + 6);
            pos += 8;
        }
        // Compose this part's transform with the one we were given.
        List<int> m2 = new List<int>();
        m2.push((m[0] * a + m[2] * b) / 16384);
        m2.push((m[1] * a + m[3] * b) / 16384);
        m2.push((m[0] * c + m[2] * d) / 16384);
        m2.push((m[1] * c + m[3] * d) / 16384);
        m2.push(m[4] + (m[0] * dx + m[2] * dy) / 16384);
        m2.push(m[5] + (m[1] * dx + m[3] * dy) / 16384);
        if (!glyph_outline(f, g, p, num, den, ox, oy, m2, depth + 1)) { return false; }
        more = (flags & 32) != 0;
        if (!r.ok) { return false; }
    }
    return true;
}

List<int> identity_transform() {
    List<int> m = new List<int>();
    m.push(16384); m.push(0); m.push(0); m.push(16384); m.push(0); m.push(0);
    return m;
}

// ---- metrics in FX at a given size ----------------------------------------------------
// `size` is the em size in FX (16 px text is fx(16)).

int font_ascent(Font f, int size) { return mul_div(f.ascent, size, f.units_per_em); }
int font_descent(Font f, int size) { return mul_div(-f.descent, size, f.units_per_em); }
int font_line_height(Font f, int size) { return mul_div(f.ascent - f.descent + f.line_gap, size, f.units_per_em); }
int glyph_advance(Font f, int g, int size) { return mul_div(advance_units(f, g), size, f.units_per_em); }

// ---- glyph masks ---------------------------------------------------------------------

// Pens are positioned to a quarter of a pixel horizontally and whole pixels
// vertically; each of the four horizontal phases is cached separately.
GlyphMask glyph_mask(Font f, int g, int size, int phase) {
    string key = $"{g}:{size}:{phase}";
    if (let hit = f.cache.get(key)) { return hit; }
    Path p = new_path();
    int ox = phase * (FX / 4);
    int oy = 0;
    bool ok = glyph_outline(f, g, p, size, f.units_per_em, ox, oy, identity_transform(), 0);
    GlyphMask mask = new GlyphMask{left: 0, top: 0, w: 0, h: 0, alpha: new List<int>()};
    if (ok && p.verbs.len() > 0) {
        Segments s = flatten(p);
        int minx = UNBOUNDED;
        int miny = UNBOUNDED;
        int maxx = -UNBOUNDED;
        int maxy = -UNBOUNDED;
        for (int i = 0; i < s.x0.len(); i += 1) {
            minx = int_min(minx, int_min(s.x0[i], s.x1[i]));
            maxx = int_max(maxx, int_max(s.x0[i], s.x1[i]));
            miny = int_min(miny, int_min(s.y0[i], s.y1[i]));
            maxy = int_max(maxy, int_max(s.y0[i], s.y1[i]));
        }
        if (s.x0.len() > 0) {
            int left = fx_floor(minx);
            int top = fx_floor(miny);
            int w = fx_ceil(maxx) - left;
            int h = fx_ceil(maxy) - top;
            // A glyph more than four ems across is damaged or hostile: drawing it
            // would cost time out of all proportion to the text (CWE-400).
            int limit = int_max(64, 4 * fx_ceil(size));
            if (w > 0 && h > 0 && w <= limit && h <= limit && glyph_mask_size_valid(w, h)) {
                // Rasterise into a scratch pixmap, shifted so the mask starts at (0, 0).
                Pixmap pm = new_pixmap(w, h);
                Canvas cv = new_canvas(pm);
                Segments t = new_segments();
                for (int j = 0; j < s.x0.len(); j += 1) {
                    t.x0.push(s.x0[j] - left * FX);
                    t.y0.push(s.y0[j] - top * FX);
                    t.x1.push(s.x1[j] - left * FX);
                    t.y1.push(s.y1[j] - top * FX);
                }
                fill_segments(cv, t, solid(0xFFFFFFFF), FILL_NONZERO);
                List<int> alpha = new List<int>();
                for (int k = 0; k < pm.px.len(); k += 1) { alpha.push(ch_a(pm.px[k])); }
                mask = new GlyphMask{left: left, top: top, w: w, h: h, alpha: alpha};
            }
        }
    }
    int mask_pixels = mask.w * mask.h;
    if (f.cached >= MAX_CACHED_GLYPHS || !glyph_cache_fits(f.cached_pixels, mask_pixels)) {
        f.cache = new Map<GlyphMask>();
        f.cached = 0;
        f.cached_pixels = 0;
    }
    f.cache.set(key, mask);
    f.cached += 1;
    f.cached_pixels += mask_pixels;
    return mask;
}
