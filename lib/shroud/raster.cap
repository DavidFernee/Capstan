// Shroud: the rasteriser.
//
// Shroud draws every pixel itself, like Flutter, instead of asking each operating
// system's toolkit to draw native controls. That is what makes an interface look and
// behave the same on Windows, macOS and Linux, and it keeps the drawing code, the
// part of a GUI that handles the most untrusted data (fonts, images, text), inside
// Capstan's guarantees. Operating systems only receive finished pixels.
//
// Paths are filled with anti-aliasing: each pixel row is sampled on 16 sub-scanlines,
// and along each sub-scanline coverage is exact to 1/256 of a pixel. Both the nonzero
// and even-odd fill rules are supported. Everything is integer arithmetic, so a scene
// renders to the same pixels on every machine.

const int FILL_NONZERO = 0;
const int FILL_EVENODD = 1;

const int SUBSAMPLES = 16;              // sub-scanlines per pixel row
const int SUB_STEP = 16;                // FX / SUBSAMPLES
const int FULL_COVER = 4096;            // FX * SUBSAMPLES

// Bound both dimensions and total allocation (CWE-789). A side-only limit of
// 16384 permitted 268 million 64-bit pixels (about 2 GiB before list overhead).
// 16 million pixels bounds the pixel payload to about 128 MiB on 64-bit targets.
const int MAX_PIXMAP_SIDE = 16384;
const int MAX_PIXMAP_PIXELS = 16777216;

bool pixmap_size_valid(int w, int h) {
    if (w < 1 || h < 1 || w > MAX_PIXMAP_SIDE || h > MAX_PIXMAP_SIDE) { return false; }
    // Division avoids overflowing w * h while validating attacker-controlled sizes.
    return w <= MAX_PIXMAP_PIXELS / h;
}

// Premultiplied 0xAARRGGBB pixels, row by row.
struct Pixmap {
    int w;
    int h;
    List<int> px;

    int get(int x, int y) { return self.px[y * self.w + x]; }

    void clear(int color) {
        int p = premultiply(color);
        for (int i = 0; i < self.px.len(); i += 1) { self.px[i] = p; }
    }
}

Pixmap new_pixmap(int w, int h) {
    if (!pixmap_size_valid(w, h)) {
        println("shroud: pixmap size out of range");
        exit(101);
    }
    List<int> px = new List<int>();
    for (int i = 0; i < w * h; i += 1) { px.push(0); }
    return new Pixmap{w: w, h: h, px: px};
}

// ---- paint -------------------------------------------------------------------------

const int PAINT_SOLID = 0;
const int PAINT_LINEAR = 1;

// What a fill puts down: one colour, or a linear gradient from (x0, y0) in colour c0
// to (x1, y1) in colour c1 (coordinates in FX, colours straight).
struct Paint {
    int kind;
    int color;
    int x0;
    int y0;
    int x1;
    int y1;
    int c1;
}

Paint solid(int color) { return new Paint{kind: PAINT_SOLID, color: color, x0: 0, y0: 0, x1: 0, y1: 0, c1: 0}; }

Paint linear_gradient(int x0, int y0, int c0, int x1, int y1, int c1) {
    return new Paint{kind: PAINT_LINEAR, color: c0, x0: x0, y0: y0, x1: x1, y1: y1, c1: c1};
}

// ---- immutable display lists --------------------------------------------------------

// Commands contain only value data and frame-owned flattened geometry. They never
// retain a View, Laid, Font, Ui or application buffer.
const int DISPLAY_RECT = 1;
const int DISPLAY_PATH = 2;
const int DISPLAY_BLEND = 3;
const int DISPLAY_MASK = 4;
const int MAX_DISPLAY_COMMANDS = 262144;
const int MAX_DISPLAY_SEGMENTS = 4194304;
const int MAX_DISPLAY_MASK_PIXELS = 1048576;
const int MAX_DISPLAY_SEGMENTS_PER_PATH = 65536;

struct DisplayCommand {
    int kind;
    Rect bounds;
    Rect clip;
    Paint paint;
    int rule;
    Segments? segments;
    List<int>? mask_alpha;
    int mask_w;
    int mask_h;
    int x;
    int y;
    int coverage;
    int opacity;
}

struct DisplayList {
    int width;
    int height;
    List<DisplayCommand> commands;
}

// A pixmap with a stack of rectangular clips (whole pixels) and a global opacity.
// Recording canvases append immutable commands; executor canvases rasterise them.
struct Canvas {
    Pixmap pm;
    List<Rect> clips;
    int opacity;
    bool recording;
    List<DisplayCommand> commands;
    List<int> budget;

    Rect clip() { return self.clips[self.clips.len() - 1]; }

    // Clips to r (in FX), rounded outward to whole pixels, within the current clip.
    void push_clip(Rect r) {
        int x0 = fx_floor(r.x);
        int y0 = fx_floor(r.y);
        int x1 = fx_ceil(r.right());
        int y1 = fx_ceil(r.bottom());
        self.clips.push(self.clip().intersect(rect(x0, y0, x1 - x0, y1 - y0)));
    }

    void pop_clip() {
        if (self.clips.len() > 1) {
            if (let _dropped = self.clips.pop()) {}
        }
    }

    void fill_path(Path p, Paint paint, int rule) {
        if (self.recording) {
            // Reserve against the conservative worst-case flattening cost before
            // allocating any segment arrays. Check both the per-path and frame
            // remainder so an over-budget path cannot create a large temporary.
            int upper_bound = path_flatten_segment_bound(p);
            if (upper_bound < 0 || upper_bound > MAX_DISPLAY_SEGMENTS_PER_PATH ||
                self.commands.len() >= MAX_DISPLAY_COMMANDS ||
                upper_bound > MAX_DISPLAY_SEGMENTS - self.budget[0]) {
                println("shroud: display list path rejected by resource preflight");
                exit(101);
            }
        }
        Segments s = flatten(p);
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_PATH, bounds: rect(0, 0, 0, 0), clip: self.clip(),
                paint: paint, rule: rule, segments: s, mask_alpha: none, mask_w: 0, mask_h: 0, x: 0, y: 0,
                coverage: 0, opacity: self.opacity
            };
            display_list_append(self, cmd, s.x0.len());
        } else {
            fill_segments(self, s, paint, rule);
        }
    }

    // Axis-aligned rectangles are most of an interface, so they have their own path:
    // exact fractional coverage at the edges, no scanline sampling.
    void fill_rect(Rect r, Paint paint) {
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_RECT, bounds: r, clip: self.clip(),
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: none, mask_w: 0, mask_h: 0,
                x: 0, y: 0, coverage: 0, opacity: self.opacity
            };
            display_list_append(self, cmd, 0);
            return;
        }
        Rect c = self.clip();
        int px0 = int_max(fx_floor(r.x), c.x);
        int py0 = int_max(fx_floor(r.y), c.y);
        int px1 = int_min(fx_ceil(r.right()), c.right());
        int py1 = int_min(fx_ceil(r.bottom()), c.bottom());
        for (int y = py0; y < py1; y += 1) {
            int cov_y = overlap(r.y, r.bottom(), y * FX);
            for (int x = px0; x < px1; x += 1) {
                int cov = cov_y * overlap(r.x, r.right(), x * FX);   // up to 65536
                self.blend(x, y, paint, (cov * 255 + 32768) >> 16);
            }
        }
    }

    void fill_round_rect(Rect r, int radius, Paint paint) {
        if (radius <= 0) {
            self.fill_rect(r, paint);
        } else {
            self.fill_path(path_round_rect(r, radius), paint, FILL_NONZERO);
        }
    }

    void stroke_round_rect(Rect r, int radius, int width, Paint paint) {
        self.fill_path(path_round_rect_ring(r, radius, width), paint, FILL_NONZERO);
    }

    // Draw a cached glyph/image alpha mask. A recording canvas retains the
    // immutable frame-owned mask as one command rather than expanding it to pixels.
    void draw_mask(List<int> alpha, int width, int height, int x, int y, Paint paint) {
        // Spaces and other empty glyphs have a valid 0x0 mask.
        if (width == 0 && height == 0 && alpha.len() == 0) { return; }
        if (width < 1 || height < 1 || width > alpha.len() / height ||
            width * height != alpha.len() || alpha.len() > MAX_DISPLAY_MASK_PIXELS) {
            println("shroud: invalid display mask dimensions");
            exit(101);
        }
        if (self.recording) {
            // Reserve before copying; the previous append-time check happened
            // after the allocation and therefore did not bound rejected work.
            if (self.commands.len() >= MAX_DISPLAY_COMMANDS ||
                alpha.len() > MAX_DISPLAY_SEGMENTS - self.budget[0]) {
                println("shroud: display list mask rejected by resource preflight");
                exit(101);
            }
            // A frame owns its mask snapshot. Retaining the font/cache list would
            // let later mutation change already-published display-list contents.
            List<int> mask_copy = new List<int>();
            for (int i = 0; i < alpha.len(); i += 1) { mask_copy.push(alpha[i]); }
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_MASK, bounds: rect(0, 0, 0, 0), clip: self.clip(),
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: mask_copy,
                mask_w: width, mask_h: height, x: x, y: y, coverage: 0,
                opacity: self.opacity
            };
            display_list_append(self, cmd, alpha.len());
            return;
        }
        Rect c = self.clip();
        int x0 = int_max(x, c.x);
        int x1 = int_min(x + width, c.right());
        int y0 = int_max(y, c.y);
        int y1 = int_min(y + height, c.bottom());
        for (int yy = y0; yy < y1; yy += 1) {
            int row = (yy - y) * width;
            for (int xx = x0; xx < x1; xx += 1) {
                int a = alpha[row + xx - x];
                if (a > 0) { self.blend(xx, yy, paint, a); }
            }
        }
    }

    // Puts paint at (x, y) with coverage 0..255.
    void blend(int x, int y, Paint paint, int coverage) {
        // Keep the primitive safe even when called directly rather than through
        // fill_rect/fill_path/draw_mask. This also makes replayed blend commands
        // obey the same clip and surface boundary as every other command.
        if (x < 0 || y < 0 || x >= self.pm.w || y >= self.pm.h) { return; }
        Rect c = self.clip();
        if (x < c.x || y < c.y || x >= c.right() || y >= c.bottom()) { return; }
        int bounded_coverage = clamp(coverage, 0, 255);
        int bounded_opacity = clamp(self.opacity, 0, 255);
        if (bounded_coverage == 0 || bounded_opacity == 0) { return; }
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_BLEND, bounds: rect(0, 0, 0, 0), clip: c,
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: none, mask_w: 0, mask_h: 0,
                x: x, y: y, coverage: bounded_coverage, opacity: bounded_opacity
            };
            display_list_append(self, cmd, 0);
            return;
        }
        int cv = div255(bounded_coverage * bounded_opacity);
        if (cv <= 0) { return; }
        int src = scale_px(premultiply(paint_at(paint, x, y)), cv);
        int i = y * self.pm.w + x;
        self.pm.px[i] = over(src, self.pm.px[i]);
    }
}

Canvas new_canvas(Pixmap pm) {
    List<Rect> clips = new List<Rect>();
    clips.push(rect(0, 0, pm.w, pm.h));
    return new Canvas{
        pm: pm, clips: clips, opacity: 255, recording: false,
        commands: new List<DisplayCommand>(), budget: new List<int>()
    };
}

// Begin a frame recording. The pixmap is retained only as the target dimensions;
// no pixels are touched until execute_display_list.
Canvas new_recording_canvas(Pixmap pm) {
    Canvas cv = new_canvas(pm);
    cv.recording = true;
    cv.budget.push(0); // total flattened path segments
    return cv;
}

void display_list_append(Canvas cv, DisplayCommand cmd, int segments) {
    if (cv.commands.len() >= MAX_DISPLAY_COMMANDS ||
        segments > MAX_DISPLAY_SEGMENTS - cv.budget[0]) {
        println("shroud: display list resource budget exceeded");
        exit(101);
    }
    cv.commands.push(cmd);
    cv.budget[0] += segments;
}

// Publishing the list ends recording. The command and geometry lists are frame-owned
// and have no mutation API after this value is returned.
DisplayList finish_display_list(Canvas cv) {
    return new DisplayList{width: cv.pm.w, height: cv.pm.h, commands: cv.commands};
}

// Execute the same immutable commands through the reference integer rasteriser.
void execute_display_list(DisplayList dl, Pixmap pm) {
    if (dl.width != pm.w || dl.height != pm.h) {
        println("shroud: display list surface dimensions differ");
        exit(101);
    }
    Canvas cv = new_canvas(pm);
    for (int i = 0; i < dl.commands.len(); i += 1) {
        DisplayCommand cmd = dl.commands[i];
        cv.clips = new List<Rect>();
        cv.clips.push(cmd.clip);
        cv.opacity = cmd.opacity;
        if (cmd.kind == DISPLAY_RECT) {
            cv.fill_rect(cmd.bounds, cmd.paint);
        } else if (cmd.kind == DISPLAY_PATH) {
            if (let s = cmd.segments) {
                fill_segments(cv, s, cmd.paint, cmd.rule);
            } else {
                println("shroud: path command has no segments");
                exit(101);
            }
        } else if (cmd.kind == DISPLAY_BLEND) {
            cv.blend(cmd.x, cmd.y, cmd.paint, cmd.coverage);
        } else if (cmd.kind == DISPLAY_MASK) {
            if (let alpha = cmd.mask_alpha) {
                cv.draw_mask(alpha, cmd.mask_w, cmd.mask_h, cmd.x, cmd.y, cmd.paint);
            } else {
                println("shroud: mask command has no pixels");
                exit(101);
            }
        } else {
            println("shroud: invalid display list command");
            exit(101);
        }
    }
}

// How much of the pixel [p, p + FX) lies in [a, b), in FX.
int overlap(int a, int b, int p) {
    return int_max(0, int_min(b, p + FX) - int_max(a, p));
}

// The paint's straight colour at the centre of pixel (x, y).
int paint_at(Paint paint, int x, int y) {
    if (paint.kind == PAINT_SOLID) { return paint.color; }
    int dx = paint.x1 - paint.x0;
    int dy = paint.y1 - paint.y0;
    int len2 = fx_mul(dx, dx) + fx_mul(dy, dy);
    if (len2 <= 0) { return paint.color; }
    int qx = x * FX + FX_HALF - paint.x0;
    int qy = y * FX + FX_HALF - paint.y0;
    int dot = fx_mul(qx, dx) + fx_mul(qy, dy);
    return mix(paint.color, paint.c1, mul_div(clamp(dot, 0, len2), 255, len2));
}

// ---- scanline fill -----------------------------------------------------------------

void fill_segments(Canvas cv, Segments s, Paint paint, int rule) {
    int n = s.x0.len();
    if (n == 0) { return; }
    // Orient every segment downwards, remembering its winding direction.
    List<int> ex0 = new List<int>();
    List<int> ey0 = new List<int>();
    List<int> ex1 = new List<int>();
    List<int> ey1 = new List<int>();
    List<int> dir = new List<int>();
    int minx = UNBOUNDED;
    int miny = UNBOUNDED;
    int maxx = -UNBOUNDED;
    int maxy = -UNBOUNDED;
    for (int i = 0; i < n; i += 1) {
        if (s.y0[i] < s.y1[i]) {
            ex0.push(s.x0[i]); ey0.push(s.y0[i]); ex1.push(s.x1[i]); ey1.push(s.y1[i]); dir.push(1);
        } else {
            ex0.push(s.x1[i]); ey0.push(s.y1[i]); ex1.push(s.x0[i]); ey1.push(s.y0[i]); dir.push(-1);
        }
        minx = int_min(minx, int_min(s.x0[i], s.x1[i]));
        maxx = int_max(maxx, int_max(s.x0[i], s.x1[i]));
        miny = int_min(miny, int_min(s.y0[i], s.y1[i]));
        maxy = int_max(maxy, int_max(s.y0[i], s.y1[i]));
    }
    Rect c = cv.clip();
    int px0 = int_max(fx_floor(minx), c.x);
    int px1 = int_min(fx_ceil(maxx), c.right());
    int py0 = int_max(fx_floor(miny), c.y);
    int py1 = int_min(fx_ceil(maxy), c.bottom());
    if (px0 >= px1 || py0 >= py1) { return; }
    int width = px1 - px0;
    List<int> cov = new List<int>();
    List<int> diff = new List<int>();
    for (int k = 0; k <= width; k += 1) {
        cov.push(0);
        diff.push(0);
    }
    List<int> row = new List<int>();         // segments that touch the current row
    List<int> keys = new List<int>();        // crossings of one sub-scanline
    int lo_x = px0 * FX;
    int hi_x = px1 * FX;
    for (int y = py0; y < py1; y += 1) {
        int top = y * FX;
        int bot = top + FX;
        row = new List<int>();
        for (int e = 0; e < n; e += 1) {
            if (ey0[e] < bot && ey1[e] > top) { row.push(e); }
        }
        if (row.len() == 0) { continue; }
        for (int sub = 0; sub < SUBSAMPLES; sub += 1) {
            int sy = top + sub * SUB_STEP + SUB_STEP / 2;
            keys = new List<int>();
            for (int r = 0; r < row.len(); r += 1) {
                int ei = row[r];
                if (ey0[ei] <= sy && sy < ey1[ei]) {
                    int x = ex0[ei] + mul_div(sy - ey0[ei], ex1[ei] - ex0[ei], ey1[ei] - ey0[ei]);
                    // Sort key: x in the high bits, direction (0 down-left, 2 up) in the low two.
                    keys.push(x * 4 + dir[ei] + 1);
                }
            }
            keys.sort();
            int wind = 0;
            for (int q = 0; q + 1 < keys.len(); q += 1) {
                wind += (keys[q] & 3) - 1;
                bool inside = wind != 0;
                if (rule == FILL_EVENODD) { inside = (wind & 1) != 0; }
                if (inside) {
                    int xa = clamp(keys[q] >> 2, lo_x, hi_x);
                    int xb = clamp(keys[q + 1] >> 2, lo_x, hi_x);
                    add_span(cov, diff, xa - lo_x, xb - lo_x);
                }
            }
        }
        int run = 0;
        for (int x2 = 0; x2 < width; x2 += 1) {
            run += diff[x2];
            int total = cov[x2] + run;
            if (total > 0) { cv.blend(px0 + x2, y, paint, (int_min(total, FULL_COVER) * 255 + FULL_COVER / 2) / FULL_COVER); }
            cov[x2] = 0;
            diff[x2] = 0;
        }
        diff[width] = 0;
        cov[width] = 0;
    }
}

// Adds the span [a, b) (in FX, relative to the row's first pixel) to one sub-scanline.
void add_span(List<int> cov, List<int> diff, int a, int b) {
    if (b <= a) { return; }
    int ia = a >> 8;
    int ib = b >> 8;
    if (ia == ib) {
        cov[ia] += b - a;
        return;
    }
    cov[ia] += FX - (a & 255);
    int next = ia + 1;
    if (next < ib) {
        diff[next] += FX;
        diff[ib] -= FX;
    }
    cov[ib] += b & 255;
}
