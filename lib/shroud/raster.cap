// Shroud: the rasteriser.
//
// Shroud draws every pixel itself, like Flutter, instead of asking each operating
// system's toolkit to draw native controls. That is what makes an interface look and
// behave the same on Windows, macOS and Linux, and it keeps the drawing code, the
// part of a GUI that handles the most untrusted data (fonts, images, text), inside
// Capstan's guarantees. Operating systems only receive finished pixels.
//
// Paths are filled with anti-aliasing: each pixel row is sampled on 16 sub-scanlines,
// and along each sub-scanline coverage is exact to 1/256 of a pixel. Both the nonzero
// and even-odd fill rules are supported. Everything is integer arithmetic, so a scene
// renders to the same pixels on every machine.

const int FILL_NONZERO = 0;
const int FILL_EVENODD = 1;

const int SUBSAMPLES = 16;              // sub-scanlines per pixel row
const int SUB_STEP = 16;                // FX / SUBSAMPLES
const int FULL_COVER = 4096;            // FX * SUBSAMPLES

// Bound both dimensions and total allocation (CWE-789). A side-only limit of
// 16384 permitted 268 million 64-bit pixels (about 2 GiB before list overhead).
// 16 million pixels bounds the pixel payload to about 128 MiB on 64-bit targets.
const int MAX_PIXMAP_SIDE = 16384;
const int MAX_PIXMAP_PIXELS = 16777216;

bool pixmap_size_valid(int w, int h) {
    if (w < 1 || h < 1 || w > MAX_PIXMAP_SIDE || h > MAX_PIXMAP_SIDE) { return false; }
    // Division avoids overflowing w * h while validating attacker-controlled sizes.
    return w <= MAX_PIXMAP_PIXELS / h;
}

// Premultiplied 0xAARRGGBB pixels, row by row.
struct Pixmap {
    int w;
    int h;
    List<int> px;

    int get(int x, int y) { return self.px[y * self.w + x]; }

    void clear(int color) {
        int p = premultiply(color);
        for (int i = 0; i < self.px.len(); i += 1) { self.px[i] = p; }
    }
}

Pixmap new_pixmap(int w, int h) {
    if (!pixmap_size_valid(w, h)) {
        println("shroud: pixmap size out of range");
        exit(101);
    }
    List<int> px = new List<int>();
    for (int i = 0; i < w * h; i += 1) { px.push(0); }
    return new Pixmap{w: w, h: h, px: px};
}

// ---- paint -------------------------------------------------------------------------

const int PAINT_SOLID = 0;
const int PAINT_LINEAR = 1;

// What a fill puts down: one colour, or a linear gradient from (x0, y0) in colour c0
// to (x1, y1) in colour c1 (coordinates in FX, colours straight).
struct Paint {
    int kind;
    int color;
    int x0;
    int y0;
    int x1;
    int y1;
    int c1;
}

Paint solid(int color) { return new Paint{kind: PAINT_SOLID, color: color, x0: 0, y0: 0, x1: 0, y1: 0, c1: 0}; }

Paint linear_gradient(int x0, int y0, int c0, int x1, int y1, int c1) {
    return new Paint{kind: PAINT_LINEAR, color: c0, x0: x0, y0: y0, x1: x1, y1: y1, c1: c1};
}

// ---- immutable display lists --------------------------------------------------------

// Commands contain only value data and frame-owned flattened geometry. They never
// retain a View, Laid, Font, Ui or application buffer.
const int DISPLAY_RECT = 1;
const int DISPLAY_PATH = 2;
const int DISPLAY_BLEND = 3;
const int DISPLAY_MASK = 4;
const int MAX_DISPLAY_COMMANDS = 262144;
const int MAX_DISPLAY_SEGMENTS = 4194304;
const int MAX_DISPLAY_MASK_PIXELS = 1048576;
const int MAX_DISPLAY_SEGMENTS_PER_PATH = 65536;
// Logical retained payload plus a conservative per-command metadata allowance.
const int MAX_DISPLAY_PAYLOAD_BYTES = 67108864;
const int DISPLAY_COMMAND_BUDGET_BYTES = 256;
// Conservative upper bound on total raster work accepted for one frame.
const int MAX_DISPLAY_WORK = 67108864;

struct DisplayCommand {
    int kind;
    Rect bounds;
    Rect clip;
    Paint paint;
    int rule;
    Segments? segments;
    List<int>? mask_alpha;
    int mask_w;
    int mask_h;
    int x;
    int y;
    int coverage;
    int opacity;
}

struct DisplayList {
    int width;
    int height;
    List<DisplayCommand> commands;
}

// A pixmap with a stack of rectangular clips (whole pixels) and a global opacity.
// Recording canvases append immutable commands; executor canvases rasterise them.
struct Canvas {
    Pixmap pm;
    List<Rect> clips;
    int opacity;
    bool recording;
    List<DisplayCommand> commands;
    List<int> budget;

    Rect clip() { return self.clips[self.clips.len() - 1]; }

    // Clips to r (in FX), rounded outward to whole pixels, within the current clip.
    void push_clip(Rect r) {
        int x0 = fx_floor(r.x);
        int y0 = fx_floor(r.y);
        int x1 = fx_ceil(r.right());
        int y1 = fx_ceil(r.bottom());
        self.clips.push(self.clip().intersect(rect(x0, y0, x1 - x0, y1 - y0)));
    }

    void pop_clip() {
        if (self.clips.len() > 1) {
            if (let _dropped = self.clips.pop()) {}
        }
    }

    void fill_path(Path p, Paint paint, int rule) {
        // Validate all callers before flatten() can index malformed point streams
        // or allocate unbounded parallel segment arrays.
        int upper_bound = path_flatten_segment_bound(p);
        if (upper_bound < 0 || upper_bound > MAX_DISPLAY_SEGMENTS_PER_PATH) {
            println("shroud: path rejected by structural/resource preflight");
            exit(101);
        }
        if (self.recording && !display_list_payload_fits(self, upper_bound, upper_bound * 32)) {
            println("shroud: display list path rejected by resource preflight");
            exit(101);
        }
        Segments s = flatten(p);
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_PATH, bounds: rect(0, 0, 0, 0), clip: self.clip(),
                paint: paint, rule: rule, segments: s, mask_alpha: none, mask_w: 0, mask_h: 0, x: 0, y: 0,
                coverage: 0, opacity: self.opacity
            };
            display_list_append(self, cmd, s.x0.len(), s.x0.len() * 32);
        } else {
            fill_segments(self, s, paint, rule);
        }
    }

    // Axis-aligned rectangles are most of an interface, so they have their own path:
    // exact fractional coverage at the edges, no scanline sampling.
    void fill_rect(Rect r, Paint paint) {
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_RECT, bounds: r, clip: self.clip(),
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: none, mask_w: 0, mask_h: 0,
                x: 0, y: 0, coverage: 0, opacity: self.opacity
            };
            display_list_append(self, cmd, 0, 0);
            return;
        }
        Rect c = self.clip();
        int px0 = int_max(fx_floor(r.x), c.x);
        int py0 = int_max(fx_floor(r.y), c.y);
        int px1 = int_min(fx_ceil(r.right()), c.right());
        int py1 = int_min(fx_ceil(r.bottom()), c.bottom());
        for (int y = py0; y < py1; y += 1) {
            int cov_y = overlap(r.y, r.bottom(), y * FX);
            for (int x = px0; x < px1; x += 1) {
                int cov = cov_y * overlap(r.x, r.right(), x * FX);   // up to 65536
                self.blend(x, y, paint, (cov * 255 + 32768) >> 16);
            }
        }
    }

    void fill_round_rect(Rect r, int radius, Paint paint) {
        if (radius <= 0) {
            self.fill_rect(r, paint);
        } else {
            self.fill_path(path_round_rect(r, radius), paint, FILL_NONZERO);
        }
    }

    void stroke_round_rect(Rect r, int radius, int width, Paint paint) {
        self.fill_path(path_round_rect_ring(r, radius, width), paint, FILL_NONZERO);
    }

    // Draw a cached glyph/image alpha mask. A recording canvas retains the
    // immutable frame-owned mask as one command rather than expanding it to pixels.
    void draw_mask(List<int> alpha, int width, int height, int x, int y, Paint paint) {
        // Spaces and other empty glyphs have a valid 0x0 mask.
        if (width == 0 && height == 0 && alpha.len() == 0) { return; }
        if (width < 1 || height < 1 || width > alpha.len() / height ||
            width * height != alpha.len() || !display_mask_alpha_valid(alpha)) {
            println("shroud: invalid display mask dimensions");
            exit(101);
        }
        Rect c = self.clip();
        // Reject a mask wholly outside the clip before adding width/height to
        // caller-supplied coordinates. The subtraction checks keep those sums
        // in a small, surface-relative range and avoid signed overflow.
        if (x >= c.right() || y >= c.bottom() ||
            x < c.x - width || y < c.y - height) { return; }
        if (self.recording) {
            // Admit the complete payload before copying it. Otherwise repeated
            // masks can allocate far beyond the frame budget before append rejects
            // the command.
            // Enforce the per-mask cap as well as the aggregate frame cap
            // before allocating the owned copy. Validate dimensions without
            // multiplying untrusted width and height first.
            if (!display_mask_admissible(self, width, height, alpha.len())) {
                println("shroud: display list mask payload is invalid or over budget");
                exit(101);
            }
            // Snapshot cached glyph pixels into frame-owned storage. A later font
            // cache eviction/rebuild must not change an already-recorded frame.
            List<int> mask_copy = new List<int>();
            for (int i = 0; i < alpha.len(); i += 1) { mask_copy.push(alpha[i]); }
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_MASK, bounds: rect(0, 0, 0, 0), clip: c,
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: mask_copy,
                mask_w: width, mask_h: height, x: x, y: y, coverage: 0,
                opacity: self.opacity
            };
            display_list_append(self, cmd, alpha.len(), alpha.len() * 8);
            return;
        }
        int x0 = int_max(x, c.x);
        int x1 = int_min(x + width, c.right());
        int y0 = int_max(y, c.y);
        int y1 = int_min(y + height, c.bottom());
        for (int yy = y0; yy < y1; yy += 1) {
            int row = (yy - y) * width;
            for (int xx = x0; xx < x1; xx += 1) {
                int a = alpha[row + xx - x];
                if (a > 0) { self.blend(xx, yy, paint, a); }
            }
        }
    }

    // Puts paint at (x, y) with coverage 0..255.
    void blend(int x, int y, Paint paint, int coverage) {
        // Keep the primitive safe even when called directly rather than through
        // fill_rect/fill_path/draw_mask. This also makes replayed blend commands
        // obey the same clip and surface boundary as every other command.
        if (x < 0 || y < 0 || x >= self.pm.w || y >= self.pm.h) { return; }
        Rect c = self.clip();
        if (x < c.x || y < c.y || x >= c.right() || y >= c.bottom()) { return; }
        int bounded_coverage = clamp(coverage, 0, 255);
        int bounded_opacity = clamp(self.opacity, 0, 255);
        if (bounded_coverage == 0 || bounded_opacity == 0) { return; }
        if (self.recording) {
            DisplayCommand cmd = new DisplayCommand{
                kind: DISPLAY_BLEND, bounds: rect(0, 0, 0, 0), clip: c,
                paint: paint, rule: FILL_NONZERO, segments: none, mask_alpha: none, mask_w: 0, mask_h: 0,
                x: x, y: y, coverage: bounded_coverage, opacity: bounded_opacity
            };
            display_list_append(self, cmd, 0, 0);
            return;
        }
        int cv = div255(bounded_coverage * bounded_opacity);
        if (cv <= 0) { return; }
        int src = scale_px(premultiply(paint_at(paint, x, y)), cv);
        int i = y * self.pm.w + x;
        self.pm.px[i] = over(src, self.pm.px[i]);
    }
}

Canvas new_canvas(Pixmap pm) {
    List<Rect> clips = new List<Rect>();
    clips.push(rect(0, 0, pm.w, pm.h));
    return new Canvas{
        pm: pm, clips: clips, opacity: 255, recording: false,
        commands: new List<DisplayCommand>(), budget: new List<int>()
    };
}

// Begin a frame recording. The pixmap is retained only as the target dimensions;
// no pixels are touched until execute_display_list.
Canvas new_recording_canvas(Pixmap pm) {
    Canvas cv = new_canvas(pm);
    cv.recording = true;
    cv.budget.push(0); // aggregate segment and mask element count
    cv.budget.push(0); // logical retained payload bytes, including command records
    return cv;
}

bool display_list_payload_fits(Canvas cv, int payload, int bytes) {
    // One element-count limit and one byte limit cover all retained payloads.
    // Charge command metadata before publishing a new command.
    if (!cv.recording || cv.budget.len() != 2 ||
        cv.budget[0] < 0 || cv.budget[0] > MAX_DISPLAY_SEGMENTS ||
        cv.budget[1] < 0 || cv.budget[1] > MAX_DISPLAY_PAYLOAD_BYTES ||
        payload < 0 || bytes < 0 || cv.commands.len() >= MAX_DISPLAY_COMMANDS) { return false; }
    int command_bytes = DISPLAY_COMMAND_BUDGET_BYTES;
    if (command_bytes > MAX_DISPLAY_PAYLOAD_BYTES - cv.budget[1]) { return false; }
    if (bytes > MAX_DISPLAY_PAYLOAD_BYTES - cv.budget[1] - command_bytes) { return false; }
    return payload <= MAX_DISPLAY_SEGMENTS - cv.budget[0];
}

bool display_mask_admissible(Canvas cv, int width, int height, int pixels) {
    if (pixels < 0 || pixels > MAX_DISPLAY_MASK_PIXELS || width < 0 || height < 0) {
        return false;
    }
    if (width == 0 || height == 0) {
        if (width != 0 || height != 0 || pixels != 0) { return false; }
    } else if (width > pixels / height || width * height != pixels) {
        return false;
    }
    return display_list_payload_fits(cv, pixels, pixels * 8);
}

void display_list_append(Canvas cv, DisplayCommand cmd, int payload, int bytes) {
    // Recheck at publication: callers must not bypass admission or exceed a
    // budget after a prior pre-allocation check.
    if (!display_list_payload_fits(cv, payload, bytes)) {
        println("shroud: display list resource budget exceeded");
        exit(101);
    }
    cv.commands.push(cmd);
    cv.budget[0] += payload;
    cv.budget[1] += bytes + DISPLAY_COMMAND_BUDGET_BYTES;
}

// Copy nested variable-sized payloads as well as the outer command sequence.
// Capstan Lists are mutable values; copying only DisplayCommand structs would leave
// path segments and glyph alpha shared with the recorder.
List<int> display_alpha_copy(List<int> source) {
    List<int> copy = new List<int>();
    for (int i = 0; i < source.len(); i += 1) { copy.push(source[i]); }
    return copy;
}

Segments display_segments_copy(Segments source) {
    // Copy each parallel array independently. Even a malformed recorder value
    // must not trigger an unchecked cross-array index before frame validation.
    return new Segments{
        x0: display_alpha_copy(source.x0), y0: display_alpha_copy(source.y0),
        x1: display_alpha_copy(source.x1), y1: display_alpha_copy(source.y1)
    };
}

bool display_snapshot_fits(Canvas cv) {
    if (cv.commands.len() > MAX_DISPLAY_COMMANDS || cv.budget.len() != 2 ||
        cv.budget[0] < 0 || cv.budget[0] > MAX_DISPLAY_SEGMENTS ||
        cv.budget[1] < 0 || cv.budget[1] > MAX_DISPLAY_PAYLOAD_BYTES) { return false; }
    int payload = 0;
    int payload_bytes = cv.commands.len() * DISPLAY_COMMAND_BUDGET_BYTES;
    if (payload_bytes > MAX_DISPLAY_PAYLOAD_BYTES) { return false; }
    for (int i = 0; i < cv.commands.len(); i += 1) {
        DisplayCommand cmd = cv.commands[i];
        if (let segments = cmd.segments) {
            int n = segments.x0.len();
            if (n > MAX_DISPLAY_SEGMENTS_PER_PATH || segments.y0.len() != n ||
                segments.x1.len() != n || segments.y1.len() != n ||
                n > MAX_DISPLAY_SEGMENTS - payload ||
                n > (MAX_DISPLAY_PAYLOAD_BYTES - payload_bytes) / 32) { return false; }
            payload += n;
            payload_bytes += n * 32;
        }
        if (let alpha = cmd.mask_alpha) {
            if (alpha.len() > MAX_DISPLAY_MASK_PIXELS ||
                alpha.len() > MAX_DISPLAY_SEGMENTS - payload ||
                alpha.len() > (MAX_DISPLAY_PAYLOAD_BYTES - payload_bytes) / 8) { return false; }
            payload += alpha.len();
            payload_bytes += alpha.len() * 8;
        }
    }
    return payload == cv.budget[0] && payload_bytes == cv.budget[1];
}

// Publishing the list ends recording. Every mutable payload is copied into
// frame-owned storage, so later recorder/cache mutation cannot alter the frame.
DisplayList finish_display_list(Canvas cv) {
    // Validate snapshot bounds before allocating any frame-owned copies. The
    // recorder is a public value, so do not trust its cached budget counters.
    if (!display_snapshot_fits(cv)) {
        println("shroud: invalid or over-budget display list recording");
        exit(101);
    }
    // Snapshot the command sequence and all nested variable-sized payloads.
    List<DisplayCommand> commands = new List<DisplayCommand>();
    for (int i = 0; i < cv.commands.len(); i += 1) {
        DisplayCommand cmd = cv.commands[i];
        Segments? owned_segments = none;
        List<int>? owned_alpha = none;
        if (let segments = cmd.segments) {
            owned_segments = display_segments_copy(segments);
        }
        if (let alpha = cmd.mask_alpha) {
            owned_alpha = display_alpha_copy(alpha);
        }
        // Construct a fresh command rather than assigning nested option fields
        // on a copied command value. This makes ownership transfer explicit.
        commands.push(new DisplayCommand{
            kind: cmd.kind, bounds: cmd.bounds, clip: cmd.clip,
            paint: cmd.paint, rule: cmd.rule,
            segments: owned_segments, mask_alpha: owned_alpha,
            mask_w: cmd.mask_w, mask_h: cmd.mask_h, x: cmd.x, y: cmd.y,
            coverage: cmd.coverage, opacity: cmd.opacity
        });
    }
    return new DisplayList{width: cv.pm.w, height: cv.pm.h, commands: commands};
}

// Validate the complete frame before touching the destination. DisplayList is a
// public value type, so the executor must not assume every instance came from
// new_recording_canvas(). This also makes rejection failure-atomic.
const int MAX_DISPLAY_COORD = MAX_PIXMAP_SIDE * FX * 2;

// Glyph masks are an internal raster primitive and a public display-list payload.
// Enforce one canonical alpha representation at both boundaries.
bool display_mask_alpha_valid(List<int> alpha) {
    if (alpha.len() > MAX_DISPLAY_MASK_PIXELS) { return false; }
    for (int i = 0; i < alpha.len(); i += 1) {
        if (alpha[i] < 0 || alpha[i] > 255) { return false; }
    }
    return true;
}

bool display_coord_valid(int v) { return v >= -MAX_DISPLAY_COORD && v <= MAX_DISPLAY_COORD; }

bool display_rect_valid(Rect r) {
    if (!display_coord_valid(r.x) || !display_coord_valid(r.y) || r.w < 0 || r.h < 0 ||
        r.w > MAX_DISPLAY_COORD * 2 || r.h > MAX_DISPLAY_COORD * 2) { return false; }
    return display_coord_valid(r.x + r.w) && display_coord_valid(r.y + r.h);
}

bool display_clip_valid(Rect r, int width, int height) {
    if (r.x < 0 || r.y < 0 || r.w < 0 || r.h < 0 || r.x > width || r.y > height) { return false; }
    return r.w <= width - r.x && r.h <= height - r.y;
}

bool display_paint_valid(Paint p) {
    if (p.color < 0 || p.color > 4294967295) { return false; }
    if (p.kind == PAINT_SOLID) { return true; }
    if (p.kind != PAINT_LINEAR || p.c1 < 0 || p.c1 > 4294967295) { return false; }
    return display_coord_valid(p.x0) && display_coord_valid(p.y0) &&
        display_coord_valid(p.x1) && display_coord_valid(p.y1);
}

int display_sort_levels(int n) {
    int levels = 1;
    while (n > 1) { n = (n + 1) / 2; levels += 1; }
    return levels;
}

bool display_command_payload_empty(DisplayCommand cmd) {
    // A command may carry only the payload selected by its kind. Reject hidden
    // geometry/mask arrays on other command kinds so frame accounting covers
    // every retained variable-sized payload, not merely the one the executor reads.
    if (let _segments = cmd.segments) { return false; }
    if (let _alpha = cmd.mask_alpha) { return false; }
    return true;
}

bool display_list_valid(DisplayList dl, Pixmap pm) {
    if (!pixmap_size_valid(pm.w, pm.h) || pm.px.len() != pm.w * pm.h ||
        dl.width != pm.w || dl.height != pm.h || dl.commands.len() > MAX_DISPLAY_COMMANDS) { return false; }

    int payload = 0;
    // Charge a conservative record size for each command plus its variable payload.
    int payload_bytes = dl.commands.len() * DISPLAY_COMMAND_BUDGET_BYTES;
    if (payload_bytes > MAX_DISPLAY_PAYLOAD_BYTES) { return false; }

    // Charge command traversal and the scratch-surface copy plus final commit.
    // Rendering never writes the caller's surface until the entire frame succeeds.
    int work = dl.commands.len();
    int surface_pixels = pm.w * pm.h;
    if (surface_pixels > (MAX_DISPLAY_WORK - work) / 2) { return false; }
    work += 2 * surface_pixels;

    for (int i = 0; i < dl.commands.len(); i += 1) {
        DisplayCommand cmd = dl.commands[i];
        if (!display_clip_valid(cmd.clip, dl.width, dl.height) || cmd.opacity < 0 || cmd.opacity > 255 ||
            !display_paint_valid(cmd.paint)) { return false; }

        if (cmd.kind == DISPLAY_RECT) {
            if (!display_command_payload_empty(cmd) || !display_rect_valid(cmd.bounds)) { return false; }
            int x0 = int_max(fx_floor(cmd.bounds.x), cmd.clip.x);
            int y0 = int_max(fx_floor(cmd.bounds.y), cmd.clip.y);
            int x1 = int_min(fx_ceil(cmd.bounds.right()), cmd.clip.right());
            int y1 = int_min(fx_ceil(cmd.bounds.bottom()), cmd.clip.bottom());
            int width = int_max(0, x1 - x0);
            int height = int_max(0, y1 - y0);
            if (height > 0 && width > (MAX_DISPLAY_WORK - work) / height) { return false; }
            work += width * height;

        } else if (cmd.kind == DISPLAY_PATH) {
            if (let _alpha = cmd.mask_alpha) { return false; }
            if (cmd.rule != FILL_NONZERO && cmd.rule != FILL_EVENODD) { return false; }
            if (let seg = cmd.segments) {
                int n = seg.x0.len();
                if (n > MAX_DISPLAY_SEGMENTS_PER_PATH || seg.y0.len() != n ||
                    seg.x1.len() != n || seg.y1.len() != n ||
                    n > MAX_DISPLAY_SEGMENTS - payload ||
                    n > (MAX_DISPLAY_PAYLOAD_BYTES - payload_bytes) / 32) { return false; }
                payload += n;
                payload_bytes += n * 32;

                if (n > 0) {
                    int min_x = int_min(seg.x0[0], seg.x1[0]);
                    int max_x = int_max(seg.x0[0], seg.x1[0]);
                    int min_y = int_min(seg.y0[0], seg.y1[0]);
                    int max_y = int_max(seg.y0[0], seg.y1[0]);
                    for (int j = 0; j < n; j += 1) {
                        if (!display_coord_valid(seg.x0[j]) || !display_coord_valid(seg.y0[j]) ||
                            !display_coord_valid(seg.x1[j]) || !display_coord_valid(seg.y1[j])) { return false; }
                        min_x = int_min(min_x, int_min(seg.x0[j], seg.x1[j]));
                        max_x = int_max(max_x, int_max(seg.x0[j], seg.x1[j]));
                        min_y = int_min(min_y, int_min(seg.y0[j], seg.y1[j]));
                        max_y = int_max(max_y, int_max(seg.y0[j], seg.y1[j]));
                    }

                    int x0 = int_max(fx_floor(min_x), cmd.clip.x);
                    int x1 = int_min(fx_ceil(max_x), cmd.clip.right());
                    int width = int_max(0, x1 - x0);
                    int y0 = int_max(fx_floor(min_y), cmd.clip.y);
                    int y1 = int_min(fx_ceil(max_y), cmd.clip.bottom());
                    int rows = int_max(0, y1 - y0);

                    // Charge validation and edge orientation, scratch setup,
                    // each row's n-edge scan, all 16 crossing builds/traversals,
                    // stable merge-sort comparisons AND copies, and pixel blending.
                    // display_sort_levels() is ceil(log2(n)) + 1, deliberately
                    // conservative for the runtime's stable merge sort.
                    int base = 8 * n + 2 * width;
                    if (base > MAX_DISPLAY_WORK - work) { return false; }
                    work += base;
                    int row_factor = 1 + SUBSAMPLES * (3 + 2 * display_sort_levels(n));
                    int per_row = width + SUBSAMPLES + 1 + n * row_factor;
                    if (rows > 0 && per_row > (MAX_DISPLAY_WORK - work) / rows) { return false; }
                    work += rows * per_row;
                }
            } else { return false; }

        } else if (cmd.kind == DISPLAY_BLEND) {
            if (!display_command_payload_empty(cmd) ||
                cmd.x < 0 || cmd.y < 0 || cmd.x >= dl.width || cmd.y >= dl.height ||
                cmd.coverage < 0 || cmd.coverage > 255) { return false; }
            if (work >= MAX_DISPLAY_WORK) { return false; }
            work += 1;

        } else if (cmd.kind == DISPLAY_MASK) {
            if (let _segments = cmd.segments) { return false; }
            if (let alpha = cmd.mask_alpha) {
                if (alpha.len() > MAX_DISPLAY_MASK_PIXELS || cmd.mask_w < 0 || cmd.mask_h < 0) { return false; }
                if (cmd.mask_w == 0 || cmd.mask_h == 0) {
                    if (cmd.mask_w != 0 || cmd.mask_h != 0 || alpha.len() != 0) { return false; }
                } else {
                    if (cmd.mask_w > alpha.len() / cmd.mask_h || cmd.mask_w * cmd.mask_h != alpha.len()) { return false; }
                }
                if (cmd.x < -MAX_PIXMAP_SIDE || cmd.x > MAX_PIXMAP_SIDE ||
                    cmd.y < -MAX_PIXMAP_SIDE || cmd.y > MAX_PIXMAP_SIDE ||
                    cmd.mask_w > MAX_DISPLAY_SEGMENTS - payload ||
                    alpha.len() > MAX_DISPLAY_SEGMENTS - payload ||
                    alpha.len() > (MAX_DISPLAY_PAYLOAD_BYTES - payload_bytes) / 8) { return false; }
                if (!display_mask_alpha_valid(alpha)) { return false; }
                payload += alpha.len();
                payload_bytes += alpha.len() * 8;

                // Admission scans alpha, draw_mask revalidates it at execution,
                // and the visible-pixel pass may visit the full mask.
                if (alpha.len() > (MAX_DISPLAY_WORK - work) / 3) { return false; }
                work += 3 * alpha.len();
            } else { return false; }

        } else { return false; }
    }
    return true;
}

// Execute the same immutable commands through the reference integer rasteriser.
void execute_display_list(DisplayList dl, Pixmap pm) {
    if (!display_list_valid(dl, pm)) {
        println("shroud: invalid or over-budget display list");
        exit(101);
    }
    // Render into a private surface. Any later allocation/runtime failure can
    // stop execution without leaving a partially rendered caller-visible frame.
    Pixmap scratch = new_pixmap(pm.w, pm.h);
    for (int pixel = 0; pixel < pm.px.len(); pixel += 1) {
        scratch.px[pixel] = pm.px[pixel];
    }
    Canvas cv = new_canvas(scratch);
    for (int i = 0; i < dl.commands.len(); i += 1) {
        DisplayCommand cmd = dl.commands[i];
        cv.clips = new List<Rect>();
        cv.clips.push(cmd.clip);
        cv.opacity = cmd.opacity;
        if (cmd.kind == DISPLAY_RECT) {
            cv.fill_rect(cmd.bounds, cmd.paint);
        } else if (cmd.kind == DISPLAY_PATH) {
            if (let s = cmd.segments) {
                fill_segments(cv, s, cmd.paint, cmd.rule);
            } else {
                println("shroud: path command has no segments");
                exit(101);
            }
        } else if (cmd.kind == DISPLAY_BLEND) {
            cv.blend(cmd.x, cmd.y, cmd.paint, cmd.coverage);
        } else if (cmd.kind == DISPLAY_MASK) {
            if (let alpha = cmd.mask_alpha) {
                cv.draw_mask(alpha, cmd.mask_w, cmd.mask_h, cmd.x, cmd.y, cmd.paint);
            } else {
                println("shroud: mask command has no pixels");
                exit(101);
            }
        } else {
            println("shroud: invalid display list command");
            exit(101);
        }
    }
    // Commit only after every command has completed successfully.
    for (int pixel = 0; pixel < pm.px.len(); pixel += 1) {
        pm.px[pixel] = scratch.px[pixel];
    }
}

// How much of the pixel [p, p + FX) lies in [a, b), in FX.
int overlap(int a, int b, int p) {
    return int_max(0, int_min(b, p + FX) - int_max(a, p));
}

// The paint's straight colour at the centre of pixel (x, y).
int paint_at(Paint paint, int x, int y) {
    if (paint.kind == PAINT_SOLID) { return paint.color; }
    int dx = paint.x1 - paint.x0;
    int dy = paint.y1 - paint.y0;
    int len2 = fx_mul(dx, dx) + fx_mul(dy, dy);
    if (len2 <= 0) { return paint.color; }
    int qx = x * FX + FX_HALF - paint.x0;
    int qy = y * FX + FX_HALF - paint.y0;
    int dot = fx_mul(qx, dx) + fx_mul(qy, dy);
    return mix(paint.color, paint.c1, mul_div(clamp(dot, 0, len2), 255, len2));
}

// ---- scanline fill -----------------------------------------------------------------

void fill_segments(Canvas cv, Segments s, Paint paint, int rule) {
    int n = s.x0.len();
    if (n == 0) { return; }
    // Orient every segment downwards, remembering its winding direction.
    List<int> ex0 = new List<int>();
    List<int> ey0 = new List<int>();
    List<int> ex1 = new List<int>();
    List<int> ey1 = new List<int>();
    List<int> dir = new List<int>();
    int minx = UNBOUNDED;
    int miny = UNBOUNDED;
    int maxx = -UNBOUNDED;
    int maxy = -UNBOUNDED;
    for (int i = 0; i < n; i += 1) {
        if (s.y0[i] < s.y1[i]) {
            ex0.push(s.x0[i]); ey0.push(s.y0[i]); ex1.push(s.x1[i]); ey1.push(s.y1[i]); dir.push(1);
        } else {
            ex0.push(s.x1[i]); ey0.push(s.y1[i]); ex1.push(s.x0[i]); ey1.push(s.y0[i]); dir.push(-1);
        }
        minx = int_min(minx, int_min(s.x0[i], s.x1[i]));
        maxx = int_max(maxx, int_max(s.x0[i], s.x1[i]));
        miny = int_min(miny, int_min(s.y0[i], s.y1[i]));
        maxy = int_max(maxy, int_max(s.y0[i], s.y1[i]));
    }
    Rect c = cv.clip();
    int px0 = int_max(fx_floor(minx), c.x);
    int px1 = int_min(fx_ceil(maxx), c.right());
    int py0 = int_max(fx_floor(miny), c.y);
    int py1 = int_min(fx_ceil(maxy), c.bottom());
    if (px0 >= px1 || py0 >= py1) { return; }
    int width = px1 - px0;
    List<int> cov = new List<int>();
    List<int> diff = new List<int>();
    for (int k = 0; k <= width; k += 1) {
        cov.push(0);
        diff.push(0);
    }
    List<int> row = new List<int>();         // segments that touch the current row
    List<int> keys = new List<int>();        // crossings of one sub-scanline
    int lo_x = px0 * FX;
    int hi_x = px1 * FX;
    for (int y = py0; y < py1; y += 1) {
        int top = y * FX;
        int bot = top + FX;
        row = new List<int>();
        for (int e = 0; e < n; e += 1) {
            if (ey0[e] < bot && ey1[e] > top) { row.push(e); }
        }
        if (row.len() == 0) { continue; }
        for (int sub = 0; sub < SUBSAMPLES; sub += 1) {
            int sy = top + sub * SUB_STEP + SUB_STEP / 2;
            keys = new List<int>();
            for (int r = 0; r < row.len(); r += 1) {
                int ei = row[r];
                if (ey0[ei] <= sy && sy < ey1[ei]) {
                    int x = ex0[ei] + mul_div(sy - ey0[ei], ex1[ei] - ex0[ei], ey1[ei] - ey0[ei]);
                    // Sort key: x in the high bits, direction (0 down-left, 2 up) in the low two.
                    keys.push(x * 4 + dir[ei] + 1);
                }
            }
            keys.sort();
            int wind = 0;
            for (int q = 0; q + 1 < keys.len(); q += 1) {
                wind += (keys[q] & 3) - 1;
                bool inside = wind != 0;
                if (rule == FILL_EVENODD) { inside = (wind & 1) != 0; }
                if (inside) {
                    int xa = clamp(keys[q] >> 2, lo_x, hi_x);
                    int xb = clamp(keys[q + 1] >> 2, lo_x, hi_x);
                    add_span(cov, diff, xa - lo_x, xb - lo_x);
                }
            }
        }
        int run = 0;
        for (int x2 = 0; x2 < width; x2 += 1) {
            run += diff[x2];
            int total = cov[x2] + run;
            if (total > 0) { cv.blend(px0 + x2, y, paint, (int_min(total, FULL_COVER) * 255 + FULL_COVER / 2) / FULL_COVER); }
            cov[x2] = 0;
            diff[x2] = 0;
        }
        diff[width] = 0;
        cov[width] = 0;
    }
}

// Adds the span [a, b) (in FX, relative to the row's first pixel) to one sub-scanline.
void add_span(List<int> cov, List<int> diff, int a, int b) {
    if (b <= a) { return; }
    int ia = a >> 8;
    int ib = b >> 8;
    if (ia == ib) {
        cov[ia] += b - a;
        return;
    }
    cov[ia] += FX - (a & 255);
    int next = ia + 1;
    if (next < ib) {
        diff[next] += FX;
        diff[ib] -= FX;
    }
    cov[ib] += b & 255;
}
