// Shroud: layout.
//
// Layout follows Flutter's single pass: constraints go down, sizes come up, and each
// parent places its children. Rows and columns share one flex algorithm. A child
// without a flex factor may use the space its earlier siblings left, so a long text
// at the end of a row wraps instead of overflowing; children with grow() share what
// is left over, in proportion. Everything is in FX device pixels: lengths given in dp
// are multiplied by the window's scale factor, so interfaces stay sharp on high-DPI
// screens on every platform.

// The most views one interface may contain, and the deepest nesting (CWE-400, CWE-674).
const int MAX_VIEWS = 100000;
const int MAX_DEPTH = 200;

// A view after layout: its frame, in absolute FX device pixels, and its children.
struct Laid {
    View v;
    string id;
    Rect frame;
    List<Laid> kids;
    List<int> cps;          // text, as code points (TEXT, BUTTON, toggles, TEXT_FIELD)
    List<int> lines;        // line starts and ends into cps
    int content_h;          // SCROLL: the child's full height
    int scroll_y;           // SCROLL: how far the child is scrolled
}

Laid new_laid(View v, string id) {
    return new Laid{v: v, id: id, frame: rect(0, 0, 0, 0), kids: new List<Laid>(), cps: new List<int>(), lines: new List<int>(), content_h: 0, scroll_y: 0};
}

int dp(Ui ui, int v) { return v * ui.scale; }

int dp_or(Ui ui, int v, int fallback) {
    if (v == AUTO) { return dp(ui, fallback); }
    return dp(ui, v);
}

Font font_of(Ui ui, View v) {
    if (v.bold) { return ui.bold_font; }
    return ui.font;
}

int text_size_of(Ui ui, View v) { return dp_or(ui, v.font_size, ui.theme.font_size); }

List<int> codepoints_of(View v) {
    if (v.has_value) {
        if (v.secure) {
            // A dot for each character typed; the text itself is never laid out.
            List<int> dots = new List<int>();
            List<int> real = untrusted_codepoints(v.value);
            for (int i = 0; i < real.len(); i += 1) { dots.push(0x2022); }
            return dots;
        }
        return untrusted_codepoints(v.value);
    }
    return text_codepoints(v.text);
}

// Lays out the whole tree for a window of the given size (FX).
Laid layout_root(Ui ui, View root, int w, int h) {
    ui.view_count = 0;
    Laid l = measure(ui, root, tight(w, h), "r", 0);
    uniquify_layout_ids(l, ui);
    place(l, 0, 0);
    return l;
}

// Explicit keys are public widget identities. A duplicate must never make hit testing
// resolve a visually selected widget to a different node with the same id.
void collect_layout_nodes(Laid l, List<Laid> out) {
    out.push(l);
    for (int i = 0; i < l.kids.len(); i += 1) { collect_layout_nodes(l.kids[i], out); }
}

void uniquify_layout_ids(Laid root, Ui ui) {
    List<Laid> all = new List<Laid>();
    collect_layout_nodes(root, all);
    for (int i = 0; i < all.len(); i += 1) {
        bool duplicate = false;
        for (int j = 0; j < i; j += 1) {
            if (all[j].id == all[i].id) { duplicate = true; }
        }
        if (duplicate) {
            int suffix = i;
            string candidate = $"{all[i].id}#shroud-duplicate-{suffix}";
            bool collision = true;
            while (collision) {
                collision = false;
                for (int k = 0; k < all.len(); k += 1) {
                    if (k != i && all[k].id == candidate) { collision = true; }
                }
                if (collision) {
                    suffix += 1;
                    candidate = $"{all[i].id}#shroud-duplicate-{suffix}";
                }
            }
            all[i].id = candidate;
            ui.problems.push("duplicate view identity detected; assign unique View.key() values");
        }
    }
}

// Turns child frames, stored relative to their parent while measuring, into absolute
// ones, with every edge snapped to a whole device pixel so that lines and fills are
// crisp. Positions accumulate unsnapped, so rounding never drifts across a long list.
void place(Laid l, int x, int y) {
    int ax = l.frame.x + x;
    int ay = l.frame.y + y;
    int x0 = fx_round(ax) * FX;
    int y0 = fx_round(ay) * FX;
    l.frame = rect(x0, y0, fx_round(ax + l.frame.w) * FX - x0, fx_round(ay + l.frame.h) * FX - y0);
    for (int i = 0; i < l.kids.len(); i += 1) { place(l.kids[i], ax, ay - l.scroll_y); }
}

Laid measure(Ui ui, View v, Constraints c0, string pid, int depth) {
    ui.view_count += 1;
    if (ui.view_count > MAX_VIEWS || depth > MAX_DEPTH) {
        println("shroud: the interface has too many views or is nested too deeply");
        exit(101);
    }
    string id = pid;
    if (v.key != "") { id = v.key; }
    Laid l = new_laid(v, id);
    // The view's own size limits narrow what the parent allows.
    Constraints c = new Constraints{min_w: c0.min_w, min_h: c0.min_h, max_w: c0.max_w, max_h: c0.max_h};
    if (v.min_w != AUTO) { c.min_w = c.fit_w(dp(ui, v.min_w)); }
    if (v.max_w != AUTO) { c.max_w = int_max(c.min_w, int_min(c.max_w, dp(ui, v.max_w))); }
    if (v.min_h != AUTO) { c.min_h = c.fit_h(dp(ui, v.min_h)); }
    if (v.max_h != AUTO) { c.max_h = int_max(c.min_h, int_min(c.max_h, dp(ui, v.max_h))); }
    if (v.width != AUTO) {
        int fw = c.fit_w(dp(ui, v.width));
        c.min_w = fw;
        c.max_w = fw;
    }
    if (v.height != AUTO) {
        int fh = c.fit_h(dp(ui, v.height));
        c.min_h = fh;
        c.max_h = fh;
    }
    Insets pad = new Insets{left: dp(ui, v.pad.left), top: dp(ui, v.pad.top), right: dp(ui, v.pad.right), bottom: dp(ui, v.pad.bottom)};
    Constraints inner = c.deflate(pad);
    Size content = measure_content(ui, v, l, inner, id, depth);
    int w = c.fit_w(content.w + pad.left + pad.right);
    int h = c.fit_h(content.h + pad.top + pad.bottom);
    // Children were placed in the content box; move them inside the padding, and
    // centre content that is smaller than a control's minimum size.
    for (int i = 0; i < l.kids.len(); i += 1) {
        Laid k = l.kids[i];
        k.frame = k.frame.offset(pad.left, pad.top);
    }
    l.frame = rect(0, 0, w, h);
    return l;
}

// Measures what is inside the padding and places any children relative to it.
Size measure_content(Ui ui, View v, Laid l, Constraints c, string id, int depth) {
    int k = v.kind;
    Theme t = ui.theme;
    if (k == K_TEXT) {
        l.cps = codepoints_of(v);
        return measure_text(ui, v, l, c.max_w);
    }
    if (k == K_BUTTON) {
        l.cps = codepoints_of(v);
        Size s = measure_text(ui, v, l, c.max_w);
        return size_of(int_max(s.w, dp(ui, 32)), int_max(s.h, dp(ui, t.control_height) - dp(ui, v.pad.top + v.pad.bottom)));
    }
    if (k == K_CHECKBOX || k == K_RADIO || k == K_SWITCH) {
        l.cps = codepoints_of(v);
        int mark = dp(ui, 20);
        int gap = dp(ui, 8);
        if (k == K_SWITCH) {
            mark = dp(ui, 40);
            gap = dp(ui, 12);
        }
        if (l.cps.len() == 0) { gap = 0; }
        Size s2 = measure_text(ui, v, l, sub_bound(c.max_w, mark + gap));
        return size_of(mark + gap + s2.w, int_max(int_max(dp(ui, 20), s2.h), dp(ui, t.control_height)));
    }
    if (k == K_TEXT_FIELD) {
        l.cps = codepoints_of(v);
        return size_of(dp(ui, 200), dp(ui, t.control_height));
    }
    if (k == K_SLIDER) { return size_of(dp(ui, 200), dp(ui, t.control_height)); }
    if (k == K_PROGRESS) { return size_of(dp(ui, 200), dp(ui, 4)); }
    if (k == K_DIVIDER) { return size_of(dp(ui, 1), dp(ui, 1)); }
    if (k == K_SPACER) { return size_of(0, 0); }
    if (k == K_ROW) { return measure_flex(ui, v, l, c, id, depth, true); }
    if (k == K_COLUMN) { return measure_flex(ui, v, l, c, id, depth, false); }
    if (k == K_STACK || k == K_BOX) { return measure_stack(ui, v, l, c, id, depth); }
    if (k == K_SCROLL) { return measure_scroll(ui, v, l, c, id, depth); }
    return size_of(0, 0);
}

Size measure_text(Ui ui, View v, Laid l, int max_w) {
    Font f = font_of(ui, v);
    int size = text_size_of(ui, v);
    int wrap = max_w;
    if (v.kind == K_BUTTON) { wrap = UNBOUNDED; }
    l.lines = wrap_lines(f, size, l.cps, wrap);
    int n = l.lines.len() / 2;
    if (v.lines != AUTO && v.lines > 0 && n > v.lines) {
        n = v.lines;
        List<int> kept = new List<int>();
        for (int i = 0; i < n * 2; i += 1) { kept.push(l.lines[i]); }
        l.lines = kept;
    }
    int w = 0;
    for (int j = 0; j < n; j += 1) { w = int_max(w, text_width(f, size, l.cps, l.lines[2 * j], l.lines[2 * j + 1])); }
    if (l.cps.len() == 0 && v.kind != K_TEXT) { return size_of(0, 0); }
    return size_of(w, n * font_line_height(f, size));
}

// Rows (horizontal = true) and columns.
Size measure_flex(Ui ui, View v, Laid l, Constraints c, string id, int depth, bool horizontal) {
    int n = v.kids.len();
    int gap = dp(ui, v.spacing);
    int max_main = c.max_h;
    int max_cross = c.max_w;
    if (horizontal) {
        max_main = c.max_w;
        max_cross = c.max_h;
    }
    int total_grow = 0;
    for (int i = 0; i < n; i += 1) { total_grow += int_max(0, v.kids[i].grow); }
    List<Laid> kids = new List<Laid>();
    for (int i2 = 0; i2 < n; i2 += 1) { kids.push(new_laid(v.kids[i2], "")); }
    // First the children that keep their own size, each offered what is still free.
    int used = gap * int_max(0, n - 1);
    for (int a = 0; a < n; a += 1) {
        View kv = v.kids[a];
        if (kv.grow <= 0) {
            Laid kl = measure(ui, kv, child_constraints(v, kv, sub_bound(max_main, used), max_cross, -1, horizontal), $"{id}.{a}", depth + 1);
            kids[a] = kl;
            used += main_of(kl, horizontal);
        }
    }
    // Then the flexible ones share the rest.
    int free = 0;
    if (max_main < UNBOUNDED) { free = int_max(0, max_main - used); }
    int given = 0;
    int seen = 0;
    for (int b = 0; b < n; b += 1) {
        View kv2 = v.kids[b];
        if (kv2.grow > 0) {
            seen += kv2.grow;
            int share = mul_div(free, seen, int_max(1, total_grow)) - given;
            given += share;
            Laid kl2 = measure(ui, kv2, child_constraints(v, kv2, share, max_cross, share, horizontal), $"{id}.{b}", depth + 1);
            kids[b] = kl2;
            used += main_of(kl2, horizontal);
        }
    }
    int cross = 0;
    for (int d = 0; d < n; d += 1) { cross = int_max(cross, cross_of(kids[d], horizontal)); }
    if (v.cross_align == ALIGN_STRETCH && max_cross < UNBOUNDED) { cross = max_cross; }
    int main = used;
    if (total_grow > 0 && max_main < UNBOUNDED) { main = int_max(main, max_main); }
    int min_main = c.min_h;
    int min_cross = c.min_w;
    if (horizontal) {
        min_main = c.min_w;
        min_cross = c.min_h;
    }
    main = int_max(main, min_main);
    cross = int_max(cross, min_cross);
    // Place the children along the main axis.
    int extra = int_max(0, main - used);
    int pos = 0;
    int between = gap;
    if (v.main_align == ALIGN_CENTER) { pos = extra / 2; }
    if (v.main_align == ALIGN_END) { pos = extra; }
    if (v.main_align == ALIGN_BETWEEN && n > 1) { between = gap + extra / (n - 1); }
    for (int e = 0; e < n; e += 1) {
        Laid kl3 = kids[e];
        int align = v.cross_align;
        if (kl3.v.self_align != AUTO) { align = kl3.v.self_align; }
        int off = 0;
        int room = cross - cross_of(kl3, horizontal);
        if (align == ALIGN_CENTER) { off = room / 2; }
        if (align == ALIGN_END) { off = room; }
        if (horizontal) {
            kl3.frame = rect(pos, off, kl3.frame.w, kl3.frame.h);
        } else {
            kl3.frame = rect(off, pos, kl3.frame.w, kl3.frame.h);
        }
        pos += main_of(kl3, horizontal) + between;
        l.kids.push(kl3);
    }
    if (horizontal) { return size_of(main, cross); }
    return size_of(cross, main);
}

int main_of(Laid l, bool horizontal) {
    if (horizontal) { return l.frame.w; }
    return l.frame.h;
}

int cross_of(Laid l, bool horizontal) {
    if (horizontal) { return l.frame.h; }
    return l.frame.w;
}

// What a row or column offers a child: at most `main` along the axis (exactly
// `exact` for a flexible child, unless -1), and the cross size, tight if stretched.
Constraints child_constraints(View parent, View kid, int main, int max_cross, int exact, bool horizontal) {
    int align = parent.cross_align;
    if (kid.self_align != AUTO) { align = kid.self_align; }
    int min_cross = 0;
    if ((align == ALIGN_STRETCH || kid.kind == K_DIVIDER) && max_cross < UNBOUNDED) { min_cross = max_cross; }
    int min_main = 0;
    if (exact >= 0) { min_main = exact; }
    if (horizontal) { return new Constraints{min_w: min_main, min_h: min_cross, max_w: main, max_h: max_cross}; }
    return new Constraints{min_w: min_cross, min_h: min_main, max_w: max_cross, max_h: main};
}

Size measure_stack(Ui ui, View v, Laid l, Constraints c, string id, int depth) {
    int w = 0;
    int h = 0;
    for (int i = 0; i < v.kids.len(); i += 1) {
        Laid k = measure(ui, v.kids[i], c.loosen(), $"{id}.{i}", depth + 1);
        w = int_max(w, k.frame.w);
        h = int_max(h, k.frame.h);
        l.kids.push(k);
    }
    w = c.fit_w(w);
    h = c.fit_h(h);
    for (int j = 0; j < l.kids.len(); j += 1) {
        Laid k2 = l.kids[j];
        k2.frame = rect(align_off(v.main_align, w - k2.frame.w), align_off(v.cross_align, h - k2.frame.h), k2.frame.w, k2.frame.h);
    }
    return size_of(w, h);
}

int align_off(int align, int room) {
    if (align == ALIGN_CENTER) { return room / 2; }
    if (align == ALIGN_END) { return room; }
    return 0;
}

Size measure_scroll(Ui ui, View v, Laid l, Constraints c, string id, int depth) {
    if (v.kids.len() == 0) { return size_of(0, 0); }
    Constraints inner = new Constraints{min_w: c.min_w, min_h: 0, max_w: c.max_w, max_h: UNBOUNDED};
    Laid k = measure(ui, v.kids[0], inner, $"{id}.0", depth + 1);
    l.kids.push(k);
    l.content_h = k.frame.h;
    int w = c.fit_w(k.frame.w);
    int h = c.fit_h(k.frame.h);
    int top = 0;
    if (let s = ui.scroll.get(id)) { top = s; }
    top = clamp(top, 0, int_max(0, l.content_h - h));
    ui.scroll.set(id, top);
    l.scroll_y = top;
    return size_of(w, h);
}
