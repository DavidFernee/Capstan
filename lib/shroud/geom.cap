// Shroud: geometry in fixed point.
//
// Capstan has no floating point, and Shroud does not need it: every coordinate is an
// int in 1/256 of a device-independent pixel (FX). Integer arithmetic is exact and
// identical on every processor and operating system, so a Shroud interface lays out
// and renders to the same pixels everywhere, which makes golden-image tests exact.
// All arithmetic is overflow-checked as usual; 2^63 / 256 leaves room for any screen.

const int FX = 256;             // one pixel
const int FX_HALF = 128;

int fx(int px) { return px * FX; }

// Whole pixels, rounding down (toward minus infinity) or up.
int fx_floor(int v) { return v >> 8; }
int fx_ceil(int v) { return (v + 255) >> 8; }
int fx_round(int v) { return (v + FX_HALF) >> 8; }

// a * b and a / b for fixed-point values, rounding to nearest.
int fx_mul(int a, int b) {
    int p = a * b;
    if (p >= 0) { return (p + FX_HALF) / FX; }
    return -((FX_HALF - p) / FX);
}

int fx_div(int a, int b) {
    int n = a * FX;
    if ((n >= 0) == (b > 0)) { return (n + int_abs(b) / 2) / b; }
    return (n - int_abs(b) / 2) / b;
}

// v * num / den, rounded to nearest; den must be positive.
int mul_div(int v, int num, int den) {
    int p = v * num;
    if (p >= 0) { return (p + den / 2) / den; }
    return -((den / 2 - p) / den);
}

int int_abs(int v) {
    if (v < 0) { return -v; }
    return v;
}

int int_min(int a, int b) {
    if (a < b) { return a; }
    return b;
}

int int_max(int a, int b) {
    if (a > b) { return a; }
    return b;
}

int clamp(int v, int lo, int hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// Integer square root: the largest r with r * r <= n (n >= 0).
int isqrt(int n) {
    if (n < 2) { return int_max(n, 0); }
    int x = n;
    int y = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}

struct Point {
    int x;
    int y;
}

Point pt(int x, int y) { return new Point{x: x, y: y}; }

struct Size {
    int w;
    int h;
}

Size size_of(int w, int h) { return new Size{w: w, h: h}; }

struct Insets {
    int left;
    int top;
    int right;
    int bottom;
}

Insets insets_all(int v) { return new Insets{left: v, top: v, right: v, bottom: v}; }
Insets insets_xy(int x, int y) { return new Insets{left: x, top: y, right: x, bottom: y}; }

struct Rect {
    int x;
    int y;
    int w;
    int h;

    int right() { return self.x + self.w; }
    int bottom() { return self.y + self.h; }
    bool empty() { return self.w <= 0 || self.h <= 0; }

    bool contains(int px, int py) {
        return px >= self.x && py >= self.y && px < self.x + self.w && py < self.y + self.h;
    }

    Rect inset(Insets i) {
        return new Rect{x: self.x + i.left, y: self.y + i.top, w: int_max(0, self.w - i.left - i.right), h: int_max(0, self.h - i.top - i.bottom)};
    }

    Rect grow(int d) {
        return new Rect{x: self.x - d, y: self.y - d, w: self.w + 2 * d, h: self.h + 2 * d};
    }

    Rect intersect(Rect o) {
        int x0 = int_max(self.x, o.x);
        int y0 = int_max(self.y, o.y);
        int x1 = int_min(self.right(), o.right());
        int y1 = int_min(self.bottom(), o.bottom());
        return new Rect{x: x0, y: y0, w: int_max(0, x1 - x0), h: int_max(0, y1 - y0)};
    }

    Rect offset(int dx, int dy) { return new Rect{x: self.x + dx, y: self.y + dy, w: self.w, h: self.h}; }
}

Rect rect(int x, int y, int w, int h) { return new Rect{x: x, y: y, w: w, h: h}; }

// Rect in whole pixels, for convenience in application code and tests.
Rect rect_px(int x, int y, int w, int h) { return new Rect{x: x * FX, y: y * FX, w: w * FX, h: h * FX}; }

// Layout constraints, as in Flutter: a parent tells a child the smallest and largest
// size it may take; the child chooses a size within them. UNBOUNDED marks no limit.
const int UNBOUNDED = 0x3FFFFFFFFFFFFFFF;

struct Constraints {
    int min_w;
    int min_h;
    int max_w;
    int max_h;

    int fit_w(int w) { return clamp(w, self.min_w, self.max_w); }
    int fit_h(int h) { return clamp(h, self.min_h, self.max_h); }

    Constraints loosen() { return new Constraints{min_w: 0, min_h: 0, max_w: self.max_w, max_h: self.max_h}; }

    Constraints deflate(Insets i) {
        int dw = i.left + i.right;
        int dh = i.top + i.bottom;
        return new Constraints{min_w: int_max(0, self.min_w - dw), min_h: int_max(0, self.min_h - dh), max_w: sub_bound(self.max_w, dw), max_h: sub_bound(self.max_h, dh)};
    }
}

int sub_bound(int bound, int d) {
    if (bound >= UNBOUNDED) { return UNBOUNDED; }
    return int_max(0, bound - d);
}

Constraints tight(int w, int h) { return new Constraints{min_w: w, min_h: h, max_w: w, max_h: h}; }
Constraints loose(int w, int h) { return new Constraints{min_w: 0, min_h: 0, max_w: w, max_h: h}; }


// ---- checked arithmetic for public geometry boundaries ------------------------------
// Optional results let callers reject invalid geometry without triggering the
// compiler's ordinary arithmetic-overflow stop. These helpers are additive: legacy
// convenience functions above retain their existing signatures during migration.

const int SHROUD_INT_MAX = 0x7FFFFFFFFFFFFFFF;
const int SHROUD_INT_MIN = -0x7FFFFFFFFFFFFFFF - 1;

int? checked_add(int a, int b) {
    if (b > 0 && a > SHROUD_INT_MAX - b) { return none; }
    if (b < 0 && a < SHROUD_INT_MIN - b) { return none; }
    return a + b;
}

int? checked_sub(int a, int b) {
    if (b > 0 && a < SHROUD_INT_MIN + b) { return none; }
    if (b < 0 && a > SHROUD_INT_MAX + b) { return none; }
    return a - b;
}

int? checked_mul(int a, int b) {
    if (a == 0 || b == 0) { return 0; }
    if ((a == -1 && b == SHROUD_INT_MIN) ||
        (b == -1 && a == SHROUD_INT_MIN)) { return none; }
    if (a > 0) {
        if (b > 0 && a > SHROUD_INT_MAX / b) { return none; }
        if (b < 0 && b < SHROUD_INT_MIN / a) { return none; }
    } else {
        if (b > 0 && a < SHROUD_INT_MIN / b) { return none; }
        if (b < 0 && a < SHROUD_INT_MAX / b) { return none; }
    }
    return a * b;
}

int? checked_abs(int v) {
    if (v == SHROUD_INT_MIN) { return none; }
    if (v < 0) { return -v; }
    return v;
}

// Signed division rounded to nearest, with exact ties away from zero.
// The denominator may have either sign but must not be zero.
int? checked_round_div(int numerator, int denominator) {
    if (denominator == 0) { return none; }
    if (numerator == SHROUD_INT_MIN && denominator == -1) { return none; }
    int q = numerator / denominator;
    int r = numerator % denominator;
    if (r == 0) { return q; }
    int halfway = 0;
    if (denominator == SHROUD_INT_MIN) {
        // abs(INT_MIN) is 2^63, which is not representable as a signed int;
        // its nearest-rounding threshold is exactly 2^62.
        halfway = 0x4000000000000000;
    } else {
        int denominator_magnitude = denominator;
        if (denominator_magnitude < 0) { denominator_magnitude = -denominator_magnitude; }
        halfway = denominator_magnitude / 2 + denominator_magnitude % 2;
    }
    int remainder_magnitude = r;
    if (remainder_magnitude < 0) { remainder_magnitude = -remainder_magnitude; }
    if (remainder_magnitude >= halfway) {
        if ((numerator < 0) == (denominator < 0)) { return q + 1; }
        return q - 1;
    }
    return q;
}

int? checked_fx(int pixels) {
    if (let scaled = checked_mul(pixels, FX)) { return scaled; }
    return none;
}

int? checked_fx_mul(int a, int b) {
    if (let product = checked_mul(a, b)) {
        return checked_round_div(product, FX);
    }
    return none;
}

int? checked_fx_div(int a, int b) {
    if (b == 0) { return none; }
    if (let numerator = checked_mul(a, FX)) {
        return checked_round_div(numerator, b);
    }
    return none;
}

// v * numerator / denominator, rounded to nearest, ties away from zero.
// A positive denominator is required to keep the public contract unambiguous.
int? checked_mul_div(int v, int numerator, int denominator) {
    if (denominator <= 0) { return none; }
    if (let product = checked_mul(v, numerator)) {
        return checked_round_div(product, denominator);
    }
    return none;
}


// Checked rectangle and constraint operations. These are the migration targets for
// callers currently using the legacy total-looking methods above.
bool checked_rect_valid(Rect r) {
    if (r.w < 0 || r.h < 0) { return false; }
    if (let _right = checked_add(r.x, r.w)) {
        if (let _bottom = checked_add(r.y, r.h)) { return true; }
    }
    return false;
}

int? checked_rect_right(Rect r) {
    if (r.w < 0) { return none; }
    return checked_add(r.x, r.w);
}

int? checked_rect_bottom(Rect r) {
    if (r.h < 0) { return none; }
    return checked_add(r.y, r.h);
}

Rect? checked_rect_offset(Rect r, int dx, int dy) {
    if (!checked_rect_valid(r)) { return none; }
    if (let x = checked_add(r.x, dx)) {
        if (let y = checked_add(r.y, dy)) {
            Rect moved = rect(x, y, r.w, r.h);
            if (checked_rect_valid(moved)) { return moved; }
        }
    }
    return none;
}

Rect? checked_rect_intersect(Rect a, Rect b) {
    if (!checked_rect_valid(a) || !checked_rect_valid(b)) { return none; }
    int ax1 = 0;
    int ay1 = 0;
    int bx1 = 0;
    int by1 = 0;
    if (let edge = checked_rect_right(a)) { ax1 = edge; } else { return none; }
    if (let edge = checked_rect_bottom(a)) { ay1 = edge; } else { return none; }
    if (let edge = checked_rect_right(b)) { bx1 = edge; } else { return none; }
    if (let edge = checked_rect_bottom(b)) { by1 = edge; } else { return none; }
    int x0 = int_max(a.x, b.x);
    int y0 = int_max(a.y, b.y);
    int x1 = int_min(ax1, bx1);
    int y1 = int_min(ay1, by1);
    if (x1 <= x0 || y1 <= y0) { return rect(x0, y0, 0, 0); }
    if (let w = checked_sub(x1, x0)) {
        if (let h = checked_sub(y1, y0)) { return rect(x0, y0, w, h); }
    }
    return none;
}

Rect? checked_rect_inset(Rect r, Insets i) {
    if (!checked_rect_valid(r) || i.left < 0 || i.top < 0 ||
        i.right < 0 || i.bottom < 0) { return none; }
    int right = 0;
    int bottom = 0;
    if (let edge = checked_rect_right(r)) { right = edge; } else { return none; }
    if (let edge = checked_rect_bottom(r)) { bottom = edge; } else { return none; }
    if (let x1 = checked_add(r.x, i.left)) {
        if (let y1 = checked_add(r.y, i.top)) {
            if (let dx = checked_add(i.left, i.right)) {
                if (let dy = checked_add(i.top, i.bottom)) {
                    int x = int_min(x1, right);
                    int y = int_min(y1, bottom);
                    int w = 0;
                    int h = 0;
                    if (dx < r.w) { w = r.w - dx; }
                    if (dy < r.h) { h = r.h - dy; }
                    return rect(x, y, w, h);
                }
            }
        }
    }
    return none;
}

Rect? checked_rect_grow(Rect r, int d) {
    if (!checked_rect_valid(r)) { return none; }
    if (let twice = checked_mul(d, 2)) {
        if (let x = checked_sub(r.x, d)) {
            if (let y = checked_sub(r.y, d)) {
                if (let w = checked_add(r.w, twice)) {
                    if (let h = checked_add(r.h, twice)) {
                        if (w < 0 || h < 0) { return none; }
                        Rect grown = rect(x, y, w, h);
                        if (checked_rect_valid(grown)) { return grown; }
                    }
                }
            }
        }
    }
    return none;
}

bool checked_constraints_valid(Constraints c) {
    if (c.min_w < 0 || c.min_h < 0 || c.max_w < c.min_w || c.max_h < c.min_h) { return false; }
    if (c.max_w > UNBOUNDED || c.max_h > UNBOUNDED) { return false; }
    return true;
}

Constraints? checked_constraints_deflate(Constraints c, Insets i) {
    if (!checked_constraints_valid(c) || i.left < 0 || i.top < 0 ||
        i.right < 0 || i.bottom < 0) { return none; }
    if (let dw = checked_add(i.left, i.right)) {
        if (let dh = checked_add(i.top, i.bottom)) {
            int min_w = 0;
            int min_h = 0;
            int max_w = UNBOUNDED;
            int max_h = UNBOUNDED;
            if (dw < c.min_w) { min_w = c.min_w - dw; }
            if (dh < c.min_h) { min_h = c.min_h - dh; }
            if (c.max_w != UNBOUNDED) {
                max_w = 0;
                if (dw < c.max_w) { max_w = c.max_w - dw; }
            }
            if (c.max_h != UNBOUNDED) {
                max_h = 0;
                if (dh < c.max_h) { max_h = c.max_h - dh; }
            }
            if (max_w < min_w) { max_w = min_w; }
            if (max_h < min_h) { max_h = min_h; }
            Constraints result = new Constraints{min_w: min_w, min_h: min_h, max_w: max_w, max_h: max_h};
            if (checked_constraints_valid(result)) { return result; }
        }
    }
    return none;
}
