// Shroud: accessibility.
//
// Shroud draws its own widgets, so it must describe them to assistive technology
// itself, as Flutter does. Every frame has an accessibility tree: each node has a role,
// a name, a value, its states and its bounds. A platform embedder translates the tree
// into the operating system's interface: UI Automation on Windows, NSAccessibility on
// macOS, AT-SPI on Linux, and later the iOS and Android equivalents (docs/SHROUD.md).
//
// Accessibility is checked, not just offered. a11y_problems() reports every control a
// screen reader could not name and every text that fails WCAG 2.2 contrast (found while
// painting), and tests can require an empty report.

struct A11yNode {
    string id;
    string role;
    string name;            // JSON-escaped
    string value;           // JSON-escaped
    List<string> states;
    Rect bounds;            // whole device pixels
    List<A11yNode> kids;
}

// Convert already-sanitised code points back to UTF-8. The accessibility tree must
// expose the same visible characters as the renderer, not the original Tainted bytes.
string utf8_from_codepoints(List<int> cps) {
    string out = "";
    for (int i = 0; i < cps.len(); i += 1) {
        int cp = cps[i];
        if (cp < 0x80) {
            out = out + char_str(cp);
        } else if (cp < 0x800) {
            out = out + char_str(0xC0 | (cp >> 6)) + char_str(0x80 | (cp & 0x3F));
        } else if (cp < 0x10000) {
            out = out + char_str(0xE0 | (cp >> 12)) + char_str(0x80 | ((cp >> 6) & 0x3F)) + char_str(0x80 | (cp & 0x3F));
        } else {
            out = out + char_str(0xF0 | (cp >> 18)) + char_str(0x80 | ((cp >> 12) & 0x3F)) + char_str(0x80 | ((cp >> 6) & 0x3F)) + char_str(0x80 | (cp & 0x3F));
        }
    }
    return out;
}

string visible_untrusted_text(Tainted value) {
    return utf8_from_codepoints(untrusted_codepoints(value));
}

string role_of(View v) {
    int k = v.kind;
    if (k == K_TEXT) { return "text"; }
    if (k == K_BUTTON) { return "button"; }
    if (k == K_CHECKBOX) { return "checkbox"; }
    if (k == K_RADIO) { return "radio"; }
    if (k == K_SWITCH) { return "switch"; }
    if (k == K_TEXT_FIELD) {
        if (v.secure) { return "password"; }
        return "textbox";
    }
    if (k == K_SLIDER) { return "slider"; }
    if (k == K_PROGRESS) { return "progressbar"; }
    if (k == K_DIVIDER) { return "separator"; }
    if (k == K_SCROLL) { return "scrollarea"; }
    return "group";
}

// The accessible name, escaped for JSON: the label if set, otherwise the visible text.
string name_of(View v) {
    if (v.label != "") { return escape_json(v.label); }
    if (v.kind == K_TEXT && v.has_value) { return escape_json(visible_untrusted_text(v.value)); }
    return escape_json(v.text);
}

string value_of(View v) {
    int k = v.kind;
    if (k == K_TEXT_FIELD) {
        // A password's value is never exposed; screen readers announce its length.
        if (v.secure) { return $"{untrusted_codepoints(v.value).len()} characters"; }
        return escape_json(visible_untrusted_text(v.value));
    }
    if (k == K_SLIDER || k == K_PROGRESS) { return $"{v.num}"; }
    return "";
}

A11yNode? a11y_node(Ui ui, Laid l, Rect clip) {
    View v = l.v;
    Rect visible = l.frame.intersect(clip);
    // A scroll viewport clips its descendants just as the software painter does.
    // Other containers may intentionally allow children to overflow their frame.
    Rect child_clip = clip;
    if (v.kind == K_SCROLL) { child_clip = clip.intersect(l.frame); }
    List<A11yNode> kids = new List<A11yNode>();
    for (int i = 0; i < l.kids.len(); i += 1) {
        if (let k = a11y_node(ui, l.kids[i], child_clip)) { kids.push(k); }
    }
    string role = role_of(v);
    // Plain containers without a name are flattened into their children.
    bool meaningful = role != "group" || v.label != "";
    if (v.kind == K_SPACER || (v.kind == K_BOX && v.label == "")) { meaningful = false; }
    if (!meaningful && kids.len() == 1) { return kids[0]; }
    if (!meaningful && kids.len() == 0) { return none; }
    if (visible.empty() && kids.len() == 0) { return none; }
    List<string> states = new List<string>();
    if (v.focusable()) { states.push("focusable"); }
    if (l.id == ui.focus) { states.push("focused"); }
    if (v.disabled) { states.push("disabled"); }
    if (v.kind == K_CHECKBOX || v.kind == K_SWITCH || v.kind == K_RADIO) {
        if (v.num != 0) { states.push("checked"); } else { states.push("unchecked"); }
    }
    if (v.secure) { states.push("protected"); }
    Rect b = rect(0, 0, 0, 0);
    if (visible.empty()) {
        // A non-clipping container may itself be outside the window while an
        // overflowing child remains visible. Bound that container by its children.
        int left = kids[0].bounds.x;
        int top = kids[0].bounds.y;
        int right = kids[0].bounds.right();
        int bottom = kids[0].bounds.bottom();
        for (int i = 1; i < kids.len(); i += 1) {
            left = int_min(left, kids[i].bounds.x);
            top = int_min(top, kids[i].bounds.y);
            right = int_max(right, kids[i].bounds.right());
            bottom = int_max(bottom, kids[i].bounds.bottom());
        }
        b = rect(left, top, right - left, bottom - top);
    } else {
        b = rect(fx_floor(visible.x), fx_floor(visible.y), fx_ceil(visible.right()) - fx_floor(visible.x), fx_ceil(visible.bottom()) - fx_floor(visible.y));
    }
    return new A11yNode{id: l.id, role: role, name: name_of(v), value: value_of(v), states: states, bounds: b, kids: kids};
}

// The current frame's accessibility tree, or none before the first render.
A11yNode? a11y_tree(Ui ui) {
    if (let l = ui.root) { return a11y_node(ui, l, rect(0, 0, fx(ui.pixmap.w), fx(ui.pixmap.h))); }
    return none;
}

string a11y_json(A11yNode n) {
    List<string> parts = new List<string>();
    parts.push($"{{\"id\":\"{escape_json(n.id)}\",\"role\":\"{n.role}\",\"name\":\"{n.name}\"");
    if (n.value != "") { parts.push($",\"value\":\"{n.value}\""); }
    if (n.states.len() > 0) { parts.push($",\"states\":[\"{join(n.states, "\",\"")}\"]"); }
    parts.push($",\"bounds\":[{n.bounds.x},{n.bounds.y},{n.bounds.w},{n.bounds.h}]");
    if (n.kids.len() > 0) {
        List<string> ks = new List<string>();
        for (int i = 0; i < n.kids.len(); i += 1) { ks.push(a11y_json(n.kids[i])); }
        parts.push($",\"children\":[{join(ks, ",")}]");
    }
    parts.push("}");
    return join(parts, "");
}

// Visit only nodes exposed in the current viewport. This keeps diagnostics in sync
// with the accessibility tree and the painter's nested scroll clipping.
void collect_a11y_problems(Ui ui, Laid l, Rect clip, List<string> out) {
    Rect visible = l.frame.intersect(clip);
    View v = l.v;
    bool interactive = v.kind == K_BUTTON || v.kind == K_CHECKBOX || v.kind == K_SWITCH || v.kind == K_RADIO || v.kind == K_TEXT_FIELD || v.kind == K_SLIDER;
    if (!visible.empty() && interactive && name_of(v) == "") { out.push($"{role_of(v)} {l.id} has no accessible name: give it a label()"); }
    // WCAG 2.5.8: only the visible, hit-testable portion is an effective target.
    if (!visible.empty() && interactive && (visible.w < dp(ui, 24) || visible.h < dp(ui, 24))) {
        out.push($"{role_of(v)} {l.id} is smaller than the 24 dp minimum target size");
    }
    Rect child_clip = clip;
    if (v.kind == K_SCROLL) { child_clip = clip.intersect(l.frame); }
    for (int i = 0; i < l.kids.len(); i += 1) {
        collect_a11y_problems(ui, l.kids[i], child_clip, out);
    }
}

// Problems an assistive-technology user would meet in the current frame.
List<string> a11y_problems(Ui ui) {
    List<string> out = new List<string>();
    if (let l = ui.root) {
        collect_a11y_problems(ui, l, rect(0, 0, fx(ui.pixmap.w), fx(ui.pixmap.h)), out);
    }
    for (int j = 0; j < ui.problems.len(); j += 1) { out.push(ui.problems[j]); }
    return out;
}
