// Shroud: accessibility.
//
// Shroud draws its own widgets, so it must describe them to assistive technology
// itself, as Flutter does. Every frame has an accessibility tree: each node has a role,
// a name, a value, its states and its bounds. A platform embedder translates the tree
// into the operating system's interface: UI Automation on Windows, NSAccessibility on
// macOS, AT-SPI on Linux, and later the iOS and Android equivalents (docs/SHROUD.md).
//
// Accessibility is checked, not just offered. a11y_problems() reports every control a
// screen reader could not name and every text that fails WCAG 2.2 contrast (found while
// painting), and tests can require an empty report.

struct A11yNode {
    string id;
    string role;
    Tainted name;           // raw accessible name; escaped only by a11y_json()
    Tainted value;          // raw accessible value; escaped only by a11y_json()
    List<string> states;
    Rect bounds;            // whole device pixels
    List<A11yNode> kids;
}

// Convert already-sanitised code points back to UTF-8. The accessibility tree must
// expose the same visible characters as the renderer, not the original Tainted bytes.
Tainted utf8_from_codepoints(List<int> cps) {
    // Validate scalar values and the encoded-byte budget before allocating any
    // output fragments. The helper can also be called with a hand-built list.
    int byte_count = 0;
    for (int p = 0; p < cps.len(); p += 1) {
        int cp = cps[p];
        if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {
            println("shroud: invalid Unicode scalar in accessibility text");
            exit(101);
        }
        int width = 1;
        if (cp >= 0x80 && cp < 0x800) { width = 2; }
        if (cp >= 0x800 && cp < 0x10000) { width = 3; }
        if (cp >= 0x10000) { width = 4; }
        if (width > MAX_TEXT_BYTES - byte_count) {
            println("shroud: accessibility UTF-8 byte limit exceeded");
            exit(101);
        }
        byte_count += width;
    }
    // Bound temporary fragment retention as well as copying: each chunk holds
    // at most 4096 code points, and cap_join allocates each joined result once.
    // Repeatedly appending to a growing prefix copied O(n^2) bytes.
    List<string> chunks = new List<string>();
    List<string> fragments = new List<string>();
    for (int i = 0; i < cps.len(); i += 1) {
        int cp = cps[i];
        if (cp < 0x80) {
            fragments.push(char_str(cp));
        } else if (cp < 0x800) {
            fragments.push(char_str(0xC0 | (cp >> 6)) + char_str(0x80 | (cp & 0x3F)));
        } else if (cp < 0x10000) {
            fragments.push(char_str(0xE0 | (cp >> 12)) + char_str(0x80 | ((cp >> 6) & 0x3F)) + char_str(0x80 | (cp & 0x3F)));
        } else {
            fragments.push(char_str(0xF0 | (cp >> 18)) + char_str(0x80 | ((cp >> 12) & 0x3F)) + char_str(0x80 | ((cp >> 6) & 0x3F)) + char_str(0x80 | (cp & 0x3F)));
        }
        if (fragments.len() == 4096) {
            chunks.push(join(fragments, ""));
            fragments = new List<string>();
        }
    }
    if (fragments.len() > 0) { chunks.push(join(fragments, "")); }
    return taint(join(chunks, ""));
}

Tainted visible_untrusted_text(Tainted value) {
    return utf8_from_codepoints(untrusted_codepoints(value));
}

string role_of(View v) {
    int k = v.kind;
    if (k == K_TEXT) { return "text"; }
    if (k == K_BUTTON) { return "button"; }
    if (k == K_CHECKBOX) { return "checkbox"; }
    if (k == K_RADIO) { return "radio"; }
    if (k == K_SWITCH) { return "switch"; }
    if (k == K_TEXT_FIELD) {
        if (v.secure) { return "password"; }
        return "textbox";
    }
    if (k == K_SLIDER) { return "slider"; }
    if (k == K_PROGRESS) { return "progressbar"; }
    if (k == K_DIVIDER) { return "separator"; }
    if (k == K_SCROLL) { return "scrollarea"; }
    return "group";
}

// The accessible name, escaped for JSON: the label if set, otherwise the visible text.
Tainted name_of(View v) {
    if (v.label != "") { return taint(v.label); }
    if (v.kind == K_TEXT && v.has_value) { return visible_untrusted_text(v.value); }
    if (v.kind == K_TEXT_FIELD) { return taint(v.hint); }
    return taint(v.text);
}

Tainted value_of(View v) {
    int k = v.kind;
    if (k == K_TEXT_FIELD) {
        // A password's value is never exposed; screen readers announce its length.
        if (v.secure) { return taint($"{untrusted_codepoints(v.value).len()} characters"); }
        return visible_untrusted_text(v.value);
    }
    if (k == K_SLIDER || k == K_PROGRESS) { return taint($"{v.num}"); }
    return taint("");
}

// Bound both recursion and output before constructing any JSON fragments. The
// sixfold field allowance is the worst-case expansion of escape_json(); the
// per-node/per-state allowances cover JSON punctuation and integer bounds.
const int MAX_A11Y_JSON_BYTES = 33554432;

bool a11y_json_budget_add(List<int> budget, int n) {
    if (n < 0 || n > MAX_A11Y_JSON_BYTES - budget[1]) { return false; }
    budget[1] += n;
    return true;
}

bool a11y_json_field_budget(List<int> budget, int n) {
    if (n < 0 || budget[1] > MAX_A11Y_JSON_BYTES) { return false; }
    int room = MAX_A11Y_JSON_BYTES - budget[1];
    if (n > room / 6) { return false; }
    return a11y_json_budget_add(budget, n * 6);
}

bool a11y_json_preflight(A11yNode n, List<int> budget, int depth) {
    if (depth > MAX_DEPTH || budget[0] >= MAX_VIEWS) { return false; }
    budget[0] += 1;
    if (!a11y_json_field_budget(budget, n.id.len())) { return false; }
    if (!a11y_json_field_budget(budget, n.role.len())) { return false; }
    if (!a11y_json_field_budget(budget, n.name.len())) { return false; }
    if (!a11y_json_field_budget(budget, n.value.len())) { return false; }
    if (!a11y_json_budget_add(budget, 128)) { return false; }
    for (int i = 0; i < n.states.len(); i += 1) {
        if (!a11y_json_field_budget(budget, n.states[i].len())) { return false; }
        if (!a11y_json_budget_add(budget, 16)) { return false; }
    }
    for (int i = 0; i < n.kids.len(); i += 1) {
        if (!a11y_json_preflight(n.kids[i], budget, depth + 1)) { return false; }
    }
    return true;
}

void a11y_json_push(List<List<string>> batches, string part) {
    List<string> current = batches[batches.len() - 1];
    current.push(part);
    if (current.len() == 4096) { batches.push(new List<string>()); }
}

void a11y_json_append(A11yNode n, List<List<string>> batches) {
    a11y_json_push(batches, "{\"id\":\"");
    a11y_json_push(batches, escape_json(taint(n.id)));
    a11y_json_push(batches, "\",\"role\":\"");
    a11y_json_push(batches, escape_json(taint(n.role)));
    a11y_json_push(batches, "\",\"name\":\"");
    a11y_json_push(batches, escape_json(n.name));
    a11y_json_push(batches, "\"");
    if (n.value.len() > 0) {
        a11y_json_push(batches, ",\"value\":\"");
        a11y_json_push(batches, escape_json(n.value));
        a11y_json_push(batches, "\"");
    }
    if (n.states.len() > 0) {
        a11y_json_push(batches, ",\"states\":[");
        for (int i = 0; i < n.states.len(); i += 1) {
            if (i > 0) { a11y_json_push(batches, ","); }
            a11y_json_push(batches, "\"");
            a11y_json_push(batches, escape_json(taint(n.states[i])));
            a11y_json_push(batches, "\"");
        }
        a11y_json_push(batches, "]");
    }
    a11y_json_push(batches, $",\"bounds\":[{n.bounds.x},{n.bounds.y},{n.bounds.w},{n.bounds.h}]");
    if (n.kids.len() > 0) {
        a11y_json_push(batches, ",\"children\":[");
        for (int i = 0; i < n.kids.len(); i += 1) {
            if (i > 0) { a11y_json_push(batches, ","); }
            a11y_json_append(n.kids[i], batches);
        }
        a11y_json_push(batches, "]");
    }
    a11y_json_push(batches, "}");
}
string a11y_json(A11yNode n) {
    List<int> budget = new List<int>();
    budget.push(0);
    budget.push(0);
    if (!a11y_json_preflight(n, budget, 0)) {
        println("shroud: accessibility JSON node/depth/byte budget exceeded");
        exit(101);
    }
    List<List<string>> batches = new List<List<string>>();
    batches.push(new List<string>());
    a11y_json_append(n, batches);
    List<string> chunks = new List<string>();
    for (int i = 0; i < batches.len(); i += 1) {
        if (batches[i].len() > 0) { chunks.push(join(batches[i], "")); }
    }
    return join(chunks, "");
}

// Problems an assistive-technology user would meet in the current frame.
List<string> a11y_problems(Ui ui) {
    List<string> out = new List<string>();
    if (let l = ui.root) {
        List<Laid> all = new List<Laid>();
        collect(l, all);
        for (int i = 0; i < all.len(); i += 1) {
            View v = all[i].v;
            bool interactive = v.kind == K_BUTTON || v.kind == K_CHECKBOX || v.kind == K_SWITCH || v.kind == K_RADIO || v.kind == K_TEXT_FIELD || v.kind == K_SLIDER;
            if (interactive && name_of(v).len() == 0) { out.push($"{role_of(v)} {all[i].id} has no accessible name: give it a label()"); }
            // WCAG 2.5.8: targets at least 24 by 24 CSS pixels.
            if (interactive && (all[i].frame.w < dp(ui, 24) || all[i].frame.h < dp(ui, 24))) {
                out.push($"{role_of(v)} {all[i].id} is smaller than the 24 dp minimum target size");
            }
        }
    }
    for (int j = 0; j < ui.problems.len(); j += 1) { out.push(ui.problems[j]); }
    return out;
}
