// Shroud: text.
//
// Text is decoded from UTF-8 into code points; invalid bytes become U+FFFD, so
// malformed input is visible rather than silently dropped or misread.
//
// Untrusted text (Tainted) is displayed safely by construction. Characters that can
// make text look like something it is not (CWE-451, user interface misrepresentation)
// are drawn as a visible replacement mark instead of acting invisibly: bidirectional
// overrides and isolates, which reorder what the user sees (the "Trojan Source"
// attack, CVE-2021-42574, and file names such as "invoice[RLO]fdp.exe"), zero-width
// characters, control characters and the byte-order mark. Trusted text written by the
// program keeps them, so its author stays in control.

const int REPLACEMENT_CHAR = 0xFFFD;
const int MAX_TEXT_BYTES = 1048576;      // longest text one widget will lay out (CWE-400)

void utf8_push(List<int> out, int b0, int b1, int b2, int b3, int n) {
    if (n == 1) {
        out.push(b0);
    } else if (n == 2) {
        out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F));
    } else if (n == 3) {
        out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F));
    } else {
        out.push(((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F));
    }
}

bool is_cont(int b) { return (b & 0xC0) == 0x80; }

struct Utf8Decoded {
    List<int> codepoints;
    List<int> byte_ends;
}

// Strict UTF-8 decoding with optional byte-end offsets. Invalid sequences use the
// maximal-subpart replacement behaviour documented above.
void utf8_decode_into(List<int> b, List<int> out, List<int>? ends) {
    int i = 0;
    int n = b.len();
    while (i < n) {
        int b0 = b[i];
        if (b0 < 0x80) {
            out.push(b0);
            i += 1;
            if (let offsets = ends) { offsets.push(i); }
            continue;
        }
        int need = 0;
        int lo = 0x80;
        int hi = 0xBF;
        if (b0 >= 0xC2 && b0 <= 0xDF) {
            need = 1;
        } else if (b0 >= 0xE0 && b0 <= 0xEF) {
            need = 2;
            if (b0 == 0xE0) { lo = 0xA0; }
            if (b0 == 0xED) { hi = 0x9F; }
        } else if (b0 >= 0xF0 && b0 <= 0xF4) {
            need = 3;
            if (b0 == 0xF0) { lo = 0x90; }
            if (b0 == 0xF4) { hi = 0x8F; }
        } else {
            out.push(REPLACEMENT_CHAR);
            i += 1;
            if (let offsets = ends) { offsets.push(i); }
            continue;
        }
        // Check the continuation bytes; the first has a narrower range.
        int got = 0;
        bool bad = false;
        while (got < need && !bad) {
            int at = i + 1 + got;
            if (at >= n) {
                bad = true;
            } else {
                int c = b[at];
                int l = 0x80;
                int h = 0xBF;
                if (got == 0) {
                    l = lo;
                    h = hi;
                }
                if (c < l || c > h) { bad = true; } else { got += 1; }
            }
        }
        if (bad) {
            out.push(REPLACEMENT_CHAR);
            i += 1 + got;
            if (let offsets = ends) { offsets.push(i); }
            continue;
        }
        int b1 = b[i + 1];
        int b2 = 0;
        int b3 = 0;
        if (need >= 2) { b2 = b[i + 2]; }
        if (need >= 3) { b3 = b[i + 3]; }
        utf8_push(out, b0, b1, b2, b3, need + 1);
        i += need + 1;
        if (let offsets = ends) { offsets.push(i); }
    }
}

Utf8Decoded utf8_decode_with_ends(List<int> b) {
    List<int> out = new List<int>();
    List<int> ends = new List<int>();
    utf8_decode_into(b, out, ends);
    return new Utf8Decoded{codepoints: out, byte_ends: ends};
}

List<int> utf8_decode(List<int> b) {
    List<int> out = new List<int>();
    utf8_decode_into(b, out, none);
    return out;
}

List<int> string_bytes(string s) {
    List<int> out = new List<int>();
    int n = int_min(s.len(), MAX_TEXT_BYTES);
    for (int i = 0; i < n; i += 1) { out.push(s.at(i)); }
    return out;
}

List<int> tainted_bytes(Tainted s) {
    List<int> out = new List<int>();
    int n = int_min(s.len(), MAX_TEXT_BYTES);
    for (int i = 0; i < n; i += 1) { out.push(s.at(i)); }
    return out;
}

// Code points of trusted text.
List<int> text_codepoints(string s) { return utf8_decode(string_bytes(s)); }

// Characters that change how surrounding text looks without being seen themselves.
bool is_deceptive(int cp) {
    if (cp < 0x20 && cp != 0x09) { return true; }                       // C0 controls (tab is kept)
    if (cp >= 0x7F && cp <= 0x9F) { return true; }                      // DEL and C1 controls
    if (cp == 0x061C || cp == 0x200E || cp == 0x200F) { return true; }  // bidi marks
    if (cp >= 0x202A && cp <= 0x202E) { return true; }                  // bidi embeddings and overrides
    if (cp >= 0x2066 && cp <= 0x2069) { return true; }                  // bidi isolates
    if (cp >= 0x200B && cp <= 0x200D) { return true; }                  // zero-width space and joiners
    if (cp == 0x2060 || cp == 0xFEFF || cp == 0x00AD) { return true; }  // word joiner, BOM, soft hyphen
    if (cp == 0x2028 || cp == 0x2029) { return true; }                  // line and paragraph separators
    if (cp >= 0xFFF9 && cp <= 0xFFFB) { return true; }                  // interlinear annotations
    if (cp >= 0xE0000 && cp <= 0xE007F) { return true; }                // tag characters
    return false;
}

// Code points of untrusted text, safe to display: see the header.
List<int> untrusted_codepoints(Tainted s) {
    List<int> cps = utf8_decode(tainted_bytes(s));
    for (int i = 0; i < cps.len(); i += 1) {
        if (is_deceptive(cps[i])) { cps[i] = REPLACEMENT_CHAR; }
    }
    return cps;
}

// ---- measuring and drawing -------------------------------------------------------------

int glyph_for(Font f, int cp) {
    if (cp == 0x09) { return glyph_index(f, 0x20); }
    int g = glyph_index(f, cp);
    if (g == 0 && cp != REPLACEMENT_CHAR) { return glyph_index(f, REPLACEMENT_CHAR); }
    return g;
}

int text_width(Font f, int size, List<int> cps, int from, int to) {
    int w = 0;
    for (int i = from; i < to; i += 1) { w += glyph_advance(f, glyph_for(f, cps[i]), size); }
    return w;
}

// Draws cps[from..to) with the pen starting at (x, baseline), both in FX.
// Returns the pen's x after the last glyph.
int draw_glyphs(Canvas cv, Font f, int size, List<int> cps, int from, int to, int x, int baseline, int color) {
    int pen = x;
    int by = fx_round(baseline);
    Paint paint = solid(color);
    Rect clip = cv.clip();
    for (int i = from; i < to; i += 1) {
        int g = glyph_for(f, cps[i]);
        int phase = (pen & 255) >> 6;
        GlyphMask m = glyph_mask(f, g, size, phase);
        int gx = (pen >> 8) + m.left;
        int gy = by + m.top;
        int x0 = int_max(gx, clip.x);
        int x1 = int_min(gx + m.w, clip.right());
        int y0 = int_max(gy, clip.y);
        int y1 = int_min(gy + m.h, clip.bottom());
        for (int yy = y0; yy < y1; yy += 1) {
            int row = (yy - gy) * m.w;
            for (int xx = x0; xx < x1; xx += 1) {
                int a = m.alpha[row + xx - gx];
                if (a > 0) { cv.blend(xx, yy, paint, a); }
            }
        }
        pen += glyph_advance(f, g, size);
    }
    return pen;
}

// ---- line breaking -----------------------------------------------------------------------

// Where each line of cps starts and ends when wrapped to max_w (FX): starts in
// out[0], 2, 4...; ends (exclusive, trailing spaces dropped) in out[1], 3, 5...
// Lines break after spaces, at newlines, and inside a word only if it alone is too
// wide. With max_w at UNBOUNDED only newlines break.
bool line_slot_available(int used, int max_lines, bool allow_truncate) {
    if (used < max_lines) { return true; }
    if (allow_truncate) { return false; }
    println("shroud: frame text line budget exceeded");
    exit(101);
}

List<int> wrap_lines_limited(Font f, int size, List<int> cps, int max_w, int max_lines, bool allow_truncate) {
    List<int> out = new List<int>();
    int limit = int_min(max_lines, MAX_FRAME_LINES);
    int start = 0;
    int w = 0;
    int last_space = -1;
    int i = 0;
    while (i < cps.len()) {
        int cp = cps[i];
        if (cp == 0x0A) {
            if (!line_slot_available(out.len() / 2, limit, allow_truncate)) { return out; }
            out.push(start);
            out.push(trim_end(cps, start, i));
            start = i + 1;
            w = 0;
            last_space = -1;
            i += 1;
            continue;
        }
        int adv = glyph_advance(f, glyph_for(f, cp), size);
        if (w + adv > max_w && i > start && cp != 0x20) {
            int brk = i;
            if (last_space >= start) { brk = last_space + 1; }
            if (!line_slot_available(out.len() / 2, limit, allow_truncate)) { return out; }
            out.push(start);
            out.push(trim_end(cps, start, brk));
            start = brk;
            w = text_width(f, size, cps, start, i);
            last_space = -1;
            continue;
        }
        if (cp == 0x20) { last_space = i; }
        w += adv;
        i += 1;
    }
    if (!line_slot_available(out.len() / 2, limit, allow_truncate)) { return out; }
    out.push(start);
    out.push(trim_end(cps, start, cps.len()));
    return out;
}

// Backwards-compatible single-value wrapper. The layout pass uses the
// limited form with its shared remaining-frame budget.
List<int> wrap_lines(Font f, int size, List<int> cps, int max_w) {
    return wrap_lines_limited(f, size, cps, max_w, MAX_FRAME_LINES, false);
}

int trim_end(List<int> cps, int from, int to) {
    int e = to;
    while (e > from && cps[e - 1] == 0x20) { e -= 1; }
    return e;
}
