        }
        if (b0 >= 0xF1 && b0 <= 0xF3) {
            if (end - i < 4 || !wayland_utf8_continuation(bytes.at(i + 1))
                || !wayland_utf8_continuation(bytes.at(i + 2))
                || !wayland_utf8_continuation(bytes.at(i + 3))) { return false; }
            i += 4; continue;
        }
        if (b0 == 0xF4) {
            if (end - i < 4) { return false; }
            int b1 = bytes.at(i + 1);
            if (b1 < 0x80 || b1 > 0x8F || !wayland_utf8_continuation(bytes.at(i + 2))
                || !wayland_utf8_continuation(bytes.at(i + 3))) { return false; }
            i += 4; continue;
        }
        return false;
    }
    return true;
}

WaylandPayloadSpan wayland_payload_span(Tainted bytes, int offset, int end, bool nul_terminated) {
    WaylandPayloadWord word = wayland_payload_word(bytes, offset, end);
    if (word.status != 1) {
        if (word.status == 0) { return wayland_incomplete_payload_span(); }
        return wayland_bad_payload_span();
    }
    int length = word.value;
    if (length > WAYLAND_MAX_FRAME_BYTES - 12) { return wayland_bad_payload_span(); }
    int padded = ((length + 3) / 4) * 4;
    int data_offset = word.end_offset;
    int payload_end = data_offset + padded;
    if (payload_end > end) { return wayland_incomplete_payload_span(); }
