            if (end - i < 2 || !wayland_utf8_continuation(bytes.at(i + 1))) { return false; }
            i += 2; continue;
        }
        if (b0 == 0xE0) {
            if (end - i < 3) { return false; }
            int b1 = bytes.at(i + 1);
            if (b1 < 0xA0 || b1 > 0xBF || !wayland_utf8_continuation(bytes.at(i + 2))) { return false; }
            i += 3; continue;
        }
        if ((b0 >= 0xE1 && b0 <= 0xEC) || (b0 >= 0xEE && b0 <= 0xEF)) {
            if (end - i < 3 || !wayland_utf8_continuation(bytes.at(i + 1))
                || !wayland_utf8_continuation(bytes.at(i + 2))) { return false; }
            i += 3; continue;
        }
        if (b0 == 0xED) {
            if (end - i < 3) { return false; }
            int b1 = bytes.at(i + 1);
            if (b1 < 0x80 || b1 > 0x9F || !wayland_utf8_continuation(bytes.at(i + 2))) { return false; }
            i += 3; continue;
        }
