// Validate UTF-8 without allocating or converting the tainted wire bytes.
// The caller supplies the bytes before the protocol string's final NUL.
bool wayland_utf8_valid_span(Tainted bytes, int start, int length) {
    if (start < 0 || length < 0 || start > bytes.len() || length > bytes.len() - start) { return false; }
    int end = start + length;
