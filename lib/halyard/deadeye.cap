// Deadeye — first Capstan-native image vertical slice.
// Strict uncompressed BMP ingest into an opaque-format RGBA frame value.
// No filesystem, network, device, C ABI or third-party image implementation.

import "core.cap";

const int DEADEYE_BMP_MAX_INPUT_BYTES = 16777216;
const int DEADEYE_BMP_MAX_PIXELS = 2097152;
const int DEADEYE_BMP_MAX_SIDE = 8192;

struct DeadeyeRgbaFrame {
    int width;
    int height;
    List<int> rgba;
}

struct DeadeyeImageResult {
    bool ok;
    DeadeyeRgbaFrame? frame;
    string error;
}

int deadeye_u16_le(List<int> bytes, int at) {
    return bytes[at] | (bytes[at + 1] << 8);
}

int deadeye_u32_le(List<int> bytes, int at) {
    return bytes[at] | (bytes[at + 1] << 8) |
        (bytes[at + 2] << 16) | (bytes[at + 3] << 24);
}

DeadeyeImageResult deadeye_bmp_error(string error) {
    return new DeadeyeImageResult{ok: false, frame: none, error: error};
}

// Strict Windows BITMAPINFOHEADER profile:
// - 14-byte BMP file header and 40-byte DIB header, pixel data starts at byte 54;
// - BI_RGB (uncompressed), 24-bit BGR or 32-bit BGRx only;
// - no palette, bitfields, colour masks, metadata gap, RLE or trailing bytes;
// - signed height supports both bottom-up and top-down rows;
// - input and pixel counts are bounded before pixel-buffer allocation.
DeadeyeImageResult deadeye_bmp_decode_internal(
    HalyardByteSource source, HalyardConsumptionBudget? budget
) {
    if (!halyard_source_shape_valid(source)) {
        return deadeye_bmp_error("invalid_source");
    }
    int source_length = halyard_source_length(source);
    if (source_length > DEADEYE_BMP_MAX_INPUT_BYTES) {
        return deadeye_bmp_error("input_limit");
    }
    if (let budget_value = budget) {
        HalyardConsumptionCharge input_charge = new HalyardConsumptionCharge{
            input_bytes: source_length, output_bytes: 0,
            decoded_units: 0, work_units: source_length
        };
        if (!halyard_consumption_budget_consume(budget_value, input_charge)) {
            return deadeye_bmp_error("budget_exceeded");
        }
    }
    if (source.position != 0) {
        return deadeye_bmp_error("source_not_at_start");
    }
    if (!halyard_source_validate(source)) {
        return deadeye_bmp_error("invalid_source");
    }

    HalyardBytesResult header = halyard_read_exact(source, 54);
    if (!header.ok) { return deadeye_bmp_error("truncated_header"); }
    if (header.bytes[0] != 'B' || header.bytes[1] != 'M') {
        return deadeye_bmp_error("not_bmp");
    }

    int file_size = deadeye_u32_le(header.bytes, 2);
    int reserved_one = deadeye_u16_le(header.bytes, 6);
    int reserved_two = deadeye_u16_le(header.bytes, 8);
    int pixel_offset = deadeye_u32_le(header.bytes, 10);
    int dib_size = deadeye_u32_le(header.bytes, 14);
    int width_raw = deadeye_u32_le(header.bytes, 18);
    int height_raw = deadeye_u32_le(header.bytes, 22);
    int planes = deadeye_u16_le(header.bytes, 26);
    int bits_per_pixel = deadeye_u16_le(header.bytes, 28);
    int compression = deadeye_u32_le(header.bytes, 30);
    int image_size = deadeye_u32_le(header.bytes, 34);
    int colours_used = deadeye_u32_le(header.bytes, 46);
    int important_colours = deadeye_u32_le(header.bytes, 50);

    if (reserved_one != 0 || reserved_two != 0) {
        return deadeye_bmp_error("reserved_fields_nonzero");
    }
    if (dib_size != 40) { return deadeye_bmp_error("unsupported_dib_header"); }
    if (pixel_offset != 54) { return deadeye_bmp_error("unsupported_pixel_offset"); }
    if (planes != 1) { return deadeye_bmp_error("invalid_planes"); }
    if (compression != 0) { return deadeye_bmp_error("unsupported_compression"); }
    if (bits_per_pixel != 24 && bits_per_pixel != 32) {
        return deadeye_bmp_error("unsupported_bit_depth");
    }
    if (colours_used != 0 || important_colours != 0) {
        return deadeye_bmp_error("unsupported_palette");
    }

    int width = width_raw;
    int height = height_raw;
    if (width >= 2147483648) { width -= 4294967296; }
    if (height >= 2147483648) { height -= 4294967296; }
    if (width < 1 || width > DEADEYE_BMP_MAX_SIDE) {
        return deadeye_bmp_error("invalid_width");
    }
    if (height == 0 || height == -2147483648) {
        return deadeye_bmp_error("invalid_height");
    }

    bool top_down = height < 0;
    int absolute_height = height;
    if (top_down) { absolute_height = -height; }
    if (absolute_height > DEADEYE_BMP_MAX_SIDE ||
        width > DEADEYE_BMP_MAX_PIXELS / absolute_height) {
        return deadeye_bmp_error("pixel_limit");
    }

    int bytes_per_pixel = bits_per_pixel / 8;
    int row_bits = width * bits_per_pixel;
    int row_stride = ((row_bits + 31) / 32) * 4;
    int image_bytes = row_stride * absolute_height;
    int expected_file_size = 54 + image_bytes;

    if (file_size != source_length || file_size != expected_file_size) {
        return deadeye_bmp_error("file_size_mismatch");
    }
    if (image_size != 0 && image_size != image_bytes) {
        return deadeye_bmp_error("image_size_mismatch");
    }
    if (halyard_source_remaining(source) != image_bytes) {
        return deadeye_bmp_error("pixel_data_size_mismatch");
    }

    int pixel_count = width * absolute_height;
    if (let budget_value = budget) {
        // Reserve the cumulative output/work allowance before read_exact creates
        // its temporary pixel copy and before the final RGBA buffer is allocated.
        // The exact remaining-length check above makes truncation impossible for
        // a valid source; a corrupted source still fails closed after the charge.
        HalyardConsumptionCharge output_charge = new HalyardConsumptionCharge{
            input_bytes: 0, output_bytes: image_bytes + pixel_count * 4,
            decoded_units: pixel_count, work_units: image_bytes + pixel_count
        };
        if (!halyard_consumption_budget_consume(budget_value, output_charge)) {
            return deadeye_bmp_error("budget_exceeded");
        }
    }

    HalyardBytesResult pixels = halyard_read_exact(source, image_bytes);
    if (!pixels.ok) { return deadeye_bmp_error("truncated_pixel_data"); }
    List<int> rgba = new List<int>();
    for (int output_y = 0; output_y < absolute_height; output_y += 1) {
        int input_y = output_y;
        if (!top_down) { input_y = absolute_height - 1 - output_y; }
        int input_row = input_y * row_stride;
        for (int x = 0; x < width; x += 1) {
            int input_at = input_row + x * bytes_per_pixel;
            int blue = pixels.bytes[input_at];
            int green = pixels.bytes[input_at + 1];
            int red = pixels.bytes[input_at + 2];
            rgba.push(red);
            rgba.push(green);
            rgba.push(blue);
            // BI_RGB 32-bit fourth bytes are reserved, not a defined alpha
            // channel in this profile. Output alpha is therefore always opaque.
            rgba.push(255);
        }
    }

    if (rgba.len() != pixel_count * 4) {
        return deadeye_bmp_error("internal_pixel_count_mismatch");
    }
    DeadeyeRgbaFrame frame = new DeadeyeRgbaFrame{
        width: width, height: absolute_height, rgba: rgba
    };
    return new DeadeyeImageResult{ok: true, frame: frame, error: ""};
}

DeadeyeImageResult deadeye_bmp_decode(HalyardByteSource source) {
    return deadeye_bmp_decode_internal(source, none);
}

// Charges input/work before parsing and temporary+final pixel payload before allocation.
DeadeyeImageResult deadeye_bmp_decode_budgeted(
    HalyardByteSource source, HalyardConsumptionBudget budget
) {
    return deadeye_bmp_decode_internal(source, budget);
}

void deadeye_test_push_u16_le(List<int> bytes, int value) {
    bytes.push(value & 0xFF);
    bytes.push((value >>> 8) & 0xFF);
}

void deadeye_test_push_u32_le(List<int> bytes, int value) {
    bytes.push(value & 0xFF);
    bytes.push((value >>> 8) & 0xFF);
    bytes.push((value >>> 16) & 0xFF);
    bytes.push((value >>> 24) & 0xFF);
}

List<int> deadeye_test_bmp_24_bottom_up() {
    List<int> bytes = new List<int>();
    bytes.push('B'); bytes.push('M');
    deadeye_test_push_u32_le(bytes, 70);
    deadeye_test_push_u16_le(bytes, 0);
    deadeye_test_push_u16_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 54);
    deadeye_test_push_u32_le(bytes, 40);
    deadeye_test_push_u32_le(bytes, 2);
    deadeye_test_push_u32_le(bytes, 2);
    deadeye_test_push_u16_le(bytes, 1);
    deadeye_test_push_u16_le(bytes, 24);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 16);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    // Bottom row first: blue, white; two bytes of row padding.
    bytes.push(255); bytes.push(0); bytes.push(0);
    bytes.push(255); bytes.push(255); bytes.push(255);
    bytes.push(0); bytes.push(0);
    // Top row: red, green; two bytes of row padding.
    bytes.push(0); bytes.push(0); bytes.push(255);
    bytes.push(0); bytes.push(255); bytes.push(0);
    bytes.push(0); bytes.push(0);
    return bytes;
}

List<int> deadeye_test_bmp_32_top_down() {
    List<int> bytes = new List<int>();
    bytes.push('B'); bytes.push('M');
    deadeye_test_push_u32_le(bytes, 58);
    deadeye_test_push_u16_le(bytes, 0);
    deadeye_test_push_u16_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 54);
    deadeye_test_push_u32_le(bytes, 40);
    deadeye_test_push_u32_le(bytes, 1);
    deadeye_test_push_u32_le(bytes, -1);
    deadeye_test_push_u16_le(bytes, 1);
    deadeye_test_push_u16_le(bytes, 32);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 4);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    deadeye_test_push_u32_le(bytes, 0);
    // B=3, G=2, R=1, reserved fourth byte=0x55 (ignored, output alpha=255).
    bytes.push(3); bytes.push(2); bytes.push(1); bytes.push(85);
    return bytes;
}

test "Deadeye decodes bottom-up 24-bit BMP rows and padding" {
    List<int> bytes = deadeye_test_bmp_24_bottom_up();
    HalyardByteSourceResult made = halyard_source_from_list(bytes, 128);
    assert(made.ok);
    if (let source = made.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(decoded.ok);
        if (let frame = decoded.frame) {
            assert(frame.width == 2 && frame.height == 2);
            assert(frame.rgba.len() == 16);
            // Top row: red, green.
            assert(frame.rgba[0] == 255 && frame.rgba[1] == 0);
            assert(frame.rgba[2] == 0 && frame.rgba[3] == 255);
            assert(frame.rgba[4] == 0 && frame.rgba[5] == 255);
            assert(frame.rgba[6] == 0 && frame.rgba[7] == 255);
            // Bottom row: blue, white.
            assert(frame.rgba[8] == 0 && frame.rgba[9] == 0);
            assert(frame.rgba[10] == 255 && frame.rgba[11] == 255);
            assert(frame.rgba[12] == 255 && frame.rgba[13] == 255);
            assert(frame.rgba[14] == 255 && frame.rgba[15] == 255);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
}

test "Deadeye decodes top-down 32-bit BMP and treats BI_RGB fourth byte as reserved" {
    List<int> bytes = deadeye_test_bmp_32_top_down();
    HalyardByteSourceResult made = halyard_source_from_list(bytes, 128);
    assert(made.ok);
    if (let source = made.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(decoded.ok);
        if (let frame = decoded.frame) {
            assert(frame.width == 1 && frame.height == 1);
            assert(frame.rgba.len() == 4);
            assert(frame.rgba[0] == 1 && frame.rgba[1] == 2);
            assert(frame.rgba[2] == 3 && frame.rgba[3] == 255);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
}

test "Deadeye rejects malformed BMP signatures and file sizes" {
    List<int> bad_signature = deadeye_test_bmp_24_bottom_up();
    bad_signature[0] = 'X';
    HalyardByteSourceResult first = halyard_source_from_list(bad_signature, 128);
    assert(first.ok);
    if (let source = first.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(!decoded.ok && decoded.error == "not_bmp");
    } else {
        assert(false);
    }

    List<int> bad_size = deadeye_test_bmp_24_bottom_up();
    bad_size[2] = 69;
    HalyardByteSourceResult second = halyard_source_from_list(bad_size, 128);
    assert(second.ok);
    if (let source2 = second.source) {
        DeadeyeImageResult decoded2 = deadeye_bmp_decode(source2);
        assert(!decoded2.ok && decoded2.error == "file_size_mismatch");
    } else {
        assert(false);
    }
}

test "Deadeye rejects unsupported BMP headers, compression and bit depths" {
    List<int> bad_dib = deadeye_test_bmp_24_bottom_up();
    bad_dib[14] = 108;
    HalyardByteSourceResult first = halyard_source_from_list(bad_dib, 128);
    assert(first.ok);
    if (let source = first.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(!decoded.ok && decoded.error == "unsupported_dib_header");
    } else {
        assert(false);
    }

    List<int> compressed = deadeye_test_bmp_24_bottom_up();
    compressed[30] = 1;
    HalyardByteSourceResult second = halyard_source_from_list(compressed, 128);
    assert(second.ok);
    if (let source2 = second.source) {
        DeadeyeImageResult decoded2 = deadeye_bmp_decode(source2);
        assert(!decoded2.ok && decoded2.error == "unsupported_compression");
    } else {
        assert(false);
    }

    List<int> bad_depth = deadeye_test_bmp_24_bottom_up();
    bad_depth[28] = 8;
    HalyardByteSourceResult third = halyard_source_from_list(bad_depth, 128);
    assert(third.ok);
    if (let source3 = third.source) {
        DeadeyeImageResult decoded3 = deadeye_bmp_decode(source3);
        assert(!decoded3.ok && decoded3.error == "unsupported_bit_depth");
    } else {
        assert(false);
    }
}

test "Deadeye rejects invalid dimensions and noncanonical pixel offsets" {
    List<int> bad_width = deadeye_test_bmp_24_bottom_up();
    bad_width[18] = 0;
    HalyardByteSourceResult first = halyard_source_from_list(bad_width, 128);
    assert(first.ok);
    if (let source = first.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(!decoded.ok && decoded.error == "invalid_width");
    } else {
        assert(false);
    }

    List<int> bad_offset = deadeye_test_bmp_24_bottom_up();
    bad_offset[10] = 55;
    HalyardByteSourceResult second = halyard_source_from_list(bad_offset, 128);
    assert(second.ok);
    if (let source2 = second.source) {
        DeadeyeImageResult decoded2 = deadeye_bmp_decode(source2);
        assert(!decoded2.ok && decoded2.error == "unsupported_pixel_offset");
    } else {
        assert(false);
    }
}

test "Deadeye rejects mismatched image size and forged source bytes" {
    List<int> bad_image_size = deadeye_test_bmp_24_bottom_up();
    bad_image_size[34] = 15;
    HalyardByteSourceResult first = halyard_source_from_list(bad_image_size, 128);
    assert(first.ok);
    if (let source = first.source) {
        DeadeyeImageResult decoded = deadeye_bmp_decode(source);
        assert(!decoded.ok && decoded.error == "image_size_mismatch");
    } else {
        assert(false);
    }

    List<int> bytes = deadeye_test_bmp_24_bottom_up();
    HalyardByteSourceResult second = halyard_source_from_list(bytes, 128);
    assert(second.ok);
    if (let source2 = second.source) {
        source2.bytes[0] = 999;
        DeadeyeImageResult decoded2 = deadeye_bmp_decode(source2);
        assert(!decoded2.ok && decoded2.error == "invalid_source");
    } else {
        assert(false);
    }
}


test "Deadeye budget charges temporary and final pixel buffers before allocation" {
    List<int> bytes = deadeye_test_bmp_24_bottom_up();
    HalyardByteSourceResult made = halyard_source_from_list(bytes, 128);
    HalyardConsumptionBudgetResult budget_result =
        halyard_consumption_budget_create(128, 32, 4, 128);
    assert(made.ok && budget_result.ok);
    if (let source = made.source) {
        if (let budget = budget_result.budget) {
            DeadeyeImageResult decoded = deadeye_bmp_decode_budgeted(source, budget);
            assert(decoded.ok);
            assert(budget.used_input_bytes == 70);
            assert(budget.used_output_bytes == 32);
            assert(budget.used_decoded_units == 4);
            assert(budget.used_work_units == 90);
        } else { assert(false); }
    } else { assert(false); }
}

test "Deadeye budget rejects pixel materialisation before allocation" {
    List<int> bytes = deadeye_test_bmp_24_bottom_up();
    HalyardByteSourceResult made = halyard_source_from_list(bytes, 128);
    HalyardConsumptionBudgetResult budget_result =
        halyard_consumption_budget_create(128, 31, 4, 128);
    assert(made.ok && budget_result.ok);
    if (let source = made.source) {
        if (let budget = budget_result.budget) {
            DeadeyeImageResult decoded = deadeye_bmp_decode_budgeted(source, budget);
            assert(!decoded.ok && decoded.error == "budget_exceeded");
            assert(budget.used_input_bytes == 70);
            assert(budget.used_output_bytes == 0);
            assert(budget.used_decoded_units == 0);
            assert(budget.used_work_units == 70);
            // The parser has consumed only the fixed header. It must reject
            // the output charge before read_exact materialises the pixel copy.
            assert(source.position == 54);
        } else { assert(false); }
    } else { assert(false); }
}


// Bounded presentation queue for decoded Deadeye frames.
//
// This is a deterministic, single-owner scheduling primitive, not a device
// presenter or a thread-safe queue. Timestamps and durations use one explicit
// rational timebase. Frames are admitted in presentation order; gaps are valid
// (variable frame rate), overlap and timestamp overflow are rejected. Enqueue
// snapshots pixel bytes so a caller cannot mutate a queued frame through its
// original input value. Queue byte limits are logical payload limits; they do
// not account for allocator metadata or runtime list capacity.

const int DEADEYE_PRESENTATION_MAX_FRAMES = 4096;
const int DEADEYE_PRESENTATION_MAX_RETAINED_BYTES = 134217728;

struct DeadeyePresentationEntry {
    DeadeyeRgbaFrame frame;
    int pts;
    int duration;
}

struct DeadeyePresentationQueue {
    HalyardTimebase timebase;
    List<DeadeyePresentationEntry> entries;
    int max_frames;
    int max_retained_bytes;
    int retained_bytes;
    bool closed;
}

struct DeadeyePresentationQueueResult {
    bool ok;
    DeadeyePresentationQueue? queue;
    string error;
}

struct DeadeyePresentationTakeResult {
    bool ok;
    bool available;
    DeadeyePresentationEntry? entry;
    string error;
}

bool deadeye_presentation_frame_valid(DeadeyeRgbaFrame frame) {
    if (frame.width < 1 || frame.width > DEADEYE_BMP_MAX_SIDE ||
        frame.height < 1 || frame.height > DEADEYE_BMP_MAX_SIDE ||
        frame.width > DEADEYE_BMP_MAX_PIXELS / frame.height) {
        return false;
    }
    int pixels = frame.width * frame.height;
    return frame.rgba.len() == pixels * 4;
}

int deadeye_presentation_frame_bytes(DeadeyeRgbaFrame frame) {
    return frame.width * frame.height * 4;
}

DeadeyeRgbaFrame deadeye_presentation_frame_snapshot(DeadeyeRgbaFrame frame) {
    List<int> rgba = new List<int>();
    for (int i = 0; i < frame.rgba.len(); i += 1) {
        rgba.push(frame.rgba[i]);
    }
    return new DeadeyeRgbaFrame{
        width: frame.width, height: frame.height, rgba: rgba
    };
}

DeadeyePresentationQueueResult deadeye_presentation_queue_create(
    HalyardTimebase timebase, int max_frames, int max_retained_bytes
) {
    if (!halyard_timebase_valid(timebase)) {
        return new DeadeyePresentationQueueResult{
            ok: false, queue: none, error: "invalid_timebase"
        };
    }
    if (max_frames < 1 || max_frames > DEADEYE_PRESENTATION_MAX_FRAMES) {
        return new DeadeyePresentationQueueResult{
            ok: false, queue: none, error: "frame_limit"
        };
    }
    if (max_retained_bytes < 0 ||
        max_retained_bytes > DEADEYE_PRESENTATION_MAX_RETAINED_BYTES) {
        return new DeadeyePresentationQueueResult{
            ok: false, queue: none, error: "retained_byte_limit"
        };
    }
    DeadeyePresentationQueue queue = new DeadeyePresentationQueue{
        timebase: timebase, entries: new List<DeadeyePresentationEntry>(),
        max_frames: max_frames, max_retained_bytes: max_retained_bytes,
        retained_bytes: 0, closed: false
    };
    return new DeadeyePresentationQueueResult{
        ok: true, queue: queue, error: ""
    };
}

bool deadeye_presentation_queue_valid(DeadeyePresentationQueue queue) {
    if (queue.closed || !halyard_timebase_valid(queue.timebase) ||
        queue.max_frames < 1 ||
        queue.max_frames > DEADEYE_PRESENTATION_MAX_FRAMES ||
        queue.entries.len() > queue.max_frames ||
        queue.max_retained_bytes < 0 ||
        queue.max_retained_bytes > DEADEYE_PRESENTATION_MAX_RETAINED_BYTES ||
        queue.retained_bytes < 0 ||
        queue.retained_bytes > queue.max_retained_bytes) {
        return false;
    }
    int total_bytes = 0;
    int previous_end = 0;
    bool has_previous = false;
    for (int i = 0; i < queue.entries.len(); i += 1) {
        DeadeyePresentationEntry entry = queue.entries[i];
        if (!deadeye_presentation_frame_valid(entry.frame) ||
            entry.duration <= 0 ||
            entry.pts > HALYARD_I64_MAX - entry.duration) {
            return false;
        }
        if (has_previous && entry.pts < previous_end) { return false; }
        previous_end = entry.pts + entry.duration;
        has_previous = true;
        int frame_bytes = deadeye_presentation_frame_bytes(entry.frame);
        if (frame_bytes > queue.max_retained_bytes - total_bytes) {
            return false;
        }
        total_bytes += frame_bytes;
    }
    return total_bytes == queue.retained_bytes;
}

// Append in presentation order. A failed admission leaves the queue unchanged.
// The payload is snapshotted only after every shape, timestamp and capacity
// check has succeeded.
bool deadeye_presentation_queue_push(
    DeadeyePresentationQueue queue, DeadeyeRgbaFrame frame, int pts, int duration
) {
    if (!deadeye_presentation_queue_valid(queue) ||
        !deadeye_presentation_frame_valid(frame) || duration <= 0 ||
        pts > HALYARD_I64_MAX - duration) {
        return false;
    }
    if (queue.entries.len() >= queue.max_frames) { return false; }
    if (queue.entries.len() > 0) {
        DeadeyePresentationEntry previous =
            queue.entries[queue.entries.len() - 1];
        if (previous.pts > HALYARD_I64_MAX - previous.duration ||
            pts < previous.pts + previous.duration) {
            return false;
        }
    }
    int frame_bytes = deadeye_presentation_frame_bytes(frame);
    if (frame_bytes > queue.max_retained_bytes - queue.retained_bytes) {
        return false;
    }

    DeadeyeRgbaFrame snapshot = deadeye_presentation_frame_snapshot(frame);
    DeadeyePresentationEntry appended = new DeadeyePresentationEntry{
        frame: snapshot, pts: pts, duration: duration
    };
    List<DeadeyePresentationEntry> replacement =
        new List<DeadeyePresentationEntry>();
    for (int i = 0; i < queue.entries.len(); i += 1) {
        replacement.push(queue.entries[i]);
    }
    replacement.push(appended);
    queue.entries = replacement;
    queue.retained_bytes += frame_bytes;
    return true;
}

// Return at most one frame whose presentation timestamp is no later than the
// supplied master-clock tick. Call repeatedly to drain all frames due at that
// clock value. Late-frame dropping is deliberately a caller policy.
DeadeyePresentationTakeResult deadeye_presentation_queue_take_due(
    DeadeyePresentationQueue queue, int master_clock_ticks
) {
    if (!deadeye_presentation_queue_valid(queue)) {
        return new DeadeyePresentationTakeResult{
            ok: false, available: false, entry: none, error: "invalid_queue"
        };
    }
    if (queue.entries.len() == 0 ||
        queue.entries[0].pts > master_clock_ticks) {
        return new DeadeyePresentationTakeResult{
            ok: true, available: false, entry: none, error: ""
        };
    }

    DeadeyePresentationEntry first = queue.entries[0];
    List<DeadeyePresentationEntry> replacement =
        new List<DeadeyePresentationEntry>();
    for (int i = 1; i < queue.entries.len(); i += 1) {
        replacement.push(queue.entries[i]);
    }
    queue.entries = replacement;
    queue.retained_bytes -= deadeye_presentation_frame_bytes(first.frame);
    return new DeadeyePresentationTakeResult{
        ok: true, available: true, entry: first, error: ""
    };
}

bool deadeye_presentation_queue_close(DeadeyePresentationQueue queue) {
    if (queue.closed || !deadeye_presentation_queue_valid(queue)) {
        return false;
    }
    queue.entries = new List<DeadeyePresentationEntry>();
    queue.retained_bytes = 0;
    queue.closed = true;
    return true;
}

DeadeyeRgbaFrame deadeye_test_presentation_frame(int red) {
    List<int> rgba = new List<int>();
    rgba.push(red); rgba.push(2); rgba.push(3); rgba.push(255);
    return new DeadeyeRgbaFrame{width: 1, height: 1, rgba: rgba};
}

test "Deadeye presentation queue schedules variable-rate frames against a rational clock" {
    HalyardTimebaseResult tb = halyard_timebase_create(1, 1000);
    assert(tb.ok);
    if (let timebase = tb.timebase) {
        DeadeyePresentationQueueResult made =
            deadeye_presentation_queue_create(timebase, 3, 12);
        assert(made.ok);
        if (let queue = made.queue) {
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(10), 0, 40
            ));
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(20), 40, 17
            ));
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(30), 57, 33
            ));
            assert(queue.retained_bytes == 12);
            DeadeyePresentationTakeResult early =
                deadeye_presentation_queue_take_due(queue, 39);
            assert(early.ok && !early.available && queue.retained_bytes == 12);
            DeadeyePresentationTakeResult due =
                deadeye_presentation_queue_take_due(queue, 40);
            assert(due.ok && due.available && queue.retained_bytes == 8);
            if (let entry = due.entry) {
                assert(entry.pts == 0 && entry.duration == 40);
                assert(entry.frame.rgba[0] == 10);
            } else { assert(false); }
            DeadeyePresentationTakeResult second =
                deadeye_presentation_queue_take_due(queue, 57);
            assert(second.ok && second.available && queue.retained_bytes == 4);
            if (let entry = second.entry) {
                assert(entry.pts == 40 && entry.duration == 17);
                assert(entry.frame.rgba[0] == 20);
            } else { assert(false); }
        } else { assert(false); }
    } else { assert(false); }
}

test "Deadeye presentation queue rejects overlap, reordering and invalid durations atomically" {
    HalyardTimebaseResult tb = halyard_timebase_create(1, 90000);
    assert(tb.ok);
    if (let timebase = tb.timebase) {
        DeadeyePresentationQueueResult made =
            deadeye_presentation_queue_create(timebase, 4, 16);
        assert(made.ok);
        if (let queue = made.queue) {
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(1), 100, 10
            ));
            assert(!deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(2), 105, 10
            ));
            assert(!deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(2), 99, 10
            ));
            assert(!deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(2), 110, 0
            ));
            assert(queue.entries.len() == 1 && queue.retained_bytes == 4);
            assert(queue.entries[0].pts == 100);
        } else { assert(false); }
    } else { assert(false); }
}

test "Deadeye presentation queue enforces frame and retained-payload limits" {
    HalyardTimebaseResult tb = halyard_timebase_create(1, 25);
    assert(tb.ok);
    if (let timebase = tb.timebase) {
        DeadeyePresentationQueueResult made =
            deadeye_presentation_queue_create(timebase, 1, 4);
        assert(made.ok);
        if (let queue = made.queue) {
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(1), 0, 1
            ));
            assert(!deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(2), 1, 1
            ));
            assert(queue.entries.len() == 1 && queue.retained_bytes == 4);
            DeadeyePresentationTakeResult taken =
                deadeye_presentation_queue_take_due(queue, 0);
            assert(taken.ok && taken.available && queue.retained_bytes == 0);
            assert(deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(3), 1, 1
            ));
        } else { assert(false); }
    } else { assert(false); }
}

test "Deadeye presentation queue snapshots pixels and flushes on close" {
    HalyardTimebaseResult tb = halyard_timebase_create(1, 24);
    assert(tb.ok);
    if (let timebase = tb.timebase) {
        DeadeyePresentationQueueResult made =
            deadeye_presentation_queue_create(timebase, 2, 8);
        assert(made.ok);
        if (let queue = made.queue) {
            DeadeyeRgbaFrame original = deadeye_test_presentation_frame(77);
            assert(deadeye_presentation_queue_push(queue, original, 0, 1));
            original.rgba[0] = 200;
            assert(queue.entries[0].frame.rgba[0] == 77);
            assert(deadeye_presentation_queue_close(queue));
            assert(queue.closed && queue.entries.len() == 0);
            assert(queue.retained_bytes == 0);
            assert(!deadeye_presentation_queue_close(queue));
        } else { assert(false); }
    } else { assert(false); }
}

test "Deadeye presentation queue rejects invalid frame shapes and timestamp overflow" {
    HalyardTimebaseResult tb = halyard_timebase_create(1, 1);
    assert(tb.ok);
    if (let timebase = tb.timebase) {
        DeadeyePresentationQueueResult made =
            deadeye_presentation_queue_create(timebase, 2, 8);
        assert(made.ok);
        if (let queue = made.queue) {
            DeadeyeRgbaFrame malformed = deadeye_test_presentation_frame(1);
            malformed.rgba.push(9);
            assert(!deadeye_presentation_queue_push(queue, malformed, 0, 1));
            assert(!deadeye_presentation_queue_push(
                queue, deadeye_test_presentation_frame(2),
                HALYARD_I64_MAX, 1
            ));
            assert(queue.entries.len() == 0 && queue.retained_bytes == 0);
        } else { assert(false); }
    } else { assert(false); }
}
